---
/** Widget Bio Accueil : sous-widgets (horaires, email, téléphone, message). */
import { Mail, MessageCircle, Clock, Phone } from 'lucide-static'

type OpeningHourSlot = {
  day_of_week: number
  closed: boolean
  start_time: string | null
  end_time: string | null
}

interface Props {
  openingHours?: OpeningHourSlot[]
  openingHoursEnabled?: boolean
  contactEmail?: string | null
  contactEmailPublic?: boolean
  contactPhone?: string | null
  contactPhonePublic?: boolean
  messageEnabled?: boolean
  messageHref?: string | null
}

const {
  openingHours = [],
  openingHoursEnabled = false,
  contactEmail = null,
  contactEmailPublic = true,
  contactPhone = null,
  contactPhonePublic = true,
  messageEnabled = false,
  messageHref = null,
} = Astro.props

const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0] as const
const DAY_LABELS: Record<number, string> = {
  0: 'Dimanche',
  1: 'Lundi',
  2: 'Mardi',
  3: 'Mercredi',
  4: 'Jeudi',
  5: 'Vendredi',
  6: 'Samedi',
}

const hoursByDay = new Map(openingHours.map((h) => [h.day_of_week, h]))
const visibleHours = DAY_ORDER.map((day) => hoursByDay.get(day)).filter(Boolean) as OpeningHourSlot[]

const email = contactEmail?.trim() || null
const phone = contactPhone?.trim() || null
const showEmail = contactEmailPublic && !!email
const showPhone = contactPhonePublic && !!phone
const showMessage = messageEnabled && !!messageHref
const mailto = showEmail && email ? `mailto:${email}` : null
const telHref = showPhone && phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null

const today = new Date().getDay()

function formatTime(t: string | null) {
  if (!t) return ''
  return t.slice(0, 5).replace(':', 'h')
}

function hourLabel(slot: OpeningHourSlot) {
  if (slot.closed) return 'Fermé'
  if (slot.start_time && slot.end_time) {
    return `${formatTime(slot.start_time)} – ${formatTime(slot.end_time)}`
  }
  return '—'
}

const hasHours = openingHoursEnabled && visibleHours.length > 0
const hasContacts = showEmail || showPhone || showMessage
const contactCount = [showEmail, showPhone, showMessage].filter(Boolean).length
---
{(hasHours || hasContacts) ? (
  <div class="bio-widget">
    {hasHours && (
      <section class="bio-widget__mini bio-widget__mini--hours">
        <header class="bio-widget__mini-head">
          <span class="bio-widget__mini-icon" set:html={Clock} />
          <h4 class="bio-widget__mini-title">Horaires</h4>
        </header>
        <ul class="bio-widget__hours">
          {visibleHours.map((slot) => (
            <li class:list={['bio-widget__hours-row', slot.day_of_week === today && 'is-today', slot.closed && 'is-closed']}>
              <span class="bio-widget__day">{DAY_LABELS[slot.day_of_week]}</span>
              <span class="bio-widget__time">{hourLabel(slot)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {hasContacts && (
      <div
        class="bio-widget__contacts"
        class:list={[
          contactCount === 1 && 'bio-widget__contacts--one',
          contactCount === 2 && 'bio-widget__contacts--two',
          contactCount === 3 && 'bio-widget__contacts--three',
        ]}
      >
        {showEmail && mailto && (
          <a href={mailto} class="bio-widget__action">
            <span class="bio-widget__action-icon" set:html={Mail} />
            <span class="bio-widget__action-copy">
              <span class="bio-widget__action-label">Email</span>
              <span class="bio-widget__action-value">{email}</span>
            </span>
          </a>
        )}

        {showPhone && telHref && (
          <a href={telHref} class="bio-widget__action">
            <span class="bio-widget__action-icon" set:html={Phone} />
            <span class="bio-widget__action-copy">
              <span class="bio-widget__action-label">Téléphone</span>
              <span class="bio-widget__action-value">{phone}</span>
            </span>
          </a>
        )}

        {showMessage && messageHref && (
          <a href={messageHref} class="bio-widget__action bio-widget__action--primary">
            <span class="bio-widget__action-icon" set:html={MessageCircle} />
            <span class="bio-widget__action-copy">
              <span class="bio-widget__action-label">Message</span>
              <span class="bio-widget__action-value">Nous écrire</span>
            </span>
          </a>
        )}
      </div>
    )}
  </div>
) : null}

<style>
  .bio-widget {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Sous-widget : carte autonome dans le widget Bio */
  .bio-widget__mini {
    background: var(--color-surface);
    border-radius: 12px;
    padding: 14px;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .bio-widget__mini-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .bio-widget__mini-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--color-panel);
    color: var(--color-neutral-700);
    flex-shrink: 0;
  }
  .bio-widget__mini-icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  .bio-widget__mini-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-neutral-800);
  }

  .bio-widget__hours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bio-widget__hours-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    padding: 5px 8px;
    border-radius: 8px;
  }

  .bio-widget__hours-row.is-today {
    background: color-mix(in srgb, var(--color-accent-soft) 55%, transparent);
  }

  .bio-widget__hours-row.is-today .bio-widget__time {
    color: var(--color-accent);
    font-weight: 600;
  }

  .bio-widget__hours-row.is-closed .bio-widget__time {
    color: var(--color-neutral-400);
  }

  .bio-widget__day {
    color: var(--color-neutral-800);
    font-weight: 500;
  }

  .bio-widget__time {
    color: var(--color-neutral-600);
    font-variant-numeric: tabular-nums;
  }

  .bio-widget__contacts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .bio-widget__contacts--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .bio-widget__contacts--one {
    grid-template-columns: 1fr;
  }

  @media (max-width: 520px) {
    .bio-widget__contacts--one,
    .bio-widget__contacts--three {
      grid-template-columns: 1fr;
    }
    .bio-widget__contacts--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .bio-widget__action {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 56px;
    padding: 11px 13px;
    border-radius: 14px;
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    box-shadow: 0 1px 2px rgba(15, 18, 28, 0.04);
    text-decoration: none;
    color: inherit;
    transition:
      transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  a.bio-widget__action:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-neutral-900) 12%, var(--color-border));
    box-shadow: 0 8px 20px -14px rgba(15, 18, 28, 0.28);
  }

  .bio-widget__action-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--color-panel);
    color: var(--color-neutral-700);
  }
  .bio-widget__action-icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  .bio-widget__action-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .bio-widget__action-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-neutral-400);
  }

  .bio-widget__action-value {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-neutral-900);
    line-height: 1.3;
    word-break: break-word;
  }

  .bio-widget__action--primary {
    background: var(--color-neutral-900);
    border-color: var(--color-neutral-900);
    box-shadow: 0 4px 14px -8px rgba(15, 18, 28, 0.45);
  }
  .bio-widget__action--primary .bio-widget__action-icon {
    background: color-mix(in srgb, #fff 14%, transparent);
    color: #fff;
  }
  .bio-widget__action--primary .bio-widget__action-label {
    color: rgba(255, 255, 255, 0.58);
  }
  .bio-widget__action--primary .bio-widget__action-value {
    color: #fff;
  }
  a.bio-widget__action--primary:hover {
    border-color: var(--color-neutral-900);
    box-shadow: 0 10px 24px -12px rgba(15, 18, 28, 0.5);
  }
</style>
