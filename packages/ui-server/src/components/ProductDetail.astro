---
import { Heart, ShoppingBag, Download, Package, MapPin, FileText, Globe, Clock, ShieldCheck, Truck, Store, PlayCircle } from 'lucide-static'

type Json = unknown

/** Bloc de contenu riche (content_blocks V2). Narrowing fait côté page. */
type ContentBlock =
  | { type: 'text'; content: string }
  | { type: 'image'; url: string; alt?: string }

interface Media {
  id: string
  url: string
  media_type?: string | null
  alt_text?: string | null
  display_order?: number
}

interface Variant {
  id: string
  attributes: Json
  stock_quantity: number
  price_cents_override: number | null
  primary_image_url: string | null
  is_active: boolean
}

interface Props {
  product: {
    id: string
    title: string
    description_short: string
    description_long: string | null
    price_cents: number
    sale_price_cents: number | null
    sale_ends_at: string | null
    currency: string
    type: 'digital' | 'physical'
    pickup_enabled: boolean
    delivery_enabled: boolean
    product_media?: Media[] | null
    product_variants?: Variant[] | null
    // digital
    digital_file_format: string | null
    digital_language: string | null
    digital_license: string | null
    digital_pages_or_duration: number | null
    // physical
    physical_condition: string | null
    physical_pickup_location: string | null
    physical_pickup_instructions: string | null
    physical_stock_quantity: number | null
    physical_stock_unlimited: boolean | null
  }
  /** État initial wishlist (calculé serveur via isInWishlist si user connecté). */
  inWishlist?: boolean
  isAuthenticated?: boolean
  dashboardUrl?: string
  productUrl: string
  /** Nom de catégorie résolu côté page (embed entity_product_categories ou legacy). */
  categoryName?: string | null
  /** Points principaux (bullet_points V2), narrowés côté page en string[]. */
  bulletPoints?: string[]
  /** Description riche (content_blocks V2), narrowée côté page. Vide → fallback description_long. */
  contentBlocks?: ContentBlock[]
  /** Promo active calculée côté SSR (sale_price_cents valide ET non expirée). */
  saleActive?: boolean
}

const {
  product,
  inWishlist = false,
  isAuthenticated = false,
  dashboardUrl = 'http://localhost:3000',
  productUrl,
  categoryName = null,
  bulletPoints = [],
  contentBlocks = [],
  saleActive = false,
} = Astro.props

const allMedia = (product.product_media ?? [])
  .slice()
  .sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0))
const images = allMedia.filter((m) => !m.media_type || m.media_type === 'image')
const video = allMedia.find((m) => m.media_type === 'video') ?? null
// Galerie : médias visibles = images + éventuelle vidéo (la vidéo apparaît en vignette).
const galleryMedia = [...images, ...(video ? [video] : [])]
const mainImage = images[0]?.url ?? null

const variants = (product.product_variants ?? []).filter((v) => v.is_active)
const hasVariants = variants.length > 0

function formatPrice(cents: number, currency: string): string {
  try {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100)
  } catch {
    return `${(cents / 100).toFixed(2)} €`
  }
}

// Prix mini sur variantes pour "à partir de"
const variantPrices = variants.map((v) => v.price_cents_override ?? product.price_cents)
const minCents = variantPrices.length > 0 ? Math.min(...variantPrices) : product.price_cents
const maxCents = variantPrices.length > 0 ? Math.max(...variantPrices) : product.price_cents
const isMultiPrice = hasVariants && minCents !== maxCents
const initialPriceText = formatPrice(minCents, product.currency)

// Promo : s'applique au PRIX DE BASE uniquement. Si une variante est sélectionnée
// (override), son prix prime et la promo n'est PAS appliquée sur la ligne variante
// (le JS du sélecteur écrase #product-price avec le prix variante brut).
const showSalePrice = saleActive && product.sale_price_cents != null
const salePriceText = showSalePrice ? formatPrice(product.sale_price_cents as number, product.currency) : null
const baseOriginalText = formatPrice(product.price_cents, product.currency)
const salePercent =
  showSalePrice && product.price_cents > 0
    ? Math.round((1 - (product.sale_price_cents as number) / product.price_cents) * 100)
    : 0
// Date de fin de promo formatée (fr-FR) si présente
let saleEndsLabel: string | null = null
if (showSalePrice && product.sale_ends_at) {
  try {
    saleEndsLabel = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(product.sale_ends_at)
    )
  } catch {
    saleEndsLabel = null
  }
}

// Description riche : content_blocks si non vide, sinon fallback description_long (V1)
const hasContentBlocks = contentBlocks.length > 0

// Disponibilité initiale (sans variante sélectionnée)
let initialInStock: boolean
if (hasVariants) {
  initialInStock = variants.some((v) => v.stock_quantity > 0)
} else if (product.type === 'digital') {
  initialInStock = true
} else {
  initialInStock = !!product.physical_stock_unlimited || (product.physical_stock_quantity ?? 0) > 0
}

// Attributs : on dérive l'ensemble des clés et valeurs depuis variants[].attributes
type AttrMap = Record<string, string>
const variantAttrs: AttrMap[] = variants.map((v) => {
  const a = (v.attributes ?? {}) as Record<string, unknown>
  const out: AttrMap = {}
  for (const k of Object.keys(a)) out[k] = String(a[k])
  return out
})
const attrKeys = Array.from(new Set(variantAttrs.flatMap((a) => Object.keys(a))))
const attrOptions: Record<string, string[]> = {}
for (const key of attrKeys) {
  attrOptions[key] = Array.from(
    new Set(variantAttrs.map((a) => a[key]).filter((v): v is string => !!v))
  )
}

// Données JSON pour le sélecteur vanilla JS
const variantData = variants.map((v, i) => ({
  id: v.id,
  attributes: variantAttrs[i],
  priceCents: v.price_cents_override ?? product.price_cents,
  stock: v.stock_quantity,
  image: v.primary_image_url,
}))

const conditionLabels: Record<string, string> = {
  new: 'Neuf',
  like_new: 'Comme neuf',
  very_good: 'Très bon état',
  good: 'Bon état',
  acceptable: 'État correct',
}
const licenseLabels: Record<string, string> = {
  personal: 'Licence personnelle',
  professional: 'Licence professionnelle',
  commercial: 'Licence commerciale',
}
const formatLabels: Record<string, string> = {
  pdf: 'PDF', epub: 'EPUB', mp4: 'MP4', mp3: 'MP3', zip: 'ZIP', other: 'Fichier',
}

const loginUrl = `${dashboardUrl}/login?redirect=${encodeURIComponent(productUrl)}`
---
<div class="flex flex-col md:flex-row">
  {/* ===== GALERIE ===== */}
  <div class="md:w-[48%] md:border-r md:border-neutral-200">
    <div class="relative aspect-square w-full overflow-hidden bg-neutral-100">
      {mainImage ? (
        <img id="product-main-image" src={mainImage} alt={product.title} class="h-full w-full object-cover" />
      ) : (
        <div id="product-main-image-empty" class="flex h-full w-full items-center justify-center text-neutral-300">
          <span class="flex h-16 w-16 items-center justify-center" set:html={ShoppingBag} />
        </div>
      )}
      {/* Viewer vidéo : masqué par défaut, affiché au clic sur la vignette vidéo. Pas d'autoplay. */}
      {video && (
        <video
          id="product-main-video"
          src={video.url}
          controls
          preload="metadata"
          playsinline
          class="absolute inset-0 hidden h-full w-full bg-black object-contain"
        ></video>
      )}
    </div>
    {(galleryMedia.length > 1 || (video && images.length === 0)) && (
      <div class="flex gap-2 overflow-x-auto px-6 py-4">
        {galleryMedia.map((m, i) => {
          const isVideo = m.media_type === 'video'
          return (
            <button
              type="button"
              data-thumb={m.url}
              data-media-type={isVideo ? 'video' : 'image'}
              class:list={[
                'relative h-16 w-16 shrink-0 overflow-hidden rounded-lg border-2 transition',
                i === 0 ? 'border-accent' : 'border-transparent hover:border-neutral-300',
              ]}
              aria-label={isVideo ? 'Voir la vidéo' : `Voir l'image ${i + 1}`}
            >
              {isVideo ? (
                <>
                  <video src={m.url} preload="metadata" muted class="h-full w-full object-cover"></video>
                  <span class="absolute inset-0 flex items-center justify-center bg-black/30 text-white">
                    <span class="flex h-6 w-6 items-center justify-center" set:html={PlayCircle} />
                  </span>
                </>
              ) : (
                <img src={m.url} alt={m.alt_text ?? product.title} class="h-full w-full object-cover" loading="lazy" />
              )}
            </button>
          )
        })}
      </div>
    )}
  </div>

  {/* ===== INFOS ===== */}
  <div class="md:w-[52%] px-6 py-6 sm:px-8">
    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-lg bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-600">
            <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={product.type === 'digital' ? Download : Package} />
            {product.type === 'digital' ? 'Produit numérique' : 'Click & collect'}
          </span>
          {categoryName && (
            <span class="inline-flex items-center rounded-lg bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent">
              {categoryName}
            </span>
          )}
        </div>
        <h1 class="mt-3 text-2xl font-semibold text-neutral-900">{product.title}</h1>
      </div>
      {/* Bouton wishlist */}
      <button
        type="button"
        id="wishlist-btn"
        data-product-id={product.id}
        data-in-wishlist={inWishlist ? 'true' : 'false'}
        data-price-cents={minCents}
        data-authenticated={isAuthenticated ? 'true' : 'false'}
        data-login-url={loginUrl}
        aria-pressed={inWishlist ? 'true' : 'false'}
        aria-label="Ajouter à ma liste de souhaits"
        class:list={[
          'flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition',
          inWishlist
            ? 'border-accent bg-accent/10 text-accent'
            : 'border-neutral-200 text-neutral-400 hover:border-accent hover:text-accent',
        ]}
      >
        <span class="flex h-5 w-5 items-center justify-center" set:html={Heart} />
      </button>
    </div>

    {/* Points principaux (bullet_points) */}
    {bulletPoints.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {bulletPoints.map((point) => (
          <li class="flex items-start gap-2 text-sm text-neutral-700">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-3 text-sm text-neutral-600">{product.description_short}</p>

    {/* Prix */}
    <div class="mt-4 flex flex-wrap items-baseline gap-2">
      {/* Prix promo : prix barré + prix promo + badge -X%. Le JS variante n'affiche pas la promo (prime sur la ligne variante). */}
      {salePriceText && <span id="product-price-original" class="text-base font-medium text-neutral-400 line-through">{baseOriginalText}</span>}
      <span id="product-price" class:list={['text-2xl font-bold', salePriceText ? 'text-accent' : 'text-neutral-900']}>
        {salePriceText ?? initialPriceText}
      </span>
      {salePriceText && salePercent > 0 && (
        <span id="product-price-discount" class="rounded-md bg-accent/10 px-2 py-0.5 text-xs font-semibold text-accent">-{salePercent} %</span>
      )}
      {isMultiPrice && <span id="product-price-from" class="text-xs text-neutral-500">à partir de</span>}
    </div>
    {saleEndsLabel && (
      <p id="product-sale-ends" class="mt-1 text-xs text-accent">Jusqu'au {saleEndsLabel}</p>
    )}
    <p id="product-stock" class="mt-1 text-xs" class:list={[initialInStock ? 'text-success' : 'text-error']}>
      {initialInStock ? 'En stock' : 'Indisponible'}
    </p>

    {/* Sélecteur de variantes */}
    {hasVariants && (
      <div class="mt-5 space-y-4" id="variant-selector" data-variants={JSON.stringify(variantData)}>
        {attrKeys.map((key) => (
          <div data-attr-group={key}>
            <p class="mb-1.5 text-xs font-medium uppercase tracking-wider text-neutral-500">{key}</p>
            <div class="flex flex-wrap gap-2">
              {attrOptions[key].map((value) => (
                <button
                  type="button"
                  data-attr-key={key}
                  data-attr-value={value}
                  class="rounded-lg border border-neutral-200 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:border-accent hover:text-accent data-[selected=true]:border-accent data-[selected=true]:bg-accent/10 data-[selected=true]:text-accent"
                >
                  {value}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    {/* CTA achat (désactivé — Stripe phase ultérieure) */}
    <button
      type="button"
      disabled
      class="mt-6 w-full cursor-not-allowed rounded-xl bg-neutral-200 py-3.5 text-sm font-semibold text-neutral-500"
      title="L'achat en ligne arrive prochainement"
    >
      Bientôt disponible
    </button>
    <p class="mt-2 text-center text-xs text-neutral-400">
      L'achat en ligne sera bientôt activé. Contactez le vendeur pour commander.
    </p>

    {/* Bloc digital : format / licence */}
    {product.type === 'digital' && (
      <div class="mt-6 space-y-2 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
        <h2 class="text-sm font-semibold text-neutral-900">Détails du fichier</h2>
        <ul class="space-y-1.5 text-sm text-neutral-600">
          {product.digital_file_format && (
            <li class="flex items-center gap-2">
              <span class="flex h-4 w-4 items-center justify-center text-neutral-400" set:html={FileText} />
              Format : {formatLabels[product.digital_file_format] ?? product.digital_file_format}
            </li>
          )}
          {product.digital_license && (
            <li class="flex items-center gap-2">
              <span class="flex h-4 w-4 items-center justify-center text-neutral-400" set:html={ShieldCheck} />
              {licenseLabels[product.digital_license] ?? product.digital_license}
            </li>
          )}
          {product.digital_language && (
            <li class="flex items-center gap-2">
              <span class="flex h-4 w-4 items-center justify-center text-neutral-400" set:html={Globe} />
              Langue : {product.digital_language.toUpperCase()}
            </li>
          )}
          {product.digital_pages_or_duration != null && (
            <li class="flex items-center gap-2">
              <span class="flex h-4 w-4 items-center justify-center text-neutral-400" set:html={Clock} />
              {product.digital_pages_or_duration} {product.digital_file_format === 'mp4' || product.digital_file_format === 'mp3' ? 'min' : 'pages'}
            </li>
          )}
        </ul>
      </div>
    )}

    {/* Bloc physical : modes de remise (retrait / livraison, cumulables) + état */}
    {product.type === 'physical' && (
      <div class="mt-6 space-y-3 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
        <h2 class="text-sm font-semibold text-neutral-900">Modes de remise</h2>
        <div class="space-y-3">
          {product.pickup_enabled && (
            <div class="flex items-start gap-2.5">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center text-accent" set:html={Store} />
              <div>
                <p class="text-sm font-medium text-neutral-900">Retrait sur place</p>
                {product.physical_pickup_location && (
                  <p class="text-sm text-neutral-600">Lieu de retrait : {product.physical_pickup_location}</p>
                )}
                {product.physical_pickup_instructions && (
                  <p class="text-sm text-neutral-500">{product.physical_pickup_instructions}</p>
                )}
              </div>
            </div>
          )}
          {product.delivery_enabled && (
            <div class="flex items-start gap-2.5">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center text-accent" set:html={Truck} />
              <div>
                <p class="text-sm font-medium text-neutral-900">Livraison possible</p>
                <p class="text-sm text-neutral-500">Modalités communiquées par le vendeur.</p>
              </div>
            </div>
          )}
          {!product.pickup_enabled && !product.delivery_enabled && (
            <p class="flex items-start gap-2.5 text-sm text-neutral-500">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={MapPin} />
              Modalités de remise communiquées par le vendeur.
            </p>
          )}
        </div>
        {product.physical_condition && (
          <p class="border-t border-neutral-200 pt-3 text-sm text-neutral-600">
            État : {conditionLabels[product.physical_condition] ?? product.physical_condition}
          </p>
        )}
      </div>
    )}

    {/* Description riche : content_blocks (V2) dans l'ordre, fallback description_long (V1) */}
    {hasContentBlocks ? (
      <div class="mt-6 border-t border-neutral-200 pt-6">
        <h2 class="mb-3 text-sm font-semibold text-neutral-900">Description</h2>
        <div class="space-y-4">
          {contentBlocks.map((block) =>
            block.type === 'text' ? (
              <p class="whitespace-pre-wrap text-sm leading-relaxed text-neutral-600">{block.content}</p>
            ) : (
              <figure>
                <img src={block.url} alt={block.alt ?? ''} class="w-full rounded-lg" loading="lazy" />
              </figure>
            )
          )}
        </div>
      </div>
    ) : (
      product.description_long && (
        <div class="mt-6 border-t border-neutral-200 pt-6">
          <h2 class="mb-3 text-sm font-semibold text-neutral-900">Description</h2>
          <p class="whitespace-pre-wrap text-sm leading-relaxed text-neutral-600">{product.description_long}</p>
        </div>
      )
    )}
  </div>
</div>

<script is:inline define:vars={{ productId: product.id, currency: product.currency, initialInStock }}>
(function() {
  // --- Galerie : miniatures (images + vidéo) ---
  var mainImg = document.getElementById('product-main-image')
  var mainVideo = document.getElementById('product-main-video')

  function showImageView(url) {
    if (mainImg) { mainImg.src = url; mainImg.classList.remove('hidden') }
    if (mainVideo) { mainVideo.pause(); mainVideo.classList.add('hidden') }
  }
  function showVideoView() {
    if (mainImg) mainImg.classList.add('hidden')
    if (mainVideo) mainVideo.classList.remove('hidden') // pas d'autoplay : l'utilisateur lance la lecture
  }

  document.querySelectorAll('[data-thumb]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.getAttribute('data-media-type') === 'video') {
        showVideoView()
      } else {
        showImageView(btn.getAttribute('data-thumb'))
      }
      document.querySelectorAll('[data-thumb]').forEach(function(b) {
        b.className = b.className.replace('border-accent', 'border-transparent')
      })
      btn.className = btn.className.replace('border-transparent', 'border-accent')
    })
  })

  function formatPrice(cents) {
    try {
      return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: currency }).format(cents / 100)
    } catch (e) {
      return (cents / 100).toFixed(2) + ' €'
    }
  }

  // --- Sélecteur de variantes ---
  var selector = document.getElementById('variant-selector')
  var selected = {}
  var variants = []
  if (selector) {
    try { variants = JSON.parse(selector.getAttribute('data-variants') || '[]') } catch (e) { variants = [] }

    function findVariant() {
      var keys = Object.keys(selected)
      return variants.find(function(v) {
        return keys.every(function(k) { return String(v.attributes[k]) === String(selected[k]) })
      })
    }

    function allKeys() {
      var set = {}
      variants.forEach(function(v) { Object.keys(v.attributes).forEach(function(k) { set[k] = true }) })
      return Object.keys(set)
    }

    function update() {
      var priceEl = document.getElementById('product-price')
      var stockEl = document.getElementById('product-stock')
      var fromEl = document.getElementById('product-price-from')
      var wishBtn = document.getElementById('wishlist-btn')

      var complete = allKeys().every(function(k) { return selected[k] != null })
      if (!complete) return

      var v = findVariant()
      if (!v) {
        if (stockEl) { stockEl.textContent = 'Combinaison indisponible'; stockEl.className = 'mt-1 text-xs text-error' }
        return
      }
      if (priceEl) {
        priceEl.textContent = formatPrice(v.priceCents)
        // Le prix variante prime : la promo (base) ne s'applique pas sur la ligne variante.
        priceEl.classList.remove('text-accent')
        priceEl.classList.add('text-neutral-900')
      }
      if (fromEl) fromEl.style.display = 'none'
      // Masque les éléments de promo (prix barré, badge -X%, date de fin) car ils
      // concernent le prix de BASE, pas le prix de la variante sélectionnée.
      ;['product-price-original', 'product-price-discount', 'product-sale-ends'].forEach(function(id) {
        var el = document.getElementById(id)
        if (el) el.style.display = 'none'
      })
      var inStock = v.stock > 0
      if (stockEl) {
        stockEl.textContent = inStock ? 'En stock' : 'Indisponible'
        stockEl.className = 'mt-1 text-xs ' + (inStock ? 'text-success' : 'text-error')
      }
      // photo de la variante : repasse en vue image si la vidéo était affichée
      if (v.image && mainImg) showImageView(v.image)
      // maj snapshot prix + variantId pour wishlist
      if (wishBtn) {
        wishBtn.setAttribute('data-price-cents', String(v.priceCents))
        wishBtn.setAttribute('data-variant-id', v.id)
      }
    }

    selector.querySelectorAll('[data-attr-key]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-attr-key')
        var value = btn.getAttribute('data-attr-value')
        selected[key] = value
        // visuel : dé-sélectionne les autres du même groupe
        selector.querySelectorAll('[data-attr-key="' + key + '"]').forEach(function(b) {
          b.setAttribute('data-selected', b === btn ? 'true' : 'false')
        })
        update()
      })
    })
  }

  // --- Wishlist (optimistic) ---
  var wishBtn = document.getElementById('wishlist-btn')
  if (wishBtn) {
    wishBtn.addEventListener('click', function() {
      if (wishBtn.getAttribute('data-authenticated') !== 'true') {
        window.location.href = wishBtn.getAttribute('data-login-url')
        return
      }
      var wasIn = wishBtn.getAttribute('data-in-wishlist') === 'true'
      var nextIn = !wasIn
      // optimistic
      setHeart(nextIn)
      wishBtn.disabled = true

      fetch('/api/wishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productId: wishBtn.getAttribute('data-product-id'),
          variantId: wishBtn.getAttribute('data-variant-id') || null,
          priceCents: parseInt(wishBtn.getAttribute('data-price-cents') || '0', 10),
        }),
      })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d } }) })
        .then(function(res) {
          if (!res.ok) { setHeart(wasIn); return }
          setHeart(!!res.data.in_wishlist)
        })
        .catch(function() { setHeart(wasIn) })
        .finally(function() { wishBtn.disabled = false })
    })

    function setHeart(on) {
      wishBtn.setAttribute('data-in-wishlist', on ? 'true' : 'false')
      wishBtn.setAttribute('aria-pressed', on ? 'true' : 'false')
      if (on) {
        wishBtn.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition border-accent bg-accent/10 text-accent'
      } else {
        wishBtn.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition border-neutral-200 text-neutral-400 hover:border-accent hover:text-accent'
      }
    }
  }
})()
</script>
