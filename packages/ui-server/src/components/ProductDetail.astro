---
import { ShoppingBag, FileText, Globe, Clock, ShieldCheck, PlayCircle, Info, Star, ChevronRight, ChevronLeft, Truck, Store, Handshake, Download } from 'lucide-static'
import EntityMoreDetails from './EntityMoreDetails.astro'
import NewsWidget from './NewsWidget.astro'

type Json = unknown

/** Bloc de contenu riche (content_blocks V2). Narrowing fait côté page. */
type ContentBlock =
  | { type: 'text'; content: string }
  | { type: 'image'; url: string; alt?: string }

interface Media {
  id: string
  url: string
  media_type?: string | null
  alt_text?: string | null
  display_order?: number
}

interface Variant {
  id: string
  attributes: Json
  stock_quantity: number
  price_cents_override: number | null
  primary_image_url: string | null
  is_active: boolean
}

interface Props {
  product: {
    id: string
    title: string
    description_short: string
    description_long: string | null
    price_cents: number
    sale_price_cents: number | null
    sale_ends_at: string | null
    currency: string
    type: 'digital' | 'physical'
    pickup_enabled: boolean
    delivery_enabled: boolean
    product_media?: Media[] | null
    product_variants?: Variant[] | null
    // digital
    digital_file_format: string | null
    digital_language: string | null
    digital_license: string | null
    digital_pages_or_duration: number | null
    // physical
    physical_condition: string | null
    physical_pickup_location: string | null
    physical_pickup_instructions: string | null
    physical_stock_quantity: number | null
    physical_stock_unlimited: boolean | null
  }
  /** Nom de catégorie résolu côté page (embed entity_product_categories ou legacy). */
  categoryName?: string | null
  /** Points principaux (bullet_points V2), narrowés côté page en string[]. */
  bulletPoints?: string[]
  /** Description riche (content_blocks V2), narrowée côté page. Vide → fallback description_long. */
  contentBlocks?: ContentBlock[]
  /** Promo active calculée côté SSR (sale_price_cents valide ET non expirée). */
  saleActive?: boolean
  /** Détails personnalisés (custom_details V2), narrowés côté page.
      family optionnelle : regroupe les détails dans "Tous les détails". */
  customDetails?: { label: string; value: string; family?: string | null }[]
  /** Agrégats d'avis (étoiles sous le titre, design Claude). */
  aggregates?: { count: number; average: number } | null
  /** Lien d'édition (dashboard) du produit pour le CTA "Modifier". */
  editHref?: string
  /** Slug du profil — lien widget Actualités. */
  entitySlug?: string
  /** Section news active dans le menu du profil → widget Actualités. */
  hasNews?: boolean
}

const {
  product,
  categoryName = null,
  bulletPoints = [],
  contentBlocks = [],
  saleActive = false,
  customDetails = [],
  aggregates = null,
  editHref = undefined,
  entitySlug = '',
  hasNews = false,
} = Astro.props

const starRow = (n: number) => Array.from({ length: 5 }, (_, i) => i < n)

const allMedia = (product.product_media ?? [])
  .slice()
  .sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0))
const images = allMedia.filter((m) => !m.media_type || m.media_type === 'image')
const video = allMedia.find((m) => m.media_type === 'video') ?? null
// Galerie : médias visibles = images + éventuelle vidéo (carrousel 9:16).
const galleryMedia = [...images, ...(video ? [video] : [])]

const variants = (product.product_variants ?? []).filter((v) => v.is_active)
const hasVariants = variants.length > 0

function formatPrice(cents: number, currency: string): string {
  try {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100)
  } catch {
    return `${(cents / 100).toFixed(2)} €`
  }
}

// Prix mini sur variantes pour "à partir de"
const variantPrices = variants.map((v) => v.price_cents_override ?? product.price_cents)
const minCents = variantPrices.length > 0 ? Math.min(...variantPrices) : product.price_cents
const maxCents = variantPrices.length > 0 ? Math.max(...variantPrices) : product.price_cents
const isMultiPrice = hasVariants && minCents !== maxCents
const initialPriceText = formatPrice(minCents, product.currency)

// Promo : s'applique au PRIX DE BASE uniquement. Si une variante est sélectionnée
// (override), son prix prime et la promo n'est PAS appliquée sur la ligne variante
// (le JS du sélecteur écrase #product-price avec le prix variante brut).
const showSalePrice = saleActive && product.sale_price_cents != null
const salePriceText = showSalePrice ? formatPrice(product.sale_price_cents as number, product.currency) : null
const baseOriginalText = formatPrice(product.price_cents, product.currency)
const salePercent =
  showSalePrice && product.price_cents > 0
    ? Math.round((1 - (product.sale_price_cents as number) / product.price_cents) * 100)
    : 0
// Date de fin de promo formatée (fr-FR) si présente
let saleEndsLabel: string | null = null
if (showSalePrice && product.sale_ends_at) {
  try {
    saleEndsLabel = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(product.sale_ends_at)
    )
  } catch {
    saleEndsLabel = null
  }
}

// Disponibilité initiale (sans variante sélectionnée)
let initialInStock: boolean
if (hasVariants) {
  initialInStock = variants.some((v) => v.stock_quantity > 0)
} else if (product.type === 'digital') {
  initialInStock = true
} else {
  initialInStock = !!product.physical_stock_unlimited || (product.physical_stock_quantity ?? 0) > 0
}

// Modes de remise/livraison disponibles, affichés dans les caractéristiques.
// Physique : Main propre (par défaut), Click & collect (pickup_enabled), Livraison
// (delivery_enabled). NB : « Main propre » n'a pas encore de champ dédié en base.
// Numérique : téléchargement immédiat (pas de remise physique).
const deliveryTags: { label: string; icon: string }[] =
  product.type === 'physical'
    ? ([
        { label: 'Main propre', icon: Handshake },
        product.pickup_enabled ? { label: 'Click & collect', icon: Store } : null,
        product.delivery_enabled ? { label: 'Livraison', icon: Truck } : null,
      ].filter(Boolean) as { label: string; icon: string }[])
    : [{ label: 'Téléchargement', icon: Download }]

// Attributs : on dérive l'ensemble des clés et valeurs depuis variants[].attributes
type AttrMap = Record<string, string>
const variantAttrs: AttrMap[] = variants.map((v) => {
  const a = (v.attributes ?? {}) as Record<string, unknown>
  const out: AttrMap = {}
  for (const k of Object.keys(a)) out[k] = String(a[k])
  return out
})
const attrKeys = Array.from(new Set(variantAttrs.flatMap((a) => Object.keys(a))))
const attrOptions: Record<string, string[]> = {}
for (const key of attrKeys) {
  attrOptions[key] = Array.from(
    new Set(variantAttrs.map((a) => a[key]).filter((v): v is string => !!v))
  )
}

// Données JSON pour le sélecteur vanilla JS
const variantData = variants.map((v, i) => ({
  id: v.id,
  attributes: variantAttrs[i],
  priceCents: v.price_cents_override ?? product.price_cents,
  stock: v.stock_quantity,
  image: v.primary_image_url,
}))

const licenseLabels: Record<string, string> = {
  personal: 'Licence personnelle',
  professional: 'Licence professionnelle',
  commercial: 'Licence commerciale',
}
const formatLabels: Record<string, string> = {
  pdf: 'PDF', epub: 'EPUB', mp4: 'MP4', mp3: 'MP3', zip: 'ZIP', other: 'Fichier',
}

// Lignes du bloc "Détails du fichier" (digital) : champs legacy + détails
// personnalisés (libres puis familles). Au-delà de 3 lignes : 3 affichées +
// "Voir plus" (ancre vers la section "Tous les détails" sous la Description).
type DetailLine = { icon: string; text: string }
type DetailRow = { label: string; value: string }
const ungroupedLines: DetailLine[] = []
if (product.type === 'digital') {
  if (product.digital_file_format) {
    ungroupedLines.push({ icon: FileText, text: `Format : ${formatLabels[product.digital_file_format] ?? product.digital_file_format}` })
  }
  if (product.digital_license) {
    // Legacy : licence des anciens produits (plus jamais écrite, custom_details la remplace)
    ungroupedLines.push({ icon: ShieldCheck, text: licenseLabels[product.digital_license] ?? product.digital_license })
  }
  if (product.digital_language) {
    ungroupedLines.push({ icon: Globe, text: `Langue : ${product.digital_language.toUpperCase()}` })
  }
  if (product.digital_pages_or_duration != null) {
    ungroupedLines.push({
      icon: Clock,
      text: `${product.digital_pages_or_duration} ${product.digital_file_format === 'mp4' || product.digital_file_format === 'mp3' ? 'min' : 'pages'}`,
    })
  }
  for (const d of customDetails) {
    if (!d.family) ungroupedLines.push({ icon: Info, text: `${d.label} : ${d.value}` })
  }
}

// Familles : groupées dans l'ordre de première apparition
const familyGroups: { name: string; lines: DetailLine[] }[] = []
if (product.type === 'digital') {
  for (const d of customDetails) {
    if (!d.family) continue
    let group = familyGroups.find((g) => g.name === d.family)
    if (!group) {
      group = { name: d.family, lines: [] }
      familyGroups.push(group)
    }
    group.lines.push({ icon: Info, text: `${d.label} : ${d.value}` })
  }
}

// Vue aplatie pour le bloc compact (3 lignes max) et le compteur
const detailLines: DetailLine[] = [...ungroupedLines, ...familyGroups.flatMap((g) => g.lines)]

function splitDetailText(text: string): DetailRow {
  const idx = text.indexOf(' : ')
  if (idx === -1) return { label: 'Information', value: text }
  return { label: text.slice(0, idx), value: text.slice(idx + 3) }
}

const detailRows: DetailRow[] = [
  ...ungroupedLines.map((line) => splitDetailText(line.text)),
  ...familyGroups.flatMap((group) =>
    group.lines.map((line) => {
      const row = splitDetailText(line.text)
      return {
        label: row.label === 'Information' ? group.name : row.label,
        value: row.value,
      }
    })
  ),
]

const formatLabel = product.digital_file_format
  ? formatLabels[product.digital_file_format] ?? product.digital_file_format.toUpperCase()
  : null
const stockLabel = initialInStock ? 'En stock' : 'Indisponible'
const reviewCount = aggregates?.count ?? 0
const reviewAverage = aggregates?.average ?? 0
---
<div class="product-detail">
{/* ===== Caractéristiques : Avis · Prix · Type · Dispo. + tags livraison, scroll horizontal ===== */}
<div class="product-detail__stats">
  <a href="#avis" class="product-detail__stat product-detail__stat--link">
    <span class="product-detail__stat-label">{reviewCount > 0 ? `${reviewCount} avis` : 'Avis'}</span>
    <span class="product-detail__stat-value">{reviewCount > 0 ? reviewAverage.toFixed(1).replace('.', ',') : '—'}</span>
    <span class="product-detail__stat-stars">
      {starRow(Math.round(reviewAverage)).map((on) => (
        <span class:list={['flex items-center justify-center', on ? 'text-neutral-900' : 'text-neutral-300']} set:html={Star} />
      ))}
    </span>
  </a>
  <div class="product-detail__stat">
    <span class="product-detail__stat-label">Prix</span>
    <span data-sync-price class:list={['product-detail__stat-value product-detail__stat-value--sm product-detail__stat-price', salePriceText && 'is-sale']}>{salePriceText ?? initialPriceText}</span>
  </div>
  <div class="product-detail__stat">
    <span class="product-detail__stat-label">Type</span>
    <span class="product-detail__stat-value product-detail__stat-value--sm">{product.type === 'digital' ? 'Numérique' : 'Physique'}</span>
  </div>
  <div class="product-detail__stat">
    <span class="product-detail__stat-label">Dispo.</span>
    <span id="product-stock" class:list={['product-detail__stat-value product-detail__stat-value--sm product-detail__stock', initialInStock ? 'is-available' : 'is-unavailable']}>{stockLabel}</span>
  </div>
  {deliveryTags.map((t) => (
    <div class="product-detail__stat">
      <span class="product-detail__stat-label">{t.label}</span>
      <span class="product-detail__stat-value product-detail__stat-icon" set:html={t.icon} />
    </div>
  ))}
</div>

{/* ===== Galerie média : carrousel 9:16 (item qui dépasse → scroll horizontal) ===== */}
<div class="product-detail__media" data-carousel>
  <div class="product-detail__carousel gallery-strip" data-carousel-track>
    {galleryMedia.length > 0 ? (
      galleryMedia.map((m) => {
        const isVideo = m.media_type === 'video'
        return (
          <div class="product-detail__slide">
            {isVideo ? (
              <video src={m.url} controls preload="metadata" playsinline class="h-full w-full bg-black object-cover"></video>
            ) : (
              <img src={m.url} alt={m.alt_text ?? product.title} class="h-full w-full object-cover" loading="lazy" />
            )}
          </div>
        )
      })
    ) : (
      <div class="product-detail__slide">
        <div class="ph" aria-hidden="true">
          <span class="flex h-14 w-14 items-center justify-center" set:html={ShoppingBag} />
        </div>
      </div>
    )}
  </div>
  {galleryMedia.length > 1 && (
    <>
      <button type="button" class="product-detail__nav product-detail__nav--prev" data-carousel-prev aria-label="Image précédente">
        <span class="flex items-center justify-center" set:html={ChevronLeft} />
      </button>
      <button type="button" class="product-detail__nav product-detail__nav--next" data-carousel-next aria-label="Image suivante">
        <span class="flex items-center justify-center" set:html={ChevronRight} />
      </button>
    </>
  )}
</div>

{/* ===== Card Information (sans prix : le prix vit dans la caractéristique PRIX) ===== */}
<div class="product-detail__buybox-card">
  {editHref && (
    <div class="product-detail__buybox-top">
      <a href={editHref} class="product-detail__cta">Modifier</a>
    </div>
  )}
  {detailLines.length > 0 && (
    <div id="tous-les-details" class="product-detail__buybox-info scroll-mt-20">
      <h3 class="product-detail__info-title">Information</h3>
      <div class="product-detail__info-menus">
        <details class="product-detail__tech-menu">
          <summary>
            <span>Information générale</span>
            <span class="product-detail__tech-chevron" aria-hidden="true" set:html={ChevronRight} />
          </summary>
          <div class="product-detail__tech-panel">
            {detailRows.map((row) => (
              <div class="product-detail__tech-line">
                <span>{row.label}</span>
                <strong>{row.value}</strong>
              </div>
            ))}
          </div>
        </details>
      </div>
    </div>
  )}
</div>

{/* ===== Sélecteur de variantes (pleine largeur) ===== */}
{hasVariants && (
  <div class="product-detail__variants" id="variant-selector" data-variants={JSON.stringify(variantData)}>
    {attrKeys.map((key) => (
      <div data-attr-group={key}>
        <p class="product-detail__variant-label">{key}</p>
        <div class="flex flex-wrap gap-2">
          {attrOptions[key].map((value) => (
            <button
              type="button"
              data-attr-key={key}
              data-attr-value={value}
              class="product-detail__variant-btn"
            >
              {value}
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
)}

{/* ===== Plus de détails (contenu produit) + Actualités profil ===== */}
<EntityMoreDetails
  entityKind="product"
  contentBlocks={contentBlocks}
  bulletPoints={bulletPoints}
  fallbackText={product.description_long}
/>
{hasNews && entitySlug && <NewsWidget entitySlug={entitySlug} />}

</div>

<style>
  .product-detail {
    background: transparent;
  }

  .product-detail__media {
    position: relative;
    padding: 16px 0;
  }

  /* ===== Carrousel d'images 9:16 (item qui dépasse → scroll horizontal) ===== */
  .product-detail__carousel {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 22px;
    padding: 0 22px;
  }
  @media (min-width: 768px) {
    .product-detail__carousel {
      cursor: grab;
    }
    .product-detail__carousel.is-grabbing {
      cursor: grabbing;
      scroll-behavior: auto;
      user-select: none;
    }
    .product-detail__carousel.is-grabbing img {
      pointer-events: none;
    }
  }
  .product-detail__slide {
    flex: 0 0 58%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-panel);
    scroll-snap-align: start;
  }

  /* ===== Flèches de navigation (tablette + desktop uniquement) ===== */
  .product-detail__nav {
    display: none;
  }
  @media (min-width: 768px) {
    .product-detail__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(8px);
      color: var(--color-neutral-800);
      box-shadow: 0 6px 18px -10px rgba(0, 0, 0, .35);
      cursor: pointer;
      transition: background .16s ease, transform .08s ease, opacity .16s ease;
    }
    .product-detail__nav :global(svg) {
      width: 20px;
      height: 20px;
    }
    .product-detail__nav:hover {
      background: var(--color-surface);
    }
    .product-detail__nav:active {
      transform: translateY(-50%) scale(.94);
    }
    .product-detail__nav--prev {
      left: 30px;
    }
    .product-detail__nav--next {
      right: 30px;
    }
    .product-detail__nav[disabled] {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ===== Card d'achat : prix + Modifier (sous les images) ===== */
  .product-detail__buybox-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0 22px;
  }
  /* Téléphone : bouton Modifier sous l'image. Desktop/tablette : Modifier dans le strip. */
  .product-detail__buybox-top {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
  }
  .product-detail__buybox-info {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    padding-top: 16px;
  }
  @media (min-width: 768px) {
    .product-detail__buybox-top {
      display: none;
    }
    .product-detail__buybox-info {
      border-top: 0;
      padding-top: 0;
    }
  }
  /* Conteneur des menus déployables : 1 menu = pleine largeur ;
     un 2e menu se place à droite (2 colonnes 50/50) dès la tablette. */
  .product-detail__info-menus {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    align-items: start;
  }
  @media (min-width: 768px) {
    .product-detail__info-menus {
      grid-template-columns: 1fr 1fr;
    }
    .product-detail__info-menus > .product-detail__tech-menu:only-child {
      grid-column: 1 / -1;
    }
  }
  .product-detail__buy-price {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .product-detail__from {
    font-size: 11px;
    color: var(--color-neutral-500);
  }
  .product-detail__buy-now {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-neutral-900);
  }
  .product-detail__buy-now.is-sale {
    color: var(--color-accent);
  }
  .product-detail__buy-was {
    font-size: 14px;
    color: var(--color-neutral-400);
    text-decoration: line-through;
  }
  .product-detail__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    min-height: 40px;
    padding: 0 22px;
    border-radius: 12px;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background .18s, transform .08s;
  }
  .product-detail__cta:hover { background: var(--color-accent-hover); }
  .product-detail__cta:active { transform: translateY(1px); }

  /* ===== Bandeau de caractéristiques : scroll horizontal, aligné à gauche ===== */
  .product-detail__stats {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 24px 0 22px;
    padding: 6px 22px;
  }
  .product-detail__stats::-webkit-scrollbar {
    display: none;
  }
  .product-detail__stat {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
    padding: 4px 16px;
    text-decoration: none;
    border-left: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .product-detail__stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  /* Icône d'un mode de livraison (caractéristique : titre = mode, principal = icône) */
  .product-detail__stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-neutral-700);
  }
  .product-detail__stat-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .product-detail__stat-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--color-neutral-400);
    text-align: center;
  }
  .product-detail__stat-value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-neutral-500);
    text-align: center;
  }
  .product-detail__stat-value--sm {
    font-size: 15px;
    font-weight: 700;
  }
  .product-detail__stat-stars {
    display: inline-flex;
    gap: 1px;
  }
  .product-detail__stat-stars :global(svg) {
    width: 11px;
    height: 11px;
  }
  .product-detail__stat-sub {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-neutral-400);
    text-align: center;
  }
  /* Colonne PRIX : valeur principale sombre, secondaire = prix avant promo barré */
  .product-detail__stat-price {
    color: var(--color-neutral-900);
  }
  .product-detail__stat-price.is-sale {
    color: var(--color-accent);
  }
  .product-detail__stat-sub--strike {
    text-decoration: line-through;
  }

  .product-detail__delivery-tag :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--color-neutral-500);
  }

  /* #product-stock vit dans le bandeau de stats : couleur seule, taille via stat-value--sm */
  .product-detail__stock.is-available {
    color: var(--color-success);
  }

  .product-detail__stock.is-unavailable {
    color: var(--color-error);
  }

  .product-detail__variants {
    margin: 18px 22px 0;
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-surface) 82%, var(--color-panel));
  }

  .product-detail__variants > * + * {
    margin-top: 14px;
  }

  .product-detail__variant-label,
  .product-detail__small-title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }

  .product-detail__variant-btn {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-neutral-700);
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }

  .product-detail__variant-btn:hover,
  .product-detail__variant-btn[data-selected='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .product-detail__sections {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 22px 4px;
  }

  .product-detail__card {
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    box-shadow: none;
  }

  .product-detail__detail-card {
    position: relative;
  }

  .product-detail__tech-menu {
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-panel) 72%, var(--color-surface));
    overflow: hidden;
  }

  .product-detail__info-title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }

  .product-detail__tech-menu summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    cursor: pointer;
    list-style: none;
    padding: 14px;
  }

  .product-detail__tech-menu summary::-webkit-details-marker {
    display: none;
  }

  .product-detail__tech-menu summary > span:first-child {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    color: #2a2a2a;
    text-transform: uppercase;
  }

  .product-detail__tech-chevron {
    display: flex;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: #2a2a2a;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    transition: transform 140ms ease;
  }

  .product-detail__tech-menu[open] .product-detail__tech-chevron {
    transform: rotate(90deg);
  }

  .product-detail__tech-panel {
    padding: 0 14px 14px;
  }

  .product-detail__tech-line {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(92px, .8fr);
    gap: 14px;
    padding: 10px 0;
  }

  .product-detail__tech-line + .product-detail__tech-line {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 55%, transparent);
  }

  .product-detail__tech-line strong {
    min-width: 0;
    font-size: 13px;
    font-weight: 600;
    color: #2a2a2a;
    text-align: right;
  }

  .product-detail__tech-line span {
    font-size: 11px;
    font-weight: 600;
    color: #2a2a2a;
    text-align: left;
    text-transform: uppercase;
  }

  @media (max-width: 520px) {
    .product-detail__tech-menu summary {
      padding: 12px;
    }
    .product-detail__tech-panel {
      padding: 0 12px 12px;
    }
    .product-detail__tech-line {
      grid-template-columns: 1fr;
      gap: 3px;
    }
    .product-detail__tech-line span {
      text-align: left;
    }
    .product-detail__tech-line strong {
      text-align: left;
    }
  }

  .gallery-strip {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }
  .gallery-strip::-webkit-scrollbar { display: none; }
</style>

<script is:inline define:vars={{ productId: product.id, currency: product.currency, initialInStock }}>
(function() {
  // --- Galerie : miniatures (images + vidéo) ---
  var mainImg = document.getElementById('product-main-image')
  var mainVideo = document.getElementById('product-main-video')

  function showImageView(url) {
    if (mainImg) { mainImg.src = url; mainImg.classList.remove('hidden') }
    if (mainVideo) { mainVideo.pause(); mainVideo.classList.add('hidden') }
  }
  function showVideoView() {
    if (mainImg) mainImg.classList.add('hidden')
    if (mainVideo) mainVideo.classList.remove('hidden') // pas d'autoplay : l'utilisateur lance la lecture
  }

  document.querySelectorAll('[data-thumb]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.getAttribute('data-media-type') === 'video') {
        showVideoView()
      } else {
        showImageView(btn.getAttribute('data-thumb'))
      }
      document.querySelectorAll('[data-thumb]').forEach(function(b) {
        b.classList.remove('is-active')
      })
      btn.classList.add('is-active')
    })
  })

  // --- Carrousel images : flèches de navigation (tablette + desktop) ---
  var track = document.querySelector('[data-carousel-track]')
  if (track) {
    var prevBtn = document.querySelector('[data-carousel-prev]')
    var nextBtn = document.querySelector('[data-carousel-next]')
    var slideStep = function() {
      var slide = track.querySelector('.product-detail__slide')
      var w = slide ? slide.getBoundingClientRect().width : track.clientWidth * 0.6
      return w + 12 // largeur d'une slide + gap
    }
    var updateNav = function() {
      var max = track.scrollWidth - track.clientWidth
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 1
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= max - 1
    }
    if (prevBtn) prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -slideStep(), behavior: 'smooth' })
    })
    if (nextBtn) nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: slideStep(), behavior: 'smooth' })
    })
    track.addEventListener('scroll', updateNav)
    window.addEventListener('resize', updateNav)
    updateNav()

    // --- Glisser-déposer à la main (souris/stylet) ; le tactile garde le scroll natif ---
    var isDown = false, startX = 0, startScroll = 0
    track.addEventListener('pointerdown', function(e) {
      if (e.pointerType === 'touch') return
      isDown = true
      startX = e.clientX
      startScroll = track.scrollLeft
      track.style.scrollSnapType = 'none' // évite les à-coups pendant le glissement
      track.classList.add('is-grabbing')
    })
    window.addEventListener('pointermove', function(e) {
      if (!isDown) return
      track.scrollLeft = startScroll - (e.clientX - startX)
    })
    var endDrag = function() {
      if (!isDown) return
      isDown = false
      track.style.scrollSnapType = ''
      track.classList.remove('is-grabbing')
    }
    window.addEventListener('pointerup', endDrag)
    window.addEventListener('pointercancel', endDrag)
    track.addEventListener('dragstart', function(e) { e.preventDefault() })
  }

  function formatPrice(cents) {
    try {
      return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: currency }).format(cents / 100)
    } catch (e) {
      return (cents / 100).toFixed(2) + ' €'
    }
  }

  // --- Sélecteur de variantes ---
  var selector = document.getElementById('variant-selector')
  var selected = {}
  var variants = []
  if (selector) {
    try { variants = JSON.parse(selector.getAttribute('data-variants') || '[]') } catch (e) { variants = [] }

    function findVariant() {
      var keys = Object.keys(selected)
      return variants.find(function(v) {
        return keys.every(function(k) { return String(v.attributes[k]) === String(selected[k]) })
      })
    }

    function allKeys() {
      var set = {}
      variants.forEach(function(v) { Object.keys(v.attributes).forEach(function(k) { set[k] = true }) })
      return Object.keys(set)
    }

    function update() {
      var priceEl = document.getElementById('product-price')
      var stockEl = document.getElementById('product-stock')
      var fromEl = document.getElementById('product-price-from')

      var complete = allKeys().every(function(k) { return selected[k] != null })
      if (!complete) return

      var v = findVariant()
      if (!v) {
        if (stockEl) {
          stockEl.textContent = 'Indisponible'
          stockEl.classList.remove('is-available')
          stockEl.classList.add('is-unavailable')
        }
        return
      }
      if (priceEl) {
        priceEl.textContent = formatPrice(v.priceCents)
        // Le prix variante prime : la promo (base) ne s'applique pas sur la ligne variante.
        priceEl.classList.remove('is-sale')
      }
      // Synchronise les prix dupliqués (strip desktop + colonne PRIX du bandeau).
      // Le prix variante prime → on retire l'état promo et le prix barré du bandeau.
      document.querySelectorAll('[data-sync-price]').forEach(function(el) {
        el.textContent = formatPrice(v.priceCents)
        el.classList.remove('is-sale')
      })
      if (fromEl) fromEl.style.display = 'none'
      // Masque les éléments de promo (prix barré, badge -X%, date de fin) car ils
      // concernent le prix de BASE, pas le prix de la variante sélectionnée.
      ;['product-price-original', 'product-price-discount', 'product-sale-ends', 'product-price-promo-label'].forEach(function(id) {
        var el = document.getElementById(id)
        if (el) el.style.display = 'none'
      })
      var inStock = v.stock > 0
      if (stockEl) {
        stockEl.textContent = inStock ? 'En stock' : 'Indisponible'
        stockEl.classList.toggle('is-available', inStock)
        stockEl.classList.toggle('is-unavailable', !inStock)
      }
      // photo de la variante : repasse en vue image si la vidéo était affichée
      if (v.image && mainImg) showImageView(v.image)
    }

    selector.querySelectorAll('[data-attr-key]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-attr-key')
        var value = btn.getAttribute('data-attr-value')
        selected[key] = value
        // visuel : dé-sélectionne les autres du même groupe
        selector.querySelectorAll('[data-attr-key]').forEach(function(b) {
          if (b.getAttribute('data-attr-key') !== key) return
          b.setAttribute('data-selected', b === btn ? 'true' : 'false')
        })
        update()
      })
    })
  }

})()
</script>
