---
import { Star, ArrowDownUp, X } from 'lucide-static'

interface ReviewPhoto {
  id: string
  url: string
  display_order?: number
}

interface Review {
  id: string
  buyer_user_id: string
  rating: number
  title: string | null
  content: string
  created_at: string
  is_verified_purchase: boolean
  helpful_count: number
  seller_reply: string | null
  seller_replied_at: string | null
  product_review_photos?: ReviewPhoto[] | null
}

interface Props {
  reviews: Review[]
  aggregates: { count: number; average: number }
  /** Distribution 1..5 → nombre (pré-calculé serveur). */
  distribution: Record<number, number>
  /** Étoiles sélectionnées (multi-sélection, query param "rating=4,5"). */
  activeRatings?: number[]
  activeSort?: 'recent' | 'oldest'
  /** Base path de la page (ex: /slug/shop/produit) pour les liens query. */
  basePath: string
}

const {
  reviews,
  aggregates,
  distribution,
  activeRatings = [],
  activeSort = 'recent',
  basePath,
} = Astro.props

function starRow(n: number) {
  return Array.from({ length: 5 }, (_, i) => i < n)
}

/** Liens rendus serveur : toggle d'une étoile (multi-sélection), reset, switch de tri. */
function buildQuery(opts: { toggleRating?: number; clearRatings?: boolean; sort?: 'recent' | 'oldest' } = {}) {
  let ratings = [...activeRatings]
  if (opts.toggleRating != null) {
    ratings = ratings.includes(opts.toggleRating)
      ? ratings.filter((r) => r !== opts.toggleRating)
      : [...ratings, opts.toggleRating]
  }
  if (opts.clearRatings) ratings = []
  const sort = opts.sort ?? activeSort
  const params = new URLSearchParams()
  if (ratings.length > 0) params.set('rating', ratings.sort((a, b) => b - a).join(','))
  if (sort !== 'recent') params.set('sort', sort)
  const qs = params.toString()
  return qs ? `${basePath}?${qs}#avis` : `${basePath}#avis`
}

const maxDist = Math.max(1, ...Object.values(distribution))
const fmtDate = (d: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d))
---
<section id="avis" class="sec">
  <div class="reviews-heading">
    <span>Les avis clients</span>
    <h2>Avis clients</h2>
  </div>

  {/* 2 colonnes dès que le container est large (>= ~720px de contenu, soit la
      carte 800px en desktop) : statistiques à gauche, liste d'avis à droite.
      Empilé en dessous. Container query → indépendant de la largeur d'écran. */}
  <div class="reviews-cq mt-5">
    <div class="reviews-grid">

      {/* ===== COLONNE STATS : note + distribution + filtres ===== */}
      <div class="reviews-stats">
        <div class="reviews-score">
          <p class="reviews-score__number">
            {aggregates.average.toFixed(1).replace('.', ',')}<span class="reviews-score__max">sur 5</span>
          </p>
          <div class="reviews-score__stars">
            {starRow(Math.round(aggregates.average)).map((on) => (
              <span class:list={['flex h-5 w-5 items-center justify-center', on ? 'text-amber-500' : 'text-neutral-200']} set:html={Star} />
            ))}
          </div>
          <p class="reviews-score__count">{aggregates.count} avis</p>
        </div>

        <div class="reviews-distribution">
          {[5, 4, 3, 2, 1].map((n) => {
            const selected = activeRatings.includes(n)
            return (
              <a
                href={buildQuery({ toggleRating: n })}
                aria-current={selected ? 'true' : undefined}
                class:list={['reviews-bar', selected && 'is-selected']}
              >
                <span class:list={['reviews-bar__stars', selected ? 'text-accent' : 'text-amber-500']}>
                  {Array.from({ length: n }, () => (
                    <span class="flex h-3 w-3 items-center justify-center" set:html={Star} />
                  ))}
                </span>
                <span class="reviews-bar__track">
                  <span class="reviews-bar__fill" style={`width:${((distribution[n] ?? 0) / maxDist) * 100}%`}></span>
                </span>
                <span class="reviews-bar__count">{distribution[n] ?? 0}</span>
              </a>
            )
          })}
        </div>

        {/* Filtres / tri (liens serveur) */}
        <div class="mt-5 flex flex-wrap items-center gap-2">
          {activeRatings.length > 0 && (
            <a href={buildQuery({ clearRatings: true })} class="inline-flex items-center gap-1 rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
              {activeRatings.join(' · ')} étoile{activeRatings.length > 1 || activeRatings[0]! > 1 ? 's' : ''}
              <span class="flex h-3 w-3 items-center justify-center" set:html={X} />
            </a>
          )}
          <a
            href={buildQuery({ sort: activeSort === 'recent' ? 'oldest' : 'recent' })}
            class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600 transition hover:bg-neutral-200"
          >
            <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={ArrowDownUp} />
            {activeSort === 'recent' ? "Plus récents d'abord" : "Plus anciens d'abord"}
          </a>
        </div>
      </div>

      {/* ===== COLONNE LISTE : avis ===== */}
      <div class="reviews-list">
    {reviews.length === 0 ? (
      <p class="py-6 text-center text-sm text-neutral-400">Aucun avis pour le moment.</p>
    ) : (
      reviews.map((review) => (
        <article class="review-item">
          <div class="review-item__top">
            <div class="review-item__stars">
              {starRow(review.rating).map((on) => (
                <span class:list={['flex h-3.5 w-3.5 items-center justify-center', on ? 'text-amber-500' : 'text-neutral-200']} set:html={Star} />
              ))}
            </div>
            <span class="review-item__score">{review.rating}/5</span>
            {review.is_verified_purchase && (
              <span class="rounded-full bg-success/10 px-2 py-0.5 text-[11px] font-medium text-success">Achat vérifié</span>
            )}
            <time class="ml-auto text-xs text-neutral-400" datetime={review.created_at}>{fmtDate(review.created_at)}</time>
          </div>
          {review.title && <h3 class="mt-2 text-sm font-semibold text-neutral-900">{review.title}</h3>}
          <p class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-neutral-600">{review.content}</p>
          {review.product_review_photos && review.product_review_photos.length > 0 && (
            <div class="mt-3 flex gap-2">
              {review.product_review_photos
                .sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0))
                .map((photo) => (
                  <img src={photo.url} alt="Photo d'avis" class="h-16 w-16 rounded-lg object-cover" loading="lazy" />
                ))}
            </div>
          )}
          {review.seller_reply && (
            <div class="review-item__reply">
              <p class="text-xs font-semibold text-neutral-900">Réponse du vendeur</p>
              <p class="mt-1 whitespace-pre-wrap text-sm text-neutral-600">{review.seller_reply}</p>
            </div>
          )}
        </article>
      ))
    )}
      </div>

    </div>
  </div>
</section>

<style>
  .reviews-heading {
    margin-bottom: 18px;
  }
  .reviews-heading span {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .reviews-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-neutral-900);
  }
  /* Container query : 2 colonnes (stats | avis) dès que le conteneur atteint
     ~600px de large — vrai dans la carte 800px en desktop (même avec le padding
     de la carte de section), mais pas sur mobile où tout reste empilé.
     Indépendant de la largeur de viewport. */
  .reviews-cq {
    container-type: inline-size;
  }
  .reviews-grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .reviews-stats {
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-panel) 72%, var(--color-surface));
    padding: 18px;
  }
  .reviews-score {
    text-align: center;
  }
  .reviews-score__count {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
  .reviews-score__number {
    margin: 0;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 900;
    color: var(--color-neutral-900);
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .reviews-score__max {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-neutral-500);
  }
  .reviews-score__stars {
    margin-top: 10px;
    display: flex;
    justify-content: center;
    gap: 2px;
  }
  .reviews-distribution {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .reviews-bar {
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 10px;
    padding: 4px 5px;
    text-decoration: none;
    transition: background 140ms ease;
  }
  .reviews-bar:hover,
  .reviews-bar.is-selected {
    background: var(--color-accent-soft);
  }
  .reviews-bar__stars {
    display: flex;
    width: 76px;
    flex-shrink: 0;
    justify-content: flex-end;
    gap: 1px;
  }
  .reviews-bar__track {
    height: 8px;
    flex: 1;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-surface);
  }
  .reviews-bar__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-accent), #f59e0b);
  }
  .reviews-bar__count {
    width: 22px;
    flex-shrink: 0;
    text-align: right;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-neutral-600);
  }
  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .review-item {
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-panel) 72%, var(--color-surface));
    padding: 16px;
  }
  .review-item__top {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .review-item__stars {
    display: flex;
    gap: 1px;
  }
  .review-item__score {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 900;
    color: var(--color-accent);
  }
  .review-item__reply {
    margin-top: 12px;
    border-radius: 12px;
    background: var(--color-surface);
    padding: 12px;
  }
  @container (min-width: 600px) {
    .reviews-grid {
      display: grid;
      grid-template-columns: 248px 1fr;
      gap: 40px;
      align-items: start;
    }
    .reviews-stats {
      position: sticky;
      top: 84px;
    }
  }
</style>
