---
import { Star, ArrowDownUp, X } from 'lucide-static'

interface ReviewPhoto {
  id: string
  url: string
  display_order?: number
}

interface Review {
  id: string
  buyer_user_id: string
  rating: number
  title: string | null
  content: string
  created_at: string
  is_verified_purchase: boolean
  helpful_count: number
  seller_reply: string | null
  seller_replied_at: string | null
  product_review_photos?: ReviewPhoto[] | null
}

interface Props {
  reviews: Review[]
  aggregates: { count: number; average: number }
  /** Distribution 1..5 → nombre (pré-calculé serveur). */
  distribution: Record<number, number>
  /** Étoiles sélectionnées (multi-sélection, query param "rating=4,5"). */
  activeRatings?: number[]
  activeSort?: 'recent' | 'oldest'
  /** Base path de la page (ex: /slug/shop/produit) pour les liens query. */
  basePath: string
}

const {
  reviews,
  aggregates,
  distribution,
  activeRatings = [],
  activeSort = 'recent',
  basePath,
} = Astro.props

function starRow(n: number) {
  return Array.from({ length: 5 }, (_, i) => i < n)
}

/** Liens rendus serveur : toggle d'une étoile (multi-sélection), reset, switch de tri. */
function buildQuery(opts: { toggleRating?: number; clearRatings?: boolean; sort?: 'recent' | 'oldest' } = {}) {
  let ratings = [...activeRatings]
  if (opts.toggleRating != null) {
    ratings = ratings.includes(opts.toggleRating)
      ? ratings.filter((r) => r !== opts.toggleRating)
      : [...ratings, opts.toggleRating]
  }
  if (opts.clearRatings) ratings = []
  const sort = opts.sort ?? activeSort
  const params = new URLSearchParams()
  if (ratings.length > 0) params.set('rating', ratings.sort((a, b) => b - a).join(','))
  if (sort !== 'recent') params.set('sort', sort)
  const qs = params.toString()
  return qs ? `${basePath}?${qs}#avis` : `${basePath}#avis`
}

const maxDist = Math.max(1, ...Object.values(distribution))
const fmtDate = (d: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d))
---
<section id="avis" class="sec">
  <h2 class="sec-h m-0">Avis clients</h2>

  {/* Résumé + distribution */}
  <div class="mt-4 flex flex-col gap-6 sm:flex-row sm:items-start">
    <div class="text-center sm:w-40 sm:shrink-0">
      <p class="text-4xl font-bold text-neutral-900">{aggregates.average.toFixed(1)}</p>
      <div class="mt-1 flex justify-center gap-0.5">
        {starRow(Math.round(aggregates.average)).map((on) => (
          <span class:list={['flex h-4 w-4 items-center justify-center', on ? 'text-amber-500' : 'text-neutral-200']} set:html={Star} />
        ))}
      </div>
      <p class="mt-1 text-xs text-neutral-500">{aggregates.count} avis</p>
    </div>

    <div class="flex-1 space-y-1.5">
      {[5, 4, 3, 2, 1].map((n) => {
        const selected = activeRatings.includes(n)
        return (
          <a
            href={buildQuery({ toggleRating: n })}
            aria-pressed={selected ? 'true' : 'false'}
            class:list={['flex items-center gap-2 rounded-lg px-1 py-0.5 text-xs transition', selected && 'bg-accent/5']}
          >
            <span class:list={['w-10 shrink-0 text-right', selected ? 'font-semibold text-accent' : 'text-neutral-600']}>{n} étoile{n > 1 ? 's' : ''}</span>
            <span class="h-2 flex-1 overflow-hidden rounded-full bg-neutral-100">
              <span class="block h-full rounded-full bg-amber-500" style={`width:${((distribution[n] ?? 0) / maxDist) * 100}%`}></span>
            </span>
            <span class="w-6 text-neutral-500">{distribution[n] ?? 0}</span>
          </a>
        )
      })}
    </div>
  </div>

  {/* Filtres / tri (liens serveur) : étoiles multi-sélection + switch d'ordre */}
  <div class="mt-6 flex flex-wrap items-center gap-2">
    {activeRatings.length > 0 && (
      <a href={buildQuery({ clearRatings: true })} class="inline-flex items-center gap-1 rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
        {activeRatings.join(' · ')} étoile{activeRatings.length > 1 || activeRatings[0]! > 1 ? 's' : ''}
        <span class="flex h-3 w-3 items-center justify-center" set:html={X} />
      </a>
    )}
    <a
      href={buildQuery({ sort: activeSort === 'recent' ? 'oldest' : 'recent' })}
      class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600 transition hover:bg-neutral-200"
    >
      <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={ArrowDownUp} />
      {activeSort === 'recent' ? "Plus récents d'abord" : "Plus anciens d'abord"}
    </a>
  </div>

  {/* Lecture seule : le dépôt d'avis se fera depuis l'historique de commandes
      (phase Stripe), pas depuis la page produit. */}

  {/* Liste des avis */}
  <div class="mt-6 space-y-5">
    {reviews.length === 0 ? (
      <p class="py-6 text-center text-sm text-neutral-400">Aucun avis pour le moment.</p>
    ) : (
      reviews.map((review) => (
        <article class="border-b border-neutral-100 pb-5 last:border-0">
          <div class="flex items-center gap-2">
            <div class="flex gap-0.5">
              {starRow(review.rating).map((on) => (
                <span class:list={['flex h-3.5 w-3.5 items-center justify-center', on ? 'text-amber-500' : 'text-neutral-200']} set:html={Star} />
              ))}
            </div>
            {review.is_verified_purchase && (
              <span class="rounded-full bg-success/10 px-2 py-0.5 text-[11px] font-medium text-success">Achat vérifié</span>
            )}
            <time class="ml-auto text-xs text-neutral-400" datetime={review.created_at}>{fmtDate(review.created_at)}</time>
          </div>
          {review.title && <h3 class="mt-2 text-sm font-semibold text-neutral-900">{review.title}</h3>}
          <p class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-neutral-600">{review.content}</p>
          {review.product_review_photos && review.product_review_photos.length > 0 && (
            <div class="mt-3 flex gap-2">
              {review.product_review_photos
                .sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0))
                .map((photo) => (
                  <img src={photo.url} alt="Photo d'avis" class="h-16 w-16 rounded-lg object-cover" loading="lazy" />
                ))}
            </div>
          )}
          {review.seller_reply && (
            <div class="mt-3 rounded-lg bg-neutral-50 p-3">
              <p class="text-xs font-semibold text-neutral-900">Réponse du vendeur</p>
              <p class="mt-1 whitespace-pre-wrap text-sm text-neutral-600">{review.seller_reply}</p>
            </div>
          )}
        </article>
      ))
    )}
  </div>
</section>
