---
import { ArrowLeft, Share, Check } from 'lucide-static'

interface Props {
  /** Destination du bouton retour (vrai lien — fonctionne sans JS) */
  backHref: string
  /** Nom complet de l'article (produit, service, event, publication) */
  title: string
}

const { backHref, title } = Astro.props
---
{/* Top bar contextuelle des pages détail (design prototype) : retour +
    nom complet de l'article + partager. Sticky sous le header global,
    fond translucide flouté. */}
<div class="detail-topbar">
  <a href={backHref} class="iconbtn" aria-label="Retour">
    <span class="flex h-[18px] w-[18px] items-center justify-center" set:html={ArrowLeft} />
  </a>
  <span class="detail-topbar__title">{title}</span>
  <span class="flex-1"></span>
  <button type="button" class="iconbtn" data-share-page aria-label="Partager">
    <span class="flex h-[17px] w-[17px] items-center justify-center" set:html={Share} />
    <span class="hidden h-[17px] w-[17px] items-center justify-center" data-share-page-done set:html={Check} />
  </button>
</div>

<style>
  .detail-topbar {
    position: sticky;
    top: 65px; /* hauteur du GlobalHeader (sticky lui aussi) */
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding: 0 16px;
    margin: 0 auto;
    max-width: 800px;
    background: rgba(255, 255, 255, .82);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .detail-topbar__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--color-neutral-900);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>

{/* Exception JS justifiée : bouton partager de la top bar (Web Share API,
    fallback copie du lien). Contenu rendu serveur, ce script ne touche pas
    au SEO. Sélecteur distinct de [data-share-profile] (hero). */}
<script is:inline>
  (function () {
    var btn = document.querySelector('[data-share-page]')
    if (!btn) return
    var icons = btn.querySelectorAll('span')
    btn.addEventListener('click', function () {
      var url = location.origin + location.pathname
      function done() {
        if (icons.length < 2) return
        icons[0].classList.add('hidden')
        icons[1].classList.remove('hidden')
        icons[1].classList.add('flex')
        setTimeout(function () {
          icons[1].classList.add('hidden')
          icons[1].classList.remove('flex')
          icons[0].classList.remove('hidden')
        }, 1600)
      }
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function () {})
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(done).catch(function () {})
      }
    })
  })()
</script>
