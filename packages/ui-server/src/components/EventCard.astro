---
import { Clock, MapPin, Globe, CalendarDays, Users } from 'lucide-static'

interface Props {
  id: string
  title: string
  slug: string
  description: string | null
  startAt: string
  endAt?: string | null
  locationType: string
  locationDetails?: string | null
  priceCents: number | null
  currency: string
  /** Jauge : null = illimité. */
  capacity?: number | null
  /** Inscrits confirmés (pour "X places restantes"). */
  registrationsCount?: number
  /** Image de couverture (gallery_images[0]) — placeholder icône sinon. */
  coverImageUrl?: string | null
  entitySlug: string
}

const {
  id,
  title,
  slug,
  description,
  startAt,
  locationType,
  priceCents,
  currency,
  capacity = null,
  registrationsCount = 0,
  coverImageUrl = null,
  entitySlug,
} = Astro.props

const start = new Date(startAt)
const dayLabel = new Intl.DateTimeFormat('fr-FR', { day: 'numeric' }).format(start)
const monthLabel = new Intl.DateTimeFormat('fr-FR', { month: 'short' }).format(start).replace('.', '')
const timeLabel = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(start)
const shortDateLabel = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'long' }).format(start)

const locationLabels: Record<string, { icon: string; label: string }> = {
  online: { icon: Globe, label: 'En ligne' },
  in_person: { icon: MapPin, label: 'Sur place' },
}
const loc = locationLabels[locationType] ?? locationLabels.online

function formatPrice(cents: number | null, curr: string) {
  if (cents === null || cents === 0) return '0€'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: curr }).format(cents / 100)
}

const remaining = capacity != null ? Math.max(0, capacity - registrationsCount) : null
const isFull = remaining !== null && remaining <= 0
---
<a href={`/${entitySlug}/events/${slug}`} class="row" data-event={id}>
  {/* Vignette + badge date */}
  <div class="row__thumb">
    {coverImageUrl ? (
      <img src={coverImageUrl} alt={title} loading="lazy" />
    ) : (
      <span class="flex h-[26px] w-[26px] items-center justify-center" set:html={CalendarDays} />
    )}
    <span class="datechip">
      <span class="d">{dayLabel}</span>
      <span class="m">{monthLabel}</span>
    </span>
  </div>

  {/* Contenu */}
  <div class="min-w-0 flex-1">
    <div class="row__title">{title}</div>
    {description && <div class="row__desc">{description}</div>}
    <div class="row__metaline">
      <span class="metachip">
        <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={Clock} />
        {shortDateLabel} · {timeLabel}
      </span>
      <span class="metachip">
        <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={loc.icon} />
        {loc.label}
      </span>
      {remaining !== null && !isFull && (
        <span class="metachip text-accent">
          <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={Users} />
          {remaining} place{remaining > 1 ? 's' : ''}
        </span>
      )}
    </div>
  </div>

  {/* Prix + CTA */}
  <div class="row__right">
    <span class="price-tag">{formatPrice(priceCents, currency)}</span>
    {isFull ? (
      <span class="pill">Complet</span>
    ) : (
      <span class="pill pill--accent">S'inscrire</span>
    )}
  </div>
</a>
