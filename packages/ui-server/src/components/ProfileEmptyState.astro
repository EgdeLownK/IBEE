---
import { Hourglass } from 'lucide-static'
---
<section class="px-6 pt-6 pb-8 text-center sm:px-12 sm:pt-8 sm:pb-10">
  <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-neutral-100">
    <span class="flex h-7 w-7 items-center justify-center text-neutral-400" set:html={Hourglass} />
  </div>
  <h2 class="mt-5 text-xl font-semibold tracking-tight text-neutral-900">
    Bientôt disponible
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-neutral-600">
    Ce profil se prépare à vous accueillir. Repassez dans quelques jours.
  </p>
</section>
