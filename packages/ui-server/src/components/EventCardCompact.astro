---
import { Clock, MapPin, Globe } from 'lucide-static'

/**
 * Carte event compacte (badge date + titre + heure/lieu + prix).
 * Version réduite d'EventCard pour les sections "autres events à venir".
 */
interface Props {
  title: string
  slug: string
  startAt: string
  locationType: string
  priceCents: number | null
  currency: string
  entitySlug: string
}

const { title, slug, startAt, locationType, priceCents, currency, entitySlug } = Astro.props

const start = new Date(startAt)
const dayLabel = new Intl.DateTimeFormat('fr-FR', { day: 'numeric' }).format(start)
const monthLabel = new Intl.DateTimeFormat('fr-FR', { month: 'short' }).format(start).replace('.', '')
const timeLabel = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(start)

const locationLabels: Record<string, { icon: string; label: string }> = {
  online: { icon: Globe, label: 'En ligne' },
  in_person: { icon: MapPin, label: 'Sur place' },
}
const loc = locationLabels[locationType] ?? locationLabels.online

function formatPrice(cents: number | null, curr: string) {
  if (cents === null || cents === 0) return '0€'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: curr }).format(cents / 100)
}
---
<a
  href={`/${entitySlug}/events/${slug}`}
  class="group flex items-center gap-3 rounded-xl border border-neutral-200 bg-neutral-0 p-3 transition hover:border-accent hover:shadow-sm"
>
  {/* Badge date */}
  <span class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-lg bg-neutral-100">
    <span class="text-sm font-bold leading-tight text-neutral-900">{dayLabel}</span>
    <span class="text-[10px] font-semibold uppercase leading-tight text-accent">{monthLabel}</span>
  </span>

  {/* Titre + meta */}
  <span class="min-w-0 flex-1">
    <span class="block truncate text-sm font-semibold text-neutral-900 transition-colors group-hover:text-accent">{title}</span>
    <span class="mt-0.5 flex items-center gap-x-3 text-xs text-neutral-400">
      <span class="inline-flex items-center gap-1">
        <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={Clock} />
        {timeLabel}
      </span>
      <span class="inline-flex items-center gap-1">
        <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={loc.icon} />
        {loc.label}
      </span>
    </span>
  </span>

  {/* Prix */}
  <span class="price-tag shrink-0 text-sm">
    {formatPrice(priceCents, currency)}
  </span>
</a>
