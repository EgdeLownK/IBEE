---
import { MessageCircleQuestion, ChevronDown, BadgeCheck } from 'lucide-static'

/** Entrée FAQ rédigée par le vendeur (products.faq, narrowing fait côté page). */
interface FaqItem {
  question: string
  answer: string
}

/** Question privée reçue par le vendeur (product_questions, owner only). */
interface ReceivedQuestion {
  id: string
  question_text: string
  created_at: string
}

interface Props {
  faq: FaqItem[]
  /** true si le visiteur est le vendeur (owner de l'entity). */
  isOwner?: boolean
  /** Questions reçues (owner only — policy RLS product_questions_owner_select). */
  receivedQuestions?: ReceivedQuestion[]
}

const {
  faq,
  isOwner = false,
  receivedQuestions = [],
} = Astro.props

const fmtDate = (d: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d))

// JSON-LD FAQPage — citable par les LLMs (GEO/AEO), uniquement si FAQ non vide
const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null
---
{faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

<section id="faq" class="sec">
  <h2 class="sec-h mt-0 mb-3 flex items-center gap-2">
    <span class="flex h-[19px] w-[19px] items-center justify-center text-neutral-500" set:html={MessageCircleQuestion} />
    Questions fréquentes
  </h2>

  {/* Accordéon natif details/summary — zéro JS */}
  {faq.length > 0 ? (
    <div class="flex flex-col gap-2">
      {faq.map((item) => (
        <details class="faq">
          <summary>
            {item.question}
            <span class="flex h-4 w-4 shrink-0 items-center justify-center" set:html={ChevronDown} />
          </summary>
          <p class="whitespace-pre-wrap">{item.answer}</p>
        </details>
      ))}
    </div>
  ) : (
    <p class="m-0 text-sm text-neutral-400">Pas encore de FAQ pour ce produit.</p>
  )}

  {/* Le bouton « Poser une question au vendeur » a été retiré : cette vue
      n'est consultée que par le owner tant que la plateforme n'est pas
      publique. L'infra product_questions reste en place pour le réactiver. */}

  {/* Questions reçues — visible uniquement par le vendeur, pour alimenter sa FAQ */}
  {isOwner && (
    <div class="mt-8 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
      <h3 class="flex items-center gap-2 text-sm font-semibold text-neutral-900">
        <span class="flex h-4 w-4 items-center justify-center text-accent" set:html={BadgeCheck} />
        Questions reçues ({receivedQuestions.length})
        <span class="ml-auto rounded-full bg-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-600">Visible par toi seul</span>
      </h3>
      {receivedQuestions.length === 0 ? (
        <p class="mt-3 text-sm text-neutral-400">Aucune question reçue pour le moment.</p>
      ) : (
        <ul class="mt-3 space-y-3">
          {receivedQuestions.map((q) => (
            <li class="border-b border-neutral-200 pb-3 text-sm last:border-0 last:pb-0">
              <p class="text-neutral-700">{q.question_text}</p>
              <time class="text-xs text-neutral-400" datetime={q.created_at}>{fmtDate(q.created_at)}</time>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-3 text-xs text-neutral-400">
        Une question revient souvent ? Ajoute-la à la FAQ du produit.
      </p>
    </div>
  )}
</section>

