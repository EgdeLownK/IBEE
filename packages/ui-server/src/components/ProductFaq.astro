---
import { ChevronDown } from 'lucide-static'

/** Entrée FAQ rédigée par le vendeur (products.faq, narrowing fait côté page). */
interface FaqItem {
  question: string
  answer: string
}

interface Props {
  faq: FaqItem[]
}

const { faq } = Astro.props

// JSON-LD FAQPage — citable par les LLMs (GEO/AEO), uniquement si FAQ non vide
const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null
---
{faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

<section id="faq" class="sec">
  <h2 class="sec-h mt-0 mb-3">
    Questions fréquentes
  </h2>

  {/* Accordéon natif details/summary — zéro JS */}
  {faq.length > 0 ? (
    <div class="flex flex-col gap-2">
      {faq.map((item) => (
        <details class="faq">
          <summary>
            {item.question}
            <span class="flex h-4 w-4 shrink-0 items-center justify-center" set:html={ChevronDown} />
          </summary>
          <p class="whitespace-pre-wrap">{item.answer}</p>
        </details>
      ))}
    </div>
  ) : (
    <div class="faq-empty-card">
      <p>Pas encore de FAQ pour ce produit.</p>
    </div>
  )}

</section>

<style>
  .faq-empty-card {
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-panel) 72%, var(--color-surface));
    padding: 18px;
  }
  .faq-empty-card p {
    margin: 0;
    font-size: 14px;
    color: var(--color-neutral-500);
  }
</style>

