---
import { Eye, EyeOff } from 'lucide-static'

interface Props {
  title: string
  sectionType: string
  isOwner?: boolean
  isVisible?: boolean
}

const { title, sectionType, isOwner = false, isVisible = true } = Astro.props
const toggleId = `section-vis-${sectionType}`
---
<div class="section-header">
  <h2 class="section-header__title">{title}</h2>

  {isOwner && (
    <button
      type="button"
      class:list={['visibility-toggle', isVisible && 'is-on']}
      id={toggleId}
      data-section-type={sectionType}
      aria-pressed={isVisible ? 'true' : 'false'}
    >
      <span class="visibility-toggle__icon">
        <span class="flex h-4 w-4 items-center justify-center" set:html={isVisible ? Eye : EyeOff} />
      </span>
      <span class="visibility-toggle__text">
        <span class="visibility-toggle__title">Section visible</span>
        <span class="visibility-toggle__sub">Affiche sur votre profil public</span>
      </span>
      <span class="visibility-toggle__switch">
        <span class="visibility-toggle__thumb"></span>
      </span>
    </button>
  )}
</div>

<style>
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 27px 14px;
  }

  .section-header__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--color-neutral-900);
    margin: 0;
  }

  .visibility-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px 8px 10px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    font-family: inherit;
    color: var(--color-neutral-900);
    transition: background 120ms, border-color 120ms;
  }

  .visibility-toggle:hover {
    background: var(--color-panel-2);
  }

  .visibility-toggle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-panel-2);
    color: var(--color-neutral-500);
    flex-shrink: 0;
    transition: background 120ms, color 120ms;
  }

  .visibility-toggle.is-on .visibility-toggle__icon {
    background: rgba(44, 141, 74, 0.14);
    color: #2C8D4A;
  }

  .visibility-toggle__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
    text-align: left;
  }

  .visibility-toggle__title {
    font-size: 13px;
    font-weight: 600;
  }

  .visibility-toggle__sub {
    font-size: 11px;
    color: var(--color-neutral-500);
    margin-top: 2px;
  }

  .visibility-toggle__switch {
    position: relative;
    width: 36px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-border);
    transition: background 160ms;
    flex-shrink: 0;
    margin-left: auto;
    display: inline-block;
  }

  .visibility-toggle__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    transition: left 160ms;
  }

  .visibility-toggle.is-on .visibility-toggle__switch {
    background: #2C8D4A;
  }

  .visibility-toggle.is-on .visibility-toggle__thumb {
    left: 18px;
  }
</style>
