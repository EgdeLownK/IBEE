---
interface Props {
  title: string
  sectionType: string
  isOwner?: boolean
  isVisible?: boolean
}

const { title, sectionType, isOwner = false, isVisible = true } = Astro.props
const toggleId = `section-vis-${sectionType}`
---
<div class="section-header">
  <h2 class="section-header__title">{title}</h2>

  {isOwner && (
    <button
      type="button"
      class:list={['visibility-toggle', isVisible && 'is-on']}
      id={toggleId}
      data-section-type={sectionType}
      aria-pressed={isVisible ? 'true' : 'false'}
      title="Affiche ou masque cette section sur votre profil public"
    >
      {/* Les deux libellés vivent dans le DOM ; le CSS affiche celui qui
          correspond à l'état — un futur JS n'aura qu'à basculer .is-on */}
      <span class="visibility-toggle__label">
        <span class="visibility-toggle__label-on">Menu visible</span>
        <span class="visibility-toggle__label-off">Menu masqué</span>
      </span>
      <span class="visibility-toggle__switch">
        <span class="visibility-toggle__thumb"></span>
      </span>
    </button>
  )}
</div>

<style>
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 27px 14px;
  }

  .section-header__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--color-neutral-900);
    margin: 0;
  }

  /* Toggle discret : label 12px + mini switch, sans carte ni bordure */
  .visibility-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .visibility-toggle__label {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-neutral-500);
    transition: color 120ms;
  }

  .visibility-toggle:hover .visibility-toggle__label {
    color: var(--color-neutral-700);
  }

  .visibility-toggle .visibility-toggle__label-on { display: none; }
  .visibility-toggle .visibility-toggle__label-off { display: inline; }
  .visibility-toggle.is-on .visibility-toggle__label-on { display: inline; }
  .visibility-toggle.is-on .visibility-toggle__label-off { display: none; }

  .visibility-toggle__switch {
    position: relative;
    width: 32px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-border);
    transition: background 160ms;
    flex-shrink: 0;
    display: inline-block;
  }

  .visibility-toggle__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    transition: left 160ms;
  }

  .visibility-toggle.is-on .visibility-toggle__switch {
    background: var(--color-success);
  }

  .visibility-toggle.is-on .visibility-toggle__thumb {
    left: 16px;
  }
</style>
