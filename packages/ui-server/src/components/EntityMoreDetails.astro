---
/** Section « Plus de détails sur ce X » — contenu riche de l'entité (pas le menu Histoire profil). */
type ContentBlock =
  | { type: 'text'; content: string }
  | { type: 'image'; url: string; alt?: string }

type EntityKind = 'product' | 'service' | 'event'

interface Props {
  entityKind: EntityKind
  contentBlocks?: ContentBlock[]
  bulletPoints?: string[]
  /** Fallback texte (description_long / description legacy). */
  fallbackText?: string | null
}

const {
  entityKind,
  contentBlocks = [],
  bulletPoints = [],
  fallbackText = null,
} = Astro.props

const sectionTitles: Record<EntityKind, string> = {
  product: 'Plus de détails sur ce produit',
  service: 'Plus de détails sur ce service',
  event: 'Plus de détails sur cet événement',
}

const hasBlocks = contentBlocks.length > 0
const hasBullets = bulletPoints.length > 0
const fallback = fallbackText?.trim() ?? ''
const hasFallback = fallback.length > 0
const hasContent = hasBlocks || hasBullets || hasFallback
---
{hasContent && (
  <section class="emd">
    <h2 class="emd__title">{sectionTitles[entityKind]}</h2>

    {hasBullets && (
      <ul class="emd__bullets">
        {bulletPoints.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )}

    <div class="emd__body">
      {hasBlocks ? (
        contentBlocks.map((block) =>
          block.type === 'text' ? (
            <p class="emd__text">{block.content}</p>
          ) : (
            <figure class="emd__figure">
              <img src={block.url} alt={block.alt ?? ''} class="emd__img" loading="lazy" />
            </figure>
          )
        )
      ) : hasFallback ? (
        <p class="emd__text">{fallback}</p>
      ) : null}
    </div>
  </section>
)}

<style>
  .emd {
    margin-top: 26px;
  }
  .emd__title {
    margin: 0 0 18px;
    padding: 0 22px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }
  .emd__bullets {
    margin: 0 0 16px;
    padding: 0 22px 0 38px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-neutral-700);
  }
  .emd__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0 22px 8px;
  }
  .emd__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: -0.01em;
    color: var(--color-neutral-700);
    white-space: pre-wrap;
  }
  .emd__figure {
    margin: 0;
  }
  .emd__img {
    display: block;
    width: 100%;
    border-radius: 14px;
  }
</style>
