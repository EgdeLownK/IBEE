---
import { MapPin, Calendar, UserPlus, UserMinus, Bell, BellOff, ChevronDown } from 'lucide-static'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'
import AuthPromptOverlay from './AuthPromptOverlay.astro'

interface Props {
  displayName: string
  role: string | null
  location: string | null
  bio: string | null
  avatarUrl: string | null
  createdAt: string
  isOwner?: boolean
  isAuthenticated?: boolean
  isFollowing?: boolean
  entityId?: string
  entitySlug?: string
  followersCount?: number
  dashboardUrl?: string
  previewMode?: boolean
}

const {
  displayName,
  role,
  location,
  bio,
  avatarUrl,
  createdAt,
  isOwner = false,
  isAuthenticated = false,
  isFollowing = false,
  entityId,
  entitySlug,
  followersCount = 0,
  dashboardUrl = '',
  previewMode = false,
} = Astro.props

const formattedDate = format(new Date(createdAt), 'MMMM yyyy', { locale: fr })

const PATTERN_FONT_SIZE = 48
const PATTERN_LINE_HEIGHT = 120
const PATTERN_LINES = Array.from({ length: 6 }, (_, i) => i)
const PATTERN_OFFSET = 240

const nameText = `${displayName.toUpperCase()}\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0`.repeat(20)

const heroClasses = `relative aspect-square w-full overflow-hidden ${!avatarUrl ? 'bg-accent-soft' : ''}`

const followAuthId = `follow-auth-${entityId ?? 'default'}`
const subscribeInfoId = `subscribe-info-${entityId ?? 'default'}`
const notifMenuId = `notif-menu-${entityId ?? 'default'}`

const followersText = followersCount === 0
  ? null
  : followersCount === 1
    ? 'Suivi par 1 personne'
    : `Suivi par ${followersCount} personnes`
---
<header>
  {/* Hero carrée pleine largeur */}
  <div class={heroClasses}>
    {avatarUrl && (
      <img
        src={avatarUrl}
        alt={displayName}
        width="800"
        height="800"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    )}

    {!avatarUrl && (
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <svg
          class="h-full w-full"
          viewBox="0 0 600 600"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          {PATTERN_LINES.map((i) => (
            <text
              x={i % 2 === 0 ? '0' : String(-PATTERN_OFFSET)}
              y={String(i * PATTERN_LINE_HEIGHT + PATTERN_FONT_SIZE)}
              font-size={String(PATTERN_FONT_SIZE)}
              font-weight="600"
              font-family="system-ui, -apple-system, sans-serif"
              fill="var(--color-accent)"
              fill-opacity="0.2"
            >
              {nameText}
            </text>
          ))}
        </svg>
      </div>
    )}

    {/* Overlay gradient bottom */}
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-white to-transparent"></div>

    {/* Zone d'action dans le gradient */}
    <div class="absolute inset-x-0 bottom-4 z-10 flex flex-col items-end gap-2 px-4">
      <div class="flex items-center gap-2" data-follow-wrapper data-entity-id={entityId} data-entity-slug={entitySlug}>
        {previewMode ? (
          <>
            <a
              href={`/${entitySlug}`}
              class="inline-flex items-center rounded-full border border-neutral-200 bg-white/90 px-5 py-2.5 text-sm font-medium text-neutral-900 backdrop-blur-sm transition-colors hover:bg-white"
            >
              Voir le profil
            </a>
            <a
              href={`/${entitySlug}`}
              class="inline-flex items-center gap-2 rounded-full bg-cta-primary px-6 py-2.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-cta-primary-hover"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
              Suivre
            </a>
          </>
        ) : isOwner ? (
          <Fragment />
        ) : (
          <>
            {/* Bouton S'abonner → popover info "bientôt dispo" */}
            <button
              type="button"
              popovertarget={subscribeInfoId}
              class="inline-flex items-center rounded-full border border-neutral-200 bg-white/90 px-5 py-2.5 text-sm font-medium text-neutral-900 backdrop-blur-sm transition-colors hover:bg-white"
            >
              S'abonner
            </button>

            {/* === FOLLOW STATES === */}

            {/* Anonyme → popover auth */}
            {!isAuthenticated && (
              <button
                type="button"
                popovertarget={followAuthId}
                style={`anchor-name: --${followAuthId};`}
                class="inline-flex items-center gap-2 rounded-full bg-cta-primary px-6 py-2.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-cta-primary-hover"
              >
                <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
                Suivre
              </button>
            )}

            {/* Authentifié — Not following: bouton Suivre */}
            {isAuthenticated && (
              <button
                type="button"
                data-follow-action
                style={isFollowing ? 'display: none;' : undefined}
                class="inline-flex items-center gap-2 rounded-full bg-cta-primary px-6 py-2.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-cta-primary-hover"
              >
                <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
                Suivre
              </button>
            )}

            {/* Authentifié — Following: bell + chevron → notification menu */}
            {isAuthenticated && (
              <button
                type="button"
                data-notif-trigger
                popovertarget={notifMenuId}
                style={`anchor-name: --${notifMenuId};${!isFollowing ? ' display: none;' : ''}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white/90 px-4 py-2.5 text-sm font-medium text-neutral-900 backdrop-blur-sm transition-colors hover:bg-white"
              >
                <span class="flex h-4 w-4 items-center justify-center" set:html={Bell} />
                <span class="flex h-3 w-3 items-center justify-center" set:html={ChevronDown} />
              </button>
            )}
          </>
        )}
      </div>

      {/* Compteur followers */}
      {!isOwner && (
        <p
          data-followers-count
          data-count={String(followersCount)}
          class:list={[
            'text-xs text-neutral-400',
            followersCount === 0 && 'hidden',
          ]}
        >
          {followersText}
        </p>
      )}
    </div>
  </div>

  <div class="px-6 py-6 text-center sm:px-12 sm:py-8">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {displayName}
    </h1>

    {role && (
      <p class="mt-2 text-base font-semibold text-neutral-900 sm:text-lg">
        {role}
      </p>
    )}

    <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-neutral-400">
      {location && (
        <span class="inline-flex items-center gap-1.5">
          <span class="flex h-4 w-4 items-center justify-center" set:html={MapPin} />
          <span class="leading-none">{location}</span>
        </span>
      )}
      <span class="inline-flex items-center gap-1.5">
        <span class="flex h-4 w-4 items-center justify-center" set:html={Calendar} />
        <span class="leading-none">Inscrit en {formattedDate}</span>
      </span>
    </div>

    {bio && (
      <p class="mx-auto mt-6 max-w-prose text-sm leading-relaxed text-neutral-600 sm:text-base">
        {bio}
      </p>
    )}
  </div>
</header>

{/* Popovers rendus hors du header pour le top layer */}

{!isOwner && !isAuthenticated && (
  <AuthPromptOverlay
    id={followAuthId}
    title={`Connectez-vous pour suivre ${displayName}`}
    loginUrl={`${dashboardUrl}/login`}
  />
)}

{!isOwner && (
  <AuthPromptOverlay
    id={subscribeInfoId}
    title="L'abonnement sera bientôt disponible"
    subtitle={`Vous pourrez soutenir ${displayName} et accéder à du contenu exclusif.`}
    position="center"
  />
)}

{/* Notification menu dropdown */}
{!isOwner && isAuthenticated && (
  <div id={notifMenuId} popover="auto" class="notif-menu" style={`position-anchor: --${notifMenuId};`}>
    <button type="button" data-notif-option="all" class="notif-menu-item notif-menu-item--active">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={Bell} />
      <span class="flex-1">Toutes</span>
    </button>
    <button type="button" data-notif-option="none" class="notif-menu-item">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={BellOff} />
      <span class="flex-1">Aucune</span>
    </button>
    <div class="my-1 border-t border-neutral-200"></div>
    <button type="button" data-unfollow-action class="notif-menu-item notif-menu-item--danger">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={UserMinus} />
      <span class="flex-1">Ne plus suivre</span>
    </button>
  </div>
)}

<style>
  .notif-menu {
    width: 240px;
    padding: 6px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    margin: 0;
    margin-top: 4px;
    overflow: visible;
    position-area: bottom;
    position-try-fallbacks: flip-block;
  }

  .notif-menu::backdrop {
    background: transparent;
  }

  .notif-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 12px;
    border: none;
    background: transparent;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-neutral-600);
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .notif-menu-item:hover {
    background: var(--color-neutral-50);
  }

  .notif-menu-item--active {
    color: var(--color-accent);
    font-weight: 500;
  }

  .notif-menu-item--danger {
    color: var(--color-neutral-600);
  }

  .notif-menu-item--danger:hover {
    background: rgb(220 38 38 / 0.06);
    color: var(--color-error);
  }
</style>

{/* Vanilla JS — follow/unfollow + notification menu */}
<script>
  const wrapper = document.querySelector<HTMLElement>('[data-follow-wrapper]')
  if (wrapper) {
    const entityId = wrapper.dataset.entityId
    const entitySlug = wrapper.dataset.entitySlug
    const followBtn = wrapper.querySelector<HTMLButtonElement>('[data-follow-action]')
    const notifTrigger = wrapper.querySelector<HTMLButtonElement>('[data-notif-trigger]')
    const counterEl = document.querySelector<HTMLElement>('[data-followers-count]')
    const unfollowBtn = document.querySelector<HTMLButtonElement>('[data-unfollow-action]')

    // Notification option selection (visual only)
    const notifOptions = document.querySelectorAll<HTMLButtonElement>('[data-notif-option]')
    notifOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        notifOptions.forEach(o => o.classList.remove('notif-menu-item--active'))
        opt.classList.add('notif-menu-item--active')
      })
    })

    let busy = false

    function updateCounter(count: number) {
      if (!counterEl) return
      counterEl.dataset.count = String(count)
      if (count === 0) {
        counterEl.style.display = 'none'
        counterEl.textContent = ''
      } else {
        counterEl.style.display = ''
        counterEl.textContent = count === 1 ? 'Suivi par 1 personne' : `Suivi par ${count} personnes`
      }
    }

    // Follow action
    followBtn?.addEventListener('click', async () => {
      if (busy) return
      busy = true
      try {
        const res = await fetch('/api/follow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entityId, slug: entitySlug }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        const data = await res.json()

        // Switch to notif trigger
        followBtn.style.display = 'none'
        if (notifTrigger) notifTrigger.style.display = ''
        updateCounter(data.followers_count ?? 0)
      } catch (err) {
        console.error('[follow]', err)
      } finally {
        busy = false
      }
    })

    // Unfollow action (from notification menu)
    unfollowBtn?.addEventListener('click', async () => {
      if (busy) return
      busy = true
      try {
        const res = await fetch('/api/unfollow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entityId, slug: entitySlug }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        const data = await res.json()

        // Close the notification menu popover
        const notifMenu = document.querySelector<HTMLElement>(`[id="notif-menu-${entityId}"]`)
        if (notifMenu && 'hidePopover' in notifMenu) {
          (notifMenu as HTMLElement & { hidePopover: () => void }).hidePopover()
        }

        // Switch to follow button
        if (notifTrigger) notifTrigger.style.display = 'none'
        if (followBtn) followBtn.style.display = ''
        updateCounter(data.followers_count ?? 0)

        // Reset notification options to default
        notifOptions.forEach(o => o.classList.remove('notif-menu-item--active'))
        document.querySelector('[data-notif-option="all"]')?.classList.add('notif-menu-item--active')
      } catch (err) {
        console.error('[unfollow]', err)
      } finally {
        busy = false
      }
    })
  }
</script>
