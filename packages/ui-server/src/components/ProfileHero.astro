---
import { UserPlus, UserMinus, Bell, BellOff, ChevronDown, Share, Check } from 'lucide-static'
import AuthPromptOverlay from './AuthPromptOverlay.astro'

interface Props {
  displayName: string
  role: string | null
  location: string | null
  bio: string | null
  avatarUrl: string | null
  bannerUrl?: string | null
  createdAt: string
  isAuthenticated?: boolean
  isFollowing?: boolean
  entityId?: string
  entitySlug?: string
  followersCount?: number
  dashboardUrl?: string
  previewMode?: boolean
}

const {
  displayName,
  role,
  bio,
  avatarUrl,
  bannerUrl,
  isAuthenticated = false,
  isFollowing = false,
  entityId,
  entitySlug,
  followersCount = 0,
  dashboardUrl = '',
  previewMode = false,
} = Astro.props

const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('')

const followersDisplay = new Intl.NumberFormat('fr-FR', {
  notation: 'compact',
  maximumFractionDigits: 1,
}).format(followersCount)
const followersText = followersCount === 0 ? null : `${followersDisplay} abonnés`

const followAuthId = `follow-auth-${entityId ?? 'default'}`
const subscribeInfoId = `subscribe-info-${entityId ?? 'default'}`
const notifMenuId = `notif-menu-${entityId ?? 'default'}`
---
<header>
  <div class="relative">
    <div class="profile-banner">
      {bannerUrl ? (
        <img src={bannerUrl} alt="" class="profile-banner__img" width="800" height="172" />
      ) : (
        <div class="profile-banner__placeholder" aria-hidden="true">
          <span class="profile-banner__label">BANNER IMAGE 800×172</span>
        </div>
      )}
    </div>
    <button
      type="button"
      class="iconbtn profile-share"
      data-share-profile
      aria-label="Partager le profil"
    >
      <span class="flex h-[17px] w-[17px] items-center justify-center" set:html={Share} />
      <span class="hidden h-[17px] w-[17px] items-center justify-center" data-share-done set:html={Check} />
    </button>
  </div>

  <div class="px-[22px]">
    <div class="flex items-center gap-4 mt-4">
      <div class="profile-avatar">
        {avatarUrl ? (
          <img src={avatarUrl} alt={displayName} width="172" height="172" fetchpriority="high" class="h-full w-full object-cover" />
        ) : (
          <span class="font-display text-[30px] font-semibold text-accent">{initials}</span>
        )}
      </div>
      <div class="min-w-0 flex-1">
        <h1 class="m-0 font-display text-[22px] font-semibold leading-tight text-neutral-900 truncate">{displayName}</h1>
        {role && <p class="mt-0.5 mb-0 text-[13.5px] text-neutral-500">{role}</p>}
      </div>
    </div>

    <p
      data-followers-count
      data-count={String(followersCount)}
      class="mt-4 mb-0 text-[13.5px] text-neutral-600"
      style={followersText ? undefined : 'display: none;'}
    >
      <b class="font-display font-bold text-neutral-900">{followersDisplay}</b> abonnés
    </p>

    {bio && <p class="mt-3 mb-0 text-[13.5px] leading-normal text-neutral-600">{bio}</p>}

    <div
      class="flex items-center gap-2.5 mt-5 mb-1"
      data-follow-wrapper
      data-entity-id={entityId}
      data-entity-slug={entitySlug}
    >
      {previewMode ? (
        <>
          <a href={`/${entitySlug}`} class="btn btn--dark flex-1">
            <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
            Suivre
          </a>
          <a href={`/${entitySlug}`} class="btn btn--ghost flex-1">Voir le profil</a>
        </>
      ) : (
        <>
          {!isAuthenticated && (
            <button
              type="button"
              popovertarget={followAuthId}
              style={`anchor-name: --${followAuthId};`}
              class="btn btn--dark flex-1"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
              Suivre
            </button>
          )}

          {isAuthenticated && (
            <button
              type="button"
              data-follow-action
              style={isFollowing ? 'display: none;' : undefined}
              class="btn btn--dark flex-1"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
              Suivre
            </button>
          )}

          {isAuthenticated && (
            <button
              type="button"
              data-notif-trigger
              popovertarget={notifMenuId}
              style={`anchor-name: --${notifMenuId};${!isFollowing ? ' display: none;' : ''}`}
              class="btn btn--ghost flex-1"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={Bell} />
              <span class="flex h-3 w-3 items-center justify-center" set:html={ChevronDown} />
            </button>
          )}

          <button type="button" popovertarget={subscribeInfoId} class="btn btn--ghost flex-1">
            S'abonner
          </button>
        </>
      )}
    </div>
  </div>
</header>

{!isAuthenticated && (
  <AuthPromptOverlay
    id={followAuthId}
    title={`Connectez-vous pour suivre ${displayName}`}
    loginUrl={`${dashboardUrl}/login`}
  />
)}

<AuthPromptOverlay
  id={subscribeInfoId}
  title="L'abonnement sera bientôt disponible"
  subtitle={`Vous pourrez soutenir ${displayName} et accéder à du contenu exclusif.`}
  position="center"
/>

{isAuthenticated && (
  <div id={notifMenuId} popover="auto" class="notif-menu" style={`position-anchor: --${notifMenuId};`}>
    <button type="button" data-notif-option="all" class="notif-menu-item notif-menu-item--active">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={Bell} />
      <span class="flex-1">Toutes</span>
    </button>
    <button type="button" data-notif-option="none" class="notif-menu-item">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={BellOff} />
      <span class="flex-1">Aucune</span>
    </button>
    <div class="my-1 border-t border-neutral-200"></div>
    <button type="button" data-unfollow-action class="notif-menu-item notif-menu-item--danger">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={UserMinus} />
      <span class="flex-1">Ne plus suivre</span>
    </button>
  </div>
)}

<style>
  .profile-banner {
    width: 100%;
    height: 172px;
    overflow: hidden;
    background: var(--color-panel);
  }

  .profile-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .profile-share {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(255, 255, 255, .85);
    backdrop-filter: blur(6px);
    z-index: 1;
  }

  .profile-banner__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: repeating-linear-gradient(
      135deg,
      var(--color-panel-2) 0,
      var(--color-panel-2) 4px,
      var(--color-panel) 4px,
      var(--color-panel) 10px
    );
  }

  .profile-banner__label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.05em;
    color: var(--color-neutral-400);
    background: var(--color-surface);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }

  .profile-avatar {
    width: 86px;
    height: 86px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-accent-soft);
    border: 4px solid var(--color-surface);
    box-shadow: 0 6px 16px -8px rgba(0, 0, 0, .3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .notif-menu {
    width: 240px;
    padding: 6px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    margin: 0;
    margin-top: 4px;
    overflow: visible;
    position-area: bottom;
    position-try-fallbacks: flip-block;
  }

  .notif-menu::backdrop {
    background: transparent;
  }

  .notif-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 12px;
    border: none;
    background: transparent;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-neutral-600);
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .notif-menu-item:hover {
    background: var(--color-neutral-50);
  }

  .notif-menu-item--active {
    color: var(--color-accent);
    font-weight: 500;
  }

  .notif-menu-item--danger {
    color: var(--color-neutral-600);
  }

  .notif-menu-item--danger:hover {
    background: rgb(220 38 38 / 0.06);
    color: var(--color-error);
  }
</style>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-share-profile]')
    if (!btn) return
    var icons = btn.querySelectorAll('span')
    btn.addEventListener('click', function () {
      var url = location.origin + location.pathname
      function done() {
        if (icons.length < 2) return
        icons[0].classList.add('hidden')
        icons[1].classList.remove('hidden')
        icons[1].classList.add('flex')
        setTimeout(function () {
          icons[1].classList.add('hidden')
          icons[1].classList.remove('flex')
          icons[0].classList.remove('hidden')
        }, 1600)
      }
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function () {})
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(done).catch(function () {})
      }
    })
  })()
</script>

<script>
  const wrapper = document.querySelector<HTMLElement>('[data-follow-wrapper]')
  if (wrapper) {
    const entityId = wrapper.dataset.entityId
    const entitySlug = wrapper.dataset.entitySlug
    const followBtn = wrapper.querySelector<HTMLButtonElement>('[data-follow-action]')
    const notifTrigger = wrapper.querySelector<HTMLButtonElement>('[data-notif-trigger]')
    const counterEl = document.querySelector<HTMLElement>('[data-followers-count]')
    const unfollowBtn = document.querySelector<HTMLButtonElement>('[data-unfollow-action]')

    const notifOptions = document.querySelectorAll<HTMLButtonElement>('[data-notif-option]')
    notifOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        notifOptions.forEach(o => o.classList.remove('notif-menu-item--active'))
        opt.classList.add('notif-menu-item--active')
      })
    })

    let busy = false

    function formatCount(count: number) {
      return new Intl.NumberFormat('fr-FR', {
        notation: 'compact',
        maximumFractionDigits: 1,
      }).format(count)
    }

    function updateCounter(count: number) {
      if (!counterEl) return
      counterEl.dataset.count = String(count)
      if (count === 0) {
        counterEl.style.display = 'none'
        counterEl.textContent = ''
      } else {
        counterEl.style.display = ''
        counterEl.innerHTML = `<b class="font-display font-bold text-neutral-900">${formatCount(count)}</b> abonnés`
      }
    }

    followBtn?.addEventListener('click', async () => {
      if (busy) return
      busy = true
      try {
        const res = await fetch('/api/follow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entityId, slug: entitySlug }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        const data = await res.json()

        followBtn.style.display = 'none'
        if (notifTrigger) notifTrigger.style.display = ''
        updateCounter(data.followers_count ?? 0)
      } catch (err) {
        console.error('[follow]', err)
      } finally {
        busy = false
      }
    })

    unfollowBtn?.addEventListener('click', async () => {
      if (busy) return
      busy = true
      try {
        const res = await fetch('/api/unfollow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entityId, slug: entitySlug }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        const data = await res.json()

        const notifMenu = document.querySelector<HTMLElement>(`[id="notif-menu-${entityId}"]`)
        if (notifMenu && 'hidePopover' in notifMenu) {
          (notifMenu as HTMLElement & { hidePopover: () => void }).hidePopover()
        }

        if (notifTrigger) notifTrigger.style.display = 'none'
        if (followBtn) followBtn.style.display = ''
        updateCounter(data.followers_count ?? 0)

        notifOptions.forEach(o => o.classList.remove('notif-menu-item--active'))
        document.querySelector('[data-notif-option="all"]')?.classList.add('notif-menu-item--active')
      } catch (err) {
        console.error('[unfollow]', err)
      } finally {
        busy = false
      }
    })
  }
</script>
