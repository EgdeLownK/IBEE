---
import { UserPlus, UserMinus, Bell, BellOff, ChevronDown, Pencil, Image as ImageIcon, Trash2 } from 'lucide-static'
import AuthPromptOverlay from './AuthPromptOverlay.astro'

interface Props {
  displayName: string
  role: string | null
  location: string | null
  bio: string | null
  avatarUrl: string | null
  createdAt: string
  isOwner?: boolean
  isAuthenticated?: boolean
  isFollowing?: boolean
  entityId?: string
  entitySlug?: string
  followersCount?: number
  dashboardUrl?: string
  previewMode?: boolean
}

const {
  displayName,
  avatarUrl,
  isOwner = false,
  isAuthenticated = false,
  isFollowing = false,
  entityId,
  entitySlug,
  followersCount = 0,
  dashboardUrl = '',
  previewMode = false,
} = Astro.props

const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('')

const followersDisplay = new Intl.NumberFormat('fr-FR', {
  notation: 'compact',
  maximumFractionDigits: 1,
}).format(followersCount)
const followersText = followersCount === 0 ? null : `${followersDisplay} abonnés`

const followAuthId = `follow-auth-${entityId ?? 'default'}`
const subscribeInfoId = `subscribe-info-${entityId ?? 'default'}`
const notifMenuId = `notif-menu-${entityId ?? 'default'}`
const bannerMenuId = `banner-menu-${entityId ?? 'default'}`
const avatarMenuId = `avatar-menu-${entityId ?? 'default'}`
const hasAvatar = !!avatarUrl
---
<header>
  {/* Banner — 240px hauteur, placeholder hachuré si pas d'image */}
  {isOwner ? (
    <button
      type="button"
      class="profile-banner profile-banner--editable"
      popovertarget={bannerMenuId}
      style={`anchor-name: --${bannerMenuId};`}
      aria-label="Modifier la bannière"
    >
      <div class="profile-banner__placeholder" aria-hidden="true">
        <span class="profile-banner__label">BANNER IMAGE 800×240</span>
      </div>
    </button>
  ) : (
    <div class="profile-banner">
      <div class="profile-banner__placeholder" aria-hidden="true">
        <span class="profile-banner__label">BANNER IMAGE 800×240</span>
      </div>
    </div>
  )}

  {/* Header row : avatar + nom + abonnés à gauche, CTA à droite */}
  <div class="flex items-center gap-[22px] px-[27px] pt-5 pb-[18px]">
    <div class="flex shrink-0 items-center">
      {isOwner ? (
        <button
          type="button"
          class="profile-avatar profile-avatar--editable"
          popovertarget={avatarMenuId}
          style={`anchor-name: --${avatarMenuId};`}
          aria-label="Modifier l'avatar"
        >
          {avatarUrl ? (
            <img src={avatarUrl} alt={displayName} width="138" height="138" fetchpriority="high" class="h-full w-full object-cover" />
          ) : (
            <span class="font-display text-2xl font-medium text-neutral-500">{initials}</span>
          )}
        </button>
      ) : (
        <div class="profile-avatar">
          {avatarUrl ? (
            <img src={avatarUrl} alt={displayName} width="138" height="138" fetchpriority="high" class="h-full w-full object-cover" />
          ) : (
            <span class="font-display text-2xl font-medium text-neutral-500">{initials}</span>
          )}
        </div>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <h1 class="font-display text-[24px] font-medium leading-tight text-neutral-900 truncate">
        {displayName}
      </h1>
      {followersText && (
        <p
          data-followers-count
          data-count={String(followersCount)}
          class="mt-2 text-base text-neutral-500"
        >
          {followersText}
        </p>
      )}
    </div>

    <div
      class="flex shrink-0 items-center gap-2"
      data-follow-wrapper
      data-entity-id={entityId}
      data-entity-slug={entitySlug}
    >
      {previewMode ? (
        <>
          <a
            href={`/${entitySlug}`}
            class="inline-flex items-center rounded-full border border-neutral-200 bg-surface px-5 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-panel-2"
          >
            Voir le profil
          </a>
          <a
            href={`/${entitySlug}`}
            class="inline-flex items-center gap-2 rounded-full bg-cta-primary px-6 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-accent"
          >
            <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
            Suivre
          </a>
        </>
      ) : isOwner ? (
        <a
          href={`/${entitySlug}/informations`}
          class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-surface px-5 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-panel-2"
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={Pencil} />
          Modifier générale
        </a>
      ) : (
        <>
          {/* Bouton S'abonner → popover info "bientôt dispo" */}
          <button
            type="button"
            popovertarget={subscribeInfoId}
            class="inline-flex items-center rounded-full border border-neutral-200 bg-surface px-5 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-panel-2"
          >
            S'abonner
          </button>

          {/* Anonyme → popover auth */}
          {!isAuthenticated && (
            <button
              type="button"
              popovertarget={followAuthId}
              style={`anchor-name: --${followAuthId};`}
              class="inline-flex items-center gap-2 rounded-full bg-cta-primary px-6 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-accent"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
              Suivre
            </button>
          )}

          {/* Authentifié — Not following */}
          {isAuthenticated && (
            <button
              type="button"
              data-follow-action
              style={isFollowing ? 'display: none;' : undefined}
              class="inline-flex items-center gap-2 rounded-full bg-cta-primary px-6 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-accent"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={UserPlus} />
              Suivre
            </button>
          )}

          {/* Authentifié — Following : bell + chevron */}
          {isAuthenticated && (
            <button
              type="button"
              data-notif-trigger
              popovertarget={notifMenuId}
              style={`anchor-name: --${notifMenuId};${!isFollowing ? ' display: none;' : ''}`}
              class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-surface px-4 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-panel-2"
            >
              <span class="flex h-4 w-4 items-center justify-center" set:html={Bell} />
              <span class="flex h-3 w-3 items-center justify-center" set:html={ChevronDown} />
            </button>
          )}
        </>
      )}
    </div>
  </div>
</header>

{/* Popovers rendus hors du header pour le top layer */}

{!isOwner && !isAuthenticated && (
  <AuthPromptOverlay
    id={followAuthId}
    title={`Connectez-vous pour suivre ${displayName}`}
    loginUrl={`${dashboardUrl}/login`}
  />
)}

{!isOwner && (
  <AuthPromptOverlay
    id={subscribeInfoId}
    title="L'abonnement sera bientôt disponible"
    subtitle={`Vous pourrez soutenir ${displayName} et accéder à du contenu exclusif.`}
    position="center"
  />
)}

{/* Banner image menu (owner only) */}
{isOwner && (
  <div id={bannerMenuId} popover="auto" class="image-action-menu" style={`position-anchor: --${bannerMenuId};`}>
    <button type="button" class="image-action-menu__item" data-banner-action="change">
      <span class="flex h-4 w-4 items-center justify-center" set:html={ImageIcon} />
      <span>Changer l'image</span>
    </button>
    <button type="button" class="image-action-menu__item image-action-menu__item--danger" data-banner-action="delete">
      <span class="flex h-4 w-4 items-center justify-center" set:html={Trash2} />
      <span>Supprimer</span>
    </button>
  </div>
)}

{/* Avatar image menu (owner only) */}
{isOwner && (
  <div id={avatarMenuId} popover="auto" class="image-action-menu" style={`position-anchor: --${avatarMenuId};`}>
    <button type="button" class="image-action-menu__item" data-avatar-action="change">
      <span class="flex h-4 w-4 items-center justify-center" set:html={ImageIcon} />
      <span>Changer l'image</span>
    </button>
    {hasAvatar && (
      <button type="button" class="image-action-menu__item image-action-menu__item--danger" data-avatar-action="delete">
        <span class="flex h-4 w-4 items-center justify-center" set:html={Trash2} />
        <span>Supprimer</span>
      </button>
    )}
  </div>
)}

{/* Notification menu dropdown */}
{!isOwner && isAuthenticated && (
  <div id={notifMenuId} popover="auto" class="notif-menu" style={`position-anchor: --${notifMenuId};`}>
    <button type="button" data-notif-option="all" class="notif-menu-item notif-menu-item--active">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={Bell} />
      <span class="flex-1">Toutes</span>
    </button>
    <button type="button" data-notif-option="none" class="notif-menu-item">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={BellOff} />
      <span class="flex-1">Aucune</span>
    </button>
    <div class="my-1 border-t border-neutral-200"></div>
    <button type="button" data-unfollow-action class="notif-menu-item notif-menu-item--danger">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={UserMinus} />
      <span class="flex-1">Ne plus suivre</span>
    </button>
  </div>
)}

<style>
  .profile-banner {
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: var(--color-panel);
  }

  .profile-banner__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: repeating-linear-gradient(
      135deg,
      var(--color-panel-2) 0,
      var(--color-panel-2) 4px,
      var(--color-panel) 4px,
      var(--color-panel) 10px
    );
  }

  .profile-banner__label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.05em;
    color: var(--color-neutral-400);
    background: var(--color-surface);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }

  .profile-avatar {
    width: 69px;
    height: 69px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-panel-2);
    border: 3px solid var(--color-surface);
    margin-top: -38px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .profile-banner--editable,
  .profile-avatar--editable {
    padding: 0;
    cursor: pointer;
    font: inherit;
    transition: filter 160ms ease;
  }
  .profile-banner--editable {
    border: none;
    background: var(--color-panel);
    width: 100%;
    height: 240px;
    overflow: hidden;
    display: block;
  }
  .profile-banner--editable:hover {
    filter: brightness(0.94);
  }
  .profile-avatar--editable:hover {
    filter: brightness(0.94);
  }

  .image-action-menu {
    min-width: 200px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: var(--shadow-pop);
    padding: 6px;
    margin: 0;
    margin-top: 8px;
    overflow: visible;
    position-area: bottom span-right;
    position-try-fallbacks: flip-block;
  }
  .image-action-menu::backdrop {
    background: transparent;
  }
  .image-action-menu__item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 12px;
    border-radius: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 13px;
    color: var(--color-neutral-900);
    text-align: left;
    transition: background 120ms;
  }
  .image-action-menu__item:hover {
    background: var(--color-panel);
  }
  .image-action-menu__item--danger {
    color: rgb(181, 51, 51);
  }
  .image-action-menu__item--danger:hover {
    background: rgba(181, 51, 51, 0.08);
  }

  .notif-menu {
    width: 240px;
    padding: 6px;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    margin: 0;
    margin-top: 4px;
    overflow: visible;
    position-area: bottom;
    position-try-fallbacks: flip-block;
  }

  .notif-menu::backdrop {
    background: transparent;
  }

  .notif-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 12px;
    border: none;
    background: transparent;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-neutral-600);
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .notif-menu-item:hover {
    background: var(--color-neutral-50);
  }

  .notif-menu-item--active {
    color: var(--color-accent);
    font-weight: 500;
  }

  .notif-menu-item--danger {
    color: var(--color-neutral-600);
  }

  .notif-menu-item--danger:hover {
    background: rgb(220 38 38 / 0.06);
    color: var(--color-error);
  }
</style>

{/* Image action menus — stubs (backend upload/delete à venir) */}
<script is:inline>
  (function() {
    document.querySelectorAll('[data-banner-action], [data-avatar-action]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var bannerAction = btn.dataset.bannerAction
        var avatarAction = btn.dataset.avatarAction
        var target = bannerAction ? 'banner' : 'avatar'
        var action = bannerAction || avatarAction
        if (action === 'change') {
          alert('Upload ' + target + ' à venir')
        } else if (action === 'delete') {
          if (confirm('Supprimer ' + target + ' ?')) {
            alert('Suppression ' + target + ' à venir')
          }
        }
      })
    })
  })()
</script>

{/* Vanilla JS — follow/unfollow + notification menu */}
<script>
  const wrapper = document.querySelector<HTMLElement>('[data-follow-wrapper]')
  if (wrapper) {
    const entityId = wrapper.dataset.entityId
    const entitySlug = wrapper.dataset.entitySlug
    const followBtn = wrapper.querySelector<HTMLButtonElement>('[data-follow-action]')
    const notifTrigger = wrapper.querySelector<HTMLButtonElement>('[data-notif-trigger]')
    const counterEl = document.querySelector<HTMLElement>('[data-followers-count]')
    const unfollowBtn = document.querySelector<HTMLButtonElement>('[data-unfollow-action]')

    const notifOptions = document.querySelectorAll<HTMLButtonElement>('[data-notif-option]')
    notifOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        notifOptions.forEach(o => o.classList.remove('notif-menu-item--active'))
        opt.classList.add('notif-menu-item--active')
      })
    })

    let busy = false

    function formatCount(count: number) {
      return new Intl.NumberFormat('fr-FR', {
        notation: 'compact',
        maximumFractionDigits: 1,
      }).format(count)
    }

    function updateCounter(count: number) {
      if (!counterEl) return
      counterEl.dataset.count = String(count)
      if (count === 0) {
        counterEl.style.display = 'none'
        counterEl.textContent = ''
      } else {
        counterEl.style.display = ''
        counterEl.textContent = `${formatCount(count)} abonnés`
      }
    }

    followBtn?.addEventListener('click', async () => {
      if (busy) return
      busy = true
      try {
        const res = await fetch('/api/follow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entityId, slug: entitySlug }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        const data = await res.json()

        followBtn.style.display = 'none'
        if (notifTrigger) notifTrigger.style.display = ''
        updateCounter(data.followers_count ?? 0)
      } catch (err) {
        console.error('[follow]', err)
      } finally {
        busy = false
      }
    })

    unfollowBtn?.addEventListener('click', async () => {
      if (busy) return
      busy = true
      try {
        const res = await fetch('/api/unfollow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entityId, slug: entitySlug }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        const data = await res.json()

        const notifMenu = document.querySelector<HTMLElement>(`[id="notif-menu-${entityId}"]`)
        if (notifMenu && 'hidePopover' in notifMenu) {
          (notifMenu as HTMLElement & { hidePopover: () => void }).hidePopover()
        }

        if (notifTrigger) notifTrigger.style.display = 'none'
        if (followBtn) followBtn.style.display = ''
        updateCounter(data.followers_count ?? 0)

        notifOptions.forEach(o => o.classList.remove('notif-menu-item--active'))
        document.querySelector('[data-notif-option="all"]')?.classList.add('notif-menu-item--active')
      } catch (err) {
        console.error('[unfollow]', err)
      } finally {
        busy = false
      }
    })
  }
</script>
