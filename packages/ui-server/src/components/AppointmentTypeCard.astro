---
import { Clock, MapPin, Video, Phone } from 'lucide-static'

interface Props {
  id: string
  title: string
  slug: string
  description: string | null
  durationMinutes: number
  locationType: string
  priceCents: number | null
  currency: string
  entitySlug: string
}

const { id, title, slug, description, durationMinutes, locationType, priceCents, currency, entitySlug } = Astro.props

const locationIcons: Record<string, { icon: string; label: string }> = {
  video: { icon: Video, label: 'Visioconférence' },
  in_person: { icon: MapPin, label: 'Sur place' },
  phone: { icon: Phone, label: 'Téléphone' },
}

const loc = locationIcons[locationType] ?? locationIcons.video

function formatPrice(cents: number | null, curr: string) {
  if (cents === null || cents === 0) return 'Gratuit'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: curr }).format(cents / 100)
}
---
<a
  href={`/${entitySlug}/services/${slug}`}
  class="group block rounded-xl border border-neutral-200 bg-neutral-0 p-5 transition hover:border-accent hover:shadow-sm"
  data-appointment-type={id}
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <h3 class="text-base font-semibold text-neutral-900 group-hover:text-accent transition-colors">{title}</h3>
      {description && (
        <p class="mt-1 text-sm text-neutral-500 line-clamp-2">{description}</p>
      )}
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-neutral-400">
        <span class="inline-flex items-center gap-1">
          <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={Clock} />
          {durationMinutes} min
        </span>
        <span class="inline-flex items-center gap-1">
          <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={loc.icon} />
          {loc.label}
        </span>
      </div>
    </div>
    <div class="shrink-0 text-right">
      <span class="text-base font-semibold text-neutral-900">{formatPrice(priceCents, currency)}</span>
    </div>
  </div>
</a>
