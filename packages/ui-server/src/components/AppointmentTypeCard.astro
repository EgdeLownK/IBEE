---
import { Clock, MapPin, Video, Phone, CalendarClock } from 'lucide-static'

interface Props {
  id: string
  title: string
  slug: string
  description: string | null
  durationMinutes: number
  locationType: string
  priceCents: number | null
  /** Prix promo (barré) — toujours < priceCents (CHECK DB). */
  promoPriceCents?: number | null
  currency: string
  /** Image de couverture (gallery_images[0]) — placeholder icône sinon. */
  coverImageUrl?: string | null
  entitySlug: string
  /** URL d'édition dashboard — si fournie (owner), affiche "Modifier" au lieu de "Réserver". */
  editHref?: string | null
}

const {
  id,
  title,
  slug,
  description,
  durationMinutes,
  locationType,
  priceCents,
  promoPriceCents = null,
  currency,
  coverImageUrl = null,
  entitySlug,
  editHref = null,
} = Astro.props

const locationIcons: Record<string, { icon: string; label: string }> = {
  video: { icon: Video, label: 'Visio' },
  in_person: { icon: MapPin, label: 'Sur place' },
  phone: { icon: Phone, label: 'Téléphone' },
}

const loc = locationIcons[locationType] ?? locationIcons.video

function formatPrice(cents: number | null, curr: string) {
  if (cents === null || cents === 0) return '0€'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: curr }).format(cents / 100)
}

const isFree = priceCents === null || priceCents === 0
const hasPromo = !isFree && promoPriceCents != null && promoPriceCents > 0
---
<div class="row" data-appointment-type={id}>
  {/* Lien étiré : toute la carte mène à la fiche service (sauf actions au-dessus) */}
  <a href={`/${entitySlug}/services/${slug}`} class="row__stretch" aria-label={title}></a>

  {/* Vignette (cover de la galerie, placeholder icône sinon) */}
  <div class="row__thumb">
    {coverImageUrl ? (
      <img src={coverImageUrl} alt={title} loading="lazy" />
    ) : (
      <span class="flex h-[26px] w-[26px] items-center justify-center" set:html={CalendarClock} />
    )}
  </div>

  {/* Contenu */}
  <div class="row__content min-w-0 flex-1">
    <h3 class="row__title m-0">{title}</h3>
    {description && <div class="row__desc">{description}</div>}
    <div class="row__metaline">
      <span class="metachip">
        <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={Clock} />
        {durationMinutes} min
      </span>
      <span class="metachip">
        <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={loc.icon} />
        {loc.label}
      </span>
    </div>
  </div>

  {/* Prix + CTA */}
  <div class="row__right">
    {hasPromo ? (
      <span class="flex items-baseline gap-1.5">
        <span class="price-tag sale">{formatPrice(promoPriceCents, currency)}</span>
        <s class="text-xs text-neutral-400">{formatPrice(priceCents, currency)}</s>
      </span>
    ) : (
      <span class="price-tag">{formatPrice(priceCents, currency)}</span>
    )}
    {editHref ? (
      <a href={editHref} class="row__edit pill pill--accent">Modifier</a>
    ) : (
      <span class="pill pill--accent">Réserver</span>
    )}
  </div>
</div>

<style>
  .row { position: relative; }
  .row__stretch {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .row__thumb,
  .row__content,
  .row__right {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  /* Le bouton Modifier reste cliquable au-dessus du lien étiré */
  .row__edit {
    pointer-events: auto;
    position: relative;
    z-index: 2;
  }
</style>
