---
import { House, ShoppingBag, CalendarDays, Zap, Newspaper, BookOpen, MessageCircleQuestion } from 'lucide-static'

interface Section {
  type: string
  is_configured?: boolean | null
}

interface Props {
  sections: Section[]
  activeType?: string
  isOwner?: boolean
  hasFaq?: boolean
  /** Préfixe des liens (ex : "/slug" depuis une page produit). Vide = ancres
      locales "#type" gérées par le script de tab-switching du profil. */
  baseHref?: string
}

const { sections, activeType = 'home', hasFaq = false, baseHref = '' } = Astro.props

// 7 types canoniques (sans "Informations" qui devient une page dédiée /:slug/informations).
// La gestion activation/désactivation des sections vit dans le menu
// « Ajouter contenu » du hero (owner) — plus de bouton "+" ici.
const labels: Record<string, string> = {
  home: 'Accueil',
  shop: 'Shop',
  appointments: 'Service',
  events: 'Event',
  news: 'News',
  history: 'Histoire',
  faq: 'FAQ',
}

const allTypes = ['home', 'shop', 'appointments', 'events', 'news', 'history', 'faq'] as const

// Icônes par type
const icons: Record<string, string> = {
  home: House,
  shop: ShoppingBag,
  appointments: CalendarDays,
  events: Zap,
  news: Newspaper,
  history: BookOpen,
  faq: MessageCircleQuestion,
}

const activeTypes = new Set<string>(sections.map(s => s.type))
// La section "home" est implicite — toujours présente sur tout profile
activeTypes.add('home')
if (hasFaq) activeTypes.add('faq')

const visibleTabs = allTypes
  .filter(t => activeTypes.has(t))
  .map(type => ({
    type,
    label: labels[type] ?? type,
    icon: icons[type],
  }))
---
{/* Tabs icône + texte, alignés à gauche, scroll horizontal si dépassement
    (même pattern que les stories). L'onglet actif est signalé par sa couleur.
    Pas de sticky : le profil vit sous le header global de l'app. */}
<nav aria-label="Navigation du profil" class="profile-tabs-wrap">
  <div class="segtabs no-scrollbar">
    {visibleTabs.map((tab) => {
      const isActive = tab.type === activeType
      return (
        <a
          href={`${baseHref}#${tab.type}`}
          data-section-tab={tab.type}
          class:list={['segtab', isActive && 'is-active']}
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={tab.icon} />
          <span>{tab.label}</span>
        </a>
      )
    })}
  </div>
</nav>

<style>
  /* Le padding horizontal vit sur .segtabs (élément scrollable) pour que
     le dernier onglet ne soit pas coupé en fin de scroll. */
  .profile-tabs-wrap {
    padding: 20px 0 16px;
  }
</style>
