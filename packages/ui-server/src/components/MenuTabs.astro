---
import { Home, Newspaper, CalendarClock, Calendar, ShoppingBag, Video, Link } from 'lucide-static'

interface Props {
  sections: Array<{ type: string }>
  activeType?: string
}

const { sections, activeType = 'news' } = Astro.props

const config: Record<string, { label: string; icon: string }> = {
  home: { label: 'Accueil', icon: Home },
  news: { label: 'News', icon: Newspaper },
  events: { label: 'Calendrier', icon: Calendar },
  videos: { label: 'Vidéo', icon: Video },
  shop: { label: 'Boutique', icon: ShoppingBag },
  appointments: { label: 'Rendez-vous', icon: CalendarClock },
  links: { label: 'Liens', icon: Link },
}
---
{sections.length > 0 && (
  <nav aria-label="Navigation du profil" class="border-b border-neutral-200 px-6 sm:px-12">
    <ul class="flex gap-8 overflow-x-auto -mb-px">
      {sections.map((section) => {
        const c = config[section.type]
        const isActive = section.type === activeType
        return (
          <li>
            <a
              href={`#${section.type}`}
              class:list={[
                'flex items-center gap-2 whitespace-nowrap border-b-2 py-3 text-sm font-medium transition-colors',
                isActive
                  ? 'border-accent text-accent'
                  : 'border-transparent text-neutral-400 hover:text-neutral-900',
              ]}
            >
              {c && <span class="flex h-4 w-4 shrink-0 items-center justify-center" set:html={c.icon} />}
              <span>{c?.label ?? section.type}</span>
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
)}
