---
import { House, ShoppingBag, CalendarDays, Zap, Newspaper, BookOpen } from 'lucide-static'

interface Section {
  type: string
  is_configured?: boolean | null
}

interface Props {
  sections: Section[]
  activeType?: string
  /** Préfixe des liens (ex : "/slug" depuis une page produit). Vide = ancres locales. */
  baseHref?: string
}

const { sections, activeType = 'home', baseHref = '' } = Astro.props

const labels: Record<string, string> = {
  home: 'Accueil',
  shop: 'Shop',
  appointments: 'Service',
  events: 'Event',
  news: 'News',
  history: 'Histoire',
}

const allTypes = ['home', 'shop', 'appointments', 'events', 'news', 'history'] as const

const icons: Record<string, string> = {
  home: House,
  shop: ShoppingBag,
  appointments: CalendarDays,
  events: Zap,
  news: Newspaper,
  history: BookOpen,
}

const activeTypes = new Set<string>(sections.map((s) => s.type))
activeTypes.add('home')

const visibleTabs = allTypes
  .filter((t) => activeTypes.has(t))
  .map((type) => ({
    type,
    label: labels[type] ?? type,
    icon: icons[type],
  }))
---
<nav aria-label="Navigation du profil" class="profile-tabs-wrap" data-profile-tabs>
  <div class="segtabs no-scrollbar" data-profile-tabs-track>
    {visibleTabs.map((tab) => {
      const isActive = tab.type === activeType
      return (
        <a
          href={`${baseHref}#${tab.type}`}
          data-section-tab={tab.type}
          class:list={['segtab', isActive && 'is-active']}
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={tab.icon} />
          <span>{tab.label}</span>
        </a>
      )
    })}
  </div>
</nav>

