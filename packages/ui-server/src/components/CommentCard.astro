---
import { formatDistanceToNow } from 'date-fns'
import { fr } from 'date-fns/locale'

interface Props {
  id: string
  content: string
  createdAt: string
  authorDisplayName: string
  authorAvatarUrl: string | null
  authorSlug: string
  canDelete?: boolean
  entitySlug: string
  publicationSlug: string
}

const { id, content, createdAt, authorDisplayName, authorAvatarUrl, authorSlug, canDelete = false, entitySlug, publicationSlug } = Astro.props

const timeAgo = formatDistanceToNow(new Date(createdAt), { addSuffix: true, locale: fr })
const initial = authorDisplayName.charAt(0).toUpperCase()
---
<article class="flex gap-3 py-4" id={`comment-${id}`}>
  <a href={`/${authorSlug}`} class="flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-accent-soft">
    {authorAvatarUrl ? (
      <img src={authorAvatarUrl} alt={authorDisplayName} class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <span class="text-xs font-semibold text-accent">{initial}</span>
    )}
  </a>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <a href={`/${authorSlug}`} class="text-sm font-medium text-neutral-900 hover:text-accent transition-colors">{authorDisplayName}</a>
      <time datetime={createdAt} class="text-xs text-neutral-400">{timeAgo}</time>
    </div>
    <p class="mt-1 text-sm leading-relaxed text-neutral-600 whitespace-pre-wrap break-words">{content}</p>
    {canDelete && (
      <button
        type="button"
        data-delete-comment={id}
        data-entity-slug={entitySlug}
        data-publication-slug={publicationSlug}
        class="mt-1 text-xs text-neutral-400 hover:text-error transition-colors"
        aria-label="Supprimer ce commentaire"
      >
        Supprimer
      </button>
    )}
  </div>
</article>
