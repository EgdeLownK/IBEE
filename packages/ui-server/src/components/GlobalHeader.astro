---
import { Menu, ChevronDown, Sun, Bell, UserCircle, LogOut, BookOpen } from 'lucide-static'
import { format, formatDistanceToNow } from 'date-fns'
import { fr } from 'date-fns/locale'

interface NotificationData {
  id: string
  type: string
  read_at: string | null
  created_at: string
  target_publication_id: string | null
  actor_entity: { id: string; display_name: string; avatar_url: string | null; slug: string } | null
  target_publication: { slug: string } | null
}

interface Props {
  projectLabel?: string | null
  profileUrl?: string
  avatarUrl?: string | null
  displayName?: string | null
  dashboardUrl: string
  isAuthenticated: boolean
  unreadCount?: number
  notifications?: NotificationData[]
  currentUserSlug?: string | null
}

const {
  projectLabel,
  avatarUrl,
  displayName,
  dashboardUrl,
  isAuthenticated,
  unreadCount = 0,
  notifications = [],
  currentUserSlug,
} = Astro.props

const initial = displayName ? displayName.charAt(0).toUpperCase() : '?'
const avatarMenuId = 'header-avatar-menu'
const notifPopoverId = 'header-notif-popover'

function formatBadge(n: number): string {
  if (n > 99) return '99+'
  return String(n)
}

function formatNotifDate(dateStr: string): string {
  const date = new Date(dateStr)
  const now = new Date()
  const diffMs = now.getTime() - date.getTime()
  const sevenDays = 7 * 24 * 60 * 60 * 1000
  if (diffMs < sevenDays) {
    return formatDistanceToNow(date, { addSuffix: true, locale: fr })
  }
  return format(date, 'd MMMM', { locale: fr })
}

function getNotifText(n: NotificationData): string {
  const name = n.actor_entity?.display_name ?? 'Quelqu\'un'
  if (n.type === 'new_follower') return `${name} vous suit`
  if (n.type === 'new_publication') return `${name} a publié une news`
  return `${name} a interagi`
}

function getNotifUrl(n: NotificationData): string {
  if (n.type === 'new_follower' && n.actor_entity) return `/${n.actor_entity.slug}`
  if (n.type === 'new_publication' && n.actor_entity && n.target_publication?.slug) {
    return `/${n.actor_entity.slug}/news/${n.target_publication.slug}`
  }
  return '#'
}
---
<header class="app-header">
  {/* Gauche — Hamburger mobile + Project label */}
  <div class="flex items-center gap-2">
    <button
      type="button"
      onclick="document.documentElement.setAttribute('data-drawer-open', document.documentElement.getAttribute('data-drawer-open') === 'true' ? 'false' : 'true')"
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-600 transition hover:bg-panel md:hidden"
      aria-label="Ouvrir le menu"
    >
      <span class="flex h-5 w-5 items-center justify-center" set:html={Menu} />
    </button>

    {projectLabel && (
      <div class="app-header__project hidden md:flex">
        <span class="truncate max-w-[200px]">{projectLabel}</span>
        <span class="flex h-4 w-4 items-center justify-center text-neutral-500" set:html={ChevronDown} />
      </div>
    )}
  </div>

  {/* Centre absolu — Brand IBEE */}
  <a href="/" class="app-header__brand" aria-label="Accueil IBEE">
    IBEE<sup>v0.4</sup>
  </a>

  {/* Droite — météo + heure + notif + avatar */}
  <div class="app-header__right">
    {/* Météo (placeholder décoratif) */}
    <div class="app-header__weather hidden md:inline-flex" aria-label="Météo">
      <span class="flex h-4 w-4 items-center justify-center" set:html={Sun} />
      <span class="app-header__weather-temp">21°</span>
    </div>

    {/* Heure — JS auto-update */}
    <span class="app-header__time hidden md:inline" data-clock>--:--</span>

    {isAuthenticated && (
      <>
        {/* Notif mobile : lien direct */}
        <a
          href="/notifications"
          class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-600 transition hover:bg-panel md:hidden"
          aria-label="Notifications"
        >
          <span class="flex h-5 w-5 items-center justify-center" set:html={Bell} />
          {unreadCount > 0 && (
            <span class="absolute -top-0.5 -right-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold text-white">
              {formatBadge(unreadCount)}
            </span>
          )}
        </a>
        {/* Notif desktop : popover */}
        <button
          type="button"
          popovertarget={notifPopoverId}
          style={`anchor-name: --${notifPopoverId};`}
          class="relative hidden h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-600 transition hover:bg-panel md:flex"
          aria-label="Notifications"
        >
          <span class="flex h-5 w-5 items-center justify-center" set:html={Bell} />
          {unreadCount > 0 && (
            <span class="absolute -top-0.5 -right-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold text-white">
              {formatBadge(unreadCount)}
            </span>
          )}
        </button>

        <div id={notifPopoverId} popover="auto" class="notif-popover" style={`position-anchor: --${notifPopoverId};`}>
          <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-100">
            <h2 class="text-base font-semibold text-neutral-900">Notifications</h2>
            {unreadCount > 0 && (
              <button type="button" data-mark-all-read class="text-xs font-medium uppercase tracking-wide text-accent transition hover:text-accent-hover">
                Tout marquer lu
              </button>
            )}
          </div>

          {notifications.length === 0 ? (
            <div class="flex flex-col items-center gap-2 px-4 py-8 text-center">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-panel-2 text-neutral-400" set:html={Bell} />
              <p class="text-sm text-neutral-400">Pas de notifications</p>
            </div>
          ) : (
            <div class="max-h-[400px] overflow-y-auto">
              {notifications.map((n) => {
                const actorInitial = n.actor_entity?.display_name?.charAt(0).toUpperCase() ?? '?'
                return (
                  <a
                    href={getNotifUrl(n)}
                    data-notif-id={n.id}
                    data-notif-read={n.read_at ? 'true' : 'false'}
                    class="notif-item flex items-center gap-3 px-4 py-3 transition hover:bg-panel"
                  >
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-accent-soft">
                      {n.actor_entity?.avatar_url ? (
                        <img src={n.actor_entity.avatar_url} alt="" class="h-full w-full object-cover" />
                      ) : (
                        <span class="text-sm font-semibold text-accent">{actorInitial}</span>
                      )}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm text-neutral-900 truncate">{getNotifText(n)}</p>
                      <p class="text-xs text-neutral-400">{formatNotifDate(n.created_at)}</p>
                    </div>
                    {!n.read_at && (
                      <span class="h-2 w-2 shrink-0 rounded-full bg-accent" />
                    )}
                  </a>
                )
              })}
            </div>
          )}

          {notifications.length > 0 && (
            <div class="border-t border-neutral-100 px-4 py-2.5 text-center">
              <a href="/notifications" class="text-xs font-medium text-accent transition hover:text-accent-hover">
                Afficher tout
              </a>
            </div>
          )}
        </div>

        {/* Avatar menu */}
        <button
          type="button"
          popovertarget={avatarMenuId}
          style={`anchor-name: --${avatarMenuId};`}
          class="app-header__avatar"
          aria-label="Mon compte"
        >
          {avatarUrl ? (
            <img src={avatarUrl} alt={displayName ?? ''} class="h-full w-full object-cover rounded-full" />
          ) : (
            <span class="flex h-full w-full items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">
              {initial}
            </span>
          )}
        </button>

        <div id={avatarMenuId} popover="auto" class="app-menu" style={`position-anchor: --${avatarMenuId};`}>
          {/* Profile header — avatar + nom + handle */}
          <div class="app-menu__profile">
            <div class="app-menu__avatar">
              {avatarUrl ? (
                <img src={avatarUrl} alt={displayName ?? ''} class="h-full w-full rounded-full object-cover" />
              ) : (
                <span class="flex h-full w-full items-center justify-center rounded-full bg-accent-soft text-base font-semibold text-accent">
                  {initial}
                </span>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <p class="app-menu__name truncate">{displayName ?? 'Mon compte'}</p>
              {currentUserSlug && (
                <p class="app-menu__handle truncate text-xs text-neutral-500">@{currentUserSlug}</p>
              )}
            </div>
          </div>

          <hr class="app-menu__divider" />

          {currentUserSlug && (
            <a href={`/${currentUserSlug}`} class="app-menu__item">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={UserCircle} />
              <span>Voir mon profil</span>
            </a>
          )}
          <a href="/explore" class="app-menu__item app-menu__item--soft">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={BookOpen} />
            <span>Explorer</span>
          </a>

          <hr class="app-menu__divider" />

          <form method="post" action="/api/auth/logout">
            <button type="submit" class="app-menu__item app-menu__item--soft w-full text-left">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={LogOut} />
              <span>Se déconnecter</span>
            </button>
          </form>
        </div>
      </>
    )}

    {!isAuthenticated && (
      <a
        href={`${dashboardUrl}/login`}
        class="inline-flex items-center rounded-full border border-neutral-200 bg-surface px-4 py-1.5 text-sm font-medium text-neutral-900 transition-colors hover:bg-panel-2"
      >
        Se connecter
      </a>
    )}
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    height: 65px;
    padding: 0 24px;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .app-header__project {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    color: var(--color-neutral-900);
    cursor: pointer;
  }

  .app-header__brand {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.02em;
    color: var(--color-neutral-900);
    text-decoration: none;
  }
  .app-header__brand sup {
    font-size: 11px;
    color: var(--color-neutral-500);
    font-weight: 500;
    margin-left: 4px;
    vertical-align: super;
  }

  .app-header__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .app-header__weather {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-neutral-500);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-panel);
    cursor: default;
  }
  .app-header__weather-temp {
    font-variant-numeric: tabular-nums;
    color: var(--color-neutral-900);
  }

  .app-header__time {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--color-neutral-500);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .app-header__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-panel-2);
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 160ms ease, transform 80ms ease;
    overflow: hidden;
  }
  .app-header__avatar:hover { border-color: var(--color-accent); }
  .app-header__avatar:active { transform: scale(0.96); }

  .app-menu, .notif-popover {
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: 14px;
    box-shadow: var(--shadow-pop);
    margin: 0;
    margin-top: 10px;
    overflow: visible;
    position-area: bottom span-left;
    position-try-fallbacks: flip-block;
  }
  .app-menu::backdrop, .notif-popover::backdrop {
    background: transparent;
  }
  .app-menu { width: 260px; padding: 8px; }
  .notif-popover {
    width: calc(100vw - 2rem);
    max-width: 400px;
    padding: 0;
    overflow: hidden;
  }

  .app-menu__profile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px 12px;
  }
  .app-menu__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-panel-2);
    flex-shrink: 0;
  }
  .app-menu__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-neutral-900);
    margin: 0;
  }
  .app-menu__handle {
    font-family: var(--font-mono);
    margin: 0;
  }
  .app-menu__divider {
    height: 1px;
    background: var(--color-border-soft);
    border: 0;
    margin: 4px 0;
  }
  .app-menu__item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--color-neutral-900);
    cursor: pointer;
    transition: background 120ms ease;
    text-decoration: none;
    background: transparent;
    border: none;
    font-family: inherit;
  }
  .app-menu__item:hover { background: var(--color-panel); }
  .app-menu__item--soft { color: var(--color-neutral-500); }

  .notif-item { text-decoration: none; }
</style>

<script is:inline>
  // Clock — update every minute
  (function() {
    var el = document.querySelector('[data-clock]')
    if (!el) return
    function tick() {
      var d = new Date()
      var h = String(d.getHours()).padStart(2, '0')
      var m = String(d.getMinutes()).padStart(2, '0')
      el.textContent = h + ':' + m
    }
    tick()
    setInterval(tick, 30000)
  })()

  // Mark all read
  document.querySelector('[data-mark-all-read]')?.addEventListener('click', function() {
    fetch('/api/notifications/mark-all-read', { method: 'POST' }).then(function() {
      document.querySelectorAll('.notif-item').forEach(function(el) {
        var dot = el.querySelector('.shrink-0.rounded-full.bg-accent')
        if (dot) dot.remove()
      })
      var badge = document.querySelector('[aria-label="Notifications"] .bg-accent')
      if (badge) badge.remove()
      var markBtn = document.querySelector('[data-mark-all-read]')
      if (markBtn) markBtn.remove()
    }).catch(function(err) { console.error('[mark-all]', err) })
  })

  // Mark individual as read on click
  document.querySelectorAll('.notif-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var id = item.dataset.notifId
      if (id) {
        fetch('/api/notifications/mark-read', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notificationId: id }),
        }).catch(function() {})
      }
    })
  })
</script>
