---
import { Menu, Link2, Clipboard, Check, Bell, UserCircle, Shield, HelpCircle, Settings } from 'lucide-static'
import { format, formatDistanceToNow } from 'date-fns'
import { fr } from 'date-fns/locale'

interface NotificationData {
  id: string
  type: string
  read_at: string | null
  created_at: string
  target_publication_id: string | null
  actor_entity: { id: string; display_name: string; avatar_url: string | null; slug: string } | null
  target_publication: { slug: string } | null
}

interface Props {
  profileUrl?: string
  avatarUrl?: string | null
  displayName?: string | null
  dashboardUrl: string
  isAuthenticated: boolean
  unreadCount?: number
  notifications?: NotificationData[]
}

const { profileUrl, avatarUrl, displayName, dashboardUrl, isAuthenticated, unreadCount = 0, notifications = [] } = Astro.props

const displayUrl = profileUrl ? profileUrl.replace(/^https?:\/\//, '') : null
const initial = displayName ? displayName.charAt(0).toUpperCase() : '?'
const avatarMenuId = 'header-avatar-menu'
const notifPopoverId = 'header-notif-popover'

function formatBadge(n: number): string {
  if (n > 99) return '99+'
  return String(n)
}

function formatNotifDate(dateStr: string): string {
  const date = new Date(dateStr)
  const now = new Date()
  const diffMs = now.getTime() - date.getTime()
  const sevenDays = 7 * 24 * 60 * 60 * 1000
  if (diffMs < sevenDays) {
    return formatDistanceToNow(date, { addSuffix: true, locale: fr })
  }
  return format(date, 'd MMMM', { locale: fr })
}

function getNotifText(n: NotificationData): string {
  const name = n.actor_entity?.display_name ?? 'Quelqu\'un'
  if (n.type === 'new_follower') return `${name} vous suit`
  if (n.type === 'new_publication') return `${name} a publié une news`
  return `${name} a interagi`
}

function getNotifUrl(n: NotificationData): string {
  if (n.type === 'new_follower' && n.actor_entity) return `/${n.actor_entity.slug}`
  if (n.type === 'new_publication' && n.actor_entity && n.target_publication?.slug) {
    return `/${n.actor_entity.slug}/news/${n.target_publication.slug}`
  }
  return '#'
}
---
<header class="sticky top-0 z-20 flex h-14 shrink-0 items-center justify-between border-b border-neutral-200 bg-neutral-0 px-4">
  {/* Gauche — Hamburger (mobile) + URL profil (desktop) */}
  <div class="flex items-center gap-2">
    {/* Hamburger — mobile only */}
    <button
      type="button"
      onclick="document.documentElement.setAttribute('data-drawer-open', document.documentElement.getAttribute('data-drawer-open') === 'true' ? 'false' : 'true')"
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-600 transition hover:bg-neutral-100 md:hidden"
      aria-label="Ouvrir le menu"
    >
      <span class="flex h-5 w-5 items-center justify-center" set:html={Menu} />
    </button>

    {/* Copy URL — mobile: pill button, desktop: URL + icon */}
    {displayUrl && (
      <>
        {/* Mobile — pill "Copier l'URL" */}
        <button
          type="button"
          data-copy-url={profileUrl}
          class="flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1.5 text-xs font-medium text-neutral-600 transition-colors hover:bg-neutral-200 md:hidden"
          aria-label="Copier l'URL de mon profil public"
        >
          <span class="flex h-4 w-4 shrink-0 items-center justify-center" data-copy-icon-mobile set:html={Link2} />
          <span data-copy-label-mobile>Copier l'URL</span>
        </button>

        {/* Desktop — URL + copy button */}
        <div class="hidden items-center gap-2 md:flex">
          <a href={profileUrl} class="truncate max-w-[300px] text-sm text-neutral-600 transition-colors hover:text-neutral-900">
            {displayUrl}
          </a>
          <button
            type="button"
            data-copy-url={profileUrl}
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-600"
            aria-label="Copier l'URL"
          >
            <span class="flex h-4 w-4 items-center justify-center" data-copy-icon set:html={Clipboard} />
          </button>
        </div>
      </>
    )}
  </div>

  {/* Droite — Cloche + Avatar */}
  <div class="flex items-center gap-2">
    {isAuthenticated && (
      <>
        {/* Paramètres — lien à définir */}
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-400 cursor-default"
          aria-label="Paramètres"
          title="Paramètres"
        >
          <span class="flex h-5 w-5 items-center justify-center" set:html={Settings} />
        </span>

        {/* Notification bell — mobile: link, desktop: popover trigger */}
        <a
          href="/notifications"
          class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-600 transition hover:bg-neutral-100 md:hidden"
          aria-label="Notifications"
        >
          <span class="flex h-5 w-5 items-center justify-center" set:html={Bell} />
          {unreadCount > 0 && (
            <span class="absolute -top-0.5 -right-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold text-white">
              {formatBadge(unreadCount)}
            </span>
          )}
        </a>
        <button
          type="button"
          popovertarget={notifPopoverId}
          style={`anchor-name: --${notifPopoverId};`}
          class="relative hidden h-9 w-9 shrink-0 items-center justify-center rounded-full text-neutral-600 transition hover:bg-neutral-100 md:flex"
          aria-label="Notifications"
        >
          <span class="flex h-5 w-5 items-center justify-center" set:html={Bell} />
          {unreadCount > 0 && (
            <span class="absolute -top-0.5 -right-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold text-white">
              {formatBadge(unreadCount)}
            </span>
          )}
        </button>

        {/* Notifications popover */}
        <div id={notifPopoverId} popover="auto" class="notif-popover" style={`position-anchor: --${notifPopoverId};`}>
          <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-100">
            <h2 class="text-base font-semibold text-neutral-900">Notifications</h2>
            {unreadCount > 0 && (
              <button type="button" data-mark-all-read class="text-xs font-medium uppercase tracking-wide text-accent transition hover:text-accent-hover">
                Tout marquer lu
              </button>
            )}
          </div>

          {notifications.length === 0 ? (
            <div class="flex flex-col items-center gap-2 px-4 py-8 text-center">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-100 text-neutral-400" set:html={Bell} />
              <p class="text-sm text-neutral-400">Pas de notifications</p>
            </div>
          ) : (
            <div class="max-h-[400px] overflow-y-auto">
              {notifications.map((n) => {
                const actorInitial = n.actor_entity?.display_name?.charAt(0).toUpperCase() ?? '?'
                return (
                  <a
                    href={getNotifUrl(n)}
                    data-notif-id={n.id}
                    data-notif-read={n.read_at ? 'true' : 'false'}
                    class="notif-item flex items-center gap-3 px-4 py-3 transition hover:bg-neutral-50"
                  >
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-accent-soft">
                      {n.actor_entity?.avatar_url ? (
                        <img src={n.actor_entity.avatar_url} alt="" class="h-full w-full object-cover" />
                      ) : (
                        <span class="text-sm font-semibold text-accent">{actorInitial}</span>
                      )}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm text-neutral-900 truncate">{getNotifText(n)}</p>
                      <p class="text-xs text-neutral-400">{formatNotifDate(n.created_at)}</p>
                    </div>
                    {!n.read_at && (
                      <span class="h-2 w-2 shrink-0 rounded-full bg-accent" />
                    )}
                  </a>
                )
              })}
            </div>
          )}

          {notifications.length > 0 && (
            <div class="border-t border-neutral-100 px-4 py-2.5 text-center">
              <a href="/notifications" class="text-xs font-medium text-accent transition hover:text-accent-hover">
                Afficher tout
              </a>
            </div>
          )}
        </div>

        {/* Avatar menu button */}
        <button
          type="button"
          popovertarget={avatarMenuId}
          style={`anchor-name: --${avatarMenuId};`}
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full overflow-hidden transition hover:ring-2 hover:ring-neutral-200"
        >
          {avatarUrl ? (
            <img src={avatarUrl} alt={displayName ?? ''} class="h-full w-full object-cover" />
          ) : (
            <span class="flex h-full w-full items-center justify-center bg-accent-soft text-sm font-semibold text-accent">
              {initial}
            </span>
          )}
        </button>

        <div id={avatarMenuId} popover="auto" class="avatar-menu" style={`position-anchor: --${avatarMenuId};`}>
          <a href={`${dashboardUrl}/account`} class="avatar-menu-item">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={UserCircle} />
            <span>Mon compte</span>
          </a>
          <div class="avatar-menu-item avatar-menu-item--disabled">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={Shield} />
            <span class="flex-1">Confidentialité</span>
            <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-400">Bientôt</span>
          </div>
          <div class="avatar-menu-item avatar-menu-item--disabled">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={HelpCircle} />
            <span class="flex-1">Aide</span>
            <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-400">Bientôt</span>
          </div>
        </div>
      </>
    )}
  </div>
</header>

<style>
  .avatar-menu, .notif-popover {
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    margin: 0;
    margin-top: 4px;
    overflow: visible;
    position-area: bottom span-left;
    position-try-fallbacks: flip-block;
  }

  .avatar-menu::backdrop, .notif-popover::backdrop {
    background: transparent;
  }

  .avatar-menu { width: 220px; padding: 6px; }
  .notif-popover { width: calc(100vw - 2rem); max-width: 400px; padding: 0; overflow: hidden; }

  .avatar-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-neutral-600);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .avatar-menu-item:hover { background: var(--color-neutral-50); }
  .avatar-menu-item--disabled { color: var(--color-neutral-400); cursor: not-allowed; }
  .avatar-menu-item--disabled:hover { background: transparent; }

  .notif-item { text-decoration: none; }
</style>

<script is:inline>
  // Copy URL (all buttons with data-copy-url)
  var checkSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
  document.querySelectorAll('[data-copy-url]').forEach(function(btn) {
    var url = btn.dataset.copyUrl
    var iconEl = btn.querySelector('[data-copy-icon], [data-copy-icon-mobile]')
    var labelEl = btn.querySelector('[data-copy-label-mobile]')
    var originalSvg = iconEl ? iconEl.innerHTML : ''
    btn.addEventListener('click', function() {
      navigator.clipboard.writeText(url).then(function() {
        if (iconEl) {
          iconEl.innerHTML = checkSvg
          setTimeout(function() { iconEl.innerHTML = originalSvg }, 2000)
        }
        if (labelEl) {
          labelEl.textContent = 'URL copiée !'
          setTimeout(function() { labelEl.textContent = 'Copier l\'URL' }, 2000)
        }
      }).catch(function(err) { console.error('[copy]', err) })
    })
  })

  // Mark all read
  document.querySelector('[data-mark-all-read]')?.addEventListener('click', function() {
    fetch('/api/notifications/mark-all-read', { method: 'POST' }).then(function() {
      document.querySelectorAll('.notif-item').forEach(function(el) {
        var dot = el.querySelector('.shrink-0.rounded-full.bg-accent')
        if (dot) dot.remove()
      })
      var badge = document.querySelector('[aria-label="Notifications"] .bg-accent')
      if (badge) badge.remove()
      var markBtn = document.querySelector('[data-mark-all-read]')
      if (markBtn) markBtn.remove()
    }).catch(function(err) { console.error('[mark-all]', err) })
  })

  // Mark individual as read on click
  document.querySelectorAll('.notif-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var id = item.dataset.notifId
      if (id) {
        fetch('/api/notifications/mark-read', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notificationId: id }),
        }).catch(function() {})
      }
    })
  })
</script>
