---
/** Accordéon FAQ (widget Accueil + section profil). */
import { ChevronDown } from 'lucide-static'

interface FaqItem {
  question: string
  answer: string
}

interface Props {
  items: FaqItem[]
  embedded?: boolean
}

const { items, embedded = false } = Astro.props

const faqSchema =
  items.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: items.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null
---
{faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

<section class:list={['faq-widget', embedded && 'faq-widget--embedded']}>
  {items.length > 0 ? (
    <div class="faq-widget__list">
      {items.map((item) => (
        <details class="faq">
          <summary>
            {item.question}
            <span class="flex h-4 w-4 shrink-0 items-center justify-center" set:html={ChevronDown} />
          </summary>
          <p class="whitespace-pre-wrap">{item.answer}</p>
        </details>
      ))}
    </div>
  ) : null}
</section>

<style>
  .faq-widget--embedded {
    margin: 0;
  }
  .faq-widget__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
