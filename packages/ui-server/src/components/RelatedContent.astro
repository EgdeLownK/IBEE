---
/** Carrousel générique de contenus mixtes (services / produits / events).
    Utilisé pour « Autres contenus du profil » et « À découvrir aussi ».
    En-tête avec « Voir plus », scroll horizontal (flèches desktop/tablette +
    glisser). Données mock pour l'instant ; les visuels utilisent le fond hachuré
    de la cover (aucune image externe). */
import { ChevronLeft, ChevronRight } from 'lucide-static'

type Kind = 'service' | 'product' | 'event'

interface RelatedItem {
  kind: Kind
  title: string
  meta: string
  href?: string
}

interface Props {
  title: string
  items: RelatedItem[]
  /** Lien du bouton « Voir plus ». */
  moreHref?: string
}

const { title, items, moreHref = '#' } = Astro.props

const kindLabel: Record<Kind, string> = {
  service: 'Service',
  product: 'Produit',
  event: 'Événement',
}
---
{items.length > 0 && (
  <section class="related">
    <div class="related__head">
      <h2 class="related__title">{title}</h2>
      <a href={moreHref} class="related__more">Voir plus</a>
    </div>

    <div class="related__carousel" data-related-carousel>
      <div class="related__track" data-related-track>
        {items.map((it) => {
          const Tag = it.href ? 'a' : 'article'
          return (
            <Tag class="related__card" href={it.href}>
              <div class="related__media" aria-hidden="true">
                <span class="related__badge">{kindLabel[it.kind]}</span>
              </div>
              <div class="related__body">
                <h3 class="related__name">{it.title}</h3>
                <p class="related__meta">{it.meta}</p>
              </div>
            </Tag>
          )
        })}
      </div>
      {items.length > 1 && (
        <>
          <button type="button" class="related__nav related__nav--prev" data-related-prev aria-label="Contenu précédent">
            <span class="flex items-center justify-center" set:html={ChevronLeft} />
          </button>
          <button type="button" class="related__nav related__nav--next" data-related-next aria-label="Contenu suivant">
            <span class="flex items-center justify-center" set:html={ChevronRight} />
          </button>
        </>
      )}
    </div>
  </section>
)}

<style>
  .related {
    margin-top: 26px;
  }
  .related__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 14px;
    padding: 0 22px;
  }
  .related__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }
  .related__more {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .related__more:hover {
    text-decoration: underline;
  }
  .related__carousel {
    position: relative;
  }
  .related__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 22px;
    padding: 0 22px 4px;
    scrollbar-width: none;
  }
  .related__track::-webkit-scrollbar {
    display: none;
  }
  .related__card {
    flex: 0 0 70%;
    max-width: 240px;
    scroll-snap-align: start;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-panel);
    text-decoration: none;
    color: inherit;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  a.related__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-pop, 0 8px 24px rgba(0, 0, 0, 0.08));
  }
  .related__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background-image: repeating-linear-gradient(
      135deg,
      var(--color-panel-2) 0,
      var(--color-panel-2) 4px,
      var(--color-panel) 4px,
      var(--color-panel) 10px
    );
  }
  .related__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-neutral-700);
  }
  .related__body {
    padding: 12px 14px 14px;
  }
  .related__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-neutral-900);
    line-height: 1.3;
  }
  .related__meta {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--color-neutral-500);
  }

  /* ===== Flèches de navigation (tablette + desktop), comme le carrousel d'images ===== */
  .related__nav {
    display: none;
  }
  @media (min-width: 768px) {
    .related__card {
      flex-basis: 220px;
    }
    .related__track {
      cursor: grab;
    }
    .related__track.is-grabbing {
      cursor: grabbing;
      scroll-behavior: auto;
      user-select: none;
    }
    .related__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(8px);
      color: var(--color-neutral-800);
      box-shadow: 0 6px 18px -10px rgba(0, 0, 0, .35);
      cursor: pointer;
      transition: background .16s ease, transform .08s ease, opacity .16s ease;
    }
    .related__nav :global(svg) {
      width: 20px;
      height: 20px;
    }
    .related__nav:hover {
      background: var(--color-surface);
    }
    .related__nav:active {
      transform: translateY(-50%) scale(.94);
    }
    .related__nav--prev {
      left: 30px;
    }
    .related__nav--next {
      right: 30px;
    }
    .related__nav[disabled] {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>

<script is:inline>
(function() {
  document.querySelectorAll('[data-related-carousel]').forEach(function(carousel) {
    if (carousel.dataset.relatedInit) return
    carousel.dataset.relatedInit = '1'

    var track = carousel.querySelector('[data-related-track]')
    if (!track) return
    var prevBtn = carousel.querySelector('[data-related-prev]')
    var nextBtn = carousel.querySelector('[data-related-next]')

    var slideStep = function() {
      var slide = track.querySelector('.related__card')
      var w = slide ? slide.getBoundingClientRect().width : track.clientWidth * 0.6
      return w + 14
    }
    var updateNav = function() {
      var max = track.scrollWidth - track.clientWidth
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 1
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= max - 1
    }
    if (prevBtn) prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -slideStep(), behavior: 'smooth' })
    })
    if (nextBtn) nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: slideStep(), behavior: 'smooth' })
    })
    track.addEventListener('scroll', updateNav)
    window.addEventListener('resize', updateNav)
    updateNav()

    var isDown = false, startX = 0, startScroll = 0
    track.addEventListener('pointerdown', function(e) {
      if (e.pointerType === 'touch') return
      isDown = true
      startX = e.clientX
      startScroll = track.scrollLeft
      track.style.scrollSnapType = 'none'
      track.classList.add('is-grabbing')
    })
    window.addEventListener('pointermove', function(e) {
      if (!isDown) return
      track.scrollLeft = startScroll - (e.clientX - startX)
    })
    var endDrag = function() {
      if (!isDown) return
      isDown = false
      track.style.scrollSnapType = ''
      track.classList.remove('is-grabbing')
    }
    window.addEventListener('pointerup', endDrag)
    window.addEventListener('pointercancel', endDrag)
    track.addEventListener('dragstart', function(e) { e.preventDefault() })
  })
})()
</script>
