---
/**
 * JSON-LD Schema.org Product pour la fiche produit.
 * Pilier SEO/GEO/AEO : rich snippets Google + citabilité LLM.
 *
 * - offers : Offer simple si prix unique, AggregateOffer si variantes multi-prix.
 * - availability : InStock / OutOfStock selon le stock.
 * - itemCondition : pour physical, mappé depuis physical_condition.
 * - aggregateRating + review[] : uniquement si avis publiés (count > 0).
 * - digital : additionalType DigitalDocument, reste sur type racine Product.
 */
type Variant = {
  id: string
  price_cents_override: number | null
  stock_quantity: number
}

interface ReviewSample {
  rating: number
  title: string | null
  content: string
  created_at: string
  authorName: string
}

interface Props {
  product: {
    title: string
    description_short: string
    description_long: string | null
    price_cents: number
    sale_price_cents: number | null
    currency: string
    type: 'digital' | 'physical'
    physical_condition: string | null
    physical_stock_quantity: number | null
    physical_stock_unlimited: boolean | null
  }
  productUrl: string
  images: string[]
  variants: Variant[]
  sellerName: string
  sellerUrl: string
  aggregates: { count: number; average: number }
  reviewSamples: ReviewSample[]
  /** Nom de catégorie résolu côté page (embed entity_product_categories ou legacy). null si non catégorisé. */
  categoryName: string | null
  /** Promo active calculée côté SSR (sale_price_cents valide ET non expirée). */
  saleActive: boolean
  /** Date de fin de promo ISO (priceValidUntil) si présente. */
  saleEndsAt: string | null
  /** Vidéo produit si présente dans les médias (exclue des images). */
  video: { url: string; name: string } | null
}

const {
  product,
  productUrl,
  images,
  variants,
  sellerName,
  sellerUrl,
  aggregates,
  reviewSamples,
  categoryName,
  saleActive,
  saleEndsAt,
  video,
} = Astro.props

const currency = product.currency

// Prix : min/max sur variantes (price_cents_override ?? prix produit) ou prix produit.
const variantPrices = variants.map((v) => v.price_cents_override ?? product.price_cents)
const minCents = variantPrices.length > 0 ? Math.min(...variantPrices) : product.price_cents
const maxCents = variantPrices.length > 0 ? Math.max(...variantPrices) : product.price_cents
const isMultiPrice = variants.length > 0 && minCents !== maxCents

function toPrice(cents: number): string {
  return (cents / 100).toFixed(2)
}

// Disponibilité : si variantes, en stock si une variante a du stock ; sinon stock produit.
let inStock: boolean
if (variants.length > 0) {
  inStock = variants.some((v) => v.stock_quantity > 0)
} else if (product.type === 'digital') {
  inStock = true
} else {
  inStock = !!product.physical_stock_unlimited || (product.physical_stock_quantity ?? 0) > 0
}
const availability = inStock
  ? 'https://schema.org/InStock'
  : 'https://schema.org/OutOfStock'

// itemCondition (physical seulement)
const conditionMap: Record<string, string> = {
  new: 'https://schema.org/NewCondition',
  like_new: 'https://schema.org/UsedCondition',
  very_good: 'https://schema.org/UsedCondition',
  good: 'https://schema.org/UsedCondition',
  acceptable: 'https://schema.org/UsedCondition',
}
const itemCondition =
  product.type === 'physical' && product.physical_condition
    ? conditionMap[product.physical_condition] ?? 'https://schema.org/UsedCondition'
    : undefined

// Prix promo : la promo s'applique au prix de BASE uniquement (pas aux variantes).
// Cohérent avec l'UI ProductDetail : sur le branche AggregateOffer (variantes
// multi-prix) on n'applique PAS la promo, on garde low/high issus des variantes.
// Sur le branche Offer simple, price = prix promo si active, sinon prix normal.
const offerPriceCents = saleActive && product.sale_price_cents != null ? product.sale_price_cents : minCents
const offers = isMultiPrice
  ? {
      '@type': 'AggregateOffer',
      priceCurrency: currency,
      lowPrice: toPrice(minCents),
      highPrice: toPrice(maxCents),
      offerCount: variants.length,
      availability,
      ...(itemCondition && { itemCondition }),
      url: productUrl,
    }
  : {
      '@type': 'Offer',
      priceCurrency: currency,
      price: toPrice(offerPriceCents),
      // priceValidUntil uniquement si promo active ET date de fin présente
      ...(saleActive && saleEndsAt && { priceValidUntil: saleEndsAt }),
      availability,
      ...(itemCondition && { itemCondition }),
      url: productUrl,
    }

const description = product.description_long ?? product.description_short

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description,
  // category : émis uniquement si présent — jamais null (cf. règle "aucune propriété null")
  ...(categoryName && { category: categoryName }),
  ...(images.length > 0 && { image: images }),
  // Vidéo : VideoObject distinct (la vidéo est exclue de image[])
  ...(video && {
    video: {
      '@type': 'VideoObject',
      contentUrl: video.url,
      name: video.name,
    },
  }),
  ...(product.type === 'digital' && {
    additionalType: 'https://schema.org/DigitalDocument',
  }),
  brand: {
    '@type': 'Person',
    name: sellerName,
    url: sellerUrl,
  },
  offers,
}

if (aggregates.count > 0) {
  schema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: aggregates.average.toFixed(1),
    reviewCount: aggregates.count,
    bestRating: 5,
    worstRating: 1,
  }
}

if (reviewSamples.length > 0) {
  schema.review = reviewSamples.map((r) => ({
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: r.rating,
      bestRating: 5,
      worstRating: 1,
    },
    author: { '@type': 'Person', name: r.authorName },
    datePublished: r.created_at,
    ...(r.title && { name: r.title }),
    reviewBody: r.content,
  }))
}
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
