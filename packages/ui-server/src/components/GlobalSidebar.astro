---
import {
  PanelsTopLeft,
  ChartColumnBig,
  Folder,
  Users,
  Plug,
  X,
  LogIn,
} from 'lucide-static'

interface SidebarItem {
  href: string
  label: string
  icon: string
  match?: (path: string) => boolean
}

interface Props {
  user: { id: string } | null
  currentUserEntity: { display_name: string; avatar_url: string | null; slug: string } | null
  currentPath: string
  dashboardUrl: string
  projectLabel?: string | null
}

const { user, currentUserEntity, currentPath, dashboardUrl, projectLabel } = Astro.props
const isConnected = !!user && !!currentUserEntity

const profileWebHref = !user
  ? `${dashboardUrl}/login`
  : currentUserEntity
    ? `/${currentUserEntity.slug}`
    : `${dashboardUrl}/`

const espaceItems: SidebarItem[] = [
  {
    href: profileWebHref,
    label: 'Profile web',
    icon: PanelsTopLeft,
    match: (p) => !!currentUserEntity && p === `/${currentUserEntity.slug}`,
  },
  {
    href: '#analyse',
    label: 'Analyse',
    icon: ChartColumnBig,
  },
]

const outilsItems: SidebarItem[] = [
  {
    href: '#drive',
    label: 'Drive',
    icon: Folder,
  },
  {
    href: '#equipe',
    label: 'Équipe',
    icon: Users,
  },
  {
    href: '#connecteur',
    label: 'Connecteur',
    icon: Plug,
  },
]

const isActive = (item: SidebarItem) => (item.match ? item.match(currentPath) : currentPath === item.href)
---
{/* Backdrop mobile */}
<div
  class="main-rail-backdrop fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200 min-[1200px]:hidden"
  onclick="document.documentElement.setAttribute('data-drawer-open','false')"
/>

{/* Placeholder — réserve l'espace du rail fixe dans le flux flex */}
<div class="main-rail-spacer hidden min-[1200px]:block" aria-hidden="true" />

{/* Sidebar */}
<aside
  data-main-rail
  class="main-rail fixed top-0 left-0 z-50 flex h-screen w-[280px] -translate-x-full flex-col transition-transform duration-200 min-[1200px]:z-40 min-[1200px]:w-[260px] min-[1200px]:translate-x-0"
  aria-label="Navigation principale"
>
  <div class="main-rail__head flex h-[65px] shrink-0 items-center justify-end px-[25px] min-[1200px]:hidden">
    <button
      type="button"
      onclick="document.documentElement.setAttribute('data-drawer-open','false')"
      class="main-rail__close flex h-8 w-8 items-center justify-center rounded-md text-neutral-600 transition hover:bg-panel"
      aria-label="Fermer le menu"
    >
      <span class="flex h-5 w-5 items-center justify-center" set:html={X} />
    </button>
  </div>

  <nav class="sidebar-nav flex-1 overflow-y-auto" onclick="if(window.innerWidth < 1200) document.documentElement.setAttribute('data-drawer-open','false')">
    <div class="sidebar__section">
      <p class="sidebar__label">Espace</p>
      {espaceItems.map((item) => (
        <a
          href={item.href}
          class:list={['sidebar__item', isActive(item) && 'is-active']}
          title={item.label}
          aria-label={item.label}
        >
          <span class="sidebar__item-icon flex h-5 w-5 shrink-0 items-center justify-center" set:html={item.icon} />
          <span class="sidebar__item-text truncate">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="sidebar__section">
      <p class="sidebar__label">Outils</p>
      {outilsItems.map((item) => (
        <a
          href={item.href}
          class:list={['sidebar__item', isActive(item) && 'is-active']}
          title={item.label}
          aria-label={item.label}
        >
          <span class="sidebar__item-icon flex h-5 w-5 shrink-0 items-center justify-center" set:html={item.icon} />
          <span class="sidebar__item-text truncate">{item.label}</span>
        </a>
      ))}
    </div>
  </nav>

  {!isConnected && (
    <div class="main-rail__foot shrink-0 p-[22px]">
      <a
        href={`${dashboardUrl}/login`}
        class="sidebar__login flex w-full items-center justify-center gap-2 rounded-full bg-cta-primary px-4 py-2.5 text-sm font-medium text-white transition duration-200 hover:bg-accent"
        aria-label="Se connecter"
        title="Se connecter"
      >
        <span class="flex h-5 w-5 shrink-0 items-center justify-center" set:html={LogIn} />
        <span class="sidebar__login-text">Se connecter</span>
      </a>
    </div>
  )}
</aside>

<style>
  .main-rail {
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    top: 0;
    height: 100vh;
  }

  @media (min-width: 1200px) {
    .main-rail {
      top: var(--app-header-height);
      height: calc(100vh - var(--app-header-height));
    }
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 22px 25px;
  }

  .sidebar__section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sidebar__label {
    font-size: 14px;
    color: var(--color-neutral-500);
    margin: 0;
  }

  .sidebar__item {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 32px;
    border-radius: 8px;
    padding: 0 8px;
    margin: 0 -8px;
    color: var(--color-neutral-900);
    font-family: var(--font-display);
    font-size: 16px;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
    position: relative;
    text-decoration: none;
  }

  .sidebar__item:hover {
    background: var(--color-panel);
  }

  .sidebar__item.is-active {
    color: var(--color-accent);
    background: var(--color-accent-tint);
  }

  .sidebar__item.is-active::before {
    content: "";
    position: absolute;
    left: -25px;
    top: 6px;
    bottom: 6px;
    width: 3px;
    background: var(--color-accent);
    border-radius: 0 3px 3px 0;
  }

  .app-header__project {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-neutral-900);
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
  }
</style>

<script is:inline>
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') document.documentElement.setAttribute('data-drawer-open', 'false')
  })
</script>
