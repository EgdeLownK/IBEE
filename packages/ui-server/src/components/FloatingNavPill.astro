---
import { Home, MessageCircle, Activity, PanelsTopLeft } from 'lucide-static'

interface NavItem {
  href: string
  label: string
  icon: string
  match?: (path: string) => boolean
}

interface Props {
  currentPath: string
  currentUserSlug?: string | null
  isAuthenticated: boolean
  dashboardUrl?: string
}

const { currentPath, currentUserSlug, isAuthenticated, dashboardUrl = '' } = Astro.props

// 3 états (voir GlobalSidebar pour explication)
const profileWebHref = !isAuthenticated
  ? `${dashboardUrl}/login`
  : currentUserSlug
    ? `/${currentUserSlug}`
    : `${dashboardUrl}/`

const items: NavItem[] = [
  {
    href: '/',
    label: 'Home',
    icon: Home,
    match: (p) => p === '/',
  },
  {
    href: '#messages',
    label: 'Message',
    icon: MessageCircle,
    match: (p) => p.startsWith('/messages'),
  },
  {
    href: '/notifications',
    label: 'Activité',
    icon: Activity,
    match: (p) => p.startsWith('/notifications'),
  },
  {
    href: profileWebHref,
    label: 'Profile web',
    icon: PanelsTopLeft,
    match: (p) => !!currentUserSlug && p === `/${currentUserSlug}`,
  },
]
---
<nav class="navpill" aria-label="Navigation rapide">
  {items.map((item) => {
    const active = item.match ? item.match(currentPath) : currentPath === item.href
    return (
      <a
        href={item.href}
        aria-label={item.label}
        aria-current={active ? 'page' : undefined}
        class:list={['navpill__btn', active && 'is-active']}
      >
        <span class="flex h-5 w-5 items-center justify-center" set:html={item.icon} />
      </a>
    )
  })}
</nav>

<style>
  .navpill {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 4px;
    height: 52px;
    padding: 6px 14px;
    border-radius: 30px;
    background: rgb(255 255 255 / 0.85);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-nav);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 30;
  }

  .navpill__btn {
    width: 39px;
    height: 39px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-neutral-900);
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    transition: all 140ms ease;
  }

  .navpill__btn:hover {
    background: var(--color-panel);
  }

  .navpill__btn.is-active {
    background: #2A4A6B;
    color: #FFFFFF;
  }
</style>
