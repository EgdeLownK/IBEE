        var head = document.createElement('div')
        head.className = 'pco__block-head'
        var tag = document.createElement('span')
        tag.className = 'pco__block-type'
        tag.textContent = block.type === 'text' ? 'Texte' : 'Image'
        head.appendChild(tag)

        var ctrls = document.createElement('div')
        ctrls.className = 'pco__block-ctrls'
        var up = document.createElement('button')
        up.type = 'button'
        up.className = 'pco__mini-btn'
        up.disabled = i === 0
        up.appendChild(icon('up'))
        up.addEventListener('click', function () { moveBlock(i, -1) })
        ctrls.appendChild(up)
        var down = document.createElement('button')
        down.type = 'button'
        down.className = 'pco__mini-btn'
        down.disabled = i === state.blocks.length - 1
        down.appendChild(icon('down'))
        down.addEventListener('click', function () { moveBlock(i, 1) })
        ctrls.appendChild(down)
        var del = document.createElement('button')
        del.type = 'button'
        del.className = 'pco__mini-btn pco__mini-btn--danger'
        del.appendChild(icon('trash'))
        del.addEventListener('click', function () {
          if (block.previewUrl) { try { URL.revokeObjectURL(block.previewUrl) } catch (e) {} }
          state.blocks.splice(i, 1)
          renderBlocks()
        })
        ctrls.appendChild(del)
        head.appendChild(ctrls)
        box.appendChild(head)

        if (block.type === 'text') {
          var ta = document.createElement('textarea')
          ta.className = 'pco__input'
          ta.rows = 4
          ta.maxLength = 2000
          ta.placeholder = 'Texte du paragraphe...'
          ta.value = block.content
          ta.addEventListener('input', function () { block.content = ta.value })
          box.appendChild(ta)
        } else {
          if (block.previewUrl || block.url) {
            var prev = document.createElement('div')
            prev.className = 'pco__block-img-preview'
            var img = document.createElement('img')
            img.src = block.previewUrl || block.url
            img.alt = ''
            prev.appendChild(img)
            box.appendChild(prev)
          }
          var label = document.createElement('label')
          label.className = 'pco__upload'
          var fInput = document.createElement('input')
          fInput.type = 'file'
          fInput.accept = 'image/*'
          fInput.className = 'pco__upload-input'
          fInput.addEventListener('change', function () {
            var f = fInput.files && fInput.files[0]
            fInput.value = ''
            if (f) uploadBlockImage(block, f)
          })
          var empty = document.createElement('span')
          empty.className = 'pco__upload-empty'
          empty.textContent = block.uploading ? 'Envoi...' : (block.url ? 'Changer l\'image' : 'Choisir une image')
          label.appendChild(fInput)
          label.appendChild(empty)
          box.appendChild(label)
        }

        blocksWrap.appendChild(box)
      })
    }

    // ===================================================================
    // Navigation entre étapes
    // ===================================================================
    var prevBtn = dialog.querySelector('[data-pco-prev]')
    var nextBtn = dialog.querySelector('[data-pco-next]')
    var submitBtn = dialog.querySelector('[data-pco-submit]')

    function isPhysical() { return state.type === 'physical' }

    // Les deux types parcourent les mêmes étapes — seul le contenu de
    // l'étape 2 diffère (physical : stock/variantes, digital : fichier/détails)
    function stepSequence() {
      return [0, 1, 2, 3]
    }
    function nextStepOf(current) {
      var seq = stepSequence()
      var idx = seq.indexOf(current)
      return idx >= 0 && idx < seq.length - 1 ? seq[idx + 1] : current
    }
    function prevStepOf(current) {
      var seq = stepSequence()
      var idx = seq.indexOf(current)
      return idx > 0 ? seq[idx - 1] : current
    }
    function isLastStep(current) {
      var seq = stepSequence()
      return seq.indexOf(current) === seq.length - 1
    }

    function showStep(step) {
      state.step = step
      dialog.querySelectorAll('[data-pco-stage]').forEach(function (s) {
        s.hidden = s.getAttribute('data-pco-stage') !== String(step)
      })
      // Indicateurs
      var seq = stepSequence()
      dialog.querySelectorAll('[data-pco-step-indicator]').forEach(function (ind) {
        var n = parseInt(ind.getAttribute('data-pco-step-indicator'), 10)
        ind.classList.remove('is-active', 'is-done')
        if (n === step) ind.classList.add('is-active')
        else if (seq.indexOf(n) !== -1 && seq.indexOf(n) < seq.indexOf(step)) ind.classList.add('is-done')
      })
      // Boutons
      prevBtn.hidden = step === 0
      var last = isLastStep(step)
      nextBtn.hidden = step === 0 || last
      submitBtn.hidden = !last || step === 0
    }

    prevBtn.addEventListener('click', function () {
      clearErrors()
      showStep(prevStepOf(state.step))
    })
    nextBtn.addEventListener('click', function () {
      if (validateStep(state.step)) {
        clearErrors()
        showStep(nextStepOf(state.step))
      }
    })

    // ===================================================================
    // Validation par étape (client)
    // ===================================================================
    function priceToCents(raw) {
      if (raw === '' || raw === null || raw === undefined) return null
      var normalized = String(raw).replace(',', '.').trim()
      var euros = parseFloat(normalized)
      if (isNaN(euros)) return null
      return Math.round(euros * 100)
    }

    function validateStep(step) {
      clearErrors()
      if (step === 1) return validateStep1()
      if (step === 2) return validateStep2()
      if (step === 3) return validateStep3()
      return true
    }

    function validateStep1() {
      var ok = true
      // Médias en cours d'upload ?
      var anyUploading = state.media.some(function (m) { return m.uploading })
      if (anyUploading) {
        showFieldError('media', 'Patiente, un média est en cours d\'envoi.')
        ok = false
      }
      var title = (dialog.querySelector('[name="title"]').value || '').trim()
      if (title.length < 1) { showFieldError('title', 'Le titre est obligatoire.'); ok = false }
      else if (title.length > 100) { showFieldError('title', 'Maximum 100 caractères.'); ok = false }

      var ds = (dialog.querySelector('[name="description_short"]').value || '').trim()
      if (ds.length < 1) { showFieldError('description_short', 'La description courte est obligatoire.'); ok = false }
      else if (ds.length > 160) { showFieldError('description_short', 'Maximum 160 caractères.'); ok = false }

      // Bullets : chacun rempli 1-100
      for (var i = 0; i < state.bullets.length; i++) {
        var b = (state.bullets[i] || '').trim()
        if (b.length < 1 || b.length > 100) {
          showFieldError('bullet_points', 'Chaque point doit faire entre 1 et 100 caractères.')
          ok = false
          break
        }
      }
      if (state.bullets.length > 8) { showFieldError('bullet_points', 'Maximum 8 points.'); ok = false }

      // Prix
      var priceCents = priceToCents(dialog.querySelector('[name="price"]').value)
      if (!(Number.isInteger(priceCents) && priceCents > 0)) {
        showFieldError('price_cents', 'Le prix doit être supérieur à 0.')
        ok = false
      }
      // Promo
      if (promoToggle.checked) {
        var sp = priceToCents(dialog.querySelector('[name="sale_price"]').value)
        if (!(Number.isInteger(sp) && sp >= 0)) {
          showFieldError('sale_price_cents', 'Indique un prix promo valide.')
          ok = false
        } else if (Number.isInteger(priceCents) && priceCents > 0 && sp >= priceCents) {
          showFieldError('sale_price_cents', 'Le prix promo doit être inférieur au prix.')
          ok = false
        }
        var endVal = dialog.querySelector('[name="sale_ends_at"]').value
        if (endVal) {
          var d = new Date(endVal)
          if (isNaN(d.getTime()) || d.getTime() <= Date.now()) {
            showFieldError('sale_ends_at', 'La date de fin doit être dans le futur.')
            ok = false
          }
        }
      }
      // Catégorie nouvelle
      if (categorySelect.value === '__new__') {
        var nn = (categoryNew.value || '').trim()
        if (nn.length < 1 || nn.length > 60) {
          showFieldError('new_category_name', 'Le nom doit faire entre 1 et 60 caractères.')
          ok = false
        }
      }
      // Physical : modes de remise (le digital n'a plus de champ propre en étape 1)
      if (isPhysical()) {
        var pickup = pickupCheck.checked
        var delivery = dialog.querySelector('[data-pco-delivery]').checked
        if (!pickup && !delivery) {
          showFieldError('pickup_enabled', 'Active au moins un mode de remise.')
          ok = false
        }
        if (pickup) {
          var loc = (dialog.querySelector('[name="physical_pickup_location"]').value || '').trim()
          if (loc.length < 1) {
            showFieldError('physical_pickup_location', 'Le lieu de retrait est obligatoire.')
            ok = false
          } else if (loc.length > 200) {
            showFieldError('physical_pickup_location', 'Maximum 200 caractères.')
            ok = false
          }
        }
      }
      return ok
    }

    function validateStep2() {
      if (!isPhysical()) return validateStep2Digital()
      var ok = true
      var stock = dialog.querySelector('[name="physical_stock_quantity"]').value
      var sn = Number(stock)
      if (stock !== '' && (!Number.isInteger(sn) || sn < 0)) {
        showFieldError('physical_stock_quantity', 'Le stock doit être un entier positif ou nul.')
        ok = false
      }
      // Variantes
      if (state.variants.length > 20) {
        showFieldError('variants', 'Maximum 20 variantes.')
        ok = false
      }
      for (var i = 0; i < state.variants.length; i++) {
        var v = state.variants[i]
        var pairCount = 0
        var pairBad = false
        for (var p = 0; p < v.pairs.length; p++) {
          var k = (v.pairs[p].key || '').trim()
          var val = (v.pairs[p].value || '').trim()
          if (k === '' && val === '') continue // paire vide ignorée
          if (k.length < 1 || k.length > 40 || val.length < 1 || val.length > 40) {
            pairBad = true
            break
          }
          pairCount++
        }
        if (pairBad) {
          showVariantError(i, 'Attribut/valeur : 1 à 40 caractères chacun.')
          ok = false
          continue
        }
        if (pairCount < 1) {
          showVariantError(i, 'Ajoute au moins un attribut (ex : Taille = M).')
          ok = false
          continue
        }
        if (v.sku && v.sku.trim().length > 80) {
          showVariantError(i, 'Le SKU ne peut pas dépasser 80 caractères.')
          ok = false
          continue
        }
        if (v.price !== '' && v.price !== null) {
          var pc = priceToCents(v.price)
          if (!(Number.isInteger(pc) && pc > 0)) {
            showVariantError(i, 'Le prix de la variante doit être supérieur à 0.')
            ok = false
            continue
          }
        }
        if (v.stock !== '' && v.stock !== null) {
          var sq = Number(v.stock)
          if (!Number.isInteger(sq) || sq < 0) {
            showVariantError(i, 'Le stock doit être un entier positif ou nul.')
            ok = false
            continue
          }
        }
      }
      return ok
    }

    function validateStep3() {
      var ok = true
      var anyUploading = state.blocks.some(function (b) { return b.uploading })
      if (anyUploading) {
        showFieldError('content_blocks', 'Patiente, une image est en cours d\'envoi.')
        return false
      }
      if (state.blocks.length > 20) {
        showFieldError('content_blocks', 'Maximum 20 blocs.')
        ok = false
      }
      for (var i = 0; i < state.blocks.length; i++) {
        var b = state.blocks[i]
        if (b.type === 'text') {
          var c = (b.content || '').trim()
          if (c.length < 1 || c.length > 2000) {
            showFieldError('content_blocks', 'Chaque bloc texte doit faire entre 1 et 2000 caractères.')
            ok = false
            break
          }
        } else {
          if (!b.url) {
            showFieldError('content_blocks', 'Chaque bloc image doit contenir une image envoyée.')
            ok = false
            break
          }
        }
      }
      // FAQ : entrées entièrement vides ignorées, entrée à moitié remplie = erreur.
      if (state.faq.length > 10) {
        showFieldError('faq', 'Maximum 10 questions.')
        ok = false
      }
      for (var f = 0; f < state.faq.length; f++) {
        var fq = (state.faq[f].question || '').trim()
        var fa = (state.faq[f].answer || '').trim()
        if (fq === '' && fa === '') continue
        if (fq.length < 1 || fq.length > 200 || fa.length < 1 || fa.length > 1000) {
          showFieldError('faq', 'Chaque entrée : question 1-200 caractères, réponse 1-1000 caractères.')
          ok = false
          break
        }
      }
      return ok
    }

    // ===================================================================
    // Construction du payload + soumission
    // ===================================================================
    function buildPayload() {
      var payload = {
        type: state.type,
        title: (dialog.querySelector('[name="title"]').value || '').trim(),
        description_short: (dialog.querySelector('[name="description_short"]').value || '').trim(),
        price_cents: priceToCents(dialog.querySelector('[name="price"]').value),
        status: (dialog.querySelector('[data-pco-publish]').checked) ? 'published' : 'draft',
      }

      // Bullets (on filtre les vides)
      var bullets = []
      state.bullets.forEach(function (b) {
        var t = (b || '').trim()
        if (t.length > 0) bullets.push(t)
      })
      if (bullets.length > 0) payload.bullet_points = bullets

      // Promo
      if (promoToggle.checked) {
        var sp = priceToCents(dialog.querySelector('[name="sale_price"]').value)
        if (sp !== null) payload.sale_price_cents = sp
        var endVal = dialog.querySelector('[name="sale_ends_at"]').value
        if (endVal) {
          var d = new Date(endVal)
          if (!isNaN(d.getTime())) payload.sale_ends_at = d.toISOString()
        }
      }

      // Catégorie
      if (categorySelect.value === '__new__') {
        var nn = (categoryNew.value || '').trim()
        if (nn.length > 0) payload.new_category_name = nn
      } else if (categorySelect.value) {
        payload.category_id = categorySelect.value
      }

      // Médias (uploadés uniquement)
      var media = []
      state.media.forEach(function (m) {
        if (m.url) media.push({ url: m.url, type: m.type })
      })
      if (media.length > 0) payload.media = media

      // Blocs de contenu
      var blocks = []
      state.blocks.forEach(function (b) {
        if (b.type === 'text') {
          var c = (b.content || '').trim()
          if (c.length > 0) blocks.push({ type: 'text', content: c })
        } else if (b.url) {
          blocks.push({ type: 'image', url: b.url })
        }
      })
      if (blocks.length > 0) payload.content_blocks = blocks

      // FAQ (entrées entièrement vides ignorées)
      var faq = []
      state.faq.forEach(function (item) {
        var q = (item.question || '').trim()
        var a = (item.answer || '').trim()
        if (q.length > 0 && a.length > 0) faq.push({ question: q, answer: a })
      })
      if (faq.length > 0) payload.faq = faq

      // Champs par type
      if (state.type === 'digital') {
        payload.digital_file_id = fileIdInput.value
        // Détails personnalisés : libres puis familles (aplaties avec champ family)
        var details = []
        state.details.forEach(function (detail) {
          var l = (detail.label || '').trim()
          var v = (detail.value || '').trim()
          if (l.length > 0 && v.length > 0) details.push({ label: l, value: v })
        })
        state.detailFamilies.forEach(function (family) {
          var famName = (family.name || '').trim()
          if (famName.length === 0) return
          family.items.forEach(function (item) {
            var l = (item.label || '').trim()
            var v = (item.value || '').trim()
            if (l.length > 0 && v.length > 0) details.push({ label: l, value: v, family: famName })
          })
        })
        if (details.length > 0) payload.custom_details = details
      } else {
        payload.physical_condition = dialog.querySelector('[name="physical_condition"]').value
        payload.pickup_enabled = pickupCheck.checked
        payload.delivery_enabled = dialog.querySelector('[data-pco-delivery]').checked
        if (pickupCheck.checked) {
          payload.physical_pickup_location = (dialog.querySelector('[name="physical_pickup_location"]').value || '').trim()
        }
        var stockRaw = dialog.querySelector('[name="physical_stock_quantity"]').value
        var sn = Number(stockRaw)
        if (Number.isInteger(sn) && sn >= 0) payload.physical_stock_quantity = sn

        // Variantes
        var variants = []
        state.variants.forEach(function (v) {
          var attributes = {}
          v.pairs.forEach(function (pair) {
            var k = (pair.key || '').trim()
            var val = (pair.value || '').trim()
            if (k.length > 0 && val.length > 0) attributes[k] = val
          })
          if (Object.keys(attributes).length === 0) return // variante vide ignorée
          var out = { attributes: attributes }
          if (v.sku && v.sku.trim().length > 0) out.sku = v.sku.trim()
          var pc = priceToCents(v.price)
          if (pc !== null) out.price_cents_override = pc
          if (v.stock !== '' && v.stock !== null) {
            var sq = Number(v.stock)
            if (Number.isInteger(sq) && sq >= 0) out.stock_quantity = sq
          }
          variants.push(out)
        })
        if (variants.length > 0) payload.variants = variants
      }

      return payload
    }

    function setLoading(loadingState) {
      submitting = loadingState
      submitBtn.disabled = loadingState
      var spinner = dialog.querySelector('[data-pco-spinner]')
      var text = dialog.querySelector('[data-pco-submit-text]')
      if (spinner) spinner.hidden = !loadingState
      if (text) text.textContent = loadingState ? 'Création...' : 'Créer le produit'
    }

    // Mapping fieldErrors serveur → étape concernée
    function stepForField(field) {
      if (field === 'physical_stock_quantity' || field === 'physical_condition' || field === 'variants' || field.indexOf('variants') === 0) {
        return 2
      }
      if (field === 'digital_file_id' || field === 'custom_details') return 2
      if (field === 'content_blocks' || field === 'faq') return 3
      return 1
    }

    function applyServerErrors(fieldErrors) {
      var firstStep = null
      Object.keys(fieldErrors).forEach(function (field) {
        var msg = fieldErrors[field]
        // Variantes : variants_<i>_<champ> → erreur inline de la variante i
        var vm = field.match(/^variants_(\d+)_/)
        if (vm) {
          showVariantError(parseInt(vm[1], 10), msg)
        } else if (!showFieldError(field, msg)) {
          showGlobalError(msg)
        }
        var st = stepForField(field)
        if (firstStep === null || st < firstStep) firstStep = st
      })
      if (firstStep !== null) {
        showStep(firstStep)
      }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault()
      if (submitting) return
      if (!isLastStep(state.step)) return

      // Validation finale de toutes les étapes pertinentes
      clearErrors()
      var seq = stepSequence()
      for (var i = 0; i < seq.length; i++) {
        var s = seq[i]
        if (s === 0) continue
        if (!validateStep(s)) {
          showStep(s)
          return
        }
      }
      clearErrors()

      var payload = buildPayload()
      setLoading(true)

      fetch('/api/products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d } }) })
        .then(function (result) {
          if (result.ok && result.data && result.data.success) {
            window.location.reload()
            return
          }
          setLoading(false)
          var data = result.data || {}
          if (data.fieldErrors) {
            applyServerErrors(data.fieldErrors)
          } else if (data.error) {
            showGlobalError(data.error)
          }
        })
        .catch(function () {
          setLoading(false)
          showGlobalError('Erreur réseau. Réessaie.')
        })
    })

    // Init (au cas où le dialog serait ouvert autrement)
    applyTypeVisibility()
  })()
</script>
