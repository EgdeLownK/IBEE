    var MAX_DIGITAL_FILE_BYTES = 200 * 1024 * 1024
    var myFilesLoaded = false

    function formatBytes(bytes) {
      if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1).replace('.', ',') + ' Mo'
      if (bytes >= 1024) return Math.round(bytes / 1024) + ' Ko'
      return bytes + ' o'
    }

    // file : { id, name, size_bytes } | null
    function setSelectedFile(file) {
      fileIdInput.value = file ? file.id : ''
      fileSelectedBox.hidden = !file
      if (file) {
        fileSelectedName.textContent = file.name
        fileSelectedSize.textContent = formatBytes(file.size_bytes)
      }
      myFilesList.querySelectorAll('.pco__file-item').forEach(function (item) {
        item.classList.toggle('is-selected', !!file && item.getAttribute('data-file-id') === file.id)
      })
    }

    function renderMyFileItem(file, prepend) {
      var btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'pco__file-item'
      btn.setAttribute('data-file-id', file.id)
      var name = document.createElement('span')
      name.className = 'pco__file-item-name'
      name.textContent = file.name
      var meta = document.createElement('span')
      meta.className = 'pco__file-item-meta'
      meta.textContent = formatBytes(file.size_bytes)
      btn.appendChild(name)
      btn.appendChild(meta)
      btn.addEventListener('click', function () {
        setSelectedFile(file)
      })
      if (prepend && myFilesList.firstChild) myFilesList.insertBefore(btn, myFilesList.firstChild)
      else myFilesList.appendChild(btn)
      myFilesBox.hidden = false
    }

    function loadMyFiles() {
      if (myFilesLoaded) return
      myFilesLoaded = true
      fetch('/api/entity-files')
        .then(function (res) { return res.json() })
        .then(function (data) {
          var files = (data && data.files) || []
          files.forEach(function (f) { renderMyFileItem(f, false) })
        })
        .catch(function () {
          myFilesLoaded = false // retentera à la prochaine ouverture digital
        })
    }

    function setFileUploading(uploading) {
      state.fileUploading = uploading
      fileUploadBtn.disabled = uploading
      if (fileUploadLabel) fileUploadLabel.textContent = uploading ? 'Envoi en cours...' : 'Téléverser un fichier'
    }

    fileUploadBtn.addEventListener('click', function () { fileInput.click() })

    fileInput.addEventListener('change', function () {
      var f = fileInput.files && fileInput.files[0]
      if (!f) return
      clearFieldError('digital_file_id')
      if (f.size > MAX_DIGITAL_FILE_BYTES) {
        showFieldError('digital_file_id', 'Le fichier ne doit pas dépasser 200 Mo.')
        fileInput.value = ''
        return
      }
      setFileUploading(true)
      var fd = new FormData()
      fd.append('file', f)
      fetch('/api/entity-files', { method: 'POST', body: fd })
        .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d } }) })
        .then(function (result) {
          setFileUploading(false)
          fileInput.value = ''
          if (result.ok && result.data && result.data.success && result.data.file) {
            renderMyFileItem(result.data.file, true)
            setSelectedFile(result.data.file)
          } else {
            showFieldError('digital_file_id', (result.data && result.data.error) || 'Erreur lors de l\'envoi du fichier.')
          }
        })
        .catch(function () {
          setFileUploading(false)
          fileInput.value = ''
          showFieldError('digital_file_id', 'Erreur réseau pendant l\'envoi. Réessaie.')
        })
    })

