    })

    function validateStep2Digital() {
      var ok = true
      if (state.fileUploading) {
        showFieldError('digital_file_id', 'Patiente, le fichier est en cours d\'envoi.')
        ok = false
      }
      if (!fileIdInput.value) {
        showFieldError('digital_file_id', 'Choisis ou téléverse un fichier.')
        ok = false
      }
      // Détails personnalisés : lignes entièrement vides ignorées,
      // ligne à moitié remplie = erreur (même logique que les variantes).
      if (state.details.length > 8) {
        showFieldError('custom_details', 'Maximum 8 détails.')
        ok = false
      }
      var totalDetails = 0
      for (var i = 0; i < state.details.length; i++) {
        var dl = (state.details[i].label || '').trim()
        var dv = (state.details[i].value || '').trim()
        if (dl === '' && dv === '') continue
        if (dl.length < 1 || dl.length > 40 || dv.length < 1 || dv.length > 100) {
          showFieldError('custom_details', 'Chaque détail : libellé 1-40 caractères, valeur 1-100 caractères.')
          ok = false
          break
        }
        totalDetails++
      }
      // Familles : nom requis (1-40), au moins un détail valide par famille,
      // familles entièrement vides ignorées.
      if (state.detailFamilies.length > 6) {
        showFieldError('custom_details_families', 'Maximum 6 familles.')
        ok = false
      }
      for (var f = 0; f < state.detailFamilies.length; f++) {
        var fam = state.detailFamilies[f]
        var famName = (fam.name || '').trim()
        var validItems = 0
        var itemBad = false
        for (var it = 0; it < fam.items.length; it++) {
          var il = (fam.items[it].label || '').trim()
          var iv = (fam.items[it].value || '').trim()
          if (il === '' && iv === '') continue
          if (il.length < 1 || il.length > 40 || iv.length < 1 || iv.length > 100) {
            itemBad = true
            break
          }
          validItems++
        }
        if (famName === '' && validItems === 0 && !itemBad) continue // famille vide ignorée
        if (itemBad) {
          showFieldError('custom_details_families', 'Chaque détail : libellé 1-40 caractères, valeur 1-100 caractères.')
          ok = false
          break
        }
        if (famName.length < 1 || famName.length > 40) {
          showFieldError('custom_details_families', 'Chaque famille doit avoir un nom (1-40 caractères).')
          ok = false
          break
        }
        if (validItems === 0) {
          showFieldError('custom_details_families', 'Ajoute au moins un détail dans la famille « ' + famName + ' » ou supprime-la.')
          ok = false
          break
        }
        totalDetails += validItems
      }
      if (totalDetails > 30) {
        showFieldError('custom_details_families', 'Maximum 30 détails au total (libres + familles).')
        ok = false
      }
      return ok
    }

