        var kind = btn.getAttribute('data-pco-block-add')
        if (kind === 'text') {
          state.blocks.push({ id: nextId(), type: 'text', content: '', url: null, uploading: false, previewUrl: null })
        } else {
          state.blocks.push({ id: nextId(), type: 'image', content: '', url: null, uploading: false, previewUrl: null })
        }
        renderBlocks()
      })
    })

    function moveBlock(index, delta) {
      var target = index + delta
      if (target < 0 || target >= state.blocks.length) return
      var tmp = state.blocks[index]
      state.blocks[index] = state.blocks[target]
      state.blocks[target] = tmp
      renderBlocks()
    }

    function uploadBlockImage(block, file) {
      block.uploading = true
      block.previewUrl = URL.createObjectURL(file)
      renderBlocks()
      var fd = new FormData()
      fd.append('file', file)
      fetch('/api/product-upload', { method: 'POST', body: fd })
        .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d } }) })
        .then(function (result) {
          block.uploading = false
          if (result.ok && result.data && result.data.url && result.data.type === 'image') {
            block.url = result.data.url
          } else {
            block.url = null
            showFieldError('content_blocks', (result.data && result.data.error) || 'Erreur lors de l\'envoi de l\'image.')
          }
          renderBlocks()
        })
        .catch(function () {
          block.uploading = false
          block.url = null
          showFieldError('content_blocks', 'Erreur réseau lors de l\'envoi de l\'image.')
          renderBlocks()
        })
    }

