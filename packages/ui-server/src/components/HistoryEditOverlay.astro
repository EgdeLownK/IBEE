  .hist-edit__ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--color-neutral-500);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }
  .hist-edit__ctrl:hover:not(:disabled) {
    background: var(--color-panel);
    color: var(--color-neutral-800);
  }
  .hist-edit__ctrl:disabled {
    opacity: 0.28;
    cursor: default;
  }
  .hist-edit__ctrl--danger:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-error) 10%, transparent);
    color: var(--color-error);
  }

  /* ——— Texte ——— */
  .hist-edit__text-shell {
    border-radius: 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: inset 0 1px 2px rgb(20 22 28 / 0.04);
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .hist-edit__text-shell:focus-within {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    box-shadow: inset 0 1px 2px rgb(20 22 28 / 0.03), 0 0 0 3px var(--color-accent-tint);
  }

  .hist-edit__textarea {
    display: block;
    width: 100%;
    min-height: 148px;
    padding: 16px 18px 12px;
    border: 0;
    background: transparent;
    resize: vertical;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-neutral-900);
    outline: none;
  }
  .hist-edit__textarea::placeholder {
    color: var(--color-neutral-400);
    font-size: 15px;
  }

  .hist-edit__text-foot {
    display: flex;
    justify-content: flex-end;
    padding: 8px 14px 10px;
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-surface);
  }

  .hist-edit__counter {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    color: var(--color-neutral-400);
  }

  /* ——— Image ——— */
  .hist-edit__img-format {
    margin-bottom: 12px;
  }
  .hist-edit__img-format-label {
    display: block;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-neutral-400);
  }
  .hist-edit__img-format-picker {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }
  .hist-edit__img-format-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px;
    border: 1px solid var(--color-border-soft);
    border-radius: 12px;
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .hist-edit__img-format-btn:hover {
    border-color: var(--color-border);
    background: var(--color-neutral-50);
  }
  .hist-edit__img-format-btn.is-active {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-soft) 35%, var(--color-surface));
  }
  .hist-edit__layout-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-neutral-400);
    transition: color 150ms ease;
  }
  .hist-edit__img-format-btn.is-active .hist-edit__layout-icon,
  .hist-edit__img-format-btn:hover .hist-edit__layout-icon {
    color: var(--color-accent);
  }
  .hist-edit__layout-icon i {
    display: block;
    border: 2px solid currentColor;
    border-radius: 3px;
    box-sizing: border-box;
    background: transparent;
  }
  .hist-edit__layout-icon--landscape i {
    width: 40px;
    height: 22px;
  }
  .hist-edit__layout-icon--square i {
    width: 22px;
    height: 22px;
  }

  .hist-edit__dropzone {
    display: block;
    cursor: pointer;
    border-radius: 16px;
    border: 2px dashed color-mix(in srgb, var(--color-neutral-300) 85%, transparent);
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--color-accent-soft) 55%, transparent) 0%, transparent 70%),
      var(--color-surface);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .hist-edit__dropzone:hover,
  .hist-edit__dropzone.is-hover {
    border-color: var(--color-accent);
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--color-accent-soft) 80%, transparent) 0%, transparent 72%),
      var(--color-surface);
    transform: translateY(-1px);
  }
  .hist-edit__dropzone input {
    display: none;
  }

  .hist-edit__dropzone-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 200px;
    padding: 28px 24px;
    text-align: center;
  }
  .hist-edit__dropzone--square .hist-edit__dropzone-inner {
    min-height: 220px;
    max-width: 280px;
    margin: 0 auto;
  }

  .hist-edit__dropzone-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: 0 4px 16px -8px rgb(20 22 28 / 0.28);
    margin-bottom: 4px;
  }

  .hist-edit__dropzone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-strong);
  }

  .hist-edit__dropzone-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }

  .hist-edit__dropzone-hint {
    font-size: 12px;
    color: var(--color-neutral-500);
  }

  .hist-edit__dropzone-cta {
    margin-top: 4px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--color-neutral-900);
    color: #fff;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
  }

  .hist-edit__img-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-panel-2);
    border: 1px solid var(--color-border);
  }
  .hist-edit__img-frame--landscape {
    aspect-ratio: var(--hist-img-aspect, 16 / 9);
  }
  .hist-edit__img-frame--square {
    aspect-ratio: 1 / 1;
    max-width: 320px;
    margin: 0 auto;
  }
  .hist-edit__img-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hist-edit__img-frame.is-uploading img {
    opacity: 0.5;
    filter: blur(2px);
  }

  .hist-edit__img-loader {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(4px);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-neutral-700);
  }

  .hist-edit__spinner {
    width: 22px;
    height: 22px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: 999px;
    animation: hist-edit-spin 0.7s linear infinite;
  }
  @keyframes hist-edit-spin {
    to { transform: rotate(360deg); }
  }

  .hist-edit__img-toolbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 14px 12px;
    background: linear-gradient(180deg, transparent 0%, rgba(20, 22, 28, 0.55) 100%);
  }

  .hist-edit__img-action {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-neutral-900);
    cursor: pointer;
    transition: transform 140ms ease;
  }
  .hist-edit__img-action:hover {
    transform: translateY(-1px);
  }
  .hist-edit__img-action input {
    display: none;
  }

  .hist-edit__img-hit {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms ease, background 160ms ease;
  }
  .hist-edit__img-frame:hover .hist-edit__img-hit,
  .hist-edit__img-hit:focus-visible {
    opacity: 1;
    background: rgba(20, 22, 28, 0.28);
  }
  .hist-edit__img-hit-label {
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }

  .hist-edit__img-advanced {
    margin-top: 12px;
    border: 0;
    background: transparent;
  }
  .hist-edit__img-advanced-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-neutral-700);
    cursor: pointer;
    list-style: none;
  }
  .hist-edit__img-advanced-summary::-webkit-details-marker {
    display: none;
  }
  .hist-edit__img-advanced-chevron {
    flex-shrink: 0;
    color: var(--color-neutral-500);
    transition: transform 220ms ease, color 150ms ease;
  }
  .hist-edit__img-advanced[open] .hist-edit__img-advanced-chevron {
    transform: rotate(180deg);
    color: var(--color-neutral-700);
  }
  .hist-edit__img-advanced-body {
    padding: 4px 0 0;
  }
  .hist-edit__img-alt-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hist-edit__img-alt-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-neutral-700);
  }
  .hist-edit__optional {
    font-weight: 400;
    color: var(--color-neutral-400);
  }
  .hist-edit__img-alt-input {
    width: 100%;
    min-height: 40px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-neutral-900);
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .hist-edit__img-alt-input:focus {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    box-shadow: 0 0 0 3px var(--color-accent-tint);
  }

  .hw-banner-crop[hidden] { display: none !important; }
  .hw-banner-crop {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .hw-banner-crop__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .55);
  }
  .hw-banner-crop__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 520px;
    max-height: 92vh;
    overflow-y: auto;
    padding: 20px;
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .hw-banner-crop__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }
  .hw-banner-crop__hint {
    margin: 6px 0 14px;
    font-size: 13px;
    color: var(--color-neutral-500);
  }
  .hw-banner-crop__stage {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
    padding: 12px;
    border-radius: 12px;
    background: var(--color-panel);
    overflow: auto;
  }
  .hw-banner-crop__frame {
    position: relative;
    display: inline-block;
    line-height: 0;
  }
  .hw-banner-crop__frame img {
    display: block;
    max-width: 100%;
    max-height: min(360px, 50vh);
    width: auto;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  .hw-banner-crop__box {
    position: absolute;
    box-sizing: border-box;
    border: 2px solid #fff;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, .45);
    cursor: move;
    touch-action: none;
  }
  .hw-banner-crop__handle {
    position: absolute;
    right: -7px;
    bottom: -7px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-accent);
    border-radius: 4px;
    background: #fff;
    cursor: nwse-resize;
    touch-action: none;
  }
  .hw-banner-crop__foot {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  /* ——— Composer (ajout) ——— */
  .hist-edit__composer,
  .hist-edit__error,
  .hist-edit__foot {
    flex-shrink: 0;
  }

  .hist-edit__composer {
    padding: 10px 18px 6px;
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-neutral-50);
  }

  .hist-edit__composer-label {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-neutral-400);
  }

  .hist-edit__add-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .hist-edit__add-card {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    text-align: left;
    cursor: pointer;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .hist-edit__add-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    box-shadow: 0 4px 14px -8px rgb(20 22 28 / 0.35);
    transform: translateY(-1px);
  }

  .hist-edit__add-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--color-neutral-700);
  }
  .hist-edit__add-icon--text {
    background: linear-gradient(145deg, #F3F4F6 0%, #E5E7EB 100%);
  }
  .hist-edit__add-icon--image {
    background: linear-gradient(145deg, var(--color-accent-soft) 0%, #FAD9C8 100%);
    color: var(--color-accent-strong);
  }

  .hist-edit__add-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .hist-edit__add-copy strong {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }
  .hist-edit__add-copy span {
    font-size: 11px;
    line-height: 1.35;
    color: var(--color-neutral-500);
  }

  .hist-edit__add-plus {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--color-panel);
    color: var(--color-neutral-500);
  }

  .hist-edit__error {
    margin: 0;
    padding: 0 18px 8px;
    font-size: 13px;
    color: var(--color-accent-strong);
  }

  .hist-edit__foot {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 18px 18px;
    border-top: 1px solid var(--color-border-soft);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .hist-edit__btn {
    min-height: 42px;
    padding: 0 20px;
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 0;
    transition: background 140ms ease, transform 140ms ease;
  }
  .hist-edit__btn:active {
    transform: scale(0.98);
  }
  .hist-edit__btn--ghost {
    background: var(--color-panel);
    color: var(--color-neutral-800);
  }
  .hist-edit__btn--ghost:hover {
    background: var(--color-panel-2);
  }
  .hist-edit__btn--primary {
    background: var(--color-neutral-900);
    color: #fff;
    box-shadow: 0 4px 14px -6px rgb(20 22 28 / 0.55);
  }
  .hist-edit__btn--primary:hover {
    background: var(--color-cta-primary-hover);
  }

  /* ——— Bannière (même UI que widget Accueil) ——— */
  .hist-edit__card-main .hw-config__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-neutral-800);
  }
  .hist-edit__card-main .hw-config__input,
  .hist-edit__card-main .hw-config__textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-neutral-900);
    outline: none;
  }
  .hist-edit__card-main .hw-config__textarea { resize: vertical; }
  .hist-edit__card-main .hw-config__optional {
    font-weight: 400;
    color: var(--color-neutral-400);
    font-size: 12px;
  }
  .hist-edit__card-main .hw-config__banner-layout-picker {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-bottom: 4px;
  }
  .hist-edit__card-main .hw-config__banner-layout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px;
    border: 1px solid var(--color-border-soft);
    border-radius: 12px;
    background: var(--color-surface);
    cursor: pointer;
  }
  .hist-edit__card-main .hw-config__layout-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: var(--color-neutral-400);
    transition: color .15s ease;
  }
  .hist-edit__card-main .hw-config__banner-layout-btn.is-active .hw-config__layout-icon,
  .hist-edit__card-main .hw-config__banner-layout-btn:hover .hw-config__layout-icon {
    color: var(--color-accent);
  }
  .hist-edit__card-main .hw-config__layout-icon i {
    display: block;
    border: 2px solid currentColor;
    border-radius: 3px;
    box-sizing: border-box;
    background: transparent;
  }
  .hist-edit__card-main .hw-config__layout-icon--landscape i { width: 40px; height: 22px; }
  .hist-edit__card-main .hw-config__layout-icon--duo i { width: 15px; height: 15px; }
  .hist-edit__card-main .hw-config__layout-icon--trio i { width: 12px; height: 12px; }
  .hist-edit__card-main .hw-config__banner-workspace.is-uploading {
    opacity: 0.65;
    pointer-events: none;
  }
  .hist-edit__card-main .hw-config__banner-workspace.has-error .hw-config__banner-slot--empty .hw-config__banner-slot-frame {
    border-color: var(--color-accent);
  }
  .hist-edit__card-main .hw-config__banner-error {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-accent);
  }
  .hist-edit__card-main .hw-config__banner-error[hidden] { display: none !important; }
  .hist-edit__card-main .hw-config__banner-advanced {
    margin-top: 8px;
    border: 0;
    background: transparent;
  }
  .hist-edit__card-main .hw-config__banner-advanced-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 0;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-neutral-700);
    cursor: pointer;
    list-style: none;
  }
  .hist-edit__card-main .hw-config__banner-advanced-summary::-webkit-details-marker { display: none; }
  .hist-edit__card-main .hw-config__banner-advanced-chevron {
    flex-shrink: 0;
    color: var(--color-neutral-500);
    transition: transform .22s ease, color .15s ease;
  }
  .hist-edit__card-main .hw-config__banner-advanced[open] .hw-config__banner-advanced-chevron {
    transform: rotate(180deg);
    color: var(--color-neutral-700);
  }
  .hist-edit__card-main .hw-config__banner-advanced-body { padding: 4px 0 0; }
  .hist-edit__card-main .hw-config__banner-advanced-body .hw-config__field:last-child { margin-bottom: 10px; }

  .hist-edit__card-main .hw-config__banner-row {
    display: grid;
    gap: 8px;
  }
  .hist-edit__card-main .hw-config__banner-row--landscape { grid-template-columns: 1fr; }
  .hist-edit__card-main .hw-config__banner-row--square { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hist-edit__card-main .hw-config__banner-row--square.hw-config__banner-row--triple {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .hist-edit__card-main .hw-config__banner-slot {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .hist-edit__card-main .hw-config__banner-slot--landscape:not(.hw-config__banner-slot--empty) {
    aspect-ratio: var(--banner-aspect, 16 / 9);
