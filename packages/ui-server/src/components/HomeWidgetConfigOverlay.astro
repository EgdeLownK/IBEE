---
/** Overlay owner : configuration d'un widget Accueil (produit vs collection, annonce…). */
import { X, Image as ImageIcon, ChevronDown } from 'lucide-static'

type OpeningHourSlot = {
  day_of_week: number
  closed: boolean
  start_time: string | null
  end_time: string | null
}

interface PickerData {
  widgets: { id: string; type: string; config: unknown }[]
  products: { id: string; title: string; tags?: string[] }[]
  categories: { id: string; name: string }[]
  services: { id: string; title: string; tags?: string[] }[]
  events: { id: string; title: string }[]
  contactInfo: {
    contact_email: string | null
    contact_email_public: boolean
    contact_phone: string | null
    contact_phone_public: boolean
    message_enabled: boolean
    opening_hours_enabled: boolean
    opening_hours: OpeningHourSlot[]
  }
}

const DAY_LABELS: Record<number, string> = {
  0: 'Dimanche', 1: 'Lundi', 2: 'Mardi', 3: 'Mercredi',
  4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi',
}
const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0] as const

interface Props {
  pickerData: PickerData
}

const { pickerData } = Astro.props
const json = JSON.stringify(pickerData)
const bannerImageIcon = ImageIcon
---
<div class="hw-config" data-home-widget-config-overlay hidden>
  <div class="hw-config__backdrop" data-hw-config-close></div>
  <div class="hw-config__panel" role="dialog" aria-labelledby="hw-config-title" aria-modal="true">
    <header class="hw-config__head">
      <h2 id="hw-config-title" class="hw-config__title">Configurer le widget</h2>
      <button type="button" class="hw-config__close" data-hw-config-close aria-label="Fermer">
        <span class="flex h-5 w-5 items-center justify-center" set:html={X} />
      </button>
    </header>
    <form class="hw-config__form" data-hw-config-form novalidate>
      <input type="hidden" name="widget_id" data-hw-config-id />

      {/* Shop : vue catégorie (carrousel) OU fiche produit */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_shop" hidden>
        <p class="hw-config__hint">
          Choisis une <strong>vue catégorie</strong> (carrousel de produits, comme News)
          ou une <strong>vue produit</strong> (mise en avant d'un article précis).
        </p>
        <fieldset class="hw-config__fieldset">
          <label class="hw-config__radio">
            <input type="radio" name="shop_mode" value="collection" checked />
            <span>Vue catégorie</span>
          </label>
          <label class="hw-config__radio">
            <input type="radio" name="shop_mode" value="product" />
            <span>Vue produit</span>
          </label>
        </fieldset>
        <label class="hw-config__field" data-hw-shop-collection>
          <span>Catégorie</span>
          <select name="category_id" class="hw-config__select" data-hw-category-select></select>
        </label>
        <div class="hw-config__field" data-hw-shop-product hidden>
          <input type="hidden" name="product_id" data-hw-product-id />
          <div class="hw-config__entity-panel">
            <div class="hw-config__entity-bar">
              <input
                type="search"
                class="hw-config__entity-search"
                placeholder="Rechercher un produit…"
                aria-label="Rechercher un produit"
                data-hw-product-search
              />
            </div>
            <div class="hw-config__entity-list" data-hw-product-picker role="listbox" aria-label="Choisir un produit"></div>
            <p class="hw-config__entity-empty" data-hw-product-empty hidden>Aucun produit ne correspond.</p>
          </div>
        </div>
      </div>

      {/* Service : vue catégorie (carrousel) OU vue service (fiche) */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_service" hidden>
        <p class="hw-config__hint">
          Choisis une <strong>vue catégorie</strong> (carrousel de services, comme Shop)
          ou une <strong>vue service</strong> (mise en avant d'un service précis).
        </p>
        <fieldset class="hw-config__fieldset">
          <label class="hw-config__radio">
            <input type="radio" name="service_mode" value="collection" checked />
            <span>Vue catégorie</span>
          </label>
          <label class="hw-config__radio">
            <input type="radio" name="service_mode" value="service" />
            <span>Vue service</span>
          </label>
        </fieldset>
        <div class="hw-config__field" data-hw-service-single hidden>
          <input type="hidden" name="appointment_type_id" data-hw-service-id />
          <div class="hw-config__entity-panel">
            <div class="hw-config__entity-bar">
              <input
                type="search"
                class="hw-config__entity-search"
                placeholder="Rechercher un service…"
                aria-label="Rechercher un service"
                data-hw-service-search
              />
            </div>
            <div class="hw-config__entity-list" data-hw-service-picker role="listbox" aria-label="Choisir un service"></div>
            <p class="hw-config__entity-empty" data-hw-service-empty hidden>Aucun service ne correspond.</p>
          </div>
        </div>
      </div>

      {/* Event : un event OU liste (comme shop) */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_event" hidden>
        <p class="hw-config__hint">Mettre en avant un event ou afficher tous les events.</p>
        <fieldset class="hw-config__fieldset">
          <label class="hw-config__radio">
            <input type="radio" name="event_mode" value="featured" checked />
            <span>Un event</span>
          </label>
          <label class="hw-config__radio">
            <input type="radio" name="event_mode" value="list" />
            <span>Tous les events</span>
          </label>
        </fieldset>
        <label class="hw-config__field" data-hw-event-single>
          <span>Event</span>
          <select name="event_id" class="hw-config__select" data-hw-event-select></select>
        </label>
      </div>

      {/* F.A.Q : éditeur dédié (ouvert via crayon → overlay FAQ) */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_faq" hidden>
        <p class="hw-config__hint">
          Les questions s'affichent en accordéon sur l'accueil. Utilise le crayon sur le widget
          F.A.Q pour ajouter ou modifier tes questions (max. 10).
        </p>
      </div>

      {/* News : 3 dernières actualités (automatique) */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_news" hidden>
        <p class="hw-config__hint">
          Ce widget affiche automatiquement les <strong>3 dernières actualités</strong> publiées,
          au même format que le menu News.
        </p>
      </div>

      {/* Bio : menu Contact / Horaires */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_bio" hidden>
        <nav class="hw-config__bio-tabs" role="tablist" aria-label="Sections Bio">
          <button type="button" class="hw-config__bio-tab is-active" role="tab" aria-selected="true" data-bio-tab="contact">
            Contact
          </button>
          <button type="button" class="hw-config__bio-tab" role="tab" aria-selected="false" data-bio-tab="hours">
            Horaires
          </button>
        </nav>

        <div class="hw-config__bio-pane is-active" data-bio-pane="contact" role="tabpanel">
          <p class="hw-config__bio-block-hint hw-config__bio-block-hint--lead">
            Active uniquement les contacts que tu veux afficher — seul, en duo ou les trois.
          </p>

          <div class="hw-config__bio-block">
            <fieldset class="hw-config__fieldset">
              <legend class="hw-config__bio-block-title">Email</legend>
              <label class="hw-config__radio">
                <input type="radio" name="bio_email_enabled" value="no" checked />
                <span>Non</span>
              </label>
              <label class="hw-config__radio">
                <input type="radio" name="bio_email_enabled" value="yes" />
                <span>Oui</span>
              </label>
            </fieldset>
            <div class="hw-config__bio-field" data-bio-email-field>
              <input type="email" name="bio_contact_email" class="hw-config__input" placeholder="contact@exemple.com" />
            </div>
          </div>

          <div class="hw-config__bio-block">
            <fieldset class="hw-config__fieldset">
              <legend class="hw-config__bio-block-title">Téléphone</legend>
              <label class="hw-config__radio">
                <input type="radio" name="bio_phone_enabled" value="no" checked />
                <span>Non</span>
              </label>
              <label class="hw-config__radio">
                <input type="radio" name="bio_phone_enabled" value="yes" />
                <span>Oui</span>
              </label>
            </fieldset>
            <div class="hw-config__bio-field" data-bio-phone-field>
              <input type="tel" name="bio_contact_phone" class="hw-config__input" placeholder="+33 6 12 34 56 78" />
            </div>
          </div>

          <div class="hw-config__bio-block">
            <fieldset class="hw-config__fieldset">
              <legend class="hw-config__bio-block-title">Envoyer un message</legend>
              <label class="hw-config__radio">
                <input type="radio" name="bio_message_enabled" value="no" checked />
                <span>Non</span>
              </label>
              <label class="hw-config__radio">
                <input type="radio" name="bio_message_enabled" value="yes" />
                <span>Oui</span>
              </label>
            </fieldset>
            <p class="hw-config__bio-block-hint">Les visiteurs pourront vous écrire via la messagerie IBEE du compte projet.</p>
          </div>
        </div>

        <div class="hw-config__bio-pane" data-bio-pane="hours" role="tabpanel" hidden>
          <fieldset class="hw-config__fieldset">
            <legend class="hw-config__bio-block-title">Afficher les horaires</legend>
            <label class="hw-config__radio">
              <input type="radio" name="bio_hours_enabled" value="no" checked />
              <span>Non</span>
            </label>
            <label class="hw-config__radio">
              <input type="radio" name="bio_hours_enabled" value="yes" />
              <span>Oui</span>
            </label>
          </fieldset>
          <div class="hw-config__hours" data-hw-bio-hours>
            {DAY_ORDER.map((day) => (
              <div class="hw-config__hours-row" data-hw-hour-row data-day={day}>
                <label class="hw-config__hours-day">
                  <input type="checkbox" data-hw-hour-open checked />
                  <span>{DAY_LABELS[day]}</span>
                </label>
                <input type="time" class="hw-config__hours-time" data-hw-hour-start value="09:00" />
                <span class="hw-config__hours-sep">–</span>
                <input type="time" class="hw-config__hours-time" data-hw-hour-end value="18:00" />
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Bannière : layout + zones + SEO repliable */}
      <div class="hw-config__panel-type" data-hw-config-type="widget_announcement" hidden>
        <div class="hw-config__field">
          <span>Format</span>
          <div class="hw-config__banner-layout-picker" data-hw-banner-layout-picker role="group" aria-label="Format de bannière">
            <button type="button" class="hw-config__banner-layout-btn is-active" data-banner-layout="1" aria-label="1 image paysage" aria-pressed="true">
              <span class="hw-config__layout-icon hw-config__layout-icon--landscape" aria-hidden="true"><i></i></span>
            </button>
            <button type="button" class="hw-config__banner-layout-btn" data-banner-layout="2" aria-label="2 images carrées" aria-pressed="false">
              <span class="hw-config__layout-icon hw-config__layout-icon--duo" aria-hidden="true"><i></i><i></i></span>
            </button>
            <button type="button" class="hw-config__banner-layout-btn" data-banner-layout="3" aria-label="3 images carrées" aria-pressed="false">
              <span class="hw-config__layout-icon hw-config__layout-icon--trio" aria-hidden="true"><i></i><i></i><i></i></span>
            </button>
          </div>
        </div>
        <div class="hw-config__field">
          <span>Images</span>
          <div class="hw-config__banner-workspace" data-hw-banner-workspace>
            <div class="hw-config__banner-row" data-hw-banner-row></div>
          </div>
          <p class="hw-config__banner-error" data-hw-banner-error hidden></p>
          <input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" hidden data-hw-banner-file />
        </div>
        <details class="hw-config__banner-advanced">
          <summary class="hw-config__banner-advanced-summary">
            <span>Paramètres avancés — visibilité</span>
            <span class="hw-config__banner-advanced-chevron flex h-4 w-4 items-center justify-center" set:html={ChevronDown} />
          </summary>
          <div class="hw-config__banner-advanced-body">
            <label class="hw-config__field">
              <span>Titre <span class="hw-config__optional">(optionnel · SEO)</span></span>
              <input type="text" name="announcement_title" class="hw-config__input" placeholder="Non affiché sur le profil" />
            </label>
            <label class="hw-config__field">
              <span>Description <span class="hw-config__optional">(optionnel · SEO)</span></span>
              <textarea name="announcement_description" rows="3" class="hw-config__textarea" placeholder="Non affichée sur le profil"></textarea>
            </label>
          </div>
        </details>
      </div>

      <footer class="hw-config__foot">
        <button type="button" class="hw-config__btn hw-config__btn--ghost" data-hw-config-close>Annuler</button>
        <button type="submit" class="hw-config__btn hw-config__btn--primary">Enregistrer</button>
      </footer>
    </form>
    <template data-hw-banner-icon-tpl set:html={bannerImageIcon}></template>
  </div>
</div>

<div class="hw-config-discard" data-hw-config-discard hidden>
  <div class="hw-config-discard__backdrop" data-hw-config-discard-cancel></div>
  <div class="hw-config-discard__panel" role="alertdialog" aria-modal="true" aria-labelledby="hw-config-discard-title">
    <h3 id="hw-config-discard-title" class="hw-config-discard__title">Quitter sans enregistrer ?</h3>
    <p class="hw-config-discard__text">Les modifications que vous avez faites seront perdues.</p>
    <footer class="hw-config-discard__foot">
      <button type="button" class="hw-config__btn hw-config__btn--ghost" data-hw-config-discard-cancel>Continuer l'édition</button>
      <button type="button" class="hw-config__btn hw-config__btn--primary" data-hw-config-discard-confirm>Quitter</button>
    </footer>
  </div>
</div>

<div class="hw-banner-crop" data-hw-banner-crop hidden>
  <div class="hw-banner-crop__backdrop" data-hw-banner-crop-backdrop></div>
  <div class="hw-banner-crop__panel" role="dialog" aria-modal="true" aria-labelledby="hw-banner-crop-title">
    <h3 id="hw-banner-crop-title" class="hw-banner-crop__title">Recadrer l'image</h3>
    <p class="hw-banner-crop__hint" data-hw-banner-crop-hint>Ajustez le cadre.</p>
    <div class="hw-banner-crop__stage">
      <div class="hw-banner-crop__frame">
        <img alt="" data-hw-banner-crop-img />
        <div class="hw-banner-crop__box" data-hw-banner-crop-box>
          <div class="hw-banner-crop__handle" data-hw-banner-crop-handle></div>
        </div>
      </div>
    </div>
    <footer class="hw-banner-crop__foot">
      <button type="button" class="hw-config__btn hw-config__btn--ghost" data-hw-banner-crop-cancel>Annuler</button>
      <button type="button" class="hw-config__btn hw-config__btn--primary" data-hw-banner-crop-confirm>Valider</button>
    </footer>
  </div>
</div>

<script>
  import '../lib/banner-image-crop.ts'
</script>

<script is:inline define:vars={{ json }}>
(function() {
  var overlay = document.querySelector('[data-home-widget-config-overlay]')
  if (!overlay) return
  var data
  try { data = JSON.parse(json) } catch (e) { return }

  var form = overlay.querySelector('[data-hw-config-form]')
  var idInput = overlay.querySelector('[data-hw-config-id]')
  var widgetById = {}
  data.widgets.forEach(function(w) { widgetById[w.id] = w })

  var BANNER_AR_MIN = 1
  var BANNER_AR_MAX = 16 / 9
  var bannerLayoutSlots = 1
  var bannerImages = []
  var bannerReplaceIndex = null
  var bannerDragIndex = null
  var bannerUploading = false
  var bannerRowEl = overlay.querySelector('[data-hw-banner-row]')
  var bannerLayoutPicker = overlay.querySelector('[data-hw-banner-layout-picker]')
  var bannerWorkspace = overlay.querySelector('[data-hw-banner-workspace]')
  var bannerFileInput = overlay.querySelector('[data-hw-banner-file]')
  var bannerIconTpl = overlay.querySelector('[data-hw-banner-icon-tpl]')
  var discardShell = document.querySelector('[data-hw-config-discard]')
  var configSnapshot = ''

  function getBannerImageIconHtml() {
    if (!bannerIconTpl) return ''
    if (bannerIconTpl.content && bannerIconTpl.content.childNodes.length > 0) {
      var holder = document.createElement('div')
      holder.appendChild(bannerIconTpl.content.cloneNode(true))
      return holder.innerHTML
    }
    return bannerIconTpl.innerHTML || ''
  }

  function clampBannerAspect(ratio) {
    return Math.min(BANNER_AR_MAX, Math.max(BANNER_AR_MIN, ratio))
  }

  function bannerCropMode() {
    return bannerLayoutSlots === 1 ? 'landscape' : 'square'
  }

  function needsSquareRecrop(img) {
    return bannerLayoutSlots > 1 && img && Math.abs(img.aspect_ratio - 1) > 0.05
  }

  function updateBannerLayoutPicker() {
    if (!bannerLayoutPicker) return
    bannerLayoutPicker.querySelectorAll('[data-banner-layout]').forEach(function(btn) {
      var n = parseInt(btn.getAttribute('data-banner-layout'), 10)
      var active = n === bannerLayoutSlots
      btn.classList.toggle('is-active', active)
      btn.setAttribute('aria-pressed', active ? 'true' : 'false')
    })
  }

  function updateBannerFileInput() {
    if (!bannerFileInput) return
    if (bannerLayoutSlots <= 1) {
      bannerFileInput.removeAttribute('multiple')
    } else {
      bannerFileInput.setAttribute('multiple', '')
    }
  }

  function countFilledBannerImages() {
    var count = 0
    for (var i = 0; i < bannerLayoutSlots; i++) {
      if (bannerImages[i] && bannerImages[i].url) count++
    }
    return count
  }

  function getBannerSaveError() {
    if (bannerLayoutSlots <= 1) return null
    var filled = countFilledBannerImages()
    if (filled === bannerLayoutSlots) return null
    if (bannerLayoutSlots === 2) {
      return 'Le format 2 images requiert 2 images.'
    }
    return 'Le format 3 images requiert 3 images.'
  }

  function updateBannerSaveHint() {
    var el = overlay.querySelector('[data-hw-banner-error]')
    var err = getBannerSaveError()
    if (!el) return
    if (err) {
      el.textContent = err
      el.hidden = false
      if (bannerWorkspace) bannerWorkspace.classList.add('has-error')
    } else {
      el.textContent = ''
      el.hidden = true
      if (bannerWorkspace) bannerWorkspace.classList.remove('has-error')
    }
  }

  function bannerImagesPayload() {
    var payload = []
    for (var bi = 0; bi < bannerLayoutSlots; bi++) {
      if (bannerImages[bi] && bannerImages[bi].url) {
        payload.push({
          url: bannerImages[bi].url,
          aspect_ratio: bannerLayoutSlots === 1
            ? clampBannerAspect(bannerImages[bi].aspect_ratio)
            : 1,
        })
      }
    }
    return payload
  }

  function buildAnnouncementConfig() {
    var seoTitle = form.announcement_title ? form.announcement_title.value.trim() : ''
    var seoDesc = form.announcement_description ? form.announcement_description.value.trim() : ''
    return {
      title: seoTitle || undefined,
      description: seoDesc || undefined,
      slot_count: bannerLayoutSlots,
      images: bannerImagesPayload(),
    }
  }

  function buildDirtyPayload() {
    var widgetId = idInput ? idInput.value : ''
    var w = widgetById[widgetId]
    if (!w) return {}
    var payload = { type: w.type, config: {} }
    if (w.type === 'widget_shop') {
      var sm = form.querySelector('input[name="shop_mode"]:checked')
      if (sm && sm.value === 'collection') {
        payload.config = { mode: 'collection', category_id: form.category_id.value, limit: 6 }
      } else {
        payload.config = { mode: 'product', product_id: form.product_id.value }
      }
    } else if (w.type === 'widget_service') {
      var svm = form.querySelector('input[name="service_mode"]:checked')
      if (svm && svm.value === 'collection') {
        payload.config = { mode: 'collection', limit: 6 }
      } else {
        payload.config = { mode: 'service', appointment_type_id: form.appointment_type_id.value }
      }
    } else if (w.type === 'widget_event') {
      var evm = form.querySelector('input[name="event_mode"]:checked')
      if (evm && evm.value === 'list') {
        payload.config = { mode: 'list', limit: 6 }
      } else {
        payload.config = { mode: 'featured', event_id: form.event_id.value }
      }
    } else if (w.type === 'widget_faq') {
      payload.config = { mode: 'menu' }
    } else if (w.type === 'widget_news') {
      payload.config = { mode: 'latest', limit: 3 }
    } else if (w.type === 'widget_bio') {
      payload.config = { mode: 'profile' }
      var openingHours = []
      overlay.querySelectorAll('[data-hw-hour-row]').forEach(function(row) {
        var day = parseInt(row.getAttribute('data-day'), 10)
        var openCb = row.querySelector('[data-hw-hour-open]')
        var startIn = row.querySelector('[data-hw-hour-start]')
        var endIn = row.querySelector('[data-hw-hour-end]')
        var isOpen = openCb && openCb.checked
        openingHours.push({
          day_of_week: day,
          closed: !isOpen,
          start_time: isOpen && startIn ? startIn.value : null,
          end_time: isOpen && endIn ? endIn.value : null,
        })
      })
      var emailOn = form.querySelector('input[name="bio_email_enabled"]:checked')
      var phoneOn = form.querySelector('input[name="bio_phone_enabled"]:checked')
      var emailElDirty = form.querySelector('[name="bio_contact_email"]')
      var phoneElDirty = form.querySelector('[name="bio_contact_phone"]')
      var emailVal = emailElDirty ? emailElDirty.value.trim() : ''
      var phoneVal = phoneElDirty ? phoneElDirty.value.trim() : ''
      var msgOn = form.querySelector('input[name="bio_message_enabled"]:checked')
      var hrsOn = form.querySelector('input[name="bio_hours_enabled"]:checked')
      var emailEnabled = !!(emailOn && emailOn.value === 'yes')
      var phoneEnabled = !!(phoneOn && phoneOn.value === 'yes')
      payload.contactInfo = {
        contact_email: emailVal || null,
        contact_email_public: emailEnabled,
        contact_phone: phoneVal || null,
        contact_phone_public: phoneEnabled,
        message_enabled: !!(msgOn && msgOn.value === 'yes'),
        opening_hours_enabled: !!(hrsOn && hrsOn.value === 'yes'),
        opening_hours: openingHours,
      }
    } else if (w.type === 'widget_announcement') {
      payload.config = buildAnnouncementConfig()
    }
    return payload
  }

  function captureConfigSnapshot() {
    configSnapshot = JSON.stringify(buildDirtyPayload())
  }

  function isConfigDirty() {
    return configSnapshot !== JSON.stringify(buildDirtyPayload())
  }

  function showDiscardConfirm() {
    if (!discardShell) {
      close()
      return
    }
    discardShell.hidden = false
    document.body.style.overflow = 'hidden'
  }

  function hideDiscardConfirm() {
    if (!discardShell) return
    discardShell.hidden = true
    if (!overlay.hidden) {
      document.body.style.overflow = 'hidden'
    } else {
      document.body.style.overflow = ''
    }
  }

  function setBannerLayout(slots) {
    if (slots !== 1 && slots !== 2 && slots !== 3) return
    if (slots === bannerLayoutSlots) return
    bannerLayoutSlots = slots
    if (bannerImages.length > slots) {
      bannerImages.length = slots
    }
    updateBannerLayoutPicker()
    updateBannerFileInput()
    renderBannerSlots()
    if (slots > 1) {
      var toAutoCrop = []
      for (var j = 0; j < slots; j++) {
        if (bannerImages[j] && needsSquareRecrop(bannerImages[j])) {
          toAutoCrop.push(j)
        }
      }
      if (toAutoCrop.length) autoSquareRecropIndices(toAutoCrop)
    }
  }

  function readBannerImageMeta(imageUrl) {
    var readMeta = window.__ibeeBannerReadMeta
    if (readMeta) return readMeta(imageUrl)
    return new Promise(function(resolve) {
      var img = new Image()
      img.onload = function() {
        resolve({ width: img.naturalWidth, height: img.naturalHeight })
      }
      img.onerror = function() { resolve(null) }
      img.src = imageUrl
    })
  }

  function imageMatchesBannerFormat(width, height, mode) {
    var matches = window.__ibeeBannerMatchesFormat
    if (matches) return matches(width, height, mode)
    if (!width || !height) return false
    var ar = width / height
    if (mode === 'square') return Math.abs(ar - 1) <= 0.02
    return ar >= BANNER_AR_MIN - 0.02 && ar <= BANNER_AR_MAX + 0.02
  }

  function openBannerCrop(sourceUrl, cropMode, fileType, onDone, onFinally) {
    var openCrop = window.__ibeeBannerCropOpen
    if (!openCrop) {
      alert('Recadrage indisponible. Recharge la page.')
      if (onFinally) onFinally()
      return
    }
    openCrop(sourceUrl, cropMode, fileType).then(function(result) {
      if (result) onDone(result)
    }).finally(function() {
      if (onFinally) onFinally()
    })
  }

  function setBannerUploading(active) {
    bannerUploading = active
    if (bannerWorkspace) bannerWorkspace.classList.toggle('is-uploading', active)
  }

  function inferImageMime(file) {
    if (file.type && file.type.indexOf('image/') === 0) return file.type
    var name = (file.name || '').toLowerCase()
    if (name.slice(-4) === '.png') return 'image/png'
    if (name.slice(-5) === '.webp') return 'image/webp'
    if (name.slice(-4) === '.gif') return 'image/gif'
    if (name.slice(-5) === '.avif') return 'image/avif'
    if (name.slice(-4) === '.jpg' || name.slice(-5) === '.jpeg') return 'image/jpeg'
    return 'image/jpeg'
  }

  function normalizeBannerUploadFile(file) {
    var mime = inferImageMime(file)
    if (file.type === mime) return file
    return new File([file], file.name || 'banner.jpg', { type: mime })
  }

  function bannerFileFromBlob(blob) {
    var mime = blob.type && blob.type.startsWith('image/') ? blob.type : 'image/webp'
    var ext = mime === 'image/png' ? 'png' : mime === 'image/jpeg' ? 'jpg' : 'webp'
    return new File([blob], 'banner.' + ext, { type: mime })
  }

  function uploadBannerBlob(blob, aspectRatio, slotIndex, onComplete, keepUploading) {
    if (typeof slotIndex !== 'number') {
      if (onComplete) onComplete()
      return
    }
    setBannerUploading(true)
    var fd = new FormData()
    fd.append('file', bannerFileFromBlob(blob))
    fetch('/api/product-upload', { method: 'POST', body: fd })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data } }) })
      .then(function(result) {
        if (!result.ok || !result.data.url) throw new Error(result.data.error || 'Upload impossible')
        var aspect = bannerLayoutSlots === 1 ? clampBannerAspect(aspectRatio) : 1
        bannerImages[slotIndex] = { url: result.data.url, aspect_ratio: aspect }
        renderBannerSlots()
        if (onComplete) onComplete()
      })
      .catch(function(err) {
        alert(err && err.message ? err.message : 'Upload impossible.')
        if (onComplete) onComplete()
      })
      .finally(function() {
        if (!keepUploading) setBannerUploading(false)
      })
  }

  function uploadBannerFile(file, aspectRatio, slotIndex, onComplete, keepUploading) {
    if (typeof slotIndex !== 'number' || !file) {
      if (onComplete) onComplete()
      return
    }
    setBannerUploading(true)
    var fd = new FormData()
    var uploadFile = normalizeBannerUploadFile(file)
    fd.append('file', uploadFile, uploadFile.name || 'banner.jpg')
    fetch('/api/product-upload', { method: 'POST', body: fd })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data } }) })
      .then(function(result) {
        if (!result.ok || !result.data.url) throw new Error(result.data.error || 'Upload impossible')
        var aspect = bannerLayoutSlots === 1 ? clampBannerAspect(aspectRatio) : 1
        bannerImages[slotIndex] = { url: result.data.url, aspect_ratio: aspect }
        renderBannerSlots()
        if (onComplete) onComplete()
      })
      .catch(function(err) {
        alert(err && err.message ? err.message : 'Upload impossible.')
        if (onComplete) onComplete()
      })
      .finally(function() {
        if (!keepUploading) setBannerUploading(false)
      })
  }

  function autoSquareRecropIndices(indices) {
    if (!indices.length || bannerUploading) return
    var autoCrop = window.__ibeeBannerAutoCrop
    if (!autoCrop) return
    setBannerUploading(true)
    var cursor = 0
    function next() {
      if (cursor >= indices.length) {
        setBannerUploading(false)
        renderBannerSlots()
        return
      }
      var idx = indices[cursor++]
      var img = bannerImages[idx]
      if (!img) {
        next()
        return
      }
      readBannerImageMeta(img.url).then(function(meta) {
        if (meta && imageMatchesBannerFormat(meta.width, meta.height, 'square')) {
          bannerImages[idx].aspect_ratio = 1
          next()
          return
        }
        autoCrop(img.url, 'square', 'image/jpeg').then(function(result) {
          if (!result) {
            next()
            return
          }
          uploadBannerBlob(result.blob, 1, idx, next, true)
        })
      })
    }
    next()
  }

  function buildSlotFillOrder(startIndex, fileCount) {
    var order = [startIndex]
    for (var i = 0; i < bannerLayoutSlots; i++) {
      if (i !== startIndex && order.length < fileCount && !bannerImages[i]) {
        order.push(i)
      }
    }
    return order.slice(0, fileCount)
  }

  function clearBannerSlotAt(index) {
    if (index < 0 || index >= bannerLayoutSlots) return
    bannerImages[index] = null
    while (bannerImages.length > bannerLayoutSlots) {
      bannerImages.pop()
    }
    while (bannerImages.length > 0 && !bannerImages[bannerImages.length - 1]) {
      bannerImages.pop()
    }
    renderBannerSlots()
  }

  function recropExistingAt(index) {
    var img = bannerImages[index]
    if (!img) return
    openBannerCrop(img.url, bannerCropMode(), 'image/jpeg', function(result) {
      if (!result) return
      uploadBannerBlob(result.blob, result.aspect_ratio, index, null)
    })
  }

  function pickBannerSlot(index) {
    if (bannerUploading) return
    bannerReplaceIndex = index
    if (bannerFileInput) {
      bannerFileInput.setAttribute('data-banner-slot-index', String(index))
      bannerFileInput.click()
    }
  }

  function ingestBannerFile(file, slotIndex, onComplete, keepUploading, forceCrop) {
    if (!file || typeof slotIndex !== 'number') {
      if (onComplete) onComplete()
      return
    }

    var mode = bannerCropMode()
    var objectUrl = URL.createObjectURL(file)

    function openCropModal() {
      if (!window.__ibeeBannerCropOpen) {
        readBannerImageMeta(objectUrl).then(function(meta) {
          URL.revokeObjectURL(objectUrl)
          var aspect = mode === 'square'
            ? 1
            : (meta ? clampBannerAspect(meta.width / meta.height) : BANNER_AR_MAX)
          uploadBannerFile(file, aspect, slotIndex, onComplete, keepUploading)
        })
        return
      }
      openBannerCrop(objectUrl, mode, file.type, function(result) {
        URL.revokeObjectURL(objectUrl)
        if (!result) {
          if (onComplete) onComplete()
          return
        }
        uploadBannerBlob(result.blob, result.aspect_ratio, slotIndex, onComplete, keepUploading)
      })
    }

    function autoCropThenUpload() {
      var autoCrop = window.__ibeeBannerAutoCrop
      if (!autoCrop) {
        uploadBannerFile(file, mode === 'square' ? 1 : BANNER_AR_MAX, slotIndex, onComplete, keepUploading)
        URL.revokeObjectURL(objectUrl)
        return
      }
      autoCrop(objectUrl, 'square', file.type).then(function(result) {
        URL.revokeObjectURL(objectUrl)
        if (!result) {
          uploadBannerFile(file, 1, slotIndex, onComplete, keepUploading)
          return
        }
        uploadBannerBlob(result.blob, 1, slotIndex, onComplete, keepUploading)
      }).catch(function() {
        URL.revokeObjectURL(objectUrl)
        uploadBannerFile(file, 1, slotIndex, onComplete, keepUploading)
      })
    }

    if (forceCrop) {
      openCropModal()
      return
    }

    readBannerImageMeta(objectUrl).then(function(meta) {
      if (meta && imageMatchesBannerFormat(meta.width, meta.height, mode)) {
        URL.revokeObjectURL(objectUrl)
        var aspect = mode === 'square' ? 1 : clampBannerAspect(meta.width / meta.height)
        uploadBannerFile(file, aspect, slotIndex, onComplete, keepUploading)
        return
      }

      if (mode === 'square') {
        autoCropThenUpload()
        return
      }

      openCropModal()
    }).catch(function() {
      URL.revokeObjectURL(objectUrl)
      uploadBannerFile(file, mode === 'square' ? 1 : BANNER_AR_MAX, slotIndex, onComplete, keepUploading)
    })
  }

  function processBannerFilesQueue(files, slotIndices, forceCrop) {
    if (!files.length || !slotIndices.length) return
    setBannerUploading(true)
    var fileIdx = 0
    function nextFile() {
      if (fileIdx >= files.length || fileIdx >= slotIndices.length) {
        setBannerUploading(false)
        renderBannerSlots()
        return
      }
      var file = files[fileIdx]
      var slotIndex = slotIndices[fileIdx]
      fileIdx += 1
      var keep = fileIdx < Math.min(files.length, slotIndices.length)
      ingestBannerFile(file, slotIndex, nextFile, keep, !!forceCrop)
    }
    nextFile()
  }

  function handleBannerFiles(files) {
    if (!files || !files.length) return
    var startIndex = bannerReplaceIndex
    if (typeof startIndex !== 'number' && bannerFileInput) {
      startIndex = parseInt(bannerFileInput.getAttribute('data-banner-slot-index'), 10)
    }
    if (typeof startIndex !== 'number' || isNaN(startIndex)) return
    bannerReplaceIndex = null
    var maxFiles = bannerLayoutSlots
    var limitedFiles = files.slice(0, maxFiles)
    var slotIndices = buildSlotFillOrder(startIndex, limitedFiles.length)
    if (!slotIndices.length) return
    processBannerFilesQueue(limitedFiles.slice(0, slotIndices.length), slotIndices, false)
  }

  function moveBannerSlot(from, to) {
    if (from === to || from < 0 || to < 0 || from >= bannerLayoutSlots || to >= bannerLayoutSlots) return
    bannerImages[to] = bannerImages[from]
    bannerImages[from] = null
    renderBannerSlots()
  }

  function swapBannerSlots(from, to) {
    if (from === to || from < 0 || to < 0 || from >= bannerLayoutSlots || to >= bannerLayoutSlots) return
    var tmp = bannerImages[from]
    bannerImages[from] = bannerImages[to]
    bannerImages[to] = tmp
    renderBannerSlots()
  }

  function bindBannerSlotDrop(slot, slotIndex) {
    slot.addEventListener('dragover', function(e) {
      if (bannerDragIndex === null) return
      e.preventDefault()
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move'
      slot.classList.add('is-drop-target')
    })
    slot.addEventListener('dragleave', function() {
      slot.classList.remove('is-drop-target')
    })
    slot.addEventListener('drop', function(e) {
      e.preventDefault()
      slot.classList.remove('is-drop-target')
      if (bannerDragIndex === null || bannerDragIndex === slotIndex) return
      var from = bannerDragIndex
      bannerDragIndex = null
      if (bannerImages[slotIndex]) {
        swapBannerSlots(from, slotIndex)
      } else {
        moveBannerSlot(from, slotIndex)
      }
    })
  }

  function renderBannerSlots() {
    if (!bannerRowEl) return
    var layout = bannerLayoutSlots === 1 ? 'landscape' : 'square'
    bannerRowEl.className = 'hw-config__banner-row hw-config__banner-row--' + layout
    if (bannerLayoutSlots === 3) bannerRowEl.classList.add('hw-config__banner-row--triple')

    bannerRowEl.innerHTML = ''

    for (var index = 0; index < bannerLayoutSlots; index++) {
      ;(function(slotIndex) {
        var img = bannerImages[slotIndex]
        var slot = document.createElement('div')
        slot.className = 'hw-config__banner-slot hw-config__banner-slot--' + layout
        slot.setAttribute('data-banner-index', String(slotIndex))

        if (!img) {
          slot.classList.add('hw-config__banner-slot--empty')
          slot.innerHTML =
            '<button type="button" class="hw-config__banner-slot-add" aria-label="Ajouter une image">' +
              '<span class="hw-config__banner-slot-frame hw-config__banner-slot-frame--' + layout + '">' +
                '<span class="hw-config__banner-slot-add-icon">' + getBannerImageIconHtml() + '</span>' +
              '</span>' +
            '</button>'
          var addBtn = slot.querySelector('.hw-config__banner-slot-add')
          if (addBtn) addBtn.addEventListener('click', function() { pickBannerSlot(slotIndex) })
          if (bannerLayoutSlots > 1) bindBannerSlotDrop(slot, slotIndex)
          bannerRowEl.appendChild(slot)
          return
        }

        if (bannerLayoutSlots > 1) slot.setAttribute('draggable', 'true')
        if (needsSquareRecrop(img)) slot.classList.add('hw-config__banner-slot--warn')
        if (bannerLayoutSlots === 1) {
          slot.style.setProperty('--banner-aspect', String(img.aspect_ratio))
        }

        var dragHandleHtml = bannerLayoutSlots > 1
          ? '<button type="button" class="hw-config__banner-slot-drag" aria-label="Déplacer l\'image">' +
              '<span class="hw-config__banner-slot-drag-grip" aria-hidden="true"></span>' +
            '</button>'
          : ''

        slot.innerHTML =
          '<div class="hw-config__banner-slot-media">' +
            '<img alt="" draggable="false" />' +
          '</div>' +
          dragHandleHtml +
          '<button type="button" class="hw-config__banner-slot-hit" aria-label="Modifier l\'image">' +
            '<span class="hw-config__banner-slot-edit">Modifier</span>' +
          '</button>' +
          '<button type="button" class="hw-config__banner-slot-remove" aria-label="Supprimer">×</button>'

        var hit = slot.querySelector('.hw-config__banner-slot-hit')
        var previewImg = slot.querySelector('.hw-config__banner-slot-media img')
        if (previewImg) previewImg.src = img.url

        if (hit) hit.addEventListener('click', function() { recropExistingAt(slotIndex) })

        var removeBtn = slot.querySelector('.hw-config__banner-slot-remove')
        if (removeBtn) {
          removeBtn.addEventListener('mousedown', function(e) {
            e.preventDefault()
            e.stopPropagation()
          })
          removeBtn.addEventListener('click', function(e) {
            e.preventDefault()
            e.stopPropagation()
            clearBannerSlotAt(slotIndex)
          })
        }

        if (bannerLayoutSlots > 1) {
          slot.addEventListener('dragstart', function(e) {
            if (!e.target.closest('.hw-config__banner-slot-drag')) {
              e.preventDefault()
              return
            }
            bannerDragIndex = slotIndex
            slot.classList.add('is-dragging')
            if (e.dataTransfer) {
              e.dataTransfer.effectAllowed = 'move'
              e.dataTransfer.setData('text/plain', String(slotIndex))
            }
          })
          slot.addEventListener('dragend', function() {
            bannerDragIndex = null
            slot.classList.remove('is-dragging')
            bannerRowEl.querySelectorAll('.hw-config__banner-slot').forEach(function(el) {
              el.classList.remove('is-drop-target')
            })
          })
          bindBannerSlotDrop(slot, slotIndex)
        }

        bannerRowEl.appendChild(slot)
      })(index)
    }
    updateBannerSaveHint()
  }

  function loadBannerImagesFromConfig(cfg) {
    bannerImages = []
    var imgs = []
    if (cfg.images && cfg.images.length) {
      cfg.images.forEach(function(img) {
        if (img && img.url) imgs.push(img)
      })
    } else if (cfg.image_url) {
      imgs.push({ url: cfg.image_url, aspect_ratio: BANNER_AR_MAX })
    }
    bannerLayoutSlots = cfg.slot_count === 2 || cfg.slot_count === 3 || cfg.slot_count === 1
      ? cfg.slot_count
      : (imgs.length === 2 ? 2 : imgs.length === 3 ? 3 : 1)
    imgs.slice(0, bannerLayoutSlots).forEach(function(img, i) {
      bannerImages[i] = {
        url: img.url,
        aspect_ratio: typeof img.aspect_ratio === 'number' ? img.aspect_ratio : BANNER_AR_MAX,
      }
    })
    if (bannerLayoutSlots > 1) {
      for (var j = 0; j < bannerLayoutSlots; j++) {
        if (bannerImages[j]) bannerImages[j].aspect_ratio = 1
      }
    } else if (bannerImages[0]) {
      bannerImages[0].aspect_ratio = clampBannerAspect(bannerImages[0].aspect_ratio)
    }
    updateBannerLayoutPicker()
    updateBannerFileInput()
    renderBannerSlots()
  }

  if (bannerLayoutPicker) {
    bannerLayoutPicker.querySelectorAll('[data-banner-layout]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var n = parseInt(btn.getAttribute('data-banner-layout'), 10)
        setBannerLayout(n)
      })
    })
  }

  if (bannerFileInput) {
    bannerFileInput.addEventListener('change', function() {
      var list = bannerFileInput.files
      if (!list || !list.length) return
      var files = Array.prototype.slice.call(list)
      bannerFileInput.value = ''
      handleBannerFiles(files)
    })
  }

  updateBannerFileInput()
  renderBannerSlots()

  function fillSelect(sel, items, valueKey) {
    if (!sel) return
    sel.innerHTML = ''
    items.forEach(function(it) {
      var opt = document.createElement('option')
      opt.value = it.id
      opt.textContent = it.title || it.name || it.id
      sel.appendChild(opt)
    })
    if (valueKey && items.some(function(it) { return it.id === valueKey })) {
      sel.value = valueKey
    }
  }

  function bindEntityPicker(opts) {
    var picker = opts.picker
    var hiddenInput = opts.hidden
    var searchInput = opts.search
    var emptyEl = opts.empty
    var items = []
    var selectedId = ''

    function render() {
      if (!picker) return
      var q = searchInput ? (searchInput.value || '').trim().toLowerCase() : ''
      picker.innerHTML = ''
      var visible = 0
      items.forEach(function(it) {
        var titleRaw = it.title || it.name || it.id || ''
        var titleLower = titleRaw.toLowerCase()
        var tags = it.tags || []
        var tagStr = tags.join(' ').toLowerCase()
        if (q && titleLower.indexOf(q) === -1 && tagStr.indexOf(q) === -1) return
        visible++

        var btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'hw-config__entity-row'
        btn.setAttribute('role', 'option')
        btn.setAttribute('data-pick-id', it.id)
        btn.setAttribute('aria-selected', it.id === selectedId ? 'true' : 'false')
        if (it.id === selectedId) btn.classList.add('is-selected')

        var mark = document.createElement('span')
        mark.className = 'hw-config__entity-mark'
        mark.setAttribute('aria-hidden', 'true')
        btn.appendChild(mark)

        var main = document.createElement('span')
        main.className = 'hw-config__entity-main'

        var titleEl = document.createElement('span')
        titleEl.className = 'hw-config__entity-title'
        titleEl.textContent = titleRaw
        main.appendChild(titleEl)

        if (tags.length) {
          var meta = document.createElement('span')
          meta.className = 'hw-config__entity-meta'
          meta.textContent = tags.join(' · ')
          main.appendChild(meta)
        }

        btn.appendChild(main)

        btn.addEventListener('click', function() {
          selectedId = it.id
          if (hiddenInput) hiddenInput.value = it.id
          render()
        })
        picker.appendChild(btn)
      })
      if (emptyEl) emptyEl.hidden = visible > 0
      if (picker) picker.hidden = visible === 0
    }

    function setItems(newItems, valueKey) {
      items = newItems || []
      selectedId = valueKey && items.some(function(it) { return it.id === valueKey }) ? valueKey : ''
      if (!selectedId && items[0]) selectedId = items[0].id
      if (hiddenInput) hiddenInput.value = selectedId || ''
      if (searchInput) searchInput.value = ''
      render()
    }

    if (searchInput) {
      searchInput.addEventListener('input', render)
    }

    return { setItems: setItems }
  }

  var productPicker = bindEntityPicker({
    picker: overlay.querySelector('[data-hw-product-picker]'),
    hidden: overlay.querySelector('[data-hw-product-id]'),
    search: overlay.querySelector('[data-hw-product-search]'),
    empty: overlay.querySelector('[data-hw-product-empty]'),
  })
  var servicePicker = bindEntityPicker({
    picker: overlay.querySelector('[data-hw-service-picker]'),
    hidden: overlay.querySelector('[data-hw-service-id]'),
    search: overlay.querySelector('[data-hw-service-search]'),
    empty: overlay.querySelector('[data-hw-service-empty]'),
  })

  productPicker.setItems(data.products)
  fillSelect(overlay.querySelector('[data-hw-category-select]'), data.categories)
  servicePicker.setItems(data.services)
  fillSelect(overlay.querySelector('[data-hw-event-select]'), data.events)
  function showType(type) {
    overlay.querySelectorAll('[data-hw-config-type]').forEach(function(el) {
      var active = el.getAttribute('data-hw-config-type') === type
      el.hidden = !active
      el.querySelectorAll('input, select, textarea').forEach(function(field) {
        field.disabled = !active
      })
