    if (type === 'widget_announcement') {
      renderBannerSlots()
    }
  }

  function open(widgetId) {
    var w = widgetById[widgetId]
    if (!w || !idInput) return
    idInput.value = widgetId
    showType(w.type)
    var cfg = w.config || {}

    if (w.type === 'widget_shop') {
      var shopMode = cfg.mode === 'collection' ? 'collection' : 'product'
      var shopRadio = form.querySelector('input[name="shop_mode"][value="' + shopMode + '"]')
      if (shopRadio) shopRadio.checked = true
      toggleShopMode()
      if (shopMode === 'product') {
        productPicker.setItems(data.products, cfg.product_id)
      }
      if (cfg.category_id) fillSelect(overlay.querySelector('[data-hw-category-select]'), data.categories, cfg.category_id)
    }
    if (w.type === 'widget_service') {
      var serviceMode = (cfg.mode === 'collection' || cfg.mode === 'list') ? 'collection' : 'service'
      var serviceRadio = form.querySelector('input[name="service_mode"][value="' + serviceMode + '"]')
      if (serviceRadio) serviceRadio.checked = true
      toggleServiceMode()
      if (serviceMode === 'service') {
        servicePicker.setItems(data.services, cfg.appointment_type_id)
      }
    }
    if (w.type === 'widget_event') {
      var eventMode = cfg.mode === 'list' ? 'list' : 'featured'
      var eventRadio = form.querySelector('input[name="event_mode"][value="' + eventMode + '"]')
      if (eventRadio) eventRadio.checked = true
      toggleEventMode()
      if (cfg.event_id) {
        fillSelect(overlay.querySelector('[data-hw-event-select]'), data.events, cfg.event_id)
      }
    }
    if (w.type === 'widget_bio') {
      switchBioTab('contact')
      var ci = data.contactInfo || {}
      var emailEl = form.querySelector('[name="bio_contact_email"]')
      if (emailEl) emailEl.value = ci.contact_email || ''
      var phoneEl = form.querySelector('[name="bio_contact_phone"]')
      if (phoneEl) phoneEl.value = ci.contact_phone || ''
      var emailRadio = form.querySelector('input[name="bio_email_enabled"][value="' + (ci.contact_email_public ? 'yes' : 'no') + '"]')
      if (emailRadio) emailRadio.checked = true
      var phoneRadio = form.querySelector('input[name="bio_phone_enabled"][value="' + (ci.contact_phone_public ? 'yes' : 'no') + '"]')
      if (phoneRadio) phoneRadio.checked = true
      var msgRadio = form.querySelector('input[name="bio_message_enabled"][value="' + (ci.message_enabled ? 'yes' : 'no') + '"]')
      if (msgRadio) msgRadio.checked = true
      toggleBioContactFields()
      var hrsRadio = form.querySelector('input[name="bio_hours_enabled"][value="' + (ci.opening_hours_enabled ? 'yes' : 'no') + '"]')
      if (hrsRadio) hrsRadio.checked = true
      toggleBioHoursFields()
      var hours = ci.opening_hours || []
      overlay.querySelectorAll('[data-hw-hour-row]').forEach(function(row) {
        var day = parseInt(row.getAttribute('data-day'), 10)
        var slot = hours.find(function(h) { return h.day_of_week === day })
        var openCb = row.querySelector('[data-hw-hour-open]')
        var startIn = row.querySelector('[data-hw-hour-start]')
        var endIn = row.querySelector('[data-hw-hour-end]')
        var closed = slot ? slot.closed : (day === 0 || day === 6)
        if (openCb) openCb.checked = !closed
        if (startIn) {
          startIn.value = slot && slot.start_time ? slot.start_time.slice(0, 5) : '09:00'
          startIn.disabled = closed
        }
        if (endIn) {
          endIn.value = slot && slot.end_time ? slot.end_time.slice(0, 5) : '18:00'
          endIn.disabled = closed
        }
      })
    }
    if (w.type === 'widget_announcement') {
      var map = {
        announcement_title: cfg.title,
        announcement_description: cfg.description,
      }
      Object.keys(map).forEach(function(name) {
        var el = form.querySelector('[name="' + name + '"]')
        if (el) el.value = map[name] || ''
      })
      loadBannerImagesFromConfig(cfg)
    }

    hideDiscardConfirm()
    overlay.hidden = false
    document.body.style.overflow = 'hidden'
    captureConfigSnapshot()
  }

  function close() {
    hideDiscardConfirm()
    overlay.hidden = true
    document.body.style.overflow = ''
  }

  function requestClose() {
    if (isConfigDirty()) {
      showDiscardConfirm()
      return
    }
    close()
  }

  function reloadHome() {
    var base = location.pathname.split('?')[0]
    location.href = base + '?_=' + Date.now() + '#home'
  }

  function toggleBioContactFields() {
    var emailOn = form.querySelector('input[name="bio_email_enabled"]:checked')
    var phoneOn = form.querySelector('input[name="bio_phone_enabled"]:checked')
    var showEmail = emailOn && emailOn.value === 'yes'
    var showPhone = phoneOn && phoneOn.value === 'yes'
    var emailWrap = overlay.querySelector('[data-bio-email-field]')
    var phoneWrap = overlay.querySelector('[data-bio-phone-field]')
    if (emailWrap) {
      emailWrap.style.opacity = showEmail ? '1' : '0.45'
      emailWrap.querySelectorAll('input').forEach(function(field) {
        field.disabled = !showEmail
      })
    }
    if (phoneWrap) {
      phoneWrap.style.opacity = showPhone ? '1' : '0.45'
      phoneWrap.querySelectorAll('input').forEach(function(field) {
        field.disabled = !showPhone
      })
    }
  }

  overlay.querySelectorAll('input[name="bio_email_enabled"], input[name="bio_phone_enabled"]').forEach(function(radio) {
    radio.addEventListener('change', toggleBioContactFields)
  })

  function toggleBioHoursFields() {
    var enabled = form.querySelector('input[name="bio_hours_enabled"]:checked')
    var show = enabled && enabled.value === 'yes'
    var grid = overlay.querySelector('[data-hw-bio-hours]')
    if (grid) {
      grid.style.opacity = show ? '1' : '0.45'
      grid.querySelectorAll('input').forEach(function(field) {
        field.disabled = !show
      })
    }
  }

  overlay.querySelectorAll('input[name="bio_hours_enabled"]').forEach(function(radio) {
    radio.addEventListener('change', toggleBioHoursFields)
  })

  function switchBioTab(tab) {
    var bioPanel = overlay.querySelector('[data-hw-config-type="widget_bio"]')
    if (!bioPanel) return
    bioPanel.querySelectorAll('[data-bio-tab]').forEach(function(btn) {
      var active = btn.getAttribute('data-bio-tab') === tab
      btn.classList.toggle('is-active', active)
      btn.setAttribute('aria-selected', active ? 'true' : 'false')
    })
    bioPanel.querySelectorAll('[data-bio-pane]').forEach(function(pane) {
      var active = pane.getAttribute('data-bio-pane') === tab
      pane.classList.toggle('is-active', active)
      pane.hidden = !active
      pane.querySelectorAll('input, select, textarea').forEach(function(field) {
        field.disabled = !active
      })
    })
  }

  overlay.querySelectorAll('[data-bio-tab]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      switchBioTab(btn.getAttribute('data-bio-tab'))
    })
  })

  function toggleShopMode() {
    var mode = form.querySelector('input[name="shop_mode"]:checked')
    var isCollection = mode && mode.value === 'collection'
    var prod = overlay.querySelector('[data-hw-shop-product]')
    var coll = overlay.querySelector('[data-hw-shop-collection]')
    if (prod) prod.hidden = isCollection
    if (coll) coll.hidden = !isCollection
    if (!isCollection) {
      var productId = overlay.querySelector('[data-hw-product-id]')
      productPicker.setItems(data.products, productId ? productId.value : undefined)
    }
  }

  function toggleServiceMode() {
    var mode = form.querySelector('input[name="service_mode"]:checked')
    var isCollection = mode && mode.value === 'collection'
    var single = overlay.querySelector('[data-hw-service-single]')
    if (single) single.hidden = isCollection
    if (!isCollection) {
      var serviceId = overlay.querySelector('[data-hw-service-id]')
      servicePicker.setItems(data.services, serviceId ? serviceId.value : undefined)
    }
  }

  function toggleEventMode() {
    var mode = form.querySelector('input[name="event_mode"]:checked')
    var isList = mode && mode.value === 'list'
    var single = overlay.querySelector('[data-hw-event-single]')
    if (single) single.hidden = isList
  }

  overlay.querySelectorAll('input[name="shop_mode"]').forEach(function(radio) {
    radio.addEventListener('change', toggleShopMode)
  })
  overlay.querySelectorAll('input[name="service_mode"]').forEach(function(radio) {
    radio.addEventListener('change', toggleServiceMode)
  })
  overlay.querySelectorAll('input[name="event_mode"]').forEach(function(radio) {
    radio.addEventListener('change', toggleEventMode)
  })

  overlay.querySelectorAll('[data-hw-hour-open]').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var row = cb.closest('[data-hw-hour-row]')
      if (!row) return
      var startIn = row.querySelector('[data-hw-hour-start]')
      var endIn = row.querySelector('[data-hw-hour-end]')
      if (startIn) startIn.disabled = !cb.checked
      if (endIn) endIn.disabled = !cb.checked
    })
  })

  document.querySelectorAll('[data-open-home-widget-config]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.getAttribute('data-open-home-widget-config')
      if (id) open(id)
    })
  })

  overlay.querySelectorAll('[data-hw-config-close]').forEach(function(btn) {
    btn.addEventListener('click', requestClose)
  })

  if (discardShell) {
    discardShell.querySelectorAll('[data-hw-config-discard-cancel]').forEach(function(btn) {
      btn.addEventListener('click', hideDiscardConfirm)
    })
    var discardConfirm = discardShell.querySelector('[data-hw-config-discard-confirm]')
    if (discardConfirm) {
      discardConfirm.addEventListener('click', close)
    }
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault()
    var widgetId = idInput.value
    var w = widgetById[widgetId]
    if (!w) return
    var config = {}
    if (w.type === 'widget_shop') {
      var sm = form.querySelector('input[name="shop_mode"]:checked')
      if (sm && sm.value === 'collection') {
        config = { mode: 'collection', category_id: form.category_id.value, limit: 6 }
      } else {
        config = { mode: 'product', product_id: form.product_id.value }
      }
    } else if (w.type === 'widget_service') {
      var svmSave = form.querySelector('input[name="service_mode"]:checked')
      if (svmSave && svmSave.value === 'collection') {
        config = { mode: 'collection', limit: 6 }
      } else {
        config = { mode: 'service', appointment_type_id: form.appointment_type_id.value }
      }
    } else if (w.type === 'widget_event') {
      var evmSave = form.querySelector('input[name="event_mode"]:checked')
      if (evmSave && evmSave.value === 'list') {
        config = { mode: 'list', limit: 6 }
      } else {
        config = { mode: 'featured', event_id: form.event_id.value }
      }
    } else if (w.type === 'widget_faq') {
      config = { mode: 'menu' }
    } else if (w.type === 'widget_news') {
      config = { mode: 'latest', limit: 3 }
    } else if (w.type === 'widget_bio') {
      config = { mode: 'profile' }
      var openingHours = []
      overlay.querySelectorAll('[data-hw-hour-row]').forEach(function(row) {
        var day = parseInt(row.getAttribute('data-day'), 10)
        var openCb = row.querySelector('[data-hw-hour-open]')
        var startIn = row.querySelector('[data-hw-hour-start]')
        var endIn = row.querySelector('[data-hw-hour-end]')
        var isOpen = openCb && openCb.checked
        openingHours.push({
          day_of_week: day,
          closed: !isOpen,
          start_time: isOpen && startIn ? startIn.value : null,
          end_time: isOpen && endIn ? endIn.value : null,
        })
      })
      var emailOn = form.querySelector('input[name="bio_email_enabled"]:checked')
      var phoneOn = form.querySelector('input[name="bio_phone_enabled"]:checked')
      var emailEnabled = !!(emailOn && emailOn.value === 'yes')
      var phoneEnabled = !!(phoneOn && phoneOn.value === 'yes')
      var emailEl = form.querySelector('[name="bio_contact_email"]')
      var phoneEl = form.querySelector('[name="bio_contact_phone"]')
      var emailVal = emailEl ? emailEl.value.trim() : ''
      var phoneVal = phoneEl ? phoneEl.value.trim() : ''
      var msgOn = form.querySelector('input[name="bio_message_enabled"]:checked')
      var hrsOn = form.querySelector('input[name="bio_hours_enabled"]:checked')
      if (emailEnabled && !emailVal) {
        alert('Renseigne une adresse email ou désactive l\'email.')
        return
      }
      if (phoneEnabled && !phoneVal) {
        alert('Renseigne un numéro de téléphone ou désactive le téléphone.')
        return
      }
      var contactBody = {
        contact_email: emailVal || null,
        contact_email_public: emailEnabled,
        contact_phone: phoneVal || null,
        contact_phone_public: phoneEnabled,
        message_enabled: !!(msgOn && msgOn.value === 'yes'),
        opening_hours_enabled: !!(hrsOn && hrsOn.value === 'yes'),
        opening_hours: openingHours,
      }
      fetch('/api/entity-contact-info', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(contactBody),
      })
        .then(function(res) {
          if (!res.ok) {
            return res.json().catch(function() { return {} }).then(function(err) {
              throw new Error(err.error || 'contact save failed')
            })
          }
          reloadHome()
        })
        .catch(function(err) {
          alert(err && err.message ? err.message : 'Enregistrement impossible. Réessaie.')
        })
      return
    } else if (w.type === 'widget_announcement') {
      var bannerSaveErr = getBannerSaveError()
      if (bannerSaveErr) {
        updateBannerSaveHint()
        alert(bannerSaveErr)
        return
      }
      config = buildAnnouncementConfig()
    }

    fetch('/api/home-widgets', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: widgetId, config: config }),
    })
      .then(function(res) {
        if (!res.ok) {
          return res.json().then(function(err) {
            throw new Error(err.error || 'save failed')
          })
        }
        reloadHome()
      })
      .catch(function(err) {
        alert(err && err.message ? err.message : 'Enregistrement impossible. Réessaie.')
      })
  })
})()
</script>

