---
/** Carte mise en avant (1 produit / service / event) — design Service unifié. */
interface Props {
  href: string
  imageUrl?: string | null
  placeholderIcon: string
  badgeLabel: string
  title: string
  tags?: string[]
  priceLabel: string
  oldPriceLabel?: string | null
  promo?: boolean
  ctaLabel: string
  embedded?: boolean
}

const {
  href,
  imageUrl = null,
  placeholderIcon,
  badgeLabel,
  title,
  tags = [],
  priceLabel,
  oldPriceLabel = null,
  promo = false,
  ctaLabel,
  embedded = false,
} = Astro.props
---
<section class:list={['wfeat', embedded && 'wfeat--embedded']}>
  <a href={href} class="wfeat__card">
    {imageUrl ? (
      <img src={imageUrl} alt="" class="wfeat__img" loading="lazy" />
    ) : (
      <span class="wfeat__placeholder" aria-hidden="true">
        <span class="flex h-10 w-10 items-center justify-center text-neutral-400" set:html={placeholderIcon} />
      </span>
    )}
    <span class="wfeat__badge">{badgeLabel}</span>
    <span class="wfeat__price-badge">
      {promo && oldPriceLabel ? (
        <>
          <span class="wfeat__price-now">{priceLabel}</span>
          <s class="wfeat__price-was">{oldPriceLabel}</s>
        </>
      ) : (
        <span class="wfeat__price-now">{priceLabel}</span>
      )}
    </span>
    <div class="wfeat__caption">
      <div class="wfeat__glass">
        <div class="wfeat__row">
          <div class="wfeat__info">
            <h3 class="wfeat__name">{title}</h3>
            {tags.length > 0 && (
              <div class="wfeat__tags">
                {tags.map((tag) => (
                  <span class="wfeat__tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <span class="wfeat__cta">{ctaLabel}</span>
        </div>
      </div>
    </div>
  </a>
</section>

<style>
  .wfeat {
    margin-top: 26px;
  }
  .wfeat--embedded {
    margin-top: 0;
  }

  .wfeat__card {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    border-radius: 16px;
    aspect-ratio: 4 / 3;
    text-decoration: none;
    color: inherit;
    background: var(--color-panel);
    box-shadow:
      0 0 0 0.5px color-mix(in srgb, var(--color-neutral-900) 8%, transparent),
      0 2px 10px -4px rgba(15, 18, 28, 0.14);
    transition:
      transform 220ms cubic-bezier(0.25, 0.1, 0.25, 1),
      box-shadow 220ms cubic-bezier(0.25, 0.1, 0.25, 1);
    margin: 0 22px;
  }
  .wfeat--embedded .wfeat__card {
    margin: 0;
  }

  a.wfeat__card:hover {
    transform: translateY(-1px) scale(1.008);
    box-shadow:
      0 0 0 0.5px color-mix(in srgb, var(--color-neutral-900) 10%, transparent),
      0 10px 28px -12px rgba(15, 18, 28, 0.22);
  }
  a.wfeat__card:hover .wfeat__img {
    transform: scale(1.03);
  }

  .wfeat__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
    transition: transform 520ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .wfeat__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: inherit;
    background: var(--color-panel);
  }
  .wfeat__badge,
  .wfeat__price-badge {
    position: absolute;
    top: 10px;
    z-index: 3;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    border: 0.5px solid rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px) saturate(1.6);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    box-shadow: 0 2px 8px rgba(15, 18, 28, 0.08);
    pointer-events: none;
  }
  .wfeat__badge {
    left: 10px;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }
  .wfeat__price-badge {
    right: 10px;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    border-radius: 12px;
    font-variant-numeric: tabular-nums;
  }
  .wfeat__price-now {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-neutral-900);
    line-height: 1.15;
  }
  .wfeat__price-badge:has(.wfeat__price-was) .wfeat__price-now {
    color: var(--color-accent);
  }
  .wfeat__price-was {
    font-size: 10px;
    font-weight: 500;
    color: var(--color-neutral-400);
    text-decoration: line-through;
    line-height: 1.1;
  }

  .wfeat__caption {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    z-index: 3;
    pointer-events: none;
  }
  .wfeat__glass {
    padding: 11px 12px 12px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.9);
    border: 0.5px solid rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(22px) saturate(1.75);
    -webkit-backdrop-filter: blur(22px) saturate(1.75);
    box-shadow:
      0 6px 20px rgba(15, 18, 28, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }
  .wfeat__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.28;
    color: var(--color-neutral-900);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .wfeat__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .wfeat__tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-neutral-900) 5%, transparent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-neutral-600);
    line-height: 1.2;
  }
  .wfeat__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .wfeat__info {
    min-width: 0;
    flex: 1;
  }
  .wfeat__cta {
    flex-shrink: 0;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--color-neutral-900);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }
</style>
