---
import { CalendarDays, Zap, BookOpen, MessageCircleQuestion } from 'lucide-static'
import ProfileCard from './ProfileCard.astro'
import ProfileHero from './ProfileHero.astro'
import ProfileStories from './ProfileStories.astro'
import MenuTabs from './MenuTabs.astro'
import ProfileEmptyState from './ProfileEmptyState.astro'
import SectionEmptyState from './SectionEmptyState.astro'
import PublicationsList from './PublicationsList.astro'
import AppointmentBooking from './AppointmentBooking.astro'
import SectionHeader from './SectionHeader.astro'
import WidgetCard from './WidgetCard.astro'
import BannerWelcomeWidget from './BannerWelcomeWidget.astro'
import ShopPlaylist from './ShopPlaylist.astro'
import ProductCreateOverlay from './ProductCreateOverlay.astro'
import ServiceCreateOverlay from './ServiceCreateOverlay.astro'
import EventCreateOverlay from './EventCreateOverlay.astro'
import EventCard from './EventCard.astro'

interface Media {
  id: string
  url: string
  alt_text: string | null
  position: number
}

interface Publication {
  id: string
  title: string
  slug: string
  content: string | null
  published_at: string | null
  publication_media: Media[]
}

interface Props {
  entity: {
    id: string
    display_name: string
    role: string | null
    location: string | null
    bio: string | null
    avatar_url: string | null
    created_at: string
    slug: string
    followers_count: number
  }
  menuSections: { id: string; type: string; position: number; is_configured?: boolean | null }[]
  homeWidgets?: unknown[]
  faqItems?: unknown[]
  publications?: Publication[]
  appointmentTypes?: { id: string; title: string; slug: string; description: string | null; duration_minutes: number; location_type: string; price_cents: number | null; promo_price_cents?: number | null; currency: string; gallery_images?: string[] }[]
  events?: { id: string; title: string; slug: string; description: string | null; start_at: string; end_at?: string | null; location_type: string; location_details?: string | null; price_cents: number | null; currency: string; capacity?: number | null; gallery_images?: string[]; registrations_count?: number }[]
  shopProducts?: { id: string; title: string; slug: string; description?: string | null; price_cents?: number | null; sale_price_cents?: number | null; sale_ends_at?: string | null; currency?: string; image_url?: string | null; status?: string | null; category_id?: string | null; type?: string | null; physical_stock_quantity?: number | null }[]
  productCategories?: { id: string; name: string }[]
  isOwner?: boolean
  isAuthenticated?: boolean
  isFollowing?: boolean
  dashboardUrl?: string
}

const { entity, menuSections, isOwner, isAuthenticated, isFollowing, dashboardUrl, publications = [], appointmentTypes = [], shopProducts = [], productCategories = [], faqItems = [], events = [] } = Astro.props
const hasFaqItems = Array.isArray(faqItems) && faqItems.length > 0

const hasNewsSection = menuSections.some(s => s.type === 'news')
const hasAppointmentsSection = menuSections.some(s => s.type === 'appointments')
const hasShopSection = menuSections.some(s => s.type === 'shop')
const hasEventsSection = menuSections.some(s => s.type === 'events')
const hasHistorySection = menuSections.some(s => s.type === 'history')
const hasFaqSection = menuSections.some(s => s.type === 'faq') || hasFaqItems

// Menu « Ajouter contenu » du hero (owner) : un item par type de section.
// FAQ : active si la section existe OU si des items FAQ existent (même logique
// que MenuTabs).
const ALL_SECTION_TYPES = ['shop', 'appointments', 'events', 'news', 'history', 'faq'] as const
const sectionTypeSet = new Set(menuSections.map(s => s.type))
const addContentSections = ALL_SECTION_TYPES.map(type => ({
  type,
  active: sectionTypeSet.has(type) || (type === 'faq' && hasFaqItems),
}))
// La section "home" est implicite : toujours présente comme tab par défaut, même
// si elle n'est pas dans entity_menu_sections (les widgets viennent de entity_home_widgets)
const defaultActiveType = 'home'
---
<ProfileCard>
  <ProfileHero
    displayName={entity.display_name}
    role={entity.role}
    location={entity.location}
    bio={entity.bio}
    avatarUrl={entity.avatar_url}
    createdAt={entity.created_at}
    isOwner={isOwner}
    isAuthenticated={isAuthenticated}
    isFollowing={isFollowing}
    entityId={entity.id}
    entitySlug={entity.slug}
    followersCount={entity.followers_count}
    dashboardUrl={dashboardUrl}
    addContentSections={addContentSections}
  />

  {/* Stories — juste sous les boutons du hero (backend à venir) */}
  <ProfileStories isOwner={isOwner} />

  {(menuSections.length > 0 || isOwner) ? (
    <MenuTabs sections={menuSections} activeType={defaultActiveType} isOwner={isOwner} hasFaq={hasFaqItems} />
  ) : <ProfileEmptyState />}

  {/* Section Accueil — widgets de la home */}
  <div data-section="home" class="profile-section">
    <SectionHeader title="Accueil" sectionType="home" isOwner={isOwner} isVisible={true} />
    <div class="profile-section__widgets">
      <WidgetCard title="Bannière" isOwner={isOwner}>
        <BannerWelcomeWidget
          title={`Bienvenue chez ${entity.display_name}`}
          description={entity.bio ?? 'Solopreneur sur IBEE.'}
          ctaLabel="Réserver"
          ctaHref={`/${entity.slug}#appointments`}
          secondaryLabel="Voir le profil"
          secondaryHref={`/${entity.slug}`}
        />
      </WidgetCard>
    </div>
  </div>

  {/* Section News */}
  {hasNewsSection && (
    <div data-section="news">
      <PublicationsList
        publications={publications}
        entityDisplayName={entity.display_name}
        entityAvatarUrl={entity.avatar_url}
        entitySlug={entity.slug}
        entityRole={entity.role}
        isOwner={isOwner}
      />
    </div>
  )}

  {/* Section Rendez-vous */}
  {hasAppointmentsSection && (
    <div data-section="appointments" class="profile-section">
      {appointmentTypes.length === 0 ? (
        <SectionEmptyState
          icon={CalendarDays}
          title="Aucun service pour le moment"
          description="Aucun service réservable pour l'instant."
          ownerDescription="Propose ton premier service réservable."
          ctaLabel="Ajouter un service"
          ctaAction="data-open-service-overlay"
          isOwner={isOwner}
        />
      ) : (
        <AppointmentBooking
          entityId={entity.id}
          entitySlug={entity.slug}
          appointmentTypes={appointmentTypes}
        />
      )}
    </div>
  )}

  {/* Section Events — events publiés à venir uniquement */}
  {hasEventsSection && (
    <div data-section="events" class="profile-section">
      {events.length === 0 ? (
        <SectionEmptyState
          icon={Zap}
          title="Aucun event à venir"
          description="Reviens bientôt pour découvrir les prochains events."
          ownerDescription="Annonce ton prochain webinaire, atelier ou meetup."
          ctaLabel="Ajouter un event"
          ctaAction="data-open-event-overlay"
          isOwner={isOwner}
        />
      ) : (
        <div class="flex flex-col gap-2.5">
          {events.map((ev) => (
            <EventCard
              id={ev.id}
              title={ev.title}
              slug={ev.slug}
              description={ev.description}
              startAt={ev.start_at}
              endAt={ev.end_at ?? null}
              locationType={ev.location_type}
              locationDetails={ev.location_details ?? null}
              priceCents={ev.price_cents}
              currency={ev.currency}
              capacity={ev.capacity ?? null}
              registrationsCount={ev.registrations_count ?? 0}
              coverImageUrl={ev.gallery_images?.[0] ?? null}
              entitySlug={entity.slug}
            />
          ))}
        </div>
      )}
    </div>
  )}

  {/* Section Shop — pattern Playlist (recherche + catégories + tuiles) */}
  {hasShopSection && (
    <div data-section="shop" class="profile-section">
      <ShopPlaylist products={shopProducts} categories={productCategories} isOwner={isOwner} entitySlug={entity.slug} />
    </div>
  )}

  {/* Section Histoire — affichage à venir, état vide en attendant */}
  {hasHistorySection && (
    <div data-section="history" class="profile-section">
      <SectionEmptyState
        icon={BookOpen}
        title="Aucune histoire pour le moment"
        description="L'histoire arrive bientôt."
        ownerDescription="Raconte ton parcours et ce qui t'anime."
        ctaLabel="Ajouter votre histoire"
        ctaAction="data-open-history-overlay"
        isOwner={isOwner}
      />
    </div>
  )}

  {/* Section FAQ — affichage des questions à venir, état vide en attendant */}
  {hasFaqSection && (
    <div data-section="faq" class="profile-section">
      {!hasFaqItems && (
        <SectionEmptyState
          icon={MessageCircleQuestion}
          title="Aucune question pour le moment"
          description="Pas encore de FAQ par ici."
          ownerDescription="Réponds aux questions les plus fréquentes de tes clients."
          ctaLabel="Ajouter une question"
          ctaAction="data-open-faq-overlay"
          isOwner={isOwner}
        />
      )}
    </div>
  )}

  {isOwner && <ProductCreateOverlay entitySlug={entity.slug} categories={productCategories} />}
  {isOwner && <ServiceCreateOverlay entitySlug={entity.slug} />}
  {isOwner && <EventCreateOverlay entitySlug={entity.slug} />}

  {/* Tab switching — affiche uniquement la section active */}
  <script is:inline>
    (function() {
      var sections = document.querySelectorAll('[data-section]');
      var tabs = document.querySelectorAll('nav[aria-label="Navigation du profil"] a');
      if (sections.length < 2) return;

      function show(type) {
        sections.forEach(function(s) {
          s.style.display = s.dataset.section === type ? '' : 'none';
        });
        tabs.forEach(function(a) {
          var t = a.dataset.sectionTab || a.getAttribute('href').slice(1);
          a.classList.toggle('is-active', t === type);
        });
      }

      tabs.forEach(function(a) {
        // Les tabs sans data-section-tab naviguent vers une page dédiée (ex: shop) :
        // on laisse le navigateur suivre le lien normalement.
        if (!a.dataset.sectionTab) return;
        a.addEventListener('click', function(e) {
          e.preventDefault();
          var type = this.dataset.sectionTab;
          show(type);
          history.replaceState(null, '', '#' + type);
        });
      });

      var hash = location.hash.slice(1);
      var validTypes = [];
      sections.forEach(function(s) { validTypes.push(s.dataset.section); });
      show(validTypes.indexOf(hash) !== -1 ? hash : validTypes[0]);
    })();
  </script>

  {/* Fallback noscript : tout visible si JS désactivé */}
  <noscript>
    <style>
      [data-section] { display: block !important; }
    </style>
  </noscript>
</ProfileCard>

<style>
  .profile-section {
    padding: 4px 22px 28px;
  }
  .profile-section__widgets {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
