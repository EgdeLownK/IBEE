---
import { BookOpen } from 'lucide-static'
import ProfileCard from './ProfileCard.astro'
import ProfileHero from './ProfileHero.astro'
import ProfileStories from './ProfileStories.astro'
import MenuTabs from './MenuTabs.astro'
import ProfileEmptyState from './ProfileEmptyState.astro'
import SectionEmptyState from './SectionEmptyState.astro'
import PublicationsList from './PublicationsList.astro'
import ServicePlaylist from './ServicePlaylist.astro'
import EventPlaylist from './EventPlaylist.astro'
import HomeWidgetsSection from './HomeWidgetsSection.astro'
import ShopPlaylist from './ShopPlaylist.astro'
import HistoryWidget from './HistoryWidget.astro'
import type { HistoryBlock } from '../history-blocks.ts'
import { historyBlocksHaveContent } from '../history-blocks.ts'
import type { FaqItemInput } from '../faq-items.ts'

interface Media {
  id: string
  url: string
  alt_text: string | null
  position: number
}

interface Publication {
  id: string
  title: string
  slug: string
  content: string | null
  published_at: string | null
  publication_media: Media[]
}

interface Props {
  entity: {
    id: string
    display_name: string
    role: string | null
    location: string | null
    bio: string | null
    avatar_url: string | null
    banner_url?: string | null
    created_at: string
    slug: string
    followers_count: number
  }
  menuSections: { id: string; type: string; position: number; is_configured?: boolean | null }[]
  homeWidgets?: { id: string; type: string; position: number; config?: unknown }[]
  faqItems?: unknown[]
  publications?: Publication[]
  appointmentTypes?: { id: string; title: string; slug: string; description: string | null; detailExcerpt?: string | null; reviewCount?: number; reviewAverage?: number; duration_minutes: number; location_type: string; price_cents: number | null; promo_price_cents?: number | null; currency: string; gallery_images?: string[] }[]
  events?: { id: string; title: string; slug: string; description: string | null; detailExcerpt?: string | null; start_at: string; end_at?: string | null; location_type: string; location_details?: string | null; price_cents: number | null; currency: string; capacity?: number | null; gallery_images?: string[]; registrations_count?: number }[]
  shopProducts?: { id: string; title: string; slug: string; detailExcerpt?: string | null; reviewCount?: number; reviewAverage?: number; price_cents?: number | null; sale_price_cents?: number | null; sale_ends_at?: string | null; currency?: string; image_url?: string | null; status?: string | null; category_id?: string | null; type?: string | null; physical_stock_quantity?: number | null }[]
  productCategories?: { id: string; name: string }[]
  historyBlocks?: HistoryBlock[]
  contactInfo?: {
    contact_email: string | null
    contact_email_public: boolean
    contact_phone: string | null
    contact_phone_public: boolean
    message_enabled: boolean
    opening_hours_enabled: boolean
    opening_hours: { day_of_week: number; closed: boolean; start_time: string | null; end_time: string | null }[]
  } | null
  isAuthenticated?: boolean
  isFollowing?: boolean
  dashboardUrl?: string
}

const {
  entity,
  menuSections,
  homeWidgets = [],
  isAuthenticated,
  isFollowing,
  dashboardUrl,
  publications = [],
  appointmentTypes = [],
  shopProducts = [],
  productCategories = [],
  faqItems = [],
  events = [],
  historyBlocks = [],
  contactInfo = null,
} = Astro.props

const hasHistoryContent = historyBlocksHaveContent(historyBlocks)
const faqItemsNormalized: FaqItemInput[] = Array.isArray(faqItems)
  ? faqItems.map((item) => {
      const row = item as { question?: string; answer?: string }
      return {
        question: typeof row.question === 'string' ? row.question : '',
        answer: typeof row.answer === 'string' ? row.answer : '',
      }
    })
  : []
const hasNewsSection = menuSections.some((s) => s.type === 'news')
const hasAppointmentsSection = menuSections.some((s) => s.type === 'appointments')
const hasShopSection = menuSections.some((s) => s.type === 'shop')
const hasEventsSection = menuSections.some((s) => s.type === 'events')
const hasHistorySection = menuSections.some((s) => s.type === 'history')
const defaultActiveType = 'home'
---
<ProfileCard>
  <ProfileHero
    displayName={entity.display_name}
    role={entity.role}
    location={entity.location}
    bio={entity.bio}
    avatarUrl={entity.avatar_url}
    bannerUrl={entity.banner_url}
    createdAt={entity.created_at}
    isAuthenticated={isAuthenticated}
    isFollowing={isFollowing}
    entityId={entity.id}
    entitySlug={entity.slug}
    followersCount={entity.followers_count}
    dashboardUrl={dashboardUrl}
  />

  <ProfileStories />

  {menuSections.length > 0 ? (
    <MenuTabs sections={menuSections} activeType={defaultActiveType} />
  ) : (
    <ProfileEmptyState />
  )}

  <HomeWidgetsSection
    entityId={entity.id}
    entitySlug={entity.slug}
    entityName={entity.display_name}
    entityAvatarUrl={entity.avatar_url}
    widgets={homeWidgets}
    shopProducts={shopProducts}
    productCategories={productCategories}
    appointmentTypes={appointmentTypes}
    events={events}
    publications={publications}
    contactInfo={contactInfo}
    faqItems={faqItemsNormalized}
  />

  {hasNewsSection && (
    <div data-section="news">
      <PublicationsList
        publications={publications}
        entityDisplayName={entity.display_name}
        entityAvatarUrl={entity.avatar_url}
        entitySlug={entity.slug}
        entityRole={entity.role}
      />
    </div>
  )}

  {hasAppointmentsSection && (
    <div data-section="appointments" class="profile-section">
      <ServicePlaylist services={appointmentTypes} entitySlug={entity.slug} />
    </div>
  )}

  {hasEventsSection && (
    <div data-section="events" class="profile-section">
      <EventPlaylist events={events} entitySlug={entity.slug} />
    </div>
  )}

  {hasShopSection && (
    <div data-section="shop" class="profile-section">
      <ShopPlaylist products={shopProducts} categories={productCategories} entitySlug={entity.slug} />
    </div>
  )}

  {hasHistorySection && (
    <div data-section="history" class="profile-section">
      {hasHistoryContent ? (
        <HistoryWidget
          entitySlug={entity.slug}
          displayName={entity.display_name}
          sectionTitle="Histoire"
          blocks={historyBlocks}
        />
      ) : (
        <SectionEmptyState
          icon={BookOpen}
          title="Aucune histoire pour le moment"
          description="L'histoire arrive bientôt."
        />
      )}
    </div>
  )}

  <script is:inline>
    (function() {
      var sections = document.querySelectorAll('[data-section]');
      var tabs = document.querySelectorAll('nav[aria-label="Navigation du profil"] a');
      if (sections.length < 2) return;

      function show(type) {
        sections.forEach(function(s) {
          s.style.display = s.dataset.section === type ? '' : 'none';
        });
        document.querySelectorAll('nav[aria-label="Navigation du profil"] a[data-section-tab]').forEach(function(a) {
          var t = a.dataset.sectionTab || a.getAttribute('href').slice(1);
          a.classList.toggle('is-active', t === type);
        });
      }

      window.__ibeeShowProfileTab = show;

      tabs.forEach(function(a) {
        if (!a.dataset.sectionTab) return;
        a.addEventListener('click', function(e) {
          e.preventDefault();
          var type = this.dataset.sectionTab;
          show(type);
          history.replaceState(null, '', '#' + type);
        });
      });

      var hash = location.hash.slice(1);
      var validTypes = [];
      sections.forEach(function(s) { validTypes.push(s.dataset.section); });
      show(validTypes.indexOf(hash) !== -1 ? hash : validTypes[0]);
    })();
  </script>

  <noscript>
    <style>
      [data-section] { display: block !important; }
    </style>
  </noscript>
</ProfileCard>

<style>
  .profile-section {
    padding: 4px 22px 28px;
  }
  @media (max-width: 1023px) {
    .profile-section:is([data-section="shop"], [data-section="appointments"], [data-section="events"]) {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
