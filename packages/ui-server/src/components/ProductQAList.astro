---
import { MessageCircleQuestion, BadgeCheck } from 'lucide-static'

interface Answer {
  id: string
  answerer_user_id: string
  answer_text: string
  is_seller: boolean
  created_at: string
}

interface Question {
  id: string
  asker_user_id: string
  question_text: string
  created_at: string
  product_answers?: Answer[] | null
}

interface Props {
  productId: string
  questions: Question[]
  user: { id: string } | null
  /** user_id du propriétaire (entity) — pour proposer de répondre comme vendeur. */
  ownerUserId: string | null
  loginUrl: string
}

const { productId, questions, user, ownerUserId, loginUrl } = Astro.props

const fmtDate = (d: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d))
const isOwner = !!(user && ownerUserId && user.id === ownerUserId)
---
<section id="questions" class="border-t border-neutral-200 px-6 py-8 sm:px-12">
  <h2 class="flex items-center gap-2 text-lg font-semibold text-neutral-900">
    <span class="flex h-5 w-5 items-center justify-center text-neutral-500" set:html={MessageCircleQuestion} />
    Questions ({questions.length})
  </h2>

  {/* Poser une question */}
  {user ? (
    <div class="mt-4 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
      <p id="question-confirm" class="mb-2 hidden rounded-lg bg-success/10 px-3 py-2 text-sm text-success"></p>
      <form id="question-form" data-product-id={productId} class="space-y-2">
        <textarea
          name="question"
          rows="2"
          minlength="10"
          maxlength="500"
          required
          placeholder="Posez votre question sur ce produit..."
          class="w-full resize-none rounded-lg border border-neutral-200 px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
        ></textarea>
        <p id="question-error" class="hidden text-sm text-error"></p>
        <div class="flex items-center justify-between">
          <span class="text-xs text-neutral-400">Publiée après validation.</span>
          <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-hover disabled:opacity-50">
            Poser ma question
          </button>
        </div>
      </form>
    </div>
  ) : (
    <div class="mt-4 rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-5 text-center">
      <p class="text-sm text-neutral-500">Connectez-vous pour poser une question.</p>
      <a href={loginUrl} class="mt-3 inline-flex items-center rounded-lg bg-accent px-5 py-2 text-sm font-medium text-white transition hover:bg-accent-hover">Se connecter</a>
    </div>
  )}

  {/* Liste des questions */}
  <div class="mt-6 space-y-5">
    {questions.length === 0 ? (
      <p class="py-6 text-center text-sm text-neutral-400">Aucune question pour le moment.</p>
    ) : (
      questions.map((q) => (
        <article class="border-b border-neutral-100 pb-5 last:border-0">
          <div class="flex items-start justify-between gap-3">
            <p class="text-sm font-medium text-neutral-900">{q.question_text}</p>
            <time class="shrink-0 text-xs text-neutral-400" datetime={q.created_at}>{fmtDate(q.created_at)}</time>
          </div>
          {q.product_answers && q.product_answers.length > 0 && (
            <div class="mt-3 space-y-3 border-l-2 border-neutral-100 pl-4">
              {q.product_answers
                .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
                .map((a) => (
                  <div>
                    <div class="flex items-center gap-2">
                      {a.is_seller && (
                        <span class="inline-flex items-center gap-1 rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">
                          <span class="flex h-3 w-3 items-center justify-center" set:html={BadgeCheck} />
                          Vendeur
                        </span>
                      )}
                      <time class="text-xs text-neutral-400" datetime={a.created_at}>{fmtDate(a.created_at)}</time>
                      {user && a.answerer_user_id === user.id && (
                        <button type="button" data-delete-answer={a.id} class="ml-auto text-xs text-neutral-400 hover:text-error">Supprimer</button>
                      )}
                    </div>
                    <p class="mt-1 whitespace-pre-wrap text-sm text-neutral-600">{a.answer_text}</p>
                  </div>
                ))}
            </div>
          )}

          {/* Répondre (owner ou tout utilisateur connecté) */}
          {user && (
            <div class="mt-3 pl-4">
              <button type="button" data-answer-toggle={q.id} class="text-xs font-medium text-accent hover:underline">
                {isOwner ? 'Répondre en tant que vendeur' : 'Répondre'}
              </button>
              <form data-answer-form={q.id} class="mt-2 hidden space-y-2">
                <textarea
                  name="answer"
                  rows="2"
                  minlength="5"
                  required
                  placeholder="Votre réponse..."
                  class="w-full resize-none rounded-lg border border-neutral-200 px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
                ></textarea>
                <button type="submit" class="rounded-lg bg-accent px-3 py-1.5 text-xs font-medium text-white transition hover:bg-accent-hover disabled:opacity-50">Envoyer</button>
              </form>
            </div>
          )}

          {user && q.asker_user_id === user.id && (
            <button type="button" data-delete-question={q.id} class="mt-2 ml-4 text-xs text-neutral-400 hover:text-error">Supprimer ma question</button>
          )}
        </article>
      ))
    )}
  </div>
</section>

<script is:inline>
(function() {
  // --- Poser une question (pending : pas de reload) ---
  var qForm = document.getElementById('question-form')
  if (qForm) {
    var qError = document.getElementById('question-error')
    var qConfirm = document.getElementById('question-confirm')
    var qBtn = qForm.querySelector('button[type="submit"]')
    qForm.addEventListener('submit', function(e) {
      e.preventDefault()
      qError.classList.add('hidden')
      var text = qForm.querySelector('[name="question"]').value.trim()
      if (text.length < 10) { qError.textContent = 'La question doit contenir au moins 10 caractères.'; qError.classList.remove('hidden'); return }
      qBtn.disabled = true
      fetch('/api/product-questions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'question', productId: qForm.getAttribute('data-product-id'), questionText: text }),
      })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d } }) })
        .then(function(res) {
          if (!res.ok) { qError.textContent = res.data.error || 'Erreur.'; qError.classList.remove('hidden'); qBtn.disabled = false; return }
          qConfirm.textContent = 'Question envoyée ! Elle sera publiée après validation.'
          qConfirm.classList.remove('hidden')
          qForm.style.display = 'none'
        })
        .catch(function() { qError.textContent = 'Erreur réseau.'; qError.classList.remove('hidden'); qBtn.disabled = false })
    })
  }

  // --- Toggle formulaires de réponse ---
  document.querySelectorAll('[data-answer-toggle]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.getAttribute('data-answer-toggle')
      var form = document.querySelector('[data-answer-form="' + id + '"]')
      if (form) form.classList.toggle('hidden')
    })
  })

  // --- Soumettre une réponse (published : reload) ---
  document.querySelectorAll('[data-answer-form]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault()
      var text = form.querySelector('[name="answer"]').value.trim()
      if (text.length < 5) { alert('La réponse doit contenir au moins 5 caractères.'); return }
      var btn = form.querySelector('button[type="submit"]')
      btn.disabled = true
      fetch('/api/product-questions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'answer', questionId: form.getAttribute('data-answer-form'), answerText: text }),
      })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d } }) })
        .then(function(res) {
          if (!res.ok) { alert(res.data.error || 'Erreur.'); btn.disabled = false; return }
          window.location.reload()
        })
        .catch(function() { alert('Erreur réseau.'); btn.disabled = false })
    })
  })

  // --- Suppressions ---
  function del(payload, msg) {
    if (!confirm(msg)) return
    fetch('/api/product-questions', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function(r) { if (r.ok) window.location.reload() })
  }
  document.querySelectorAll('[data-delete-question]').forEach(function(btn) {
    btn.addEventListener('click', function() { del({ action: 'delete-question', questionId: btn.getAttribute('data-delete-question') }, 'Supprimer votre question ?') })
  })
  document.querySelectorAll('[data-delete-answer]').forEach(function(btn) {
    btn.addEventListener('click', function() { del({ action: 'delete-answer', answerId: btn.getAttribute('data-delete-answer') }, 'Supprimer votre réponse ?') })
  })
})()
</script>
