---
/** Overlay owner : composer d'ajout de contenu (style LinkedIn). News par défaut. */
import {
  X,
  ShoppingBag,
  CalendarDays,
  Zap,
  Newspaper,
  BookOpen,
  Smile,
  Image as ImageIcon,
  Video,
  BarChart3,
  Loader2,
  Plus,
  Trash2,
  ChevronLeft,
  ChevronRight,
} from 'lucide-static'

interface SectionState {
  type: string
  active: boolean
}

interface Props {
  displayName: string
  avatarUrl?: string | null
  addContentSections?: SectionState[]
}

const { displayName, avatarUrl = null, addContentSections = [] } = Astro.props

const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('')

const activeTypes = new Set(addContentSections.filter((s) => s.active).map((s) => s.type))

const toolbarItems = [
  { type: 'news', label: 'News', icon: Newspaper, mode: 'composer' as const },
  { type: 'shop', label: 'Produit', icon: ShoppingBag, mode: 'overlay' as const, openAttr: 'data-open-product-overlay' },
  { type: 'appointments', label: 'Service', icon: CalendarDays, mode: 'overlay' as const, openAttr: 'data-open-service-overlay' },
  { type: 'events', label: 'Event', icon: Zap, mode: 'overlay' as const, openAttr: 'data-open-event-overlay' },
  { type: 'history', label: 'Histoire', icon: BookOpen, mode: 'overlay' as const, openAttr: 'data-open-history-overlay' },
].filter((item) => activeTypes.has(item.type))

const hasNews = activeTypes.has('news')
const defaultType = hasNews ? 'news' : (toolbarItems[0]?.type ?? 'news')

const EMOJIS = ['😀', '😃', '😄', '😁', '😅', '😂', '🤣', '😊', '😇', '🙂', '😉', '😍', '🥰', '😘', '🤔', '👍', '👏', '🎉', '🔥', '❤️', '💯', '🙌', '✨', '💪']
---
<div
  class="add-content"
  data-add-content-overlay
  hidden
  data-default-type={defaultType}
  data-has-news={hasNews ? '1' : '0'}
>
  <div class="add-content__backdrop" data-add-content-close></div>
  <div
    class="add-content__panel"
    role="dialog"
    aria-labelledby="add-content-title"
    aria-modal="true"
  >
    <header class="add-content__head">
      <div class="add-content__user">
        {avatarUrl ? (
          <img src={avatarUrl} alt="" class="add-content__avatar" width="40" height="40" />
        ) : (
          <span class="add-content__avatar add-content__avatar--initials" aria-hidden="true">{initials}</span>
        )}
        <div class="add-content__user-text">
          <p class="add-content__name">{displayName}</p>
          <p id="add-content-title" class="add-content__subtitle">Ajouter du contenu</p>
        </div>
      </div>
      <button type="button" class="add-content__close" data-add-content-close aria-label="Fermer">
        <span class="flex h-5 w-5 items-center justify-center" set:html={X} />
      </button>
    </header>

    <div class="add-content__body">
      {toolbarItems.length === 0 ? (
        <p class="add-content__prompt add-content__prompt--muted">
          Aucun menu actif pour publier du contenu.
          <span class="add-content__hint">Utilise l'onglet <strong>+</strong> pour activer Shop, Service, Event…</span>
        </p>
      ) : (
        <>
          <div class="add-content__composer" data-add-content-composer hidden={!hasNews}>
            <textarea
              class="add-content__textarea"
              data-add-content-text
              rows="5"
              maxlength="10000"
              placeholder="Quelle actu souhaitez-vous partager ?"
            ></textarea>

            <div class="add-content__media" data-add-content-media hidden></div>

            <div class="add-content__poll" data-add-content-poll-panel hidden>
              <div class="add-content__poll-head">
                <span class="add-content__poll-label">Sondage</span>
                <button type="button" class="add-content__poll-remove" data-add-content-poll-remove aria-label="Retirer le sondage">
                  <span class="flex h-4 w-4 items-center justify-center" set:html={Trash2} />
                </button>
              </div>
              <input
                type="text"
                class="add-content__poll-q"
                data-add-content-poll-q
                maxlength="200"
                placeholder="Ta question…"
              />
              <div class="add-content__poll-options" data-add-content-poll-options></div>
              <button type="button" class="add-content__poll-add" data-add-content-poll-add>
                <span class="flex h-4 w-4 items-center justify-center" set:html={Plus} />
                Ajouter une option
              </button>
            </div>

            <p class="add-content__error" data-add-content-error hidden></p>
          </div>

          <p class="add-content__prompt" data-add-content-other-prompt hidden>
            Choisis un type ci-dessous pour continuer.
          </p>
        </>
      )}
    </div>

    {toolbarItems.length > 0 && (
      <footer class="add-content__foot">
        <div class="add-content__composer-bar" data-add-content-composer-bar hidden={!hasNews}>
          <div class="add-content__composer-tools">
            <div class="add-content__emoji-wrap">
              <button type="button" class="add-content__icon-btn" data-add-content-emoji aria-label="Ajouter un emoji" title="Emoji">
                <span class="flex h-5 w-5 items-center justify-center" set:html={Smile} />
              </button>
              <div class="add-content__emoji-pop" data-add-content-emoji-pop hidden>
                {EMOJIS.map((e) => (
                  <button type="button" class="add-content__emoji-item" data-add-content-emoji-pick={e}>{e}</button>
                ))}
              </div>
            </div>
            <button type="button" class="add-content__icon-btn" data-add-content-image aria-label="Ajouter une image" title="Image">
              <span class="flex h-5 w-5 items-center justify-center" set:html={ImageIcon} />
            </button>
            <button type="button" class="add-content__icon-btn" data-add-content-video aria-label="Ajouter une vidéo" title="Vidéo (max 5 min)">
              <span class="flex h-5 w-5 items-center justify-center" set:html={Video} />
            </button>
            <button type="button" class="add-content__icon-btn" data-add-content-poll-toggle aria-label="Ajouter un sondage" title="Sondage">
              <span class="flex h-5 w-5 items-center justify-center" set:html={BarChart3} />
            </button>
            <input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" class="add-content__file" data-add-content-image-input multiple />
            <input type="file" accept="video/mp4,video/webm" class="add-content__file" data-add-content-video-input />
          </div>
          <button type="button" class="add-content__publish" data-add-content-publish disabled>
            <span class="add-content__spinner" data-add-content-spinner hidden set:html={Loader2} />
            <span data-add-content-publish-text>Publier</span>
          </button>
        </div>

        <div class="add-content__toolbar" role="toolbar" aria-label="Types de contenu">
          {toolbarItems.map((item) => (
            <button
              type="button"
              class:list={[
                'add-content__tool',
                item.type === defaultType && 'is-active',
              ]}
              data-add-content-tool
              data-add-content-type={item.type}
              data-add-content-mode={item.mode}
              title={item.label}
              {...(item.mode === 'overlay' && item.openAttr ? { [item.openAttr]: true } : {})}
            >
              <span class="add-content__tool-icon" set:html={item.icon} />
              <span class="add-content__tool-label">{item.label}</span>
            </button>
          ))}
        </div>
      </footer>
    )}
  </div>
</div>

<template data-add-content-tpl-chevron-left set:html={ChevronLeft}></template>
<template data-add-content-tpl-chevron-right set:html={ChevronRight}></template>

<script is:inline>
(function() {
  var overlay = document.querySelector('[data-add-content-overlay]')
  if (!overlay) return

  var defaultType = overlay.getAttribute('data-default-type') || 'news'
  var hasNews = overlay.getAttribute('data-has-news') === '1'
  var activeType = defaultType

  var composer = overlay.querySelector('[data-add-content-composer]')
  var composerBar = overlay.querySelector('[data-add-content-composer-bar]')
  var otherPrompt = overlay.querySelector('[data-add-content-other-prompt]')
  var textarea = overlay.querySelector('[data-add-content-text]')
  var mediaWrap = overlay.querySelector('[data-add-content-media]')
  var pollPanel = overlay.querySelector('[data-add-content-poll-panel]')
  var pollOptionsWrap = overlay.querySelector('[data-add-content-poll-options]')
  var pollQ = overlay.querySelector('[data-add-content-poll-q]')
  var pollAddBtn = overlay.querySelector('[data-add-content-poll-add]')
  var pollRemoveBtn = overlay.querySelector('[data-add-content-poll-remove]')
  var errorEl = overlay.querySelector('[data-add-content-error]')
  var publishBtn = overlay.querySelector('[data-add-content-publish]')
  var publishText = overlay.querySelector('[data-add-content-publish-text]')
  var spinner = overlay.querySelector('[data-add-content-spinner]')
  var emojiBtn = overlay.querySelector('[data-add-content-emoji]')
  var emojiPop = overlay.querySelector('[data-add-content-emoji-pop]')
  var imageBtn = overlay.querySelector('[data-add-content-image]')
  var videoBtn = overlay.querySelector('[data-add-content-video]')
  var pollToggleBtn = overlay.querySelector('[data-add-content-poll-toggle]')
  var imageInput = overlay.querySelector('[data-add-content-image-input]')
  var videoInput = overlay.querySelector('[data-add-content-video-input]')

  var MAX_VIDEO_SECONDS = 300
  var MAX_MEDIA = 10
  var media = []
  var pollEnabled = false
  var pollOptionCount = 2
  var submitting = false
  var uid = 0

  window.ibeeMarkReturnToAddContent = function() {
    window.__ibeeReturnToAddContent = true
  }

  window.ibeeReopenAddContentIfNeeded = function() {
    if (!window.__ibeeReturnToAddContent) return
    window.__ibeeReturnToAddContent = false
    open()
  }

  function nextId() { uid += 1; return 'm' + uid }

  function lockScroll() {
    document.documentElement.style.overflow = 'hidden'
    document.body.style.overflow = 'hidden'
  }

  function unlockScroll() {
    document.documentElement.style.overflow = ''
    document.body.style.overflow = ''
  }

  function showError(msg) {
    if (!errorEl) return
    if (msg) {
      errorEl.textContent = msg
      errorEl.hidden = false
    } else {
      errorEl.textContent = ''
      errorEl.hidden = true
    }
  }

  function setActiveType(type) {
    activeType = type
    overlay.querySelectorAll('[data-add-content-tool]').forEach(function(btn) {
      btn.classList.toggle('is-active', btn.getAttribute('data-add-content-type') === type)
    })
    var isNews = type === 'news' && hasNews
    if (composer) composer.hidden = !isNews
    if (composerBar) composerBar.hidden = !isNews
    if (otherPrompt) otherPrompt.hidden = isNews
    updatePublishState()
  }

  function resetComposer() {
    if (textarea) textarea.value = ''
    media = []
    pollEnabled = false
    pollOptionCount = 2
    if (pollPanel) pollPanel.hidden = true
    if (pollQ) pollQ.value = ''
    if (mediaWrap) {
      mediaWrap.innerHTML = ''
      mediaWrap.hidden = true
    }
    renderPollOptions()
    showError('')
    submitting = false
    if (publishBtn) publishBtn.disabled = true
    if (spinner) spinner.hidden = true
    if (publishText) publishText.hidden = false
    if (emojiPop) emojiPop.hidden = true
    if (imageInput) imageInput.value = ''
    if (videoInput) videoInput.value = ''
  }

  function renderPollOptions() {
    if (!pollOptionsWrap) return
    pollOptionsWrap.innerHTML = ''
    for (var i = 0; i < pollOptionCount; i++) {
      var row = document.createElement('div')
      row.className = 'add-content__poll-row'
      var input = document.createElement('input')
      input.type = 'text'
      input.className = 'add-content__poll-opt'
      input.maxLength = 80
      input.placeholder = 'Option ' + (i + 1)
      input.setAttribute('data-add-content-poll-opt', String(i))
      row.appendChild(input)
      pollOptionsWrap.appendChild(row)
    }
    if (pollAddBtn) pollAddBtn.hidden = pollOptionCount >= 4
  }

  function getPollData() {
    if (!pollEnabled || !pollQ) return null
    var question = pollQ.value.trim()
    var options = []
    pollOptionsWrap.querySelectorAll('[data-add-content-poll-opt]').forEach(function(inp) {
      var v = inp.value.trim()
      if (v) options.push(v)
    })
    if (!question || options.length < 2) return null
    return { question: question, options: options }
  }

  function updatePublishState() {
    if (!publishBtn || activeType !== 'news' || !hasNews) return
    var text = textarea ? textarea.value.trim() : ''
    var poll = getPollData()
    var can = !!(text || media.length > 0 || poll)
    publishBtn.disabled = submitting || !can
  }

  function mediaIcon(name) {
    var tpl = overlay.querySelector('[data-add-content-tpl-chevron-' + name + ']')
    if (!tpl || !tpl.content || !tpl.content.firstElementChild) return null
    return tpl.content.firstElementChild.cloneNode(true)
  }

  function moveMedia(id, delta) {
    var idx = -1
    for (var i = 0; i < media.length; i++) {
      if (media[i].id === id) { idx = i; break }
    }
    if (idx < 0) return
    var target = idx + delta
    if (target < 0 || target >= media.length) return
    var tmp = media[idx]
    media[idx] = media[target]
    media[target] = tmp
    renderMedia()
  }

  function renderMedia() {
    if (!mediaWrap) return
    mediaWrap.innerHTML = ''
    if (media.length === 0) {
      mediaWrap.hidden = true
      updatePublishState()
      return
    }
    mediaWrap.hidden = false
    var canReorder = media.length > 1
    media.forEach(function(item, index) {
      var box = document.createElement('div')
      box.className = 'add-content__media-item'
      box.setAttribute('data-add-content-media-item', item.id)

      var thumb = document.createElement('div')
      thumb.className = 'add-content__media-thumb'

      if (item.type === 'video') {
        var vid = document.createElement('video')
        vid.src = item.previewUrl || item.url
        vid.muted = true
        vid.playsInline = true
        vid.setAttribute('preload', 'metadata')
        thumb.appendChild(vid)
        var badge = document.createElement('span')
        badge.className = 'add-content__media-badge'
        badge.textContent = '▶'
        thumb.appendChild(badge)
      } else {
        var img = document.createElement('img')
        img.src = item.previewUrl || item.url
        img.alt = ''
        thumb.appendChild(img)
      }

      if (item.uploading) {
        var load = document.createElement('span')
        load.className = 'add-content__media-loading'
        load.textContent = 'Envoi…'
        thumb.appendChild(load)
      }

      var rm = document.createElement('button')
      rm.type = 'button'
      rm.className = 'add-content__media-remove'
      rm.setAttribute('aria-label', 'Retirer')
      rm.textContent = '×'
      rm.addEventListener('click', function() {
        media = media.filter(function(m) { return m.id !== item.id })
        if (item.previewUrl && item.previewUrl.indexOf('blob:') === 0) {
          try { URL.revokeObjectURL(item.previewUrl) } catch (e) {}
        }
        renderMedia()
      })
      if (canReorder) {
        var reorder = document.createElement('div')
        reorder.className = 'add-content__media-reorder'
        reorder.setAttribute('aria-label', 'Réordonner')

        var prevBtn = document.createElement('button')
        prevBtn.type = 'button'
        prevBtn.className = 'add-content__media-move'
        prevBtn.setAttribute('aria-label', 'Déplacer avant')
        prevBtn.disabled = index === 0 || !!item.uploading
        var prevIcon = mediaIcon('left')
        if (prevIcon) prevBtn.appendChild(prevIcon)
        prevBtn.addEventListener('click', function(e) { e.stopPropagation(); moveMedia(item.id, -1) })
        reorder.appendChild(prevBtn)

        var nextBtn = document.createElement('button')
        nextBtn.type = 'button'
        nextBtn.className = 'add-content__media-move'
        nextBtn.setAttribute('aria-label', 'Déplacer après')
        nextBtn.disabled = index === media.length - 1 || !!item.uploading
        var nextIcon = mediaIcon('right')
        if (nextIcon) nextBtn.appendChild(nextIcon)
        nextBtn.addEventListener('click', function(e) { e.stopPropagation(); moveMedia(item.id, 1) })
        reorder.appendChild(nextBtn)

        thumb.appendChild(reorder)
      }

      thumb.appendChild(rm)
      box.appendChild(thumb)
      mediaWrap.appendChild(box)
    })
    updatePublishState()
  }

  function readVideoMeta(file, cb) {
    var url = URL.createObjectURL(file)
    var v = document.createElement('video')
    v.preload = 'metadata'
    v.onloadedmetadata = function() {
      var duration = v.duration
      URL.revokeObjectURL(url)
      if (duration > MAX_VIDEO_SECONDS) {
        cb(false, 'La vidéo ne doit pas dépasser 5 minutes (' + Math.round(duration) + ' s détectées).')
      } else {
        cb(true)
      }
    }
    v.onerror = function() {
      URL.revokeObjectURL(url)
      cb(false, 'Impossible de lire cette vidéo.')
    }
    v.src = url
  }

  function readImageMeta(file, cb) {
    var url = URL.createObjectURL(file)
    var img = new Image()
    img.onload = function() {
      cb(true, img.naturalWidth, img.naturalHeight)
      URL.revokeObjectURL(url)
    }
    img.onerror = function() {
      URL.revokeObjectURL(url)
      cb(true, null, null)
    }
    img.src = url
  }

  function uploadFile(file, type, width, height) {
    if (media.length >= MAX_MEDIA) {
      showError('Maximum ' + MAX_MEDIA + ' médias par publication.')
      return
    }
    var id = nextId()
    var previewUrl = URL.createObjectURL(file)
    var item = { id: id, type: type, url: '', previewUrl: previewUrl, uploading: true, width: width, height: height }
    media.push(item)
    renderMedia()
    showError('')

    var fd = new FormData()
    fd.append('file', file)
    fetch('/api/product-upload', { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data } }) })
      .then(function(result) {
        var found = media.find(function(m) { return m.id === id })
        if (!found) return
        if (result.ok && result.data && result.data.success && result.data.url) {
          found.url = result.data.url
          found.uploading = false
          found.type = result.data.type || type
        } else {
          media = media.filter(function(m) { return m.id !== id })
          showError((result.data && result.data.error) || 'Erreur lors de l\'envoi du fichier.')
        }
        renderMedia()
      })
      .catch(function() {
        media = media.filter(function(m) { return m.id !== id })
        showError('Erreur réseau lors de l\'envoi.')
        renderMedia()
      })
  }

  function open() {
    overlay.hidden = false
    lockScroll()
    if (!overlay.parentElement || overlay.parentElement !== document.body) {
      document.body.appendChild(overlay)
    }
    setActiveType(defaultType)
    resetComposer()
  }

  function close() {
    overlay.hidden = true
    unlockScroll()
    if (emojiPop) emojiPop.hidden = true
  }

  function setSubmitting(on) {
    submitting = on
    if (spinner) spinner.hidden = !on
    if (publishText) publishText.hidden = on
    if (on) {
      if (publishBtn) publishBtn.disabled = true
    } else {
      updatePublishState()
    }
  }

  function publish() {
    if (submitting || activeType !== 'news') return
    var uploading = media.some(function(m) { return m.uploading })
    if (uploading) {
      showError('Patiente pendant l\'envoi des médias.')
      return
    }
    var content = textarea ? textarea.value.trim() : ''
    var poll = getPollData()
    if (!content && media.length === 0 && !poll) {
      showError('Ajoute du texte, un média ou un sondage.')
      return
    }
    if (pollEnabled && !poll) {
      showError('Complète la question et au moins 2 options du sondage.')
      return
    }

    setSubmitting(true)
    showError('')

    var payload = {
      content: content,
      poll: poll,
      media: media.filter(function(m) { return m.url && !m.uploading }).map(function(m) {
        return { url: m.url, type: m.type, width: m.width, height: m.height }
      }),
    }

    fetch('/api/publications', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload),
    })
      .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data } }) })
      .then(function(result) {
        if (result.ok && result.data && result.data.success) {
          window.location.reload()
          return
        }
        setSubmitting(false)
        showError((result.data && result.data.error) || 'Erreur lors de la publication.')
      })
      .catch(function() {
        setSubmitting(false)
        showError('Erreur réseau.')
      })
  }

  document.querySelectorAll('[data-open-add-content-overlay]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault()
      open()
    })
  })

  document.querySelectorAll('[data-open-publication-overlay]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault()
      if (!hasNews) {
        open()
        return
      }
      defaultType = 'news'
      open()
      setActiveType('news')
    })
  })

  overlay.querySelectorAll('[data-add-content-close]').forEach(function(btn) {
    btn.addEventListener('click', close)
  })

  overlay.querySelectorAll('[data-add-content-tool]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.disabled) return
      var type = btn.getAttribute('data-add-content-type')
      var mode = btn.getAttribute('data-add-content-mode')
      if (mode === 'composer' || type === 'news') {
        setActiveType('news')
        return
      }
      if (window.ibeeMarkReturnToAddContent) window.ibeeMarkReturnToAddContent()
      close()
    })
  })

  if (textarea) {
    textarea.addEventListener('input', updatePublishState)
  }

  if (pollQ) pollQ.addEventListener('input', updatePublishState)
  if (pollOptionsWrap) {
    pollOptionsWrap.addEventListener('input', updatePublishState)
  }

  if (pollToggleBtn) {
    pollToggleBtn.addEventListener('click', function() {
      pollEnabled = true
      if (pollPanel) pollPanel.hidden = false
      renderPollOptions()
      updatePublishState()
    })
  }

  if (pollRemoveBtn) {
    pollRemoveBtn.addEventListener('click', function() {
      pollEnabled = false
      if (pollPanel) pollPanel.hidden = true
      if (pollQ) pollQ.value = ''
      renderPollOptions()
      updatePublishState()
    })
  }

  if (pollAddBtn) {
    pollAddBtn.addEventListener('click', function() {
      if (pollOptionCount < 4) {
        pollOptionCount += 1
        renderPollOptions()
      }
    })
  }

  if (emojiBtn && emojiPop) {
    emojiBtn.addEventListener('click', function(e) {
      e.stopPropagation()
      emojiPop.hidden = !emojiPop.hidden
    })
    emojiPop.querySelectorAll('[data-add-content-emoji-pick]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var em = btn.getAttribute('data-add-content-emoji-pick') || ''
        if (textarea) {
          var start = textarea.selectionStart
          var end = textarea.selectionEnd
          var val = textarea.value
          textarea.value = val.slice(0, start) + em + val.slice(end)
          textarea.focus()
          textarea.selectionStart = textarea.selectionEnd = start + em.length
        }
        emojiPop.hidden = true
        updatePublishState()
      })
    })
  }

  document.addEventListener('click', function(e) {
    if (emojiPop && !emojiPop.hidden) {
      var wrap = overlay.querySelector('.add-content__emoji-wrap')
      if (wrap && !wrap.contains(e.target)) emojiPop.hidden = true
    }
  })

  if (imageBtn && imageInput) {
    imageBtn.addEventListener('click', function() { imageInput.click() })
    imageInput.addEventListener('change', function() {
      var files = imageInput.files
      if (!files) return
      Array.prototype.forEach.call(files, function(file) {
        if (media.length >= MAX_MEDIA) return
        readImageMeta(file, function(ok, w, h) {
          if (ok) uploadFile(file, 'image', w, h)
        })
      })
      imageInput.value = ''
    })
  }

  if (videoBtn && videoInput) {
    videoBtn.addEventListener('click', function() { videoInput.click() })
    videoInput.addEventListener('change', function() {
      var file = videoInput.files && videoInput.files[0]
      if (!file) return
      readVideoMeta(file, function(ok, err) {
        if (!ok) {
          showError(err || 'Vidéo invalide.')
          return
        }
        uploadFile(file, 'video', null, null)
      })
      videoInput.value = ''
    })
  }

  if (publishBtn) publishBtn.addEventListener('click', publish)

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !overlay.hidden) close()
  })

  renderPollOptions()
})()
</script>

