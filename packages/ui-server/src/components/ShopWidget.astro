---
import { Plus, ShoppingBag } from 'lucide-static'

interface Product {
  id: string
  title: string
  slug?: string
  description?: string | null
  price_cents?: number | null
  currency?: string
  image_url?: string | null
  /** Statut du produit — affiche un badge Brouillon/Archivé pour l'owner. */
  status?: string | null
}

interface Props {
  products?: Product[]
  isOwner?: boolean
  currency?: string
  /** Slug de l'entity — active les liens vers les fiches produit /[slug]/shop/[productSlug]. */
  entitySlug?: string
}

const { products = [], isOwner = false, currency = 'EUR', entitySlug } = Astro.props

const STATUS_LABELS: Record<string, string> = {
  draft: 'Brouillon',
  archived: 'Archivé',
}

function formatPrice(cents: number | null | undefined, currency: string): string {
  if (cents == null) return ''
  const value = cents / 100
  try {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(value)
  } catch {
    return `${value.toFixed(2)} €`
  }
}
---
<section class="shop-section">
  {products.length === 0 ? (
    <div class="shop-empty">
      <span class="shop-empty__icon" set:html={ShoppingBag} />
      <h3 class="shop-empty__title">Aucun produit pour le moment</h3>
      <p class="shop-empty__desc">
        {isOwner
          ? 'Ajoute ton premier produit pour démarrer ta boutique.'
          : 'Cette boutique ne propose pas encore de produits.'}
      </p>
      {isOwner && (
        <button type="button" data-open-product-overlay class="shop-empty__cta">
          <span class="flex h-4 w-4 items-center justify-center" set:html={Plus} />
          Ajouter un produit
        </button>
      )}
    </div>
  ) : (
    <div class="shop-list">
      {products.map((product) => {
        const href = entitySlug && product.slug ? `/${entitySlug}/shop/${product.slug}` : null
        const statusBadge = isOwner && product.status && product.status !== 'published'
          ? STATUS_LABELS[product.status]
          : null
        return (
          <article class="shop-item">
            <div class="shop-item__img">
              {product.image_url ? (
                <img src={product.image_url} alt={product.title} class="h-full w-full object-cover" />
              ) : (
                <div class="shop-item__img-placeholder" aria-hidden="true">
                  <span class="flex h-6 w-6 items-center justify-center text-neutral-400" set:html={ShoppingBag} />
                </div>
              )}
            </div>
            <div class="shop-item__body">
              <h3 class="shop-item__name">
                {product.title}
                {statusBadge && <span class="shop-item__badge">{statusBadge}</span>}
              </h3>
              {product.description && (
                <p class="shop-item__desc">{product.description}</p>
              )}
            </div>
            {product.price_cents != null && (
              <div class="shop-item__price">{formatPrice(product.price_cents, product.currency ?? currency)}</div>
            )}
            {href ? (
              <a href={href} class="shop-item__cta">Voir la fiche</a>
            ) : (
              <button type="button" class="shop-item__cta shop-item__cta--soon" disabled>Bientôt disponible</button>
            )}
          </article>
        )
      })}
      {isOwner && (
        <button type="button" data-open-product-overlay class="shop-add-btn">
          <span class="flex h-4 w-4 items-center justify-center" set:html={Plus} />
          Ajouter un produit
        </button>
      )}
    </div>
  )}
</section>

<style>
  .shop-section {
    padding: 0 27px 24px;
  }

  /* Empty state */
  .shop-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 48px 24px;
    background: var(--color-panel);
    border-radius: 14px;
    text-align: center;
  }
  .shop-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-neutral-400);
  }
  .shop-empty__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-neutral-900);
    margin: 8px 0 0;
  }
  .shop-empty__desc {
    font-size: 13px;
    color: var(--color-neutral-500);
    margin: 0 0 12px;
    max-width: 360px;
  }
  .shop-empty__cta,
  .shop-add-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 16px;
    border-radius: 50px;
    background: transparent;
    border: 1.5px dashed var(--color-border);
    color: var(--color-neutral-500);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 120ms, color 120ms;
    font-family: inherit;
  }
  .shop-empty__cta:hover,
  .shop-add-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* List */
  .shop-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shop-item {
    display: grid;
    grid-template-columns: 90px 1fr auto auto;
    align-items: center;
    gap: 18px;
    padding: 14px 18px;
    background: var(--color-panel);
    border-radius: 12px;
    transition: background 160ms;
  }
  .shop-item:hover {
    background: var(--color-panel-2);
  }
  .shop-item__img {
    width: 90px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-panel-2);
    flex-shrink: 0;
  }
  .shop-item__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: repeating-linear-gradient(
      135deg,
      var(--color-panel) 0,
      var(--color-panel) 4px,
      var(--color-surface) 4px,
      var(--color-surface) 10px
    );
  }
  .shop-item__body {
    min-width: 0;
  }
  .shop-item__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-neutral-900);
    margin: 0;
  }
  .shop-item__badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-panel-2);
    color: var(--color-neutral-500);
    font-family: var(--font-sans, inherit);
    font-size: 11px;
    font-weight: 500;
    vertical-align: middle;
  }
  .shop-item__desc {
    color: var(--color-neutral-500);
    font-size: 14px;
    margin: 4px 0 0;
    line-height: 1.4;
  }
  .shop-item__price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-neutral-900);
  }
  .shop-item__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background 120ms;
    font-family: inherit;
    text-decoration: none;
  }
  .shop-item__cta:hover {
    background: var(--color-accent-hover);
  }
  .shop-item__cta--soon {
    background: var(--color-panel-2);
    color: var(--color-neutral-500);
    cursor: not-allowed;
  }
  .shop-item__cta--soon:hover {
    background: var(--color-panel-2);
  }
</style>
