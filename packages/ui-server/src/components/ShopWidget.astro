---
/** Widget Shop Accueil : carrousel catégorie (tile--rich) ou fiche produit mise en avant. */
import { ShoppingBag, Star } from 'lucide-static'
import WidgetFeatured from './WidgetFeatured.astro'
import WidgetCategoryCarousel from './WidgetCategoryCarousel.astro'

export type ShopWidgetItem = {
  title: string
  slug?: string
  imageUrl?: string | null
  detailExcerpt?: string | null
  reviewCount?: number
  reviewAverage?: number
  price_cents?: number | null
  sale_price_cents?: number | null
  sale_ends_at?: string | null
  currency?: string
  type?: string | null
  physical_stock_quantity?: number | null
}

interface Props {
  entitySlug: string
  mode: 'category' | 'product'
  items: ShopWidgetItem[]
  categoryTitle?: string
  moreHref?: string
  embedded?: boolean
}

const {
  entitySlug,
  mode,
  items,
  categoryTitle = 'Collection',
  moreHref,
  embedded = false,
} = Astro.props

function formatPrice(cents: number | null | undefined, currency: string | undefined): string {
  if (cents == null || cents === 0) return '0€'
  const value = cents / 100
  try {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: currency || 'EUR' }).format(value)
  } catch {
    return `${value.toFixed(2)} €`
  }
}

function saleActive(item: ShopWidgetItem): boolean {
  if (item.sale_price_cents == null) return false
  if (!item.sale_ends_at) return true
  return new Date(item.sale_ends_at).getTime() > Date.now()
}

function salePercent(item: ShopWidgetItem): number {
  if (!saleActive(item) || item.price_cents == null || item.price_cents <= 0) return 0
  return Math.round((1 - (item.sale_price_cents as number) / item.price_cents) * 100)
}

function typeLabel(item: ShopWidgetItem): string {
  return item.type === 'digital' ? 'Numérique' : 'Physique'
}

function stockBadge(item: ShopWidgetItem): string | null {
  if (item.type === 'digital') return null
  const q = item.physical_stock_quantity
  if (q == null) return null
  if (q === 0) return 'Épuisé'
  if (q <= 5) return `Plus que ${q}`
  return null
}

const starRow = (rating: number) =>
  Array.from({ length: 5 }, (_, i) => i < Math.round(rating))

const featured = mode === 'product' && items[0]
  ? (() => {
      const item = items[0]
      const onSale = saleActive(item)
      return {
        title: item.title,
        imageUrl: item.imageUrl ?? null,
        href: item.slug ? `/${entitySlug}/shop/${item.slug}` : `/${entitySlug}#shop`,
        tags: [typeLabel(item)],
        promo: onSale,
        priceLabel: formatPrice(onSale ? item.sale_price_cents : item.price_cents, item.currency),
        oldPriceLabel: onSale ? formatPrice(item.price_cents, item.currency) : null,
      }
    })()
  : null

const tiles = mode === 'category'
  ? items.map((item) => ({
      item,
      href: item.slug ? `/${entitySlug}/shop/${item.slug}` : `/${entitySlug}#shop`,
      onSale: saleActive(item),
      percent: salePercent(item),
      stock: stockBadge(item),
    }))
  : []
---
{mode === 'product' && featured ? (
  <WidgetFeatured
    embedded={embedded}
    href={featured.href}
    imageUrl={featured.imageUrl}
    placeholderIcon={ShoppingBag}
    badgeLabel="Produit"
    title={featured.title}
    tags={featured.tags}
    priceLabel={featured.priceLabel}
    oldPriceLabel={featured.oldPriceLabel}
    promo={featured.promo}
    ctaLabel="Acheter"
  />
) : tiles.length > 0 ? (
  <WidgetCategoryCarousel
    embedded={embedded}
    categoryTitle={categoryTitle}
    moreHref={moreHref}
    showNav={tiles.length > 1}
    navPrevLabel="Produit précédent"
    navNextLabel="Produit suivant"
  >
    {tiles.map(({ item, href, onSale, percent, stock }) => {
      const excerpt = item.detailExcerpt?.trim() ?? ''
      const reviewCount = item.reviewCount ?? 0
      const reviewAverage = item.reviewAverage ?? 0
      const showPrice = item.price_cents != null
      return (
        <div class="tile tile--rich wcat__tile">
          <a class="tile__stretch" href={href} aria-label={item.title}></a>
          <div class="tile__media">
            {onSale && percent > 0 ? (
              <span class="tile__badge">-{percent}%</span>
            ) : stock ? (
              <span class="tile__badge tile__badge--dark">{stock}</span>
            ) : null}
            {showPrice && (
              <span class="tile__price-badge">
                {onSale ? (
                  <>
                    <span class="tile__price-now">{formatPrice(item.sale_price_cents, item.currency)}</span>
                    <s class="tile__price-was">{formatPrice(item.price_cents, item.currency)}</s>
                  </>
                ) : (
                  <span class="tile__price-now">{formatPrice(item.price_cents, item.currency)}</span>
                )}
              </span>
            )}
            {item.imageUrl ? (
              <img src={item.imageUrl} alt={item.title} loading="lazy" />
            ) : (
              <div class="ph" aria-hidden="true">
                <span class="flex h-6 w-6 items-center justify-center" set:html={ShoppingBag} />
              </div>
            )}
          </div>
          <div class="tile__body">
            <div class="tile__head">
              <div class="tile__title">{item.title}</div>
              <div class="tile__meta">{typeLabel(item)}</div>
            </div>
            {excerpt && (
              <div class="tile__detail">
                <p class="tile__detail-text">{excerpt}</p>
              </div>
            )}
            <div class="tile__reviews">
              {reviewCount > 0 ? (
                <>
                  <span class="tile__stars" aria-hidden="true">
                    {starRow(reviewAverage).map((on) => (
                      <span class:list={['tile__star', on && 'is-on']} set:html={Star} />
                    ))}
                  </span>
                  <span class="tile__rating">{reviewAverage.toFixed(1).replace('.', ',')}</span>
                  <span class="tile__review-count">({reviewCount} avis)</span>
                </>
              ) : (
                <span class="tile__review-empty">Soyez le premier à noter</span>
              )}
            </div>
          </div>
        </div>
      )
    })}
  </WidgetCategoryCarousel>
) : null}
