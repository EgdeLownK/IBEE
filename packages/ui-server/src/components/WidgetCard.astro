---
import { MoreVertical, Pencil, Trash2, ArrowUp, ArrowDown } from 'lucide-static'

type WidgetEditMode = 'config' | 'faq' | 'none'

interface Props {
  title: string
  isOwner?: boolean
  widgetId?: string
  /** config = overlay réglages ; faq = éditeur de contenu ; none = automatique. */
  editMode?: WidgetEditMode
  /** Au moins un élément sélectionné / contenu affiché → pas de fond gris. */
  filled?: boolean
  /** Menu Monter/Descendre (owner). */
  sortable?: boolean
  canMoveUp?: boolean
  canMoveDown?: boolean
}

const {
  title,
  isOwner = false,
  widgetId,
  editMode = 'config',
  filled = false,
  sortable = false,
  canMoveUp = false,
  canMoveDown = false,
} = Astro.props
const showEdit = isOwner && editMode !== 'none'
const menuId = widgetId ? `widget-menu-${widgetId}` : undefined
const editAttr =
  editMode === 'faq' ? 'data-open-faq-overlay' : 'data-open-home-widget-config'
const editLabel =
  editMode === 'config' ? 'Modifier le widget' : 'Modifier le contenu'
---
{sortable && widgetId ? (
  <div
    class="widget-sort-item"
    data-widget-sort-item
    data-widget-id={widgetId}
  >
    <article class:list={['widget', filled && 'widget--filled']}>
      <header class="widget__head">
        <h3 class="widget__title">{title}</h3>
        {menuId && (
          <button
            type="button"
            class="widget__menu-trigger"
            popovertarget={menuId}
            style={`anchor-name: --${menuId};`}
            data-widget-menu-toggle
            aria-haspopup="menu"
            aria-label="Options du widget"
          >
            <span class="flex h-5 w-5 items-center justify-center" set:html={MoreVertical} />
          </button>
        )}
      </header>
      <div class="widget__body">
        <slot />
      </div>
    </article>
    {menuId && (
      <div id={menuId} popover="auto" class="widget-menu" style={`position-anchor: --${menuId};`} data-widget-menu role="menu">
        <button
          type="button"
          class="widget-menu__item"
          role="menuitem"
          data-widget-move="up"
          data-widget-id={widgetId}
          disabled={!canMoveUp}
          aria-label="Monter le widget"
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={ArrowUp} />
          <span>Monter</span>
        </button>
        <button
          type="button"
          class="widget-menu__item"
          role="menuitem"
          data-widget-move="down"
          data-widget-id={widgetId}
          disabled={!canMoveDown}
          aria-label="Descendre le widget"
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={ArrowDown} />
          <span>Descendre</span>
        </button>
        {showEdit && (
          <button
            type="button"
            class="widget-menu__item"
            role="menuitem"
            {...{ [editAttr]: editMode === 'config' ? widgetId : '' }}
            aria-label={editLabel}
          >
            <span class="flex h-4 w-4 items-center justify-center" set:html={Pencil} />
            <span>Modifier</span>
          </button>
        )}
        <button
          type="button"
          class="widget-menu__item widget-menu__item--danger"
          role="menuitem"
          data-widget-delete={widgetId}
          aria-label="Supprimer le widget"
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={Trash2} />
          <span>Supprimer</span>
        </button>
      </div>
    )}
  </div>
) : (
  <>
    <article class:list={['widget', filled && 'widget--filled']}>
      <header class="widget__head">
        <h3 class="widget__title">{title}</h3>
        {isOwner && widgetId && menuId && (
          <button
            type="button"
            class="widget__menu-trigger"
            popovertarget={menuId}
            style={`anchor-name: --${menuId};`}
            data-widget-menu-toggle
            aria-haspopup="menu"
            aria-label="Options du widget"
          >
            <span class="flex h-5 w-5 items-center justify-center" set:html={MoreVertical} />
          </button>
        )}
      </header>
      <div class="widget__body">
        <slot />
      </div>
    </article>
    {isOwner && widgetId && menuId && (
      <div id={menuId} popover="auto" class="widget-menu" style={`position-anchor: --${menuId};`} data-widget-menu role="menu">
        {showEdit && (
          <button
            type="button"
            class="widget-menu__item"
            role="menuitem"
            {...{ [editAttr]: editMode === 'config' ? widgetId : '' }}
            aria-label={editLabel}
          >
            <span class="flex h-4 w-4 items-center justify-center" set:html={Pencil} />
            <span>Modifier</span>
          </button>
        )}
        <button
          type="button"
          class="widget-menu__item widget-menu__item--danger"
          role="menuitem"
          data-widget-delete={widgetId}
          aria-label="Supprimer le widget"
        >
          <span class="flex h-4 w-4 items-center justify-center" set:html={Trash2} />
          <span>Supprimer</span>
        </button>
      </div>
    )}
  </>
)}

<style>
  .widget {
    background: var(--color-panel);
    border-radius: 14px;
    padding: 16px;
    border: 1px solid transparent;
    transition: border-color 160ms, box-shadow 160ms, background 160ms;
  }
  .widget--filled {
    background: transparent;
    border-color: transparent;
    padding-left: 0;
    padding-right: 0;
  }
  .widget:not(.widget--filled):hover {
    box-shadow: var(--shadow-card);
  }
  .widget__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .widget__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    margin: 0;
    color: var(--color-neutral-900);
  }
  .widget__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .widget__menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-neutral-500);
    cursor: pointer;
    transition: background 120ms, color 120ms;
  }
  .widget__menu-trigger:hover {
    background: var(--color-panel-2);
    color: var(--color-neutral-900);
  }
</style>
