---
import AppointmentTypeCard from './AppointmentTypeCard.astro'

interface ServiceItem {
  id: string
  title: string
  slug: string
  description?: string | null
  duration_minutes: number
  location_type: string
  price_cents: number | null
  promo_price_cents?: number | null
  currency: string
  gallery_images?: string[] | null
}

interface Props {
  services: ServiceItem[]
  entitySlug: string
  title?: string
}

const { services, entitySlug, title = 'Autres services' } = Astro.props

// On réutilise le design du menu service (AppointmentTypeCard / .row), limité à 4.
const visible = services.slice(0, 4)
---
{visible.length > 0 && (
  <div class="reco">
    <h2 class="reco__title">{title}</h2>
    <div class="flex flex-col gap-2">
      {visible.map((svc) => (
        <AppointmentTypeCard
          id={svc.id}
          title={svc.title}
          slug={svc.slug}
          description={svc.description ?? null}
          durationMinutes={svc.duration_minutes}
          locationType={svc.location_type}
          priceCents={svc.price_cents}
          promoPriceCents={svc.promo_price_cents ?? null}
          currency={svc.currency}
          coverImageUrl={svc.gallery_images?.[0] ?? null}
          entitySlug={entitySlug}
        />
      ))}
    </div>
  </div>
)}

<style>
  .reco__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-neutral-900);
  }
</style>
