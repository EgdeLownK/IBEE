---
/** Carrousel catégorie (plusieurs tuiles tile--rich) — shell partagé Shop / Service / Event. */
import { ChevronLeft, ChevronRight } from 'lucide-static'

interface Props {
  categoryTitle: string
  moreHref?: string
  embedded?: boolean
  navPrevLabel?: string
  navNextLabel?: string
  showNav?: boolean
}

const {
  categoryTitle,
  moreHref,
  embedded = false,
  navPrevLabel = 'Élément précédent',
  navNextLabel = 'Élément suivant',
  showNav = true,
} = Astro.props
---
<section class:list={['wcat', embedded && 'wcat--embedded']} data-swidget-root>
  <div class="wcat__head">
    <h2 class="wcat__title">{categoryTitle}</h2>
    {moreHref && <a href={moreHref} class="wcat__more">Voir plus</a>}
  </div>

  <div class="wcat__carousel">
    <div class="wcat__track" data-swidget-track>
      <slot />
    </div>
    {showNav && (
      <>
        <button type="button" class="wcat__nav wcat__nav--prev" data-swidget-prev aria-label={navPrevLabel}>
          <span class="flex items-center justify-center" set:html={ChevronLeft} />
        </button>
        <button type="button" class="wcat__nav wcat__nav--next" data-swidget-next aria-label={navNextLabel}>
          <span class="flex items-center justify-center" set:html={ChevronRight} />
        </button>
      </>
    )}
  </div>
</section>

<style>
  .wcat {
    margin-top: 26px;
  }
  .wcat--embedded {
    margin-top: 0;
  }

  .wcat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 14px;
    padding: 0 22px;
  }
  .wcat--embedded .wcat__head {
    padding: 0;
  }
  .wcat__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-neutral-900);
  }
  .wcat__more {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0.92;
    transition: opacity 160ms ease;
  }
  .wcat__more:hover {
    opacity: 1;
  }

  .wcat__carousel {
    position: relative;
  }
  .wcat__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 22px;
    padding: 0 22px 4px;
    scrollbar-width: none;
  }
  .wcat--embedded .wcat__track {
    scroll-padding-left: 0;
    padding: 0 0 4px;
  }
  .wcat__track::-webkit-scrollbar {
    display: none;
  }

  .wcat__track :global(.wcat__tile) {
    flex: 0 0 58%;
    max-width: 220px;
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .wcat__track :global(.wcat__tile) {
      flex: 0 0 200px;
      max-width: 200px;
    }
  }

  .wcat__nav {
    display: none;
  }
  @media (min-width: 768px) {
    .wcat__track {
      cursor: grab;
    }
    .wcat__track.is-grabbing {
      cursor: grabbing;
      scroll-behavior: auto;
      user-select: none;
    }
    .wcat__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(8px);
      color: var(--color-neutral-800);
      box-shadow: 0 6px 18px -10px rgba(0, 0, 0, .35);
      cursor: pointer;
      transition: background .16s ease, transform .08s ease, opacity .16s ease;
    }
    .wcat__nav:hover {
      background: var(--color-surface);
    }
    .wcat__nav:active {
      transform: translateY(-50%) scale(.94);
    }
    .wcat__nav--prev {
      left: 30px;
    }
    .wcat__nav--next {
      right: 30px;
    }
    .wcat--embedded .wcat__nav--prev {
      left: 4px;
    }
    .wcat--embedded .wcat__nav--next {
      right: 4px;
    }
    .wcat__nav[disabled] {
      opacity: 0;
      pointer-events: none;
    }
    .wcat__nav :global(svg) {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script is:inline>
(function() {
  document.querySelectorAll('[data-swidget-root]').forEach(function(root) {
    var track = root.querySelector('[data-swidget-track]')
    if (!track) return
    var prevBtn = root.querySelector('[data-swidget-prev]')
    var nextBtn = root.querySelector('[data-swidget-next]')
    var slideStep = function() {
      var slide = track.querySelector('.wcat__tile')
      var w = slide ? slide.getBoundingClientRect().width : track.clientWidth * 0.6
      return w + 14
    }
    var updateNav = function() {
      var max = track.scrollWidth - track.clientWidth
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 1
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= max - 1
    }
    if (prevBtn) prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -slideStep(), behavior: 'smooth' })
    })
    if (nextBtn) nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: slideStep(), behavior: 'smooth' })
    })
    track.addEventListener('scroll', updateNav)
    window.addEventListener('resize', updateNav)
    updateNav()

    var isDown = false, startX = 0, startScroll = 0
    track.addEventListener('pointerdown', function(e) {
      if (e.pointerType === 'touch') return
      isDown = true
      startX = e.clientX
      startScroll = track.scrollLeft
      track.style.scrollSnapType = 'none'
      track.classList.add('is-grabbing')
    })
    var onPointerMove = function(e) {
      if (!isDown) return
      track.scrollLeft = startScroll - (e.clientX - startX)
    }
    var endDrag = function() {
      if (!isDown) return
      isDown = false
      track.style.scrollSnapType = ''
      track.classList.remove('is-grabbing')
    }
    window.addEventListener('pointermove', onPointerMove)
    window.addEventListener('pointerup', endDrag)
    window.addEventListener('pointercancel', endDrag)
    track.addEventListener('dragstart', function(e) { e.preventDefault() })
  })
})()
</script>
