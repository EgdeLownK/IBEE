---
export type BannerImage = {
  url: string
  aspect_ratio: number
}

interface Props {
  images?: BannerImage[]
  /** Non affiché — utilisé pour l'attribut alt (SEO). */
  seoTitle?: string
}

const { images = [], seoTitle = '' } = Astro.props

const hasImages = images.length > 0
const imgAlt = seoTitle.trim()
---
{hasImages && (
  <div class="banner-welcome">
    <div class:list={['banner-welcome__gallery', `banner-welcome__gallery--count-${Math.min(images.length, 3)}`]}>
      {images.map((img, index) => (
        <div
          class="banner-welcome__media"
          style={`--banner-aspect: ${images.length === 1 ? img.aspect_ratio : 1}`}
        >
          <img
            src={img.url}
            alt={index === 0 && imgAlt ? imgAlt : ''}
            loading="lazy"
            class="banner-welcome__img"
          />
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .banner-welcome {
    overflow: hidden;
  }

  .banner-welcome__gallery {
    display: grid;
    gap: 6px;
  }

  .banner-welcome__gallery--count-1 {
    grid-template-columns: 1fr;
  }

  .banner-welcome__gallery--count-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .banner-welcome__gallery--count-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 520px) {
    .banner-welcome__gallery--count-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .banner-welcome__media {
    aspect-ratio: var(--banner-aspect, 16 / 9);
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-panel);
  }

  .banner-welcome__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
