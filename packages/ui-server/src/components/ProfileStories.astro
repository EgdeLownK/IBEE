---
import { Plus, Image as ImageIcon } from 'lucide-static'

/**
 * Stories du profil (format Instagram) : ronds image + titre court dessous,
 * placées juste sous les boutons du hero. Même comportement que les onglets :
 * taille fixe, alignées à gauche, défilement horizontal.
 * Backend à venir (table stories + upload) — le owner voit le bouton d'ajout.
 */
interface Story {
  id: string
  title: string
  imageUrl?: string | null
}

interface Props {
  stories?: Story[]
  isOwner?: boolean
}

const { stories = [], isOwner = false } = Astro.props

/** Titre limité à 15 caractères max. */
const truncate = (t: string) => (t.length > 15 ? `${t.slice(0, 15)}…` : t)
---
{(stories.length > 0 || isOwner) && (
  <div class="stories no-scrollbar" aria-label="Stories">
    {isOwner && (
      <button type="button" class="story" data-story-add title="Bientôt disponible">
        <span class="story__circle story__circle--add">
          <span class="flex h-5 w-5 items-center justify-center" set:html={Plus} />
        </span>
        <span class="story__title">Nouvelle</span>
      </button>
    )}
    {stories.map((s) => (
      <button type="button" class="story" data-story={s.id}>
        <span class="story__circle">
          {s.imageUrl ? (
            <img src={s.imageUrl} alt={s.title} loading="lazy" />
          ) : (
            <span class="story__placeholder" aria-hidden="true">
              <span class="flex h-5 w-5 items-center justify-center" set:html={ImageIcon} />
            </span>
          )}
        </span>
        <span class="story__title">{truncate(s.title)}</span>
      </button>
    ))}
  </div>
)}

{/* Stub : la création/lecture de stories arrive avec son backend */}
<script is:inline>
  (function () {
    var addBtn = document.querySelector('[data-story-add]')
    if (addBtn) addBtn.addEventListener('click', function () {
      alert('Stories : bientôt disponible')
    })
  })()
</script>

<style>
  .stories {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 22px 22px 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .story {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    width: 68px;
    flex-shrink: 0;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  /* Anneau accent + liseré blanc, image ronde à l'intérieur */
  .story__circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    padding: 3px;
    background: var(--color-surface);
    transition: transform .12s ease;
  }
  .story:hover .story__circle { transform: scale(1.04); }
  .story:active .story__circle { transform: scale(.97); }

  .story__circle img,
  .story__placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .story__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-panel-2);
    color: var(--color-neutral-400);
  }

  .story__circle--add {
    border-style: dashed;
    border-color: var(--color-border);
    color: var(--color-neutral-500);
    transition: border-color .12s, color .12s, transform .12s ease;
  }
  .story:hover .story__circle--add {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .story__title {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-neutral-600);
    white-space: nowrap;
    max-width: 68px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
