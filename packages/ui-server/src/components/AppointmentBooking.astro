---
import AppointmentTypeCard from './AppointmentTypeCard.astro'
import { CalendarClock } from 'lucide-static'

interface AppointmentType {
  id: string
  title: string
  slug: string
  description: string | null
  duration_minutes: number
  location_type: string
  price_cents: number | null
  promo_price_cents?: number | null
  currency: string
  gallery_images?: string[]
}

interface Props {
  entityId: string
  entitySlug: string
  appointmentTypes: AppointmentType[]
  autoBookTypeId?: string
  /** Owner connecté → affiche "Modifier" sur chaque service. */
  isOwner?: boolean
  dashboardUrl?: string
}

const { entityId, entitySlug, appointmentTypes, autoBookTypeId, isOwner = false, dashboardUrl } = Astro.props
---
<section id="appointments">
  {appointmentTypes.length === 0 ? (
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400" set:html={CalendarClock} />
      <p class="mt-4 text-sm text-neutral-400">Aucun rendez-vous disponible pour le moment.</p>
    </div>
  ) : (
    <div>
      {/* Step 1: Type selection */}
      <div id="booking-step-types">
        <div class="flex flex-col gap-2.5">
          {appointmentTypes.map(type => (
            <AppointmentTypeCard
              id={type.id}
              title={type.title}
              slug={type.slug}
              description={type.description}
              durationMinutes={type.duration_minutes}
              locationType={type.location_type}
              priceCents={type.price_cents}
              promoPriceCents={type.promo_price_cents ?? null}
              currency={type.currency}
              coverImageUrl={type.gallery_images?.[0] ?? null}
              entitySlug={entitySlug}
              editHref={isOwner && dashboardUrl ? `${dashboardUrl}/services/${type.id}` : null}
            />
          ))}
        </div>
      </div>

      {/* Step 2: Calendar + time (JS-powered) */}
      <div id="booking-step-calendar" style="display: none;">
        <button type="button" id="booking-back-types" class="mb-4 text-sm font-medium text-accent hover:underline">
          ← Retour aux services
        </button>
        <h2 class="mb-1 text-lg font-semibold text-neutral-900" id="booking-type-title"></h2>
        <p class="mb-4 text-sm text-neutral-400" id="booking-type-info"></p>

        <div class="flex flex-col gap-6 md:flex-row">
          {/* Calendar */}
          <div class="flex-1">
            <div id="booking-calendar" class="rounded-lg border border-neutral-200 bg-neutral-0 p-4"></div>
          </div>
          {/* Time slots */}
          <div class="w-full md:w-48">
            <h3 class="mb-2 text-sm font-medium text-neutral-900">Créneaux disponibles</h3>
            <div id="booking-slots" class="space-y-2">
              <p class="text-xs text-neutral-400">Sélectionnez une date.</p>
            </div>
          </div>
        </div>
      </div>

      {/* Step 3: Booking form */}
      <div id="booking-step-form" style="display: none;">
        <button type="button" id="booking-back-calendar" class="mb-4 text-sm font-medium text-accent hover:underline">
          ← Retour au calendrier
        </button>
        <h2 class="mb-4 text-lg font-semibold text-neutral-900">Confirmer le rendez-vous</h2>
        <div class="mb-4 rounded-lg bg-accent/5 px-4 py-3 text-sm text-neutral-900" id="booking-summary"></div>

        <form id="booking-form" class="space-y-4">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-neutral-900">Nom *</label>
            <input name="name" required class="w-full rounded-lg border border-neutral-200 bg-neutral-0 px-3 py-2.5 text-sm text-neutral-900 transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-neutral-900">Email *</label>
            <input name="email" type="email" required class="w-full rounded-lg border border-neutral-200 bg-neutral-0 px-3 py-2.5 text-sm text-neutral-900 transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-neutral-900">Téléphone</label>
            <input name="phone" type="tel" class="w-full rounded-lg border border-neutral-200 bg-neutral-0 px-3 py-2.5 text-sm text-neutral-900 transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-neutral-900">Message</label>
            <textarea name="message" rows="3" maxlength="2000" class="w-full rounded-lg border border-neutral-200 bg-neutral-0 px-3 py-2.5 text-sm text-neutral-900 transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"></textarea>
          </div>
          <input type="hidden" name="entityId" value={entityId} />
          <input type="hidden" name="typeId" id="booking-type-id" />
          <input type="hidden" name="startAt" id="booking-start-at" />
          <input type="hidden" name="endAt" id="booking-end-at" />

          <button type="submit" id="booking-submit" class="w-full rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover disabled:opacity-50">
            Confirmer le rendez-vous
          </button>
        </form>
      </div>

      {/* Step 4: Confirmation */}
      <div id="booking-step-done" style="display: none;" class="flex flex-col items-center justify-center py-16 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-success/10">
          <svg class="h-8 w-8 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <h2 class="mt-6 text-xl font-semibold text-neutral-900">Rendez-vous demandé !</h2>
        <p class="mt-2 text-sm text-neutral-500">Vous recevrez une confirmation par email une fois le rendez-vous validé.</p>
      </div>
    </div>
  )}
</section>

<script is:inline define:vars={{ entityId, autoBookTypeId }}>
(function() {
  var typesStep = document.getElementById('booking-step-types')
  var calendarStep = document.getElementById('booking-step-calendar')
  var formStep = document.getElementById('booking-step-form')
  var doneStep = document.getElementById('booking-step-done')
  var slotsContainer = document.getElementById('booking-slots')
  var calendarContainer = document.getElementById('booking-calendar')
  var selectedTypeId = ''
  var selectedType = null
  var selectedDate = ''
  var selectedSlot = null
  var currentMonth = new Date()

  function showStep(step) {
    typesStep.style.display = step === 'types' ? '' : 'none'
    calendarStep.style.display = step === 'calendar' ? '' : 'none'
    formStep.style.display = step === 'form' ? '' : 'none'
    doneStep.style.display = step === 'done' ? '' : 'none'
  }

  // Auto-ouverture : via prop autoBookTypeId ou hash #book-{typeId}
  var autoId = autoBookTypeId || (window.location.hash.match(/^#book-(.+)$/) || [])[1]
  if (autoId) {
    selectedTypeId = autoId
    var card = document.querySelector('[data-appointment-type="' + selectedTypeId + '"]')
    if (card) {
      var title = card.querySelector('h3')?.textContent || ''
      var info = card.querySelector('.text-xs')?.textContent || ''
      document.getElementById('booking-type-title').textContent = title
      document.getElementById('booking-type-info').textContent = info
      document.getElementById('booking-type-id').value = selectedTypeId
      currentMonth = new Date()
      renderCalendar()
      showStep('calendar')
    }
  }

  // Back buttons
  document.getElementById('booking-back-types')?.addEventListener('click', function() { showStep('types') })
  document.getElementById('booking-back-calendar')?.addEventListener('click', function() { showStep('calendar') })

  // Calendar rendering
  function renderCalendar() {
    var year = currentMonth.getFullYear()
    var month = currentMonth.getMonth()
    var firstDay = new Date(year, month, 1).getDay()
    var daysInMonth = new Date(year, month + 1, 0).getDate()
    var today = new Date()
    today.setHours(0,0,0,0)

    var monthNames = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre']

    var html = '<div class="flex items-center justify-between mb-3">'
    html += '<button type="button" id="cal-prev" class="px-2 py-1 text-neutral-400 hover:text-neutral-900">&lt;</button>'
    html += '<span class="text-sm font-semibold text-neutral-900">' + monthNames[month] + ' ' + year + '</span>'
    html += '<button type="button" id="cal-next" class="px-2 py-1 text-neutral-400 hover:text-neutral-900">&gt;</button>'
    html += '</div>'

    html += '<div class="grid grid-cols-7 gap-1 text-center text-xs text-neutral-400 mb-1">'
    ;['D','L','M','M','J','V','S'].forEach(function(d) { html += '<div>' + d + '</div>' })
    html += '</div>'

    html += '<div class="grid grid-cols-7 gap-1">'
    for (var i = 0; i < firstDay; i++) html += '<div></div>'

    for (var d = 1; d <= daysInMonth; d++) {
      var dateObj = new Date(year, month, d)
      var dateStr = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0')
      var isPast = dateObj < today
      var isSelected = dateStr === selectedDate

      if (isPast) {
        html += '<div class="flex h-9 w-9 items-center justify-center rounded-md text-xs text-neutral-300">' + d + '</div>'
      } else {
        html += '<button type="button" data-date="' + dateStr + '" class="flex h-9 w-9 items-center justify-center rounded-md text-xs font-medium transition '
          + (isSelected ? 'bg-accent text-white' : 'text-neutral-900 hover:bg-accent/10')
          + '">' + d + '</button>'
      }
    }
    html += '</div>'

    calendarContainer.innerHTML = html

    document.getElementById('cal-prev')?.addEventListener('click', function() {
      currentMonth.setMonth(currentMonth.getMonth() - 1)
      renderCalendar()
    })
    document.getElementById('cal-next')?.addEventListener('click', function() {
      currentMonth.setMonth(currentMonth.getMonth() + 1)
      renderCalendar()
    })

    calendarContainer.querySelectorAll('[data-date]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectedDate = btn.getAttribute('data-date')
        renderCalendar()
        loadSlots(selectedDate)
      })
    })
  }

  // Load slots
  function loadSlots(date) {
    slotsContainer.innerHTML = '<p class="text-xs text-neutral-400">Chargement...</p>'

    fetch('/api/bookings/slots?entityId=' + entityId + '&typeId=' + selectedTypeId + '&date=' + date)
      .then(function(r) { return r.json() })
      .then(function(data) {
        if (!data.slots || data.slots.length === 0) {
          slotsContainer.innerHTML = '<p class="text-xs text-neutral-400">Aucun créneau disponible ce jour.</p>'
          return
        }

        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone
        var html = data.slots.map(function(slot) {
          var time = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(slot.start))
          return '<button type="button" data-start="' + slot.start + '" data-end="' + slot.end + '" class="w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm font-medium text-neutral-900 transition hover:border-accent hover:bg-accent/5">' + time + '</button>'
        }).join('')

        slotsContainer.innerHTML = html

        slotsContainer.querySelectorAll('button').forEach(function(btn) {
          btn.addEventListener('click', function() {
            selectedSlot = { start: btn.getAttribute('data-start'), end: btn.getAttribute('data-end') }
            document.getElementById('booking-start-at').value = selectedSlot.start
            document.getElementById('booking-end-at').value = selectedSlot.end

            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone
            var dateStr = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: tz }).format(new Date(selectedSlot.start))
            var timeStr = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(selectedSlot.start))
            var endTimeStr = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(selectedSlot.end))

            document.getElementById('booking-summary').textContent = dateStr + ' de ' + timeStr + ' à ' + endTimeStr
            showStep('form')
          })
        })
      })
      .catch(function() {
        slotsContainer.innerHTML = '<p class="text-xs text-error">Erreur lors du chargement.</p>'
      })
  }

  // Form submission
  document.getElementById('booking-form')?.addEventListener('submit', function(e) {
    e.preventDefault()
    var form = e.target
    var btn = document.getElementById('booking-submit')
    btn.disabled = true
    btn.textContent = 'Envoi...'

    var body = {
      appointment_type_id: form.typeId.value,
      entity_id: form.entityId.value,
      booker_name: form.name.value,
      booker_email: form.email.value,
      booker_phone: form.phone.value || null,
      booker_message: form.message.value || null,
      start_at: form.startAt.value,
      end_at: form.endAt.value,
    }

    fetch('/api/bookings/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
      .then(function(r) { return r.json() })
      .then(function(data) {
        if (data.error) {
          alert(data.error)
          btn.disabled = false
          btn.textContent = 'Confirmer le rendez-vous'
          return
        }
        showStep('done')
      })
      .catch(function() {
        alert('Erreur lors de la réservation.')
        btn.disabled = false
        btn.textContent = 'Confirmer le rendez-vous'
      })
  })
})()
</script>
