---
import { MessageCircle } from 'lucide-static'
import CommentCard from './CommentCard.astro'

interface Comment {
  id: string
  content: string
  created_at: string
  user_id: string
  author_display_name: string
  author_avatar_url: string | null
  author_slug: string
}

interface Props {
  comments: Comment[]
  commentsCount: number
  publicationId: string
  entitySlug: string
  publicationSlug: string
  user: { id: string } | null
  /** user_id of the publication owner — enables delete for moderation */
  publicationOwnerUserId: string
  dashboardUrl: string
}

const { comments, commentsCount, publicationId, entitySlug, publicationSlug, user, publicationOwnerUserId, dashboardUrl } = Astro.props
---
<section id="comments" class="mt-6 border-t border-neutral-200 pt-6">
  <h2 class="flex items-center gap-2 text-base font-semibold text-neutral-900">
    <span class="flex h-5 w-5 items-center justify-center text-neutral-500" set:html={MessageCircle} />
    Commentaires ({commentsCount})
  </h2>

  {/* Comment form or auth CTA */}
  {user ? (
    <form
      data-comment-form
      data-publication-id={publicationId}
      data-entity-slug={entitySlug}
      data-publication-slug={publicationSlug}
      class="mt-4"
    >
      <textarea
        name="content"
        rows="3"
        maxlength="2000"
        required
        placeholder="Ajouter un commentaire..."
        class="w-full resize-none rounded-lg border border-neutral-200 bg-neutral-0 px-3 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
      ></textarea>
      <div class="mt-2 flex items-center justify-between">
        <span data-char-count class="text-xs text-neutral-400"></span>
        <button
          type="submit"
          class="rounded-lg bg-cta-primary px-4 py-2 text-sm font-medium text-neutral-0 transition duration-200 hover:bg-cta-primary-hover disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Commenter
        </button>
      </div>
      <p data-comment-error class="mt-2 hidden text-sm text-error"></p>
    </form>
  ) : (
    <div class="mt-4 rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-5 text-center">
      <p class="text-sm text-neutral-500">Connectez-vous pour participer à la discussion.</p>
      <a
        href={`${dashboardUrl}/signup`}
        class="mt-3 inline-flex items-center justify-center rounded-lg bg-cta-primary px-5 py-2 text-sm font-medium text-neutral-0 transition duration-200 hover:bg-cta-primary-hover"
      >
        Créer mon profil Agora
      </a>
    </div>
  )}

  {/* Comments list */}
  {comments.length > 0 ? (
    <div class="mt-4 divide-y divide-neutral-100">
      {comments.map((comment) => (
        <CommentCard
          id={comment.id}
          content={comment.content}
          createdAt={comment.created_at}
          authorDisplayName={comment.author_display_name}
          authorAvatarUrl={comment.author_avatar_url}
          authorSlug={comment.author_slug}
          canDelete={user !== null && (user.id === comment.user_id || user.id === publicationOwnerUserId)}
          entitySlug={entitySlug}
          publicationSlug={publicationSlug}
        />
      ))}
    </div>
  ) : (
    <p class="mt-4 text-center text-sm text-neutral-400 py-4">Soyez le premier à commenter.</p>
  )}
</section>

<script is:inline>
(function() {
  function init() {
    // Comment form submission
    var form = document.querySelector('[data-comment-form]')
    if (form) {
      var textarea = form.querySelector('textarea')
      var charCount = form.querySelector('[data-char-count]')
      var errorEl = form.querySelector('[data-comment-error]')
      var submitBtn = form.querySelector('button[type="submit"]')

      // Character counter
      if (textarea && charCount) {
        textarea.addEventListener('input', function() {
          var len = textarea.value.length
          charCount.textContent = len > 0 ? len + '/2000' : ''
        })
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault()
        if (!textarea || !textarea.value.trim()) return

        submitBtn.disabled = true
        errorEl.classList.add('hidden')

        fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            publicationId: form.dataset.publicationId,
            content: textarea.value.trim(),
            entitySlug: form.dataset.entitySlug,
            publicationSlug: form.dataset.publicationSlug
          })
        })
        .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, data: d } }) })
        .then(function(result) {
          if (result.ok) {
            window.location.reload()
          } else {
            errorEl.textContent = result.data.error || 'Une erreur est survenue.'
            errorEl.classList.remove('hidden')
            submitBtn.disabled = false
          }
        })
        .catch(function() {
          errorEl.textContent = 'Erreur réseau. Réessayez.'
          errorEl.classList.remove('hidden')
          submitBtn.disabled = false
        })
      })
    }

    // Delete comment buttons
    document.querySelectorAll('[data-delete-comment]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!confirm('Supprimer ce commentaire ?')) return

        fetch('/api/comments', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            commentId: btn.dataset.deleteComment,
            entitySlug: btn.dataset.entitySlug,
            publicationSlug: btn.dataset.publicationSlug
          })
        })
        .then(function(res) {
          if (res.ok) window.location.reload()
        })
      })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
})()
</script>
