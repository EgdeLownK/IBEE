---
import { Newspaper } from 'lucide-static'
import PublicationCard from './PublicationCard.astro'
import SectionEmptyState from './SectionEmptyState.astro'

interface Media {
  id: string
  url: string
  alt_text: string | null
  position: number
  width: number | null
  height: number | null
}

interface Publication {
  id: string
  title: string
  slug: string
  content: string | null
  published_at: string | null
  comments_count: number
  publication_media: Media[]
}

interface Props {
  publications: Publication[]
  entityDisplayName: string
  entityAvatarUrl: string | null
  entitySlug: string
  entityRole?: string | null
  isOwner?: boolean
}

const { publications, entityDisplayName, entityAvatarUrl, entitySlug, entityRole, isOwner = false } = Astro.props
---
<section id="news" class="pt-4 pb-4">
  {publications.length === 0 ? (
    <div class="px-[22px]">
      <SectionEmptyState
        icon={Newspaper}
        title="Aucune publication pour le moment"
        description="Pas encore d'actus par ici."
        ownerDescription="Partage tes actus avec ta communauté."
        ctaLabel="Ajouter une publication"
        ctaAction="data-open-publication-overlay"
        isOwner={isOwner}
      />
    </div>
  ) : (
    <div class="divide-y divide-neutral-200 [&>article]:pt-2 [&>article]:pb-4">
      {publications.map((pub) => (
        <PublicationCard
          id={pub.id}
          title={pub.title}
          content={pub.content}
          publishedAt={pub.published_at!}
          entityDisplayName={entityDisplayName}
          entityAvatarUrl={entityAvatarUrl}
          entitySlug={entitySlug}
          entityRole={entityRole}
          media={pub.publication_media}
          permalinkUrl={`/${entitySlug}/news/${pub.slug}`}
          commentsCount={pub.comments_count ?? 0}
          isOwner={isOwner}
        />
      ))}
    </div>
  )}
</section>
