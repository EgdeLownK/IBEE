---
import { ShoppingBag, Download, Package, MapPin, FileText, Globe, Clock, ShieldCheck, Truck, Store, PlayCircle, Info, ChevronDown, Star, Check } from 'lucide-static'

type Json = unknown

/** Bloc de contenu riche (content_blocks V2). Narrowing fait c├┤t├® page. */
type ContentBlock =
  | { type: 'text'; content: string }
  | { type: 'image'; url: string; alt?: string }

interface Media {
  id: string
  url: string
  media_type?: string | null
  alt_text?: string | null
  display_order?: number
}

interface Variant {
  id: string
  attributes: Json
  stock_quantity: number
  price_cents_override: number | null
  primary_image_url: string | null
  is_active: boolean
}

interface Props {
  product: {
    id: string
    title: string
    description_short: string
    description_long: string | null
    price_cents: number
    sale_price_cents: number | null
    sale_ends_at: string | null
    currency: string
    type: 'digital' | 'physical'
    pickup_enabled: boolean
    delivery_enabled: boolean
    product_media?: Media[] | null
    product_variants?: Variant[] | null
    // digital
    digital_file_format: string | null
    digital_language: string | null
    digital_license: string | null
    digital_pages_or_duration: number | null
    // physical
    physical_condition: string | null
    physical_pickup_location: string | null
    physical_pickup_instructions: string | null
    physical_stock_quantity: number | null
    physical_stock_unlimited: boolean | null
  }
  /** Nom de cat├®gorie r├®solu c├┤t├® page (embed entity_product_categories ou legacy). */
  categoryName?: string | null
  /** Points principaux (bullet_points V2), narrow├®s c├┤t├® page en string[]. */
  bulletPoints?: string[]
  /** Description riche (content_blocks V2), narrow├®e c├┤t├® page. Vide ÔåÆ fallback description_long. */
  contentBlocks?: ContentBlock[]
  /** Promo active calcul├®e c├┤t├® SSR (sale_price_cents valide ET non expir├®e). */
  saleActive?: boolean
  /** D├®tails personnalis├®s (custom_details V2), narrow├®s c├┤t├® page.
      family optionnelle : regroupe les d├®tails dans "Tous les d├®tails". */
  customDetails?: { label: string; value: string; family?: string | null }[]
  /** Agr├®gats d'avis (├®toiles sous le titre, design Claude). */
  aggregates?: { count: number; average: number } | null
}

const {
  product,
  categoryName = null,
  bulletPoints = [],
  contentBlocks = [],
  saleActive = false,
  customDetails = [],
  aggregates = null,
} = Astro.props

const starRow = (n: number) => Array.from({ length: 5 }, (_, i) => i < n)

const allMedia = (product.product_media ?? [])
  .slice()
  .sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0))
const images = allMedia.filter((m) => !m.media_type || m.media_type === 'image')
const video = allMedia.find((m) => m.media_type === 'video') ?? null
// Galerie : m├®dias visibles = images + ├®ventuelle vid├®o (la vid├®o appara├«t en vignette).
const galleryMedia = [...images, ...(video ? [video] : [])]
const mainImage = images[0]?.url ?? null

const variants = (product.product_variants ?? []).filter((v) => v.is_active)
const hasVariants = variants.length > 0

function formatPrice(cents: number, currency: string): string {
  try {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100)
  } catch {
    return `${(cents / 100).toFixed(2)} Ôé¼`
  }
}

// Prix mini sur variantes pour "├á partir de"
const variantPrices = variants.map((v) => v.price_cents_override ?? product.price_cents)
const minCents = variantPrices.length > 0 ? Math.min(...variantPrices) : product.price_cents
const maxCents = variantPrices.length > 0 ? Math.max(...variantPrices) : product.price_cents
const isMultiPrice = hasVariants && minCents !== maxCents
const initialPriceText = formatPrice(minCents, product.currency)

// Promo : s'applique au PRIX DE BASE uniquement. Si une variante est s├®lectionn├®e
// (override), son prix prime et la promo n'est PAS appliqu├®e sur la ligne variante
// (le JS du s├®lecteur ├®crase #product-price avec le prix variante brut).
const showSalePrice = saleActive && product.sale_price_cents != null
const salePriceText = showSalePrice ? formatPrice(product.sale_price_cents as number, product.currency) : null
const baseOriginalText = formatPrice(product.price_cents, product.currency)
const salePercent =
  showSalePrice && product.price_cents > 0
    ? Math.round((1 - (product.sale_price_cents as number) / product.price_cents) * 100)
    : 0
// Date de fin de promo format├®e (fr-FR) si pr├®sente
let saleEndsLabel: string | null = null
if (showSalePrice && product.sale_ends_at) {
  try {
    saleEndsLabel = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(product.sale_ends_at)
    )
  } catch {
    saleEndsLabel = null
  }
}

// Description riche : content_blocks si non vide, sinon fallback description_long (V1)
const hasContentBlocks = contentBlocks.length > 0

// Disponibilit├® initiale (sans variante s├®lectionn├®e)
let initialInStock: boolean
if (hasVariants) {
  initialInStock = variants.some((v) => v.stock_quantity > 0)
} else if (product.type === 'digital') {
  initialInStock = true
} else {
  initialInStock = !!product.physical_stock_unlimited || (product.physical_stock_quantity ?? 0) > 0
}

// Attributs : on d├®rive l'ensemble des cl├®s et valeurs depuis variants[].attributes
type AttrMap = Record<string, string>
const variantAttrs: AttrMap[] = variants.map((v) => {
  const a = (v.attributes ?? {}) as Record<string, unknown>
  const out: AttrMap = {}
  for (const k of Object.keys(a)) out[k] = String(a[k])
  return out
})
const attrKeys = Array.from(new Set(variantAttrs.flatMap((a) => Object.keys(a))))
const attrOptions: Record<string, string[]> = {}
for (const key of attrKeys) {
  attrOptions[key] = Array.from(
    new Set(variantAttrs.map((a) => a[key]).filter((v): v is string => !!v))
  )
}

// Donn├®es JSON pour le s├®lecteur vanilla JS
const variantData = variants.map((v, i) => ({
  id: v.id,
  attributes: variantAttrs[i],
  priceCents: v.price_cents_override ?? product.price_cents,
  stock: v.stock_quantity,
  image: v.primary_image_url,
}))

const conditionLabels: Record<string, string> = {
  new: 'Neuf',
  like_new: 'Comme neuf',
  very_good: 'Tr├¿s bon ├®tat',
  good: 'Bon ├®tat',
  acceptable: '├ëtat correct',
}
const licenseLabels: Record<string, string> = {
  personal: 'Licence personnelle',
  professional: 'Licence professionnelle',
  commercial: 'Licence commerciale',
}
const formatLabels: Record<string, string> = {
  pdf: 'PDF', epub: 'EPUB', mp4: 'MP4', mp3: 'MP3', zip: 'ZIP', other: 'Fichier',
}

// Lignes du bloc "D├®tails du fichier" (digital) : champs legacy + d├®tails
// personnalis├®s (libres puis familles). Au-del├á de 3 lignes : 3 affich├®es +
// "Voir plus" (ancre vers la section "Tous les d├®tails" sous la Description).
type DetailLine = { icon: string; text: string }
const ungroupedLines: DetailLine[] = []
if (product.type === 'digital') {
  if (product.digital_file_format) {
    ungroupedLines.push({ icon: FileText, text: `Format : ${formatLabels[product.digital_file_format] ?? product.digital_file_format}` })
  }
  if (product.digital_license) {
    // Legacy : licence des anciens produits (plus jamais ├®crite, custom_details la remplace)
    ungroupedLines.push({ icon: ShieldCheck, text: licenseLabels[product.digital_license] ?? product.digital_license })
  }
  if (product.digital_language) {
    ungroupedLines.push({ icon: Globe, text: `Langue : ${product.digital_language.toUpperCase()}` })
  }
  if (product.digital_pages_or_duration != null) {
    ungroupedLines.push({
      icon: Clock,
      text: `${product.digital_pages_or_duration} ${product.digital_file_format === 'mp4' || product.digital_file_format === 'mp3' ? 'min' : 'pages'}`,
    })
  }
  for (const d of customDetails) {
    if (!d.family) ungroupedLines.push({ icon: Info, text: `${d.label} : ${d.value}` })
  }
}

// Familles : group├®es dans l'ordre de premi├¿re apparition
const familyGroups: { name: string; lines: DetailLine[] }[] = []
if (product.type === 'digital') {
  for (const d of customDetails) {
    if (!d.family) continue
    let group = familyGroups.find((g) => g.name === d.family)
    if (!group) {
      group = { name: d.family, lines: [] }
      familyGroups.push(group)
    }
    group.lines.push({ icon: Info, text: `${d.label} : ${d.value}` })
  }
}

// Vue aplatie pour le bloc compact (3 lignes max) et le compteur
const detailLines: DetailLine[] = [...ungroupedLines, ...familyGroups.flatMap((g) => g.lines)]
const visibleDetailLines = detailLines.slice(0, 3)
const hasMoreDetails = detailLines.length > 3
---
{/* ===== GALERIE pleine largeur ===== */}
<div>
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-neutral-100">
    {mainImage ? (
      <img id="product-main-image" src={mainImage} alt={product.title} class="h-full w-full object-cover" />
    ) : (
      <div id="product-main-image-empty" class="ph" aria-hidden="true">
        <span class="flex h-14 w-14 items-center justify-center" set:html={ShoppingBag} />
      </div>
    )}
    {/* Viewer vid├®o : masqu├® par d├®faut, affich├® au clic sur la vignette vid├®o. Pas d'autoplay. */}
    {video && (
      <video
        id="product-main-video"
        src={video.url}
        controls
        preload="metadata"
        playsinline
        class="absolute inset-0 hidden h-full w-full bg-black object-contain"
      ></video>
    )}
  </div>
  {(galleryMedia.length > 1 || (video && images.length === 0)) && (
    <div class="gallery-strip flex gap-2 overflow-x-auto px-[22px] pt-3" data-gallery-strip>
      {galleryMedia.map((m, i) => {
        const isVideo = m.media_type === 'video'
        return (
          <button
            type="button"
            data-thumb={m.url}
            data-media-type={isVideo ? 'video' : 'image'}
            class:list={[
              'relative h-14 w-14 shrink-0 overflow-hidden rounded-[10px] border-2 transition',
              i === 0 ? 'border-accent' : 'border-transparent hover:border-neutral-300',
            ]}
            aria-label={isVideo ? 'Voir la vid├®o' : `Voir l'image ${i + 1}`}
          >
            {isVideo ? (
              <>
                <video src={m.url} preload="metadata" muted class="h-full w-full object-cover"></video>
                <span class="absolute inset-0 flex items-center justify-center bg-black/30 text-white">
                  <span class="flex h-6 w-6 items-center justify-center" set:html={PlayCircle} />
                </span>
              </>
            ) : (
              <img src={m.url} alt={m.alt_text ?? product.title} class="h-full w-full object-cover" loading="lazy" />
            )}
          </button>
        )
      })}
    </div>
  )}
</div>

{/* ===== INFOS ===== */}
<div class="px-[22px] pt-[18px] pb-1.5">
  <div class="flex flex-wrap items-center gap-2">
    <span class="pill">
      <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={product.type === 'digital' ? Download : Package} />
      {product.type === 'digital' ? 'Produit num├®rique' : 'Click & collect'}
    </span>
    {categoryName && <span class="pill pill--accent">{categoryName}</span>}
  </div>
  <h1 class="mt-3 mb-0 font-display text-[23px] font-semibold leading-tight text-neutral-900">{product.title}</h1>

  {/* Note moyenne (si avis publi├®s) */}
  {aggregates && aggregates.count > 0 && (
    <div class="mt-2 flex items-center gap-2">
      <span class="stars text-amber-500">
        {starRow(Math.round(aggregates.average)).map((on) => (
          <span class:list={['flex items-center justify-center', !on && 'text-neutral-200']} set:html={Star} />
        ))}
      </span>
      <span class="text-[13px] text-neutral-500">{aggregates.average.toFixed(1).replace('.', ',')} ┬À {aggregates.count} avis</span>
    </div>
  )}

  {/* Points principaux (bullet_points) ÔÇö checklist accent */}
  {bulletPoints.length > 0 && (
    <ul class="mt-4 mb-0 flex list-none flex-col gap-2 p-0">
      {bulletPoints.map((point) => (
        <li class="flex items-start gap-2.5 text-sm text-neutral-700">
          <span class="mt-0.5 flex h-[17px] w-[17px] shrink-0 items-center justify-center text-accent" set:html={Check} />
          <span>{point}</span>
        </li>
      ))}
    </ul>
  )}

  <p class="mt-3 mb-0 text-sm leading-normal text-neutral-600">{product.description_short}</p>

  {/* Disponibilit├® (le prix vit dans l'actionbar sticky, mis ├á jour par le JS variantes) */}
  <p id="product-stock" class="mt-3 mb-0 text-xs" class:list={[initialInStock ? 'text-success' : 'text-error']}>
    {initialInStock ? 'En stock' : 'Indisponible'}
  </p>
  {saleEndsLabel && (
    <p id="product-sale-ends" class="mt-1 mb-0 text-xs text-accent">Promo jusqu'au {saleEndsLabel}</p>
  )}

  {/* S├®lecteur de variantes */}
  {hasVariants && (
    <div class="mt-5 space-y-4" id="variant-selector" data-variants={JSON.stringify(variantData)}>
      {attrKeys.map((key) => (
        <div data-attr-group={key}>
          <p class="mb-1.5 text-xs font-medium uppercase tracking-wider text-neutral-500">{key}</p>
          <div class="flex flex-wrap gap-2">
            {attrOptions[key].map((value) => (
              <button
                type="button"
                data-attr-key={key}
                data-attr-value={value}
                class="rounded-[10px] border border-neutral-200 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:border-accent hover:text-accent data-[selected=true]:border-accent data-[selected=true]:bg-accent/10 data-[selected=true]:text-accent"
              >
                {value}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}

  {/* Bloc digital : d├®tails du fichier en cartes (3 max + "Voir plus" si davantage) */}
  {product.type === 'digital' && detailLines.length > 0 && (
    <div class="mt-5">
      <div class="flex gap-2.5">
        {visibleDetailLines.map((line) => (
          <div class="flex flex-1 flex-col items-center gap-1 rounded-[12px] border border-[var(--color-border)] px-1.5 py-3 text-center">
            <span class="flex h-[18px] w-[18px] items-center justify-center text-neutral-400" set:html={line.icon} />
            <span class="text-[12.5px] font-medium text-neutral-900">{line.text}</span>
          </div>
        ))}
      </div>
      {hasMoreDetails && (
        <a href="#tous-les-details" class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline">
          Voir plus
          <span class="flex h-4 w-4 items-center justify-center" set:html={ChevronDown} />
        </a>
      )}
    </div>
  )}

  {/* Bloc physical : modes de remise (retrait / livraison, cumulables) + ├®tat */}
  {product.type === 'physical' && (
    <div class="mt-5 space-y-3 rounded-[14px] border border-[var(--color-border)] bg-neutral-50 p-4">
      <h2 class="m-0 text-sm font-semibold text-neutral-900">Modes de remise</h2>
      <div class="space-y-3">
        {product.pickup_enabled && (
          <div class="flex items-start gap-2.5">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center text-accent" set:html={Store} />
            <div>
              <p class="m-0 text-sm font-medium text-neutral-900">Retrait sur place</p>
              {product.physical_pickup_location && (
                <p class="m-0 text-sm text-neutral-600">Lieu de retrait : {product.physical_pickup_location}</p>
              )}
              {product.physical_pickup_instructions && (
                <p class="m-0 text-sm text-neutral-500">{product.physical_pickup_instructions}</p>
              )}
            </div>
          </div>
        )}
        {product.delivery_enabled && (
          <div class="flex items-start gap-2.5">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center text-accent" set:html={Truck} />
            <div>
              <p class="m-0 text-sm font-medium text-neutral-900">Livraison possible</p>
              <p class="m-0 text-sm text-neutral-500">Modalit├®s communiqu├®es par le vendeur.</p>
            </div>
          </div>
        )}
        {!product.pickup_enabled && !product.delivery_enabled && (
          <p class="m-0 flex items-start gap-2.5 text-sm text-neutral-500">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={MapPin} />
            Modalit├®s de remise communiqu├®es par le vendeur.
          </p>
        )}
      </div>
      {product.physical_condition && (
        <p class="m-0 border-t border-[var(--color-border)] pt-3 text-sm text-neutral-600">
          ├ëtat : {conditionLabels[product.physical_condition] ?? product.physical_condition}
        </p>
      )}
    </div>
  )}
</div>

{/* Description : content_blocks (V2) dans l'ordre, fallback description_long (V1) */}
{(hasContentBlocks || product.description_long) && (
  <section class="sec" style="margin-top:22px;">
    <h2 class="sec-h mt-0 mb-2">Description</h2>
    {hasContentBlocks ? (
      <div class="space-y-3">
        {contentBlocks.map((block) =>
          block.type === 'text' ? (
            <p class="m-0 whitespace-pre-wrap text-sm leading-relaxed text-neutral-600">{block.content}</p>
          ) : (
            <figure class="m-0">
              <img src={block.url} alt={block.alt ?? ''} class="w-full rounded-[14px]" loading="lazy" />
            </figure>
          )
        )}
      </div>
    ) : (
      <p class="m-0 whitespace-pre-wrap text-sm leading-relaxed text-neutral-600">{product.description_long}</p>
    )}
  </section>
)}

{/* Tous les d├®tails ÔÇö toujours affich├®e d├¿s qu'il y a au moins un d├®tail
    (cible de l'ancre "Voir plus" du bloc fichier quand il y en a plus de 3).
    D├®tails libres d'abord, puis chaque famille sous son intitul├®. */}
{detailLines.length > 0 && (
  <section id="tous-les-details" class="sec scroll-mt-20">
    <h2 class="sec-h mt-0 mb-3">Tous les d├®tails</h2>
    {ungroupedLines.length > 0 && (
      <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-sm text-neutral-600">
        {ungroupedLines.map((line) => (
          <li class="flex items-center gap-2">
            <span class="flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={line.icon} />
            {line.text}
          </li>
        ))}
      </ul>
    )}
    {familyGroups.map((group) => (
      <div class="mt-5 first:mt-0">
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-500">{group.name}</h3>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-sm text-neutral-600">
          {group.lines.map((line) => (
            <li class="flex items-center gap-2">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={line.icon} />
              {line.text}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}

<style>
  /* Miniatures : d├®filement horizontal sans scrollbar */
  .gallery-strip {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }
  .gallery-strip::-webkit-scrollbar { display: none; }
</style>

<script is:inline define:vars={{ productId: product.id, currency: product.currency, initialInStock }}>
(function() {
  // --- Galerie : miniatures (images + vid├®o) ---
  var mainImg = document.getElementById('product-main-image')
  var mainVideo = document.getElementById('product-main-video')

  function showImageView(url) {
    if (mainImg) { mainImg.src = url; mainImg.classList.remove('hidden') }
    if (mainVideo) { mainVideo.pause(); mainVideo.classList.add('hidden') }
  }
  function showVideoView() {
    if (mainImg) mainImg.classList.add('hidden')
    if (mainVideo) mainVideo.classList.remove('hidden') // pas d'autoplay : l'utilisateur lance la lecture
  }

  document.querySelectorAll('[data-thumb]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.getAttribute('data-media-type') === 'video') {
        showVideoView()
      } else {
        showImageView(btn.getAttribute('data-thumb'))
      }
      document.querySelectorAll('[data-thumb]').forEach(function(b) {
        b.className = b.className.replace('border-accent', 'border-transparent')
      })
      btn.className = btn.className.replace('border-transparent', 'border-accent')
    })
  })

  // --- Miniatures : fl├¿ches de d├®filement (visibles seulement si overflow) ---
  var strip = document.querySelector('[data-gallery-strip]')
  if (strip) {
    var arrows = document.querySelectorAll('[data-gallery-scroll]')
    var updateArrows = function() {
      var max = strip.scrollWidth - strip.clientWidth
      arrows.forEach(function(btn) {
        var dir = parseInt(btn.getAttribute('data-gallery-scroll'), 10)
        if (max <= 1) { btn.hidden = true; return }
        btn.hidden = dir === -1 ? strip.scrollLeft <= 0 : strip.scrollLeft >= max - 1
      })
    }
    arrows.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var dir = parseInt(btn.getAttribute('data-gallery-scroll'), 10)
        strip.scrollBy({ left: dir * Math.round(strip.clientWidth * 0.8), behavior: 'smooth' })
      })
    })
    strip.addEventListener('scroll', updateArrows)
    window.addEventListener('resize', updateArrows)
    updateArrows()
  }

  function formatPrice(cents) {
    try {
      return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: currency }).format(cents / 100)
    } catch (e) {
      return (cents / 100).toFixed(2) + ' Ôé¼'
    }
  }

  // --- S├®lecteur de variantes ---
  var selector = document.getElementById('variant-selector')
  var selected = {}
  var variants = []
  if (selector) {
    try { variants = JSON.parse(selector.getAttribute('data-variants') || '[]') } catch (e) { variants = [] }

    function findVariant() {
      var keys = Object.keys(selected)
      return variants.find(function(v) {
        return keys.every(function(k) { return String(v.attributes[k]) === String(selected[k]) })
      })
    }

    function allKeys() {
      var set = {}
      variants.forEach(function(v) { Object.keys(v.attributes).forEach(function(k) { set[k] = true }) })
      return Object.keys(set)
    }

    function update() {
      var priceEl = document.getElementById('product-price')
      var stockEl = document.getElementById('product-stock')
      var fromEl = document.getElementById('product-price-from')

      var complete = allKeys().every(function(k) { return selected[k] != null })
      if (!complete) return

      var v = findVariant()
      if (!v) {
        if (stockEl) { stockEl.textContent = 'Combinaison indisponible'; stockEl.className = 'mt-1 text-xs text-error' }
        return
      }
      if (priceEl) {
        priceEl.textContent = formatPrice(v.priceCents)
        // Le prix variante prime : la promo (base) ne s'applique pas sur la ligne variante.
        priceEl.classList.remove('text-accent')
        priceEl.classList.add('text-neutral-900')
      }
      if (fromEl) fromEl.style.display = 'none'
      // Masque les ├®l├®ments de promo (prix barr├®, badge -X%, date de fin) car ils
      // concernent le prix de BASE, pas le prix de la variante s├®lectionn├®e.
      ;['product-price-original', 'product-price-discount', 'product-sale-ends', 'product-price-promo-label'].forEach(function(id) {
        var el = document.getElementById(id)
        if (el) el.style.display = 'none'
      })
      var inStock = v.stock > 0
      if (stockEl) {
        stockEl.textContent = inStock ? 'En stock' : 'Indisponible'
        stockEl.className = 'mt-1 text-xs ' + (inStock ? 'text-success' : 'text-error')
      }
      // photo de la variante : repasse en vue image si la vid├®o ├®tait affich├®e
      if (v.image && mainImg) showImageView(v.image)
    }

    selector.querySelectorAll('[data-attr-key]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-attr-key')
        var value = btn.getAttribute('data-attr-value')
        selected[key] = value
        // visuel : d├®-s├®lectionne les autres du m├¬me groupe
        selector.querySelectorAll('[data-attr-key="' + key + '"]').forEach(function(b) {
          b.setAttribute('data-selected', b === btn ? 'true' : 'false')
        })
        update()
      })
    })
  }

})()
</script>
