---
import BaseLayout from './BaseLayout.astro'
import GlobalSidebar from '@ibee/ui-server/src/components/GlobalSidebar.astro'
import GlobalHeader from '@ibee/ui-server/src/components/GlobalHeader.astro'
import FloatingNavPill from '@ibee/ui-server/src/components/FloatingNavPill.astro'
import { supabase } from '../lib/supabase/client'
import { createAuthClient } from '../lib/supabase/auth'
import { getEntityByUserId, getUnreadCount, getNotifications } from '@ibee/supabase'

interface Props {
  title: string
  description?: string
  image?: string
  url?: string
  type?: string
  user: { id: string } | null
  profileUrl?: string
  robots?: string
  projectLabel?: string | null
  showSidebar?: boolean
}

const { user, profileUrl, projectLabel, showSidebar = false, ...layoutProps } = Astro.props

let currentUserEntity = null
let unreadCount = 0
let notifications: Awaited<ReturnType<typeof getNotifications>> = []

if (user) {
  const authClient = createAuthClient(Astro.request, Astro.cookies)

  const [entity, count, notifs] = await Promise.all([
    getEntityByUserId(supabase, user.id),
    getUnreadCount(authClient, user.id),
    getNotifications(authClient, user.id, { limit: 5 }),
  ])
  currentUserEntity = entity
  unreadCount = count
  notifications = notifs
}

const dashboardUrl = import.meta.env.DASHBOARD_URL ?? 'http://localhost:3000'
const isEmbed = Astro.url.searchParams.get('embed') === 'true'
---
<BaseLayout {...layoutProps}>
  <slot name="head" slot="head" />
  {isEmbed ? (
    <div>
      <slot />
      <script is:inline>
        (function() {
          document.addEventListener('click', function(e) {
            var a = e.target.closest('a[href]')
            if (!a) return
            var href = a.getAttribute('href')
            if (!href || href.startsWith('http') || href.startsWith('#') || href.startsWith('mailto:')) return
            if (href.indexOf('embed=true') === -1) {
              a.setAttribute('href', href + (href.indexOf('?') === -1 ? '?' : '&') + 'embed=true')
            }
          })
        })()
      </script>
    </div>
  ) : (
    <div class="flex min-h-screen bg-background">
      {showSidebar && (
        <GlobalSidebar
          user={user}
          currentUserEntity={currentUserEntity}
          currentPath={Astro.url.pathname}
          dashboardUrl={dashboardUrl}
          projectLabel={projectLabel}
        />
      )}
      <div class="relative flex flex-1 flex-col min-w-0">
        <GlobalHeader
          projectLabel={projectLabel}
          profileUrl={profileUrl}
          avatarUrl={currentUserEntity?.avatar_url}
          displayName={currentUserEntity?.display_name}
          currentUserSlug={currentUserEntity?.slug}
          dashboardUrl={dashboardUrl}
          isAuthenticated={!!user}
          unreadCount={unreadCount}
          notifications={notifications}
        />
        <div class="flex-1 overflow-auto pb-[100px]">
          <slot />
        </div>
        <FloatingNavPill
          currentPath={Astro.url.pathname}
          currentUserSlug={currentUserEntity?.slug}
          isAuthenticated={!!user}
          dashboardUrl={dashboardUrl}
        />
      </div>
    </div>
  )}
</BaseLayout>
