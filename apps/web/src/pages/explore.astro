---
import { Compass, Search, SearchX, Globe } from 'lucide-static'
import AppLayout from '../layouts/AppLayout.astro'
import { createAuthClient } from '../lib/supabase/auth'

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()

const siteUrl = import.meta.env.SITE_URL

Astro.response.headers.set('Cache-Control', 's-maxage=300')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---
<AppLayout
  title="Explorer — IBEE"
  user={user}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="flex h-[calc(100vh-3.5rem)] overflow-hidden">
    {/* Colonne gauche — Recherche + résultats */}
    <div class="flex w-full flex-col border-r border-neutral-200 bg-neutral-0 md:w-[35%]">
      {/* Search bar */}
      <div class="border-b border-neutral-200 px-4 py-3">
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 flex h-4 w-4 items-center justify-center text-neutral-400" set:html={Search} />
          <input
            id="explore-search"
            type="text"
            placeholder="Rechercher un profil..."
            autocomplete="off"
            autofocus
            class="w-full rounded-lg border border-neutral-200 bg-neutral-0 py-2.5 pl-10 pr-10 text-sm text-neutral-900 placeholder:text-neutral-400 transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            aria-label="Rechercher un profil"
          />
          <button
            id="explore-clear"
            type="button"
            style="display: none;"
            class="absolute right-3 top-1/2 -translate-y-1/2 flex h-5 w-5 items-center justify-center rounded-full text-neutral-400 hover:text-neutral-600"
            aria-label="Effacer"
          >
            &times;
          </button>
        </div>
      </div>

      {/* Results zone */}
      <div id="explore-results" class="flex flex-1 flex-col overflow-y-auto">
        {/* Initial state */}
        <div id="explore-initial" class="flex flex-1 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-24 w-24 items-center justify-center rounded-full bg-accent-soft">
            <span class="flex h-12 w-12 items-center justify-center text-accent" set:html={Compass} />
          </div>
          <h2 class="mt-10 text-3xl font-semibold tracking-tight text-neutral-900">Découvrez les solopreneurs<br />qui façonnent leur métier</h2>
          <p class="mx-auto mt-5 max-w-[420px] text-base leading-relaxed text-neutral-500">Tapez un nom, un métier, une ville. Chaque profil raconte une ambition en mouvement.</p>
        </div>

        {/* Empty state (hidden by default) */}
        <div id="explore-empty" style="display: none;" class="flex flex-1 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-24 w-24 items-center justify-center rounded-full bg-neutral-100">
            <span class="flex h-12 w-12 items-center justify-center text-neutral-400" set:html={SearchX} />
          </div>
          <h2 class="mt-10 text-3xl font-semibold tracking-tight text-neutral-900">Le bon profil<br />se prépare peut-être</h2>
          <p class="mx-auto mt-5 max-w-[420px] text-base leading-relaxed text-neutral-500">Ajustez votre recherche ou revenez bientôt. De nouveaux solopreneurs rejoignent IBEE chaque semaine pour y installer leur présence.</p>
        </div>

        {/* Loading skeleton (hidden by default) */}
        <div id="explore-loading" style="display: none;" class="space-y-1 p-2">
          <div class="flex items-center gap-3 rounded-md px-4 py-3"><div class="h-10 w-10 shrink-0 animate-pulse rounded-full bg-neutral-200"></div><div class="flex-1 space-y-2"><div class="h-3.5 w-32 animate-pulse rounded bg-neutral-200"></div><div class="h-3 w-20 animate-pulse rounded bg-neutral-200"></div></div></div>
          <div class="flex items-center gap-3 rounded-md px-4 py-3"><div class="h-10 w-10 shrink-0 animate-pulse rounded-full bg-neutral-200"></div><div class="flex-1 space-y-2"><div class="h-3.5 w-28 animate-pulse rounded bg-neutral-200"></div><div class="h-3 w-24 animate-pulse rounded bg-neutral-200"></div></div></div>
          <div class="flex items-center gap-3 rounded-md px-4 py-3"><div class="h-10 w-10 shrink-0 animate-pulse rounded-full bg-neutral-200"></div><div class="flex-1 space-y-2"><div class="h-3.5 w-36 animate-pulse rounded bg-neutral-200"></div><div class="h-3 w-16 animate-pulse rounded bg-neutral-200"></div></div></div>
        </div>

        {/* Results list (populated by JS) */}
        <div id="explore-list" role="list" class="p-2"></div>
        <div id="explore-more-wrap" style="display: none;" class="px-4 pb-4">
          <button id="explore-more" type="button" class="w-full rounded-lg bg-neutral-100 px-4 py-2 text-center text-sm font-medium text-neutral-600 transition hover:bg-neutral-200">
            Afficher plus
          </button>
        </div>
      </div>
    </div>

    {/* Colonne droite — Preview (desktop/tablette only) */}
    <div id="explore-preview" class="hidden flex-1 overflow-y-auto bg-background md:block">
      {/* Empty preview state */}
      <div id="explore-preview-empty" class="flex h-full flex-col items-center justify-center px-6 text-center">
        <span class="flex h-16 w-16 items-center justify-center text-neutral-300" set:html={Globe} />
        <p class="mt-4 text-sm text-neutral-400">Sélectionnez un profil pour voir ses publications</p>
      </div>
      {/* Preview content (populated by JS) */}
      <div id="explore-preview-content" style="display: none;"></div>
    </div>
  </main>
</AppLayout>

<script is:inline>
(function() {
  function init() {
  var input = document.getElementById('explore-search')
  var clearBtn = document.getElementById('explore-clear')
  var initialEl = document.getElementById('explore-initial')
  var emptyEl = document.getElementById('explore-empty')
  var loadingEl = document.getElementById('explore-loading')
  var listEl = document.getElementById('explore-list')
  var moreWrap = document.getElementById('explore-more-wrap')
  var moreBtn = document.getElementById('explore-more')
  var previewEmpty = document.getElementById('explore-preview-empty')
  var previewContent = document.getElementById('explore-preview-content')

  var debounceTimer = null
  var currentOffset = 0
  var currentQuery = ''
  var selectedSlug = ''
  var isDesktop = window.matchMedia('(min-width: 768px)').matches

  window.matchMedia('(min-width: 768px)').addEventListener('change', function(e) {
    isDesktop = e.matches
  })

  function showState(state) {
    initialEl.style.display = state === 'initial' ? '' : 'none'
    emptyEl.style.display = state === 'empty' ? '' : 'none'
    loadingEl.style.display = state === 'loading' ? '' : 'none'
    listEl.style.display = (state === 'results' || state === 'append') ? '' : 'none'
    if (state !== 'results' && state !== 'append') {
      moreWrap.style.display = 'none'
    }
  }

  function renderItem(r) {
    var initial = r.display_name ? r.display_name.charAt(0).toUpperCase() : '?'
    var avatarHtml = r.avatar_url
      ? '<img src="' + r.avatar_url + '" alt="" class="h-full w-full object-cover" />'
      : '<span class="text-sm font-semibold text-accent">' + initial + '</span>'
    var roleHtml = r.role ? '<span class="text-xs text-neutral-600">' + r.role + '</span>' : ''
    var isSelected = r.slug === selectedSlug
    var bgClass = isSelected ? 'bg-background' : 'hover:bg-neutral-50'

    return '<div role="listitem" data-slug="' + r.slug + '" class="flex items-center gap-3 rounded-md px-4 py-3 transition cursor-pointer ' + bgClass + '">'
      + '<div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-accent-soft">' + avatarHtml + '</div>'
      + '<div class="min-w-0 flex-1">'
      + '<p class="text-sm font-medium text-neutral-900 truncate">' + r.display_name + '</p>'
      + '<p class="text-xs text-neutral-500">@' + r.slug + '</p>'
      + roleHtml
      + '</div></div>'
  }

  function attachItemListeners() {
    listEl.querySelectorAll('[data-slug]').forEach(function(item) {
      item.addEventListener('click', function() {
        var slug = item.getAttribute('data-slug')
        if (!isDesktop) {
          window.location.href = '/' + slug
          return
        }
        selectedSlug = slug
        // Highlight active
        listEl.querySelectorAll('[data-slug]').forEach(function(el) {
          el.classList.remove('bg-background')
          el.classList.add('hover:bg-neutral-50')
        })
        item.classList.remove('hover:bg-neutral-50')
        item.classList.add('bg-background')
        loadPreview(slug)
      })
    })
  }

  function loadPreview(slug) {
    previewEmpty.style.display = 'none'
    previewContent.style.display = ''
    previewContent.innerHTML = '<div class="flex items-center justify-center py-16"><div class="h-6 w-6 animate-spin rounded-full border-2 border-accent border-t-transparent"></div></div>'

    fetch('/profile-preview/' + slug)
      .then(function(res) { return res.text() })
      .then(function(html) {
        previewContent.innerHTML = html
      })
      .catch(function() {
        previewContent.innerHTML = '<p class="py-16 text-center text-sm text-neutral-400">Impossible de charger le profil</p>'
      })
  }

  function doSearch(append) {
    if (!currentQuery) {
      showState('initial')
      previewEmpty.style.display = ''
      previewContent.style.display = 'none'
      selectedSlug = ''
      return
    }

    if (!append) {
      showState('loading')
      currentOffset = 0
      listEl.innerHTML = ''
    }

    fetch('/api/search?q=' + encodeURIComponent(currentQuery) + '&offset=' + currentOffset)
      .then(function(res) { return res.json() })
      .then(function(data) {
        if (data.results.length === 0 && currentOffset === 0) {
          showState('empty')
          return
        }
        showState('results')
        var html = data.results.map(renderItem).join('')
        if (append) {
          listEl.insertAdjacentHTML('beforeend', html)
        } else {
          listEl.innerHTML = html
        }
        moreWrap.style.display = data.hasMore ? '' : 'none'
        currentOffset += data.results.length
        attachItemListeners()
      })
      .catch(function() {
        showState('empty')
      })
  }

  input.addEventListener('input', function() {
    var val = input.value.trim()
    clearBtn.style.display = val ? '' : 'none'
    clearTimeout(debounceTimer)
    currentQuery = val
    debounceTimer = setTimeout(function() { doSearch(false) }, 300)
  })

  clearBtn.addEventListener('click', function() {
    input.value = ''
    clearBtn.style.display = 'none'
    currentQuery = ''
    selectedSlug = ''
    showState('initial')
    previewEmpty.style.display = ''
    previewContent.style.display = 'none'
    input.focus()
  })

  moreBtn.addEventListener('click', function() {
    doSearch(true)
  })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
})()
</script>
