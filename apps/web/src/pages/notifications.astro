---
import { Bell } from 'lucide-static'
import AppLayout from '../layouts/AppLayout.astro'
import { supabase } from '../lib/supabase/client'
import { createAuthClient } from '../lib/supabase/auth'
import { getEntityByUserId, getNotifications, getUnreadCount } from '@agora/supabase'
import { format, formatDistanceToNow } from 'date-fns'
import { fr } from 'date-fns/locale'

const dashboardUrl = import.meta.env.DASHBOARD_URL ?? 'http://localhost:3000'
const siteUrl = import.meta.env.SITE_URL

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()

if (!user) {
  return Astro.redirect(`${dashboardUrl}/login`)
}

const [currentUserEntity, notifications, unreadCount] = await Promise.all([
  getEntityByUserId(supabase, user.id),
  getNotifications(authClient, user.id, { limit: 50 }),
  getUnreadCount(authClient, user.id),
])

const profileUrl = currentUserEntity ? `${siteUrl}/${currentUserEntity.slug}` : siteUrl

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')

function formatNotifDate(dateStr: string): string {
  const date = new Date(dateStr)
  const diffMs = Date.now() - date.getTime()
  if (diffMs < 7 * 24 * 60 * 60 * 1000) {
    return formatDistanceToNow(date, { addSuffix: true, locale: fr })
  }
  return format(date, 'd MMMM yyyy', { locale: fr })
}

function getNotifText(n: (typeof notifications)[number]): string {
  const actor = n.actor_entity as { display_name: string } | null
  const name = actor?.display_name ?? 'Quelqu\'un'
  if (n.type === 'new_follower') return `${name} vous suit`
  if (n.type === 'new_publication') return `${name} a publié une news`
  return `${name} a interagi`
}

function getNotifUrl(n: (typeof notifications)[number]): string {
  const actor = n.actor_entity as { slug: string } | null
  const targetPub = n.target_publication as { slug: string } | null
  if (n.type === 'new_follower' && actor) return `/${actor.slug}`
  if (n.type === 'new_publication' && actor && targetPub?.slug) {
    return `/${actor.slug}/news/${targetPub.slug}`
  }
  return '#'
}
---
<AppLayout
  title="Notifications — Agora"
  user={user}
  profileUrl={profileUrl}
  robots="noindex, nofollow"
>
  <main class="py-8 sm:py-12">
    <div class="mx-auto max-w-[800px] px-4">
      <div class="rounded-xl border border-neutral-200 bg-neutral-0 shadow-sm overflow-hidden">
        {/* Header */}
        <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-100">
          <h1 class="text-xl font-semibold text-neutral-900">Notifications</h1>
          {unreadCount > 0 && (
            <button
              type="button"
              data-mark-all-read-page
              class="text-xs font-medium uppercase tracking-wide text-accent transition hover:text-accent-hover"
            >
              Tout marquer lu
            </button>
          )}
        </div>

        {/* List */}
        {notifications.length === 0 ? (
          <div class="flex flex-col items-center gap-3 px-6 py-16 text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400" set:html={Bell} />
            <h2 class="text-base font-medium text-neutral-600">Aucune notification</h2>
            <p class="text-sm text-neutral-400">Les interactions sur votre profil apparaîtront ici.</p>
          </div>
        ) : (
          <div>
            {notifications.map((n) => {
              const actor = n.actor_entity as { display_name: string; avatar_url: string | null; slug: string } | null
              const actorInitial = actor?.display_name?.charAt(0).toUpperCase() ?? '?'
              return (
                <a
                  href={getNotifUrl(n)}
                  data-notif-id={n.id}
                  class:list={[
                    'flex items-center gap-4 px-6 py-4 transition hover:bg-neutral-50 border-b border-neutral-100 last:border-b-0',
                    !n.read_at && 'bg-accent-soft/30',
                  ]}
                >
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-accent-soft">
                    {actor?.avatar_url ? (
                      <img src={actor.avatar_url} alt="" class="h-full w-full object-cover" />
                    ) : (
                      <span class="text-sm font-semibold text-accent">{actorInitial}</span>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-neutral-900">{getNotifText(n)}</p>
                    <p class="text-xs text-neutral-400 mt-0.5">{formatNotifDate(n.created_at)}</p>
                  </div>
                  {!n.read_at && (
                    <span class="h-2 w-2 shrink-0 rounded-full bg-accent" />
                  )}
                </a>
              )
            })}
          </div>
        )}
      </div>
    </div>
  </main>
</AppLayout>

<script>
  // Mark all read
  document.querySelector('[data-mark-all-read-page]')?.addEventListener('click', async () => {
    try {
      await fetch('/api/notifications/mark-all-read', { method: 'POST' })
      // Remove unread styling
      document.querySelectorAll('.bg-accent-soft\\/30').forEach(el => el.classList.remove('bg-accent-soft/30'))
      document.querySelectorAll('.notif-dot').forEach(el => el.remove())
      // Remove dots
      document.querySelectorAll('[data-notif-id]').forEach(item => {
        const dot = item.querySelector('.bg-accent.h-2.w-2')
        dot?.remove()
      })
      // Remove button
      document.querySelector('[data-mark-all-read-page]')?.remove()
    } catch (err) { console.error('[mark-all]', err) }
  })

  // Mark individual on click
  document.querySelectorAll<HTMLAnchorElement>('[data-notif-id]').forEach(item => {
    item.addEventListener('click', () => {
      const id = item.dataset.notifId
      if (id) {
        fetch('/api/notifications/mark-read', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notificationId: id }),
        }).catch(() => {})
      }
    })
  })
</script>
