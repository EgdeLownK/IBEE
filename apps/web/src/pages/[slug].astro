---
import AppLayout from '../layouts/AppLayout.astro'
import ProfilePage from '@ibee/ui-server/src/components/ProfilePage.astro'
import SchemaJsonLd from '@ibee/ui-server/src/components/SchemaJsonLd.astro'
import { supabase } from '../lib/supabase/client'
import { createAuthClient } from '../lib/supabase/auth'
import {
  getEntityBySlug,
  getEntityMenuSections,
  getEntityHomeWidgets,
  getEntityHistory,
  getEntityContactInfo,
  defaultOpeningHours,
  getEntityFaq,
  getPublicationsByEntity,
  getAppointmentTypesByEntity,
  listPublishedProductsByEntity,
  listProductCategories,
  listUpcomingEvents,
  countEventRegistrations,
  getReviewAggregates,
  getServiceReviewAggregates,
  isFollowing as checkIsFollowing
} from '@ibee/supabase'

const { slug } = Astro.params
if (!slug) return new Response(null, { status: 404 })

if (slug.startsWith('__')) return new Response(null, { status: 404 })

const entity = await getEntityBySlug(supabase, slug)
if (!entity) return new Response(null, { status: 404 })

const entityRow = entity as typeof entity & { banner_url?: string | null }

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()
const dashboardUrl = import.meta.env.DASHBOARD_URL ?? 'http://localhost:3000'
const isPreview = Astro.url.searchParams.get('preview') === '1'
const isOwner = !!(user && entity.user_id && user.id === entity.user_id)

// Cutover phase 9 : l'owner édite via le dashboard React, pas via Astro.
if (isOwner && !isPreview) {
  return Astro.redirect(`${dashboardUrl}/dashboard/site`)
}

const [menuSections, homeWidgetsRaw, historyBlocks, contactInfoRaw, faq, publications, appointmentTypes, products, productCategories, upcomingEvents] = await Promise.all([
  getEntityMenuSections(supabase, entity.id),
  getEntityHomeWidgets(supabase, entity.id),
  getEntityHistory(supabase, entity.id).catch(() => []),
  getEntityContactInfo(supabase, entity.id).catch(() => null),
  getEntityFaq(supabase, entity.id),
  getPublicationsByEntity(supabase, entity.id, { publicOnly: true, limit: 50 }),
  getAppointmentTypesByEntity(supabase, entity.id, { activeOnly: true }),
  listPublishedProductsByEntity(supabase, entity.id, { limit: 60 }),
  listProductCategories(supabase, entity.id),
  listUpcomingEvents(supabase, entity.id),
])

const eventRegistrationCounts = await Promise.all(
  upcomingEvents.map((ev) =>
    ev.capacity != null ? countEventRegistrations(supabase, ev.id).catch(() => 0) : Promise.resolve(0)
  )
)
const events = upcomingEvents.map((ev, i) => ({
  ...ev,
  registrations_count: eventRegistrationCounts[i],
}))

const productCategoryOptions = productCategories.map((c) => ({ id: c.id, name: c.name }))

const CARD_DETAIL_EXCERPT_MAX = 150

function truncateText(text: string, max: number = CARD_DETAIL_EXCERPT_MAX): string {
  const t = text.trim()
  if (t.length <= max) return t
  return `${t.slice(0, max)}...`
}

function entityDetailExcerpt(entity: {
  content_blocks?: unknown
  description_long?: string | null
  description_short?: string | null
  description?: string | null
}): string {
  if (Array.isArray(entity.content_blocks)) {
    for (const raw of entity.content_blocks) {
      if (!raw || typeof raw !== 'object') continue
      const block = raw as Record<string, unknown>
      if (block.type === 'text' && typeof block.content === 'string' && block.content.trim()) {
        return truncateText(block.content)
      }
      if (block.type === 'list' && Array.isArray(block.items) && block.items.length > 0) {
        return truncateText(
          block.items.filter((item): item is string => typeof item === 'string').join(' · ')
        )
      }
    }
  }
  if (typeof entity.description_long === 'string' && entity.description_long.trim()) {
    return truncateText(entity.description_long)
  }
  if (typeof entity.description_short === 'string' && entity.description_short.trim()) {
    return truncateText(entity.description_short)
  }
  if (typeof entity.description === 'string' && entity.description.trim()) {
    const desc = entity.description.trim()
    try {
      const parsed = JSON.parse(desc)
      if (Array.isArray(parsed) && parsed[0]?.type === 'text' && typeof parsed[0].content === 'string') {
        return truncateText(parsed[0].content)
      }
    } catch {
      return truncateText(desc)
    }
  }
  return ''
}

const [productReviewStats, serviceReviewStats] = await Promise.all([
  Promise.all(
    products.map((p) =>
      getReviewAggregates(supabase, p.id).catch(() => ({ count: 0, average: 0 }))
    )
  ),
  Promise.all(
    appointmentTypes.map((s) =>
      getServiceReviewAggregates(supabase, s.id).catch(() => ({ count: 0, average: 0 }))
    )
  ),
])

const playlistServices = appointmentTypes.map((s, i) => ({
  ...s,
  detailExcerpt: entityDetailExcerpt(s),
  reviewCount: serviceReviewStats[i].count,
  reviewAverage: serviceReviewStats[i].average,
}))

const playlistEvents = events.map((ev) => ({
  ...ev,
  detailExcerpt: entityDetailExcerpt(ev),
}))

const shopProducts = products.map((p, i) => ({
  id: p.id,
  title: p.title,
  slug: p.slug,
  detailExcerpt: entityDetailExcerpt(p),
  reviewCount: productReviewStats[i].count,
  reviewAverage: productReviewStats[i].average,
  price_cents: p.price_cents,
  sale_price_cents: p.sale_price_cents,
  sale_ends_at: p.sale_ends_at,
  currency: p.currency,
  image_url: p.product_media?.[0]?.url ?? null,
  status: p.status,
  category_id: p.category_id,
  type: p.type,
  physical_stock_quantity: p.physical_stock_quantity,
}))

const siteUrl = import.meta.env.SITE_URL
const profileUrl = `${siteUrl}/${entity.slug}`
const homeWidgets = homeWidgetsRaw.map((w) => ({
  ...w,
  config: typeof w.config === 'string'
    ? (() => { try { return JSON.parse(w.config) } catch { return {} } })()
    : (w.config ?? {}),
}))

const faqItems = (faq.items ?? []).map((item) => ({
  question: item.question,
  answer: item.answer,
}))
const contactInfo = contactInfoRaw ?? {
  entity_id: entity.id,
  contact_email: null,
  contact_email_public: true,
  contact_phone: null,
  contact_phone_public: true,
  message_enabled: false,
  opening_hours_enabled: false,
  opening_hours: defaultOpeningHours(),
}

const isAuthenticated = !!user
let isFollowing = false
if (user) {
  isFollowing = await checkIsFollowing(supabase, user.id, entity.id)
}

Astro.response.headers.set(
  'Cache-Control',
  's-maxage=86400, stale-while-revalidate=604800'
)
Astro.response.headers.set(
  'X-Robots-Tag',
  'index, follow, max-snippet:-1, max-image-preview:large'
)
---
<AppLayout
  title={`${entity.display_name} — IBEE`}
  description={entity.bio ?? `${entity.display_name} sur IBEE`}
  image={entity.avatar_url ?? undefined}
  url={profileUrl}
  type="profile"
  user={user}
  profileUrl={profileUrl}
  showSidebar={true}
>
  <SchemaJsonLd
    slot="head"
    entity={entity}
    siteUrl={siteUrl}
    faqItems={faq.isActive ? faqItems : []}
  />
  <main class="profile-page">
    <ProfilePage
      entity={{
        id: entity.id,
        display_name: entity.display_name,
        role: entity.role,
        location: entity.location,
        bio: entity.bio,
        avatar_url: entity.avatar_url,
        banner_url: entityRow.banner_url ?? null,
        created_at: entity.created_at,
        slug: entity.slug,
        followers_count: entity.followers_count ?? 0,
      }}
      menuSections={menuSections}
      homeWidgets={homeWidgets}
      faqItems={faqItems}
      publications={publications}
      appointmentTypes={playlistServices}
      shopProducts={shopProducts}
      productCategories={productCategoryOptions}
      events={playlistEvents}
      historyBlocks={historyBlocks}
      contactInfo={contactInfo}
      isAuthenticated={isAuthenticated}
      isFollowing={isFollowing}
      dashboardUrl={dashboardUrl}
    />
  </main>
</AppLayout>
