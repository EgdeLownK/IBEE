---
import { ArrowLeft, ShoppingBag } from 'lucide-static'
import AppLayout from '../../layouts/AppLayout.astro'
import ProfileCard from '@ibee/ui-server/src/components/ProfileCard.astro'
import ProductCard from '@ibee/ui-server/src/components/ProductCard.astro'
import { supabase } from '../../lib/supabase/client'
import { createAuthClient } from '../../lib/supabase/auth'
import { getEntityBySlug, listPublishedProductsByEntity } from '@ibee/supabase'

const { slug } = Astro.params
if (!slug) return new Response(null, { status: 404 })
if (slug.startsWith('__')) return new Response(null, { status: 404 })

const entity = await getEntityBySlug(supabase, slug)
if (!entity) return new Response(null, { status: 404 })

// Lecture publique : client anon
const products = await listPublishedProductsByEntity(supabase, entity.id, { limit: 48 })

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()
const isOwner = !!(user && entity.user_id && user.id === entity.user_id)

const siteUrl = import.meta.env.SITE_URL
const profileUrl = `${siteUrl}/${entity.slug}`
const shopUrl = `${siteUrl}/${entity.slug}/shop`
const dashboardUrl = import.meta.env.DASHBOARD_URL ?? 'http://localhost:3000'

const description = `Boutique de ${entity.display_name} — ${products.length} produit${products.length > 1 ? 's' : ''} en vente sur Agora.`

// JSON-LD : ItemList des produits pour la page boutique (GEO/AEO).
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Boutique — ${entity.display_name}`,
  url: shopUrl,
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/${entity.slug}/shop/${p.slug}`,
    name: p.title,
  })),
}

Astro.response.headers.set('Cache-Control', 's-maxage=86400, stale-while-revalidate=604800')
Astro.response.headers.set('X-Robots-Tag', 'index, follow, max-snippet:-1, max-image-preview:large')
---
<AppLayout
  title={`Boutique — ${entity.display_name} — Agora`}
  description={description}
  image={entity.avatar_url ?? undefined}
  url={shopUrl}
  type="website"
  user={user}
  profileUrl={profileUrl}
  showSidebar={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} is:inline />
  </Fragment>

  <main class="md:py-8 sm:py-12">
    <div class="mx-auto max-w-[1000px] px-4 mb-3 md:px-0">
      <a href={`/${entity.slug}`} class="inline-flex items-center gap-1.5 text-sm text-neutral-500 transition hover:text-neutral-900">
        <span class="flex h-4 w-4 items-center justify-center" set:html={ArrowLeft} />
        {entity.display_name}
      </a>
    </div>

    <ProfileCard>
      <header class="px-6 sm:px-12 pt-6 pb-4">
        <h1 class="text-2xl font-semibold text-neutral-900">Boutique</h1>
        <p class="mt-1 text-sm text-neutral-500">
          Produits proposés par {entity.display_name}
        </p>
      </header>

      <section class="px-6 sm:px-12 pb-10">
        {products.length === 0 ? (
          <div class="flex flex-col items-center justify-center gap-2 py-16 text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400" set:html={ShoppingBag} />
            <h2 class="mt-2 text-base font-semibold text-neutral-900">Aucun produit pour le moment</h2>
            <p class="max-w-sm text-sm text-neutral-500">
              {isOwner
                ? 'Ajoute ton premier produit depuis ton dashboard pour démarrer ta boutique.'
                : 'Cette boutique ne propose pas encore de produits.'}
            </p>
            {isOwner && (
              <a
                href={`${dashboardUrl}/dashboard/site/products`}
                class="mt-3 inline-flex items-center rounded-lg bg-accent px-5 py-2 text-sm font-medium text-white transition hover:bg-accent-hover"
              >
                Gérer ma boutique
              </a>
            )}
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((product) => (
              <ProductCard product={product} entitySlug={entity.slug} />
            ))}
          </div>
        )}
      </section>
    </ProfileCard>
  </main>
</AppLayout>
