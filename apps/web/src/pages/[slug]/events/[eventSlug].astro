---
import { CalendarDays } from 'lucide-static'
import AppLayout from '../../../layouts/AppLayout.astro'
import DetailTopBar from '@ibee/ui-server/src/components/DetailTopBar.astro'
import DetailEntityStrip from '@ibee/ui-server/src/components/DetailEntityStrip.astro'
import ProfileCard from '@ibee/ui-server/src/components/ProfileCard.astro'
import EntityDetailBody from '@ibee/ui-server/src/components/EntityDetailBody.astro'
import RelatedContent from '@ibee/ui-server/src/components/RelatedContent.astro'
import ProductFaq from '@ibee/ui-server/src/components/ProductFaq.astro'
import { supabase } from '../../../lib/supabase/client'
import { createAuthClient } from '../../../lib/supabase/auth'
import { getEntityBySlug, getEventBySlug, countEventRegistrations, getEntityMenuSections } from '@ibee/supabase'

const { slug, eventSlug } = Astro.params
if (!slug || !eventSlug) return new Response(null, { status: 404 })
if (slug.startsWith('__')) return new Response(null, { status: 404 })

const entity = await getEntityBySlug(supabase, slug)
if (!entity) return new Response(null, { status: 404 })

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()

const event = await getEventBySlug(supabase, entity.id, eventSlug)
if (!event || !event.is_published) return new Response(null, { status: 404 })

// Jauge (RPC SECURITY DEFINER — la table inscriptions est owner-only)
let registrationsCount = 0
try {
  registrationsCount = await countEventRegistrations(supabase, event.id)
} catch {
  registrationsCount = 0
}
const remaining = event.capacity != null ? Math.max(0, event.capacity - registrationsCount) : null
const isFull = remaining !== null && remaining <= 0
const isPast = new Date(event.start_at).getTime() <= Date.now()

const siteUrl = import.meta.env.SITE_URL
const profileUrl = `${siteUrl}/${entity.slug}`
const eventUrl = `${siteUrl}/${entity.slug}/events/${event.slug}`
// Dates formatées (fr-FR)
const start = new Date(event.start_at)
const dateLabel = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(start)
const dayChip = new Intl.DateTimeFormat('fr-FR', { day: 'numeric' }).format(start)
const monthChip = new Intl.DateTimeFormat('fr-FR', { month: 'short' }).format(start).replace('.', '')
const timeLabel = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(start)
const endTimeLabel = event.end_at
  ? new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(new Date(event.end_at))
  : null

const locationLabels: Record<string, string> = {
  online: 'En ligne',
  in_person: 'Sur place',
}
const locLabel = locationLabels[event.location_type] ?? 'En ligne'

function formatPrice(cents: number | null, curr: string) {
  if (cents === null || cents === 0) return '0€'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: curr }).format(cents / 100)
}
const priceText = formatPrice(event.price_cents, event.currency)

const statusAvailable = !isPast && !isFull

// Bandeau stats (Date / Lieu / Places)
const placesStat = remaining !== null
  ? { value: isFull ? 'Complet' : String(remaining), sub: isFull ? undefined : 'places restantes' }
  : { value: isPast ? 'Terminé' : 'Ouvert', sub: undefined }
const stats = [
  { label: 'Date', value: `${dayChip} ${monthChip}`, valueSmall: true },
  { label: 'Prix', value: priceText, valueSmall: true, valueDark: true },
  { label: 'Lieu', value: locLabel, valueSmall: true },
  { label: 'Places', value: placesStat.value, valueSmall: true, state: (statusAvailable ? 'success' : 'error') as 'success' | 'error' },
]

// Lignes de l'accordéon "Information générale" (date / horaire / lieu / capacité)
const detailRows: { label: string; value: string }[] = [
  { label: 'Date', value: dateLabel },
  { label: 'Horaire', value: endTimeLabel ? `${timeLabel} — ${endTimeLabel}` : timeLabel },
  { label: 'Lieu', value: event.location_details ? `${locLabel} · ${event.location_details}` : locLabel },
  ...(remaining !== null ? [{ label: 'Places', value: isFull ? 'Complet' : `${remaining} restante${remaining > 1 ? 's' : ''}` }] : []),
]

// FAQ (narrowing défensif)
const faq = Array.isArray(event.faq)
  ? (event.faq as unknown[]).flatMap((f): { question: string; answer: string }[] => {
      if (!f || typeof f !== 'object') return []
      const item = f as Record<string, unknown>
      if (typeof item.question === 'string' && typeof item.answer === 'string') {
        return [{ question: item.question, answer: item.answer }]
      }
      return []
    })
  : []

// Description (meta + schema)
type ContentBlock = { type: 'text'; content: string } | { type: 'image'; url: string; alt?: string }
const blocks: ContentBlock[] = Array.isArray(event.content_blocks)
  ? (event.content_blocks as unknown[]).flatMap((b): ContentBlock[] => {
      if (!b || typeof b !== 'object') return []
      const block = b as Record<string, unknown>
      if (block.type === 'text' && typeof block.content === 'string') return [{ type: 'text', content: block.content }]
      if (block.type === 'image' && typeof block.url === 'string') {
        return [{ type: 'image', url: block.url, alt: typeof block.alt === 'string' ? block.alt : undefined }]
      }
      return []
    })
  : []
const textContent = blocks.filter((b): b is { type: 'text'; content: string } => b.type === 'text').map((b) => b.content).join(' ')
const metaDescription = event.description ?? (textContent ? textContent.slice(0, 160) : `${event.title} — Event par ${entity.display_name}`)

// Médias (galerie event) → carrousel ; sinon placeholder
const eventMedia = Array.isArray(event.gallery_images)
  ? (event.gallery_images as unknown[]).filter((u): u is string => typeof u === 'string').map((url) => ({ url }))
  : []
const coverImage = eventMedia[0]?.url ?? null

const menuSections = await getEntityMenuSections(supabase, entity.id)
const hasNews = menuSections.some((s) => s.type === 'news')

// --- Mock data (reco) — même traitement que la page produit ---
const profileRelated = [
  { kind: 'event' as const, title: 'Atelier en ligne', meta: 'Événement · 12 juin' },
  { kind: 'service' as const, title: 'Séance de coaching', meta: 'Service · 60 min' },
  { kind: 'product' as const, title: 'Guide complet (PDF)', meta: 'Produit · 19 €' },
  { kind: 'event' as const, title: 'Conférence annuelle', meta: 'Événement · 5 juillet' },
  { kind: 'product' as const, title: 'Pack ressources', meta: 'Produit · 39 €' },
]
const similarRelated = [
  { kind: 'event' as const, title: 'Événement à découvrir', meta: 'Événement · 20 juin' },
  { kind: 'service' as const, title: 'Prestation similaire', meta: 'Service · 45 min' },
  { kind: 'product' as const, title: 'Produit similaire', meta: 'Produit · 24 €' },
  { kind: 'event' as const, title: 'Autre rendez-vous', meta: 'Événement · 1 août' },
  { kind: 'service' as const, title: 'Service recommandé', meta: 'Service · 30 min' },
]

// JSON-LD Event — schéma riche pour Google/LLMs (GEO/AEO)
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  ...(event.description && { description: event.description }),
  startDate: event.start_at,
  ...(event.end_at && { endDate: event.end_at }),
  eventAttendanceMode:
    event.location_type === 'online'
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location:
    event.location_type === 'online'
      ? { '@type': 'VirtualLocation', url: eventUrl }
      : { '@type': 'Place', name: event.location_details ?? 'Sur place', address: event.location_details ?? undefined },
  ...(coverImage && { image: [coverImage] }),
  organizer: { '@type': 'Person', name: entity.display_name, url: profileUrl },
  offers: {
    '@type': 'Offer',
    price: ((event.price_cents ?? 0) / 100).toFixed(2),
    priceCurrency: event.currency,
    availability: isFull ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    url: eventUrl,
  },
  url: eventUrl,
}

// Cache CDN réservé aux visiteurs anonymes : le formulaire varie selon l'auth
if (user) {
  Astro.response.headers.set('Cache-Control', 'private, no-store')
} else {
  Astro.response.headers.set('Cache-Control', 's-maxage=86400, stale-while-revalidate=604800')
}
Astro.response.headers.set('X-Robots-Tag', 'index, follow, max-snippet:-1, max-image-preview:large')
---
<AppLayout
  title={`${event.title} — ${entity.display_name} — IBEE`}
  description={metaDescription}
  image={coverImage ?? entity.avatar_url ?? undefined}
  url={eventUrl}
  type="website"
  user={user}
  profileUrl={profileUrl}
  showSidebar={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  </Fragment>

  <main class="profile-page">
    <ProfileCard>
      <DetailTopBar backHref={`/${entity.slug}#events`} title={`Voir le profil de ${entity.display_name}`} />

      <DetailEntityStrip
        displayName={entity.display_name}
        avatarUrl={entity.avatar_url}
        profileHref={`/${entity.slug}`}
        title={event.title}
        subtitle={[`${dayChip} ${monthChip}`, locLabel].filter(Boolean).join(' · ')}
      />

      <EntityDetailBody
        title={event.title}
        media={eventMedia}
        placeholderIcon={CalendarDays}
        stats={stats}
        priceText={priceText}
        detailRows={detailRows}
        entitySlug={entity.slug}
        entityKind="event"
        contentBlocks={blocks}
        fallbackText={event.description}
        hasNews={hasNews}
      />

      {/* Reco : autres contenus du profil, puis contenus similaires */}
      <div class="product-related pb-2">
        <RelatedContent title={`Autres contenus de ${entity.display_name}`} items={profileRelated} />
        <RelatedContent title="À découvrir aussi" items={similarRelated} />
      </div>

      {/* Grande section "Questions" (label orange, même style que produit) */}
      {faq.length > 0 && (
        <div class="product-sections px-[22px] pt-2 pb-6">
          <section class="product-major-section">
            <h2 class="product-major-section__title">Questions</h2>
            <div class="product-major-section__body">
              <ProductFaq faq={faq} />
            </div>
          </section>
        </div>
      )}
    </ProfileCard>
  </main>
</AppLayout>

<style>
  .product-sections {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .product-major-section {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .product-major-section__title {
    margin: 0;
    display: block;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .product-major-section__body {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .product-major-section :global(#faq .sec-h) {
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #2a2a2a;
  }
  .product-major-section :global(.sec) {
    border-top: 0;
    padding: 0;
  }
</style>
