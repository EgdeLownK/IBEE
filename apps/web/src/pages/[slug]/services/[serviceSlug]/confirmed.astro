---
import { CheckCircle, ArrowRight, CalendarDays, Clock, MapPin, Video, Phone } from 'lucide-static'
import AppLayout from '../../../../layouts/AppLayout.astro'
import ProfileCard from '@ibee/ui-server/src/components/ProfileCard.astro'
import { supabase } from '../../../../lib/supabase/client'
import { createAuthClient } from '../../../../lib/supabase/auth'
import { getEntityBySlug, getAppointmentTypeBySlug, getAppointmentTypesByEntity } from '@ibee/supabase'
import RecommendedServices from '@ibee/ui-server/src/components/RecommendedServices.astro'

const { slug, serviceSlug } = Astro.params
if (!slug || !serviceSlug) return new Response(null, { status: 404 })

const entity = await getEntityBySlug(supabase, slug!)
if (!entity) return new Response(null, { status: 404 })

const service = await getAppointmentTypeBySlug(supabase, entity.id, serviceSlug!)
if (!service) return new Response(null, { status: 404 })

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()

const allTypes = await getAppointmentTypesByEntity(supabase, entity.id, { activeOnly: true })
const otherServices = allTypes.filter(t => t.id !== service.id)

const siteUrl = import.meta.env.SITE_URL
const profileUrl = `${siteUrl}/${entity.slug}`

const url = new URL(Astro.request.url)
const bookerName = url.searchParams.get('name') ?? ''
const dateRecap = url.searchParams.get('date') ?? ''

function formatPrice(cents: number | null, currency: string) {
  if (cents === null || cents === 0) return 'Gratuit'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100)
}

const locationLabels: Record<string, { icon: string; label: string }> = {
  video: { icon: Video, label: 'Visio' }, in_person: { icon: MapPin, label: 'Sur place' }, phone: { icon: Phone, label: 'Tel' },
}
const loc = locationLabels[service.location_type] ?? locationLabels.video

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---
<AppLayout
  title={`Rendez-vous confirme — ${entity.display_name} — Agora`}
  user={user}
  profileUrl={profileUrl}
  robots="noindex, nofollow"
  showSidebar={true}
>
  <main class="md:py-8 sm:py-12">
    <ProfileCard>
      {/* Avatar */}
      <div class="flex flex-col items-center pt-10 pb-2 px-6">
        {entity.avatar_url ? (
          <img src={entity.avatar_url} alt={entity.display_name} class="h-20 w-20 rounded-full object-cover border-4 border-neutral-0 shadow-sm" />
        ) : (
          <div class="flex h-20 w-20 items-center justify-center rounded-full bg-accent-soft text-2xl font-bold text-accent">
            {entity.display_name.charAt(0).toUpperCase()}
          </div>
        )}
      </div>

      {/* Celebration */}
      <div class="px-6 sm:px-12 py-8 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-success/10">
          <span class="flex h-8 w-8 items-center justify-center text-success" set:html={CheckCircle} />
        </div>

        <h1 class="mt-6 text-2xl font-semibold text-neutral-900">
          {bookerName ? `Merci ${bookerName} !` : 'Rendez-vous demande !'}
        </h1>
        <p class="mt-2 text-sm text-neutral-500">
          Votre demande a bien ete envoyee. {entity.display_name} reviendra vers vous pour confirmer le creneau.
        </p>

        {/* Recap card */}
        <div class="mt-8 rounded-xl border border-neutral-200 bg-neutral-0 p-5 text-left">
          <h2 class="text-sm font-semibold text-neutral-900">{service.title}</h2>
          <div class="mt-3 space-y-2">
            {dateRecap && (
              <div class="flex items-center gap-2.5 text-sm text-neutral-600">
                <span class="flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={CalendarDays} />
                {dateRecap}
              </div>
            )}
            <div class="flex items-center gap-2.5 text-sm text-neutral-600">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={Clock} />
              {service.duration_minutes} minutes
            </div>
            <div class="flex items-center gap-2.5 text-sm text-neutral-600">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center text-neutral-400" set:html={loc.icon} />
              {loc.label}
            </div>
          </div>
          {service.price_cents !== null && service.price_cents > 0 && (
            <div class="mt-3 border-t border-neutral-100 pt-3 text-right">
              <span class="text-base font-semibold text-neutral-900">{formatPrice(service.price_cents, service.currency)}</span>
            </div>
          )}
        </div>

        <p class="mt-6 text-xs text-neutral-400">
          Un email de confirmation sera envoye a l'adresse indiquee.
        </p>

        {/* Actions */}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a
            href={`/${entity.slug}`}
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent-hover"
          >
            Voir le profil
            <span class="flex h-4 w-4 items-center justify-center" set:html={ArrowRight} />
          </a>
          <a
            href={`/${entity.slug}/services/${service.slug}`}
            class="inline-flex items-center justify-center rounded-xl border border-neutral-200 px-6 py-3 text-sm font-medium text-neutral-600 transition hover:bg-neutral-50"
          >
            Reprendre un rendez-vous
          </a>
        </div>
      </div>

      {/* Widget recommandations */}
      {otherServices.length > 0 && (
        <div class="border-t border-neutral-200 px-6 sm:px-12 py-6">
          <RecommendedServices services={otherServices} entitySlug={entity.slug} title="Decouvrir aussi" />
        </div>
      )}
    </ProfileCard>
  </main>
</AppLayout>
