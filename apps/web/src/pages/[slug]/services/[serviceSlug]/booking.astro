---
import { Clock, MapPin, Video, Phone, CalendarDays, ChevronLeft } from 'lucide-static'
import AppLayout from '../../../../layouts/AppLayout.astro'
import DetailTopBar from '@ibee/ui-server/src/components/DetailTopBar.astro'
import DetailEntityStrip from '@ibee/ui-server/src/components/DetailEntityStrip.astro'
import ProfileCard from '@ibee/ui-server/src/components/ProfileCard.astro'
import { supabase } from '../../../../lib/supabase/client'
import { createAuthClient } from '../../../../lib/supabase/auth'
import { getEntityBySlug, getAppointmentTypeBySlug, getEntityByUserId } from '@ibee/supabase'

const { slug, serviceSlug } = Astro.params
if (!slug || !serviceSlug) return new Response(null, { status: 404 })
if (slug.startsWith('__')) return new Response(null, { status: 404 })

const entity = await getEntityBySlug(supabase, slug)
if (!entity) return new Response(null, { status: 404 })

const service = await getAppointmentTypeBySlug(supabase, entity.id, serviceSlug)
if (!service || !service.is_active) return new Response(null, { status: 404 })

const authClient = createAuthClient(Astro.request, Astro.cookies)
const { data: { user } } = await authClient.auth.getUser()

let bookerEntity: { display_name: string; slug: string } | null = null
if (user) {
  bookerEntity = await getEntityByUserId(supabase, user.id)
}
const isLoggedIn = !!user
const bookerName = bookerEntity?.display_name ?? ''
const bookerEmail = user?.email ?? ''

const siteUrl = import.meta.env.SITE_URL
const profileUrl = `${siteUrl}/${entity.slug}`
const serviceUrl = `${siteUrl}/${entity.slug}/services/${service.slug}`

function formatPrice(cents: number | null, currency: string) {
  if (cents === null || cents === 0) return '0€'
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100)
}

const priceText = formatPrice(service.price_cents, service.currency)
const locationLabels: Record<string, { icon: string; label: string }> = {
  video: { icon: Video, label: 'Visioconference' },
  in_person: { icon: MapPin, label: 'Sur place' },
  phone: { icon: Phone, label: 'Telephone' },
}
const loc = locationLabels[service.location_type] ?? locationLabels.video
---
<AppLayout title={`Réserver ${service.title} — ${entity.display_name} — IBEE`} user={user} profileUrl={profileUrl} showSidebar={true}>
  <main class="profile-page">
    <DetailTopBar backHref={`/${entity.slug}/services/${service.slug}`} title={`Réserver : ${service.title}`} />

    <ProfileCard>
      <DetailEntityStrip
        displayName={entity.display_name}
        avatarUrl={entity.avatar_url}
        profileHref={`/${entity.slug}`}
      />

      <section class="booking-hero px-[22px] pt-[18px] pb-3">
        <h1 class="m-0 font-display text-[26px] font-semibold leading-[1.15] tracking-tight text-neutral-900">{service.title}</h1>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="pill">
            <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={Clock} />{service.duration_minutes} min
          </span>
          <span class="pill">
            <span class="flex h-3.5 w-3.5 items-center justify-center" set:html={loc.icon} />{loc.label}
          </span>
          <span class="pill pill--accent font-semibold">{priceText}</span>
        </div>
      </section>

      <section id="booking-panel" class="sec booking-panel scroll-mt-20" style="margin-top:22px;">
        {/* Step 1 : Calendrier + creneaux */}
        <div id="step-calendar">
          <div class="mb-4 flex items-center justify-between">
            <div class="w-7"></div>
            <h2 class="text-base font-semibold text-neutral-900">Choisir un creneau</h2>
            <div class="flex items-center gap-1.5">
              <span class="flex h-2 w-2 rounded-full bg-accent"></span>
              <span class="flex h-2 w-2 rounded-full bg-neutral-200"></span>
            </div>
          </div>
          <div id="booking-calendar"></div>
          <div class="mt-5">
            <p class="mb-2 text-xs font-medium uppercase tracking-wider text-neutral-500">Creneaux</p>
            <div id="booking-slots" class="grid grid-cols-3 gap-2 sm:grid-cols-4">
              <p class="col-span-full text-sm text-neutral-400">Chargement...</p>
            </div>
          </div>
        </div>

        {/* Step 2 : Coordonnees + recap + confirmation */}
        <div id="step-recap" style="display:none;">
          <div class="mb-4 flex items-center justify-between">
            <button type="button" id="back-calendar" class="rounded-lg p-1.5 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-600">
              <span class="flex h-4 w-4 items-center justify-center" set:html={ChevronLeft} />
            </button>
            <h2 class="text-base font-semibold text-neutral-900">Confirmer</h2>
            <div class="flex items-center gap-1.5">
              <span class="flex h-2 w-2 rounded-full bg-accent"></span>
              <span class="flex h-2 w-2 rounded-full bg-accent"></span>
            </div>
          </div>

          <div class="space-y-3">
            <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-4 space-y-2">
              <p class="text-sm font-semibold text-neutral-900">{service.title}</p>
              <div class="flex items-center gap-2 text-xs text-neutral-600">
                <span class="flex h-3.5 w-3.5 items-center justify-center text-neutral-400" set:html={CalendarDays} />
                <span id="recap-datetime-final"></span>
              </div>
              <div class="flex items-center gap-2 text-xs text-neutral-600">
                <span class="flex h-3.5 w-3.5 items-center justify-center text-neutral-400" set:html={Clock} />
                {service.duration_minutes} min — {loc.label}
              </div>
              {service.price_cents !== null && service.price_cents > 0 && (
                <p class="pt-1 text-sm font-semibold text-neutral-900">{priceText}</p>
              )}
            </div>

            <div class="space-y-3" id="identity-fields">
              <div>
                <label class="field-label">Nom complet *</label>
                <input id="id-name" type="text" required autocomplete="name" class="field" placeholder="Jean Dupont" value={bookerName} />
              </div>
              <div>
                <label class="field-label">Email *</label>
                <input id="id-email" type="email" required autocomplete="email" class="field" placeholder="jean@exemple.com" value={bookerEmail} />
              </div>
              <div>
                <label class="field-label">Telephone</label>
                <input id="id-phone" type="tel" autocomplete="tel" class="field" placeholder="06 12 34 56 78" />
              </div>
            </div>

            <form id="booking-form">
              <input type="hidden" name="entityId" value={entity.id} />
              <input type="hidden" name="typeId" value={service.id} />
              <input type="hidden" name="startAt" id="booking-start-at" />
              <input type="hidden" name="endAt" id="booking-end-at" />
              <input type="hidden" name="name" id="form-name" />
              <input type="hidden" name="email" id="form-email" />
              <input type="hidden" name="phone" id="form-phone" />
              <button type="submit" id="booking-submit" class="btn btn--accent btn--block">
                Confirmer le rendez-vous
              </button>
              <p class="mt-2 text-center text-xs text-neutral-400">Vous recevrez un email de confirmation.</p>
            </form>
          </div>
        </div>
      </section>
    </ProfileCard>
  </main>
</AppLayout>

<script is:inline define:vars={{ entityId: entity.id, serviceId: service.id, entitySlug: entity.slug, serviceSlugVar: service.slug }}>
(function() {
  var selectedDate = ''
  var selectedStart = ''
  var selectedEnd = ''
  var availableDaysSet = {}
  var currentMonth = new Date()
  var calendarContainer = document.getElementById('booking-calendar')
  var slotsContainer = document.getElementById('booking-slots')

  function showStep(id) {
    var stepCalendar = document.getElementById('step-calendar')
    var stepRecap = document.getElementById('step-recap')
    if (stepCalendar) stepCalendar.style.display = id === 'step-calendar' ? '' : 'none'
    if (stepRecap) stepRecap.style.display = id === 'step-recap' ? '' : 'none'
  }

  var backCalendar = document.getElementById('back-calendar')
  if (backCalendar) backCalendar.addEventListener('click', function() { showStep('step-calendar') })

  function loadAvailableDays() {
    var monthStr = currentMonth.getFullYear() + '-' + String(currentMonth.getMonth() + 1).padStart(2, '0')
    fetch('/api/bookings/available-days?entityId=' + entityId + '&typeId=' + serviceId + '&month=' + monthStr)
      .then(function(r) { return r.json() })
      .then(function(data) {
        availableDaysSet = {}
        ;(data.days || []).forEach(function(d) { availableDaysSet[d] = true })
        renderCalendar()
        var sortedDays = (data.days || []).sort()
        if (sortedDays.length > 0) { selectedDate = sortedDays[0]; renderCalendar(); loadSlots(sortedDays[0]) }
      })
      .catch(function() { renderCalendar() })
  }

  function renderCalendar() {
    var year = currentMonth.getFullYear(), month = currentMonth.getMonth()
    var firstDay = new Date(year, month, 1).getDay()
    var daysInMonth = new Date(year, month + 1, 0).getDate()
    var today = new Date(); today.setHours(0,0,0,0)
    var monthNames = ['Janvier','Fevrier','Mars','Avril','Mai','Juin','Juillet','Aout','Septembre','Octobre','Novembre','Decembre']

    while (calendarContainer.firstChild) calendarContainer.removeChild(calendarContainer.firstChild)

    var header = document.createElement('div'); header.className = 'mb-3 flex items-center justify-between'
    var prev = document.createElement('button'); prev.type = 'button'; prev.className = 'rounded-lg p-1.5 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-900'; prev.textContent = '\u2190'
    var titleEl = document.createElement('span'); titleEl.className = 'text-sm font-semibold text-neutral-900'; titleEl.textContent = monthNames[month] + ' ' + year
    var next = document.createElement('button'); next.type = 'button'; next.className = 'rounded-lg p-1.5 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-900'; next.textContent = '\u2192'
    prev.addEventListener('click', function() { currentMonth.setMonth(currentMonth.getMonth() - 1); loadAvailableDays() })
    next.addEventListener('click', function() { currentMonth.setMonth(currentMonth.getMonth() + 1); loadAvailableDays() })
    header.appendChild(prev); header.appendChild(titleEl); header.appendChild(next)
    calendarContainer.appendChild(header)

    var dayRow = document.createElement('div'); dayRow.className = 'mb-1 grid grid-cols-7 gap-1 text-center text-xs font-medium text-neutral-400'
    ;['D','L','M','M','J','V','S'].forEach(function(d) { var el = document.createElement('div'); el.className = 'py-1'; el.textContent = d; dayRow.appendChild(el) })
    calendarContainer.appendChild(dayRow)

    var grid = document.createElement('div'); grid.className = 'grid grid-cols-7 gap-1'
    for (var i = 0; i < firstDay; i++) grid.appendChild(document.createElement('div'))
    for (var d = 1; d <= daysInMonth; d++) {
      var dateObj = new Date(year, month, d)
      var dateStr = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0')
      var isPast = dateObj < today
      var isAvailable = !!availableDaysSet[dateStr]
      var isSelected = dateStr === selectedDate
      var isDisabled = isPast || !isAvailable

      var cell = document.createElement(isDisabled ? 'div' : 'button')
      if (!isDisabled) cell.type = 'button'
      cell.textContent = String(d)

      if (isSelected && !isDisabled) {
        cell.className = 'flex h-9 w-full items-center justify-center rounded-lg bg-accent text-sm font-semibold text-white'
      } else if (isDisabled) {
        cell.className = 'flex h-9 w-full items-center justify-center rounded-lg text-sm text-neutral-200'
      } else {
        cell.className = 'flex h-9 w-full items-center justify-center rounded-lg text-sm font-medium text-neutral-900 transition hover:bg-accent/10'
      }

      if (!isDisabled) {
        cell.addEventListener('click', (function(ds) { return function() { selectedDate = ds; renderCalendar(); loadSlots(ds) } })(dateStr))
      }
      grid.appendChild(cell)
    }
    calendarContainer.appendChild(grid)
  }

  function loadSlots(date) {
    while (slotsContainer.firstChild) slotsContainer.removeChild(slotsContainer.firstChild)
    var loading = document.createElement('p'); loading.className = 'col-span-full text-sm text-neutral-400'; loading.textContent = 'Chargement...'
    slotsContainer.appendChild(loading)

    fetch('/api/bookings/slots?entityId=' + entityId + '&typeId=' + serviceId + '&date=' + date)
      .then(function(r) { return r.json() })
      .then(function(data) {
        while (slotsContainer.firstChild) slotsContainer.removeChild(slotsContainer.firstChild)
        if (!data.slots || data.slots.length === 0) { var msg = document.createElement('p'); msg.className = 'col-span-full text-sm text-neutral-400'; msg.textContent = 'Aucun creneau ce jour.'; slotsContainer.appendChild(msg); return }
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone
        data.slots.forEach(function(slot) {
          var time = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(slot.start))
          var btn = document.createElement('button'); btn.type = 'button'
          btn.className = 'rounded-lg border border-neutral-200 py-2 text-sm font-medium text-neutral-900 transition hover:border-accent hover:text-accent'
          btn.textContent = time
          btn.addEventListener('click', function() {
            selectedStart = slot.start
            selectedEnd = slot.end

            document.getElementById('booking-start-at').value = slot.start
            document.getElementById('booking-end-at').value = slot.end

            var dateF = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: tz }).format(new Date(slot.start))
            var t1 = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(slot.start))
            var t2 = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(slot.end))
            var recapText = dateF.charAt(0).toUpperCase() + dateF.slice(1) + ', ' + t1 + ' \u2014 ' + t2
            document.getElementById('recap-datetime-final').textContent = recapText

            showStep('step-recap')
          })
          slotsContainer.appendChild(btn)
        })
      })
      .catch(function() {
        while (slotsContainer.firstChild) slotsContainer.removeChild(slotsContainer.firstChild)
        var e = document.createElement('p'); e.className = 'col-span-full text-sm text-error'; e.textContent = 'Erreur de chargement.'
        slotsContainer.appendChild(e)
      })
  }

  document.getElementById('booking-form').addEventListener('submit', function(e) {
    e.preventDefault()
    var form = e.target
    var btn = document.getElementById('booking-submit')

    var n = document.getElementById('id-name').value.trim()
    var em = document.getElementById('id-email').value.trim()
    var ph = document.getElementById('id-phone').value.trim()
    if (!n || !em) { alert('Nom et email sont obligatoires.'); return }
    if (!selectedStart || !selectedEnd) { alert('Veuillez choisir un créneau.'); return }

    document.getElementById('form-name').value = n
    document.getElementById('form-email').value = em
    document.getElementById('form-phone').value = ph

    btn.disabled = true; btn.textContent = 'Envoi...'
    fetch('/api/bookings/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        appointment_type_id: form.typeId.value,
        entity_id: form.entityId.value,
        booker_name: form.name.value,
        booker_email: form.email.value,
        booker_phone: form.phone.value || null,
        booker_message: null,
        start_at: form.startAt.value,
        end_at: form.endAt.value
      })
    })
      .then(function(r) { return r.json() })
      .then(function(data) {
        if (data.error) { alert(data.error); btn.disabled = false; btn.textContent = 'Confirmer le rendez-vous'; return }
        window.location.href = '/' + entitySlug + '/services/' + serviceSlugVar + '/confirmed?name=' + encodeURIComponent(form.name.value) + '&date=' + encodeURIComponent(document.getElementById('recap-datetime-final').textContent)
      })
      .catch(function() { alert('Erreur.'); btn.disabled = false; btn.textContent = 'Confirmer le rendez-vous' })
  })

  loadAvailableDays()
})()
</script>

<style>
  .booking-hero {
    border-bottom: 1px solid var(--color-border);
  }
  .booking-panel {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .booking-panel :is(#step-calendar, #step-recap) {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    padding: 18px;
  }
  .booking-panel .field-label {
    margin-bottom: 6px;
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-neutral-600);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .booking-panel .field {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-neutral-900);
    font-size: 14px;
    line-height: 1.35;
    padding: 10px 12px;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .booking-panel .field:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 16%, transparent);
  }
  @media (min-width: 768px) {
    .booking-panel :is(#step-calendar, #step-recap) {
      padding: 22px;
    }
  }
</style>
