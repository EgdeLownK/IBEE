NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Server-only — jamais exposé côté client
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout (boutique)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret pour /api/cron/* (header Authorization: Bearer <secret> ou x-cron-secret)
CRON_SECRET=

# Emails transactionnels rendez-vous (Resend)
RESEND_API_KEY=
BOOKING_EMAIL_FROM=IBEE <onboarding@resend.dev>
# Signature des liens d'annulation client (fallback: CRON_SECRET)
BOOKING_EMAIL_SECRET=

# Logs perf dashboard (durées shell + pages) — activer en dev ou next start
# NEXT_DEBUG=1
