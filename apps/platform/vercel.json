{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm -C ../.. install --frozen-lockfile",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/booking-checkout-expiry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/team-payouts",
      "schedule": "0 7 * * *"
    }
  ]
}
