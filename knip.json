{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "SecondBrain/**",
    "*-preview.jsx",
    "supabase/**"
  ],
  "workspaces": {
    "apps/platform": {
      "entry": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "next.config.{ts,js,mjs}"
      ],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/*": {
      "project": "src/**/*.{ts,tsx}"
    }
  }
}
