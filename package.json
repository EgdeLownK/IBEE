{
  "name": "ibee",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ibee/platform dev",
    "build": "pnpm --filter @ibee/platform build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "deadcode": "knip"
  },
  "devDependencies": {
    "knip": "^6.4.1",
    "supabase": "^2.88.1",
    "turbo": "latest",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "workerd",
      "unrs-resolver"
    ]
  }
}
